[31;1m  .\scripts\register_daily_quotes_fetch.ps1                 # todos los días a las 18:45 hora local[0m
[31;1m  .\scripts\register_daily_quotes_fetch.ps1 -Hora 19:15[0m
[31;1m  .\scripts\register_daily_quotes_fetch.ps1 -Eliminar[0m
