[31;1mdef review_stats(rounds: list[dict]) -> dict:[0m
[31;1m    """Recuentos derivados sólo de entradas identificables (R17-05): hallazgos nuevos emitidos y verificaciones de Astra.[0m
[31;1m[0m
[31;1m    Una verificación cuenta como tal si Astra la registró con estado ``reproducido`` en una ronda posterior; el texto de la[0m
[31;1m    verificación puede declararla parcial, y eso no se interpreta aquí: se publica el recuento y el enlace al JSON."""[0m
[31;1m    new_by_id: dict[str, str] = {}[0m
[31;1m    emitted_round: dict[str, int] = {}[0m
[31;1m    for r in rounds:[0m
[31;1m        for h in r["new_findings"]:[0m
[31;1m            new_by_id[h["id"]] = h.get("severity") or ""[0m
[31;1m            emitted_round[h["id"]] = r["round"][0m
[31;1m    verified: set[str] = set()[0m
[31;1m    for r in rounds:[0m
[31;1m        for v in r["verifications"]:[0m
[31;1m            # sólo cuenta una verificación de un hallazgo existente, en una ronda posterior a su emisión (R18-03)[0m
[31;1m            if v["id"] in new_by_id and v["state"] == "reproducido" and r["round"] > emitted_round[v["id"]]:[0m
[31;1m                verified.add(v["id"])[0m
[31;1m    blocking = {i for i, s in new_by_id.items() if s == "bloqueante"}[0m
[31;1m    return {"new_total": len(new_by_id), "verified_total": len(verified), "blocking_new": len(blocking),[0m
[31;1m            "blocking_verified": len(blocking & verified), "unverified_ids": sorted(set(new_by_id) - verified)}[0m
[31;1m[0m
