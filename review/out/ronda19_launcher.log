[31;1mdef _first_heading(p: Path) -> str:[0m
[31;1m    with p.open(encoding="utf-8") as fh:[0m
[31;1m        for line in fh:[0m
[31;1m            if line.startswith("# "):[0m
[31;1m                return line[2:].strip()[0m
[31;1m    return p.stem[0m
[31;1m[0m
