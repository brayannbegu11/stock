[31;1mdef oracle_cost(q,p,c):[0m
[31;1m    gross=(q*p).quantize(D(1),rounding=ROUND_HALF_UP)[0m
[31;1m    rnd=ROUND_DOWN if c.rounding=='floor' else ROUND_HALF_UP[0m
[31;1m    slip=(gross*D(c.slippage_bps_per_side)/10000).quantize(D(1),rounding=rnd)[0m
[31;1m    ex=gross+slip[0m
[31;1m    comm=max((ex*c.commission_per_side).quantize(D(1),rounding=rnd),c.min_commission_twd) if ex>0 else D(0)[0m
[31;1m    return ex+comm[0m
