@pytest.mark.parametrize('blocked', [False, True])
def test_carry_matches_valid_empty_week(tmp_path, monkeypatch, right, blocked):
    raw, market = fixture(tmp_path, prices=lambda d: D(110) if d >= date(2024,1,15) else D(100))
    sid = market.by_symbol['A']
    days = [date(2024,1,12)] + ([date(2024,1,19)] if blocked else [])
    market.securities[sid].bars = [b for b in market.securities[sid].bars if b.session not in days]
    for day in days: del market.by_session[sid][day]
    if right != 'none':
        market.securities[sid].events = [DividendLike('r28-div',date(2024,1,17),'cash',cash_per_share=D(10),pay_date=date(2024,1,18),ambiguous=right=='ambiguous')]
    cfg = prev.BacktestConfig(date(2024,1,1),date(2024,1,26),slots=1,notional=10000,lot_size=1,commission_per_side=D(0),sell_tax=D(0),slippage_bps=0,label='lab',n_boot=20)
    runners = [prev.Runner(raw,market,cfg,[prev.MomentumForecaster(),prev.RandomForecaster(1)]) for _ in range(2)]
    for r in runners: r.run_week(date(2024,1,7))
    original = raw.find
    def fail(**kw):
        if kw['source_id']=='packet' and kw['dataset'].endswith('2024-W03'): raise OSError('r28 failure')
        return original(**kw)
    monkeypatch.setattr(raw,'find',fail)
    runners[0].run_week(date(2024,1,14))
    monkeypatch.setattr(raw,'find',original)
    for r in runners:
        for f in r.forecasters.values(): monkeypatch.setattr(f,'forecast',lambda *a,**kw:([],{}))
    runners[1].run_week(date(2024,1,14))
    for week in [None, date(2024,1,21)]:
        if week:
            for r in runners: r.run_week(week)
        a,b=runners
        assert a.cursor==b.cursor
        assert a.prev_equity==b.prev_equity
        assert a.open_slots==b.open_slots
        assert a.ambiguous_claims==b.ambiguous_claims
        for name in a.ledgers:
            # A valid abstention registers owners for its empty slots; those
            # identifiers hold no position, cash or event and are immaterial.
            assert {k:v for k,v in vars(a.ledgers[name]).items() if k!='owners_seen'}=={k:v for k,v in vars(b.ledgers[name]).items() if k!='owners_seen'}
            assert a.weeks[-1]['forecasters'][name]['equity_end']==b.weeks[-1]['forecasters'][name]['equity_end']


