// Renderiza la secci├│n de la semana y la tabla de semanas de docs/index.html con un data.json dado, en los tres idiomas.
// Uso: node tests/site_render.cjs <ruta a data.json>   ΓåÆ JSON {es|en|zh: {week, table}} por stdout.
const fs = require("fs"), vm = require("vm"), path = require("path");
const html = fs.readFileSync(path.join(__dirname, "..", "docs", "index.html"), "utf8");
const data = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
let code = [...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].pop()[1];
