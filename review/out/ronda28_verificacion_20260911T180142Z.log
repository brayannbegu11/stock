+from twlab.models.q1 import DividendLike
+
+
+@pytest.mark.parametrize('right', ['none', 'cash', 'ambiguous'])
+def test_consecutive_failed_weeks_match_empty_valid_books(tmp_path, monkeypatch, right):
+    raw, market = fixture(tmp_path, prices=lambda d: D(100))
+    sid = market.by_symbol['A']
+    market.securities[sid].bars = [b for b in market.securities[sid].bars if b.session != date(2024, 1, 12)]
+    del market.by_session[sid][date(2024, 1, 12)]
+    if right != 'none':
+        market.securities[sid].events = [DividendLike('r28-late-pay', date(2024, 1, 17), 'cash',
+            cash_per_share=D(10), pay_date=date(2024, 1, 24), ambiguous=right == 'ambiguous')]
+    cfg = prev.BacktestConfig(date(2024, 1, 1), date(2024, 1, 26), slots=1, notional=10000,
+        lot_size=1, commission_per_side=D(0), sell_tax=D(0), slippage_bps=0, label='lab', n_boot=20)
+    failed, control = [prev.Runner(raw, market, cfg, [prev.MomentumForecaster(), prev.RandomForecaster(1)]) for _ in range(2)]
+    for r in (failed, control):
+        r.run_week(date(2024, 1, 7))
+        for f in r.forecasters.values():
+            monkeypatch.setattr(f, 'forecast', lambda *a, **kw: ([], {}))
+    original = raw.find
+    def fail(**kw):
+        if kw['source_id'] == 'packet':
+            raise OSError('consecutive archive failures')
+        return original(**kw)
+    for sunday in (date(2024, 1, 14), date(2024, 1, 21)):
+        monkeypatch.setattr(raw, 'find', fail)
