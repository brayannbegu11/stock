+    original = runner.marks
+    def fail(session, ledger, kind, **kw):
+        if ledger.ledger_id == 'Q1':
+            raise OSError('market mark unavailable for Q1')
+        return original(session, ledger, kind, **kw)
+    monkeypatch.setattr(runner, 'marks', fail)
+    runner.run_week(date(2024, 1, 7))
+    assert runner.weeks[-1]['status'] == 'invalid:archive'
+
+
+def test_stored_markdown_keeps_failure_cause(tmp_path, monkeypatch):
+    from review.out.astra_scratch.test_r28 import history_failed_fixture
+    from twlab.backtest import markdown_report
+    raw, market, data = history_failed_fixture(tmp_path, monkeypatch)
+    text = markdown_report(data, title='history')
+    assert 'ARCHIVE-FAIL-2023-W52' in text
+    assert 'ARCHIVE-FAIL-2024-W02' in text

