        c=CostModel(D('0.001425') if i%3 else D(0),slippage_bps_per_side=[0,10,20,25][i%4],min_commission_twd=D(minimum),rounding=rounding)
        target=rng.randrange(1,30)*lot
        budget=oracle_cost(target,p,c)+D(['-1','-0.01','0','0.01','1'][i%5])
