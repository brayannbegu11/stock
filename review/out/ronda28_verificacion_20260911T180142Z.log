def test_sunday_end_to_end(tmp_path,monkeypatch):
    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
    assert d['weeks'][-1]['pending_outcome'] and 'filled' not in d['weeks'][-1]['forecasters']['Q0']
    ex=export_setup(monkeypatch,raw,d,tmp_path)
    out=ex.build();w=out['scenarios'][0]['weeks'][-1]
    assert w['prospective'] and out['status']['phase']==3
    asm=load('assemble_backtest_reports')
    original_spec=importlib.util.spec_from_file_location
    def redirected_spec(name,*args,**kwargs):
        spec=original_spec(name,*args,**kwargs)
        if name=='export_site_data':
            original_exec=spec.loader.exec_module
            def execute(module):
                original_exec(module);module.RAW=raw.root
            spec.loader.exec_module=execute
        return spec
    monkeypatch.setattr(importlib.util,'spec_from_file_location',redirected_spec)
    # Full header requires mature statistics: run earlier fixture weeks with the same Sunday --end.
    cfg2=replace(cfg,start=date(2023,12,10))
    r2=Runner(raw,m,cfg2,list(r.forecasters.values()));d2=r2.run()
    for sid in ['standard','user','longhist']:
        path=tmp_path/f'{sid}.md';path.write_text(markdown_report(d2,title='Backtest lab'),encoding='utf8')
        header=(lambda:asm.header_15(d2)) if sid=='standard' else (lambda:asm.header_15b(d2,d2)) if sid=='user' else (lambda:asm.header_15c(d2,d2))
        asm._assemble(path,'# Backtest',header)
        assert 'entrada pendiente' in path.read_text(encoding='utf8')
        assert 'predicci├│n del protocolo seg├║n el reloj' in path.read_text(encoding='utf8')
    # Render actual exported fixture in all languages.
    path=tmp_path/'site.json';path.write_text(json.dumps(out),encoding='utf8')
    result=subprocess.run(['node',str(ROOT/'review/out/astra_scratch/r21_render.cjs'),'file',str(path)],cwd=ROOT,capture_output=True,text=True,encoding='utf8',check=True)
    rendered=json.loads(result.stdout)
    for lang,x in rendered.items():assert x['tag_pro'] in x['week']

import sys, json
from pathlib import Path
ROOT = Path(__file__).resolve().parents[3]
sys.path[:0] = [str(ROOT), str(ROOT / 'src')]
from datetime import date, time, timedelta
from decimal import Decimal as D
from twlab.backtest import BacktestConfig, Runner, load_market, MomentumForecaster, RandomForecaster
from twlab.calendar import TradingCalendar
from twlab.store import RawStore
from twlab.timeutil import taipei

def fixture(tmp_path, *, dividends=(), prices=None, closures=(), end='2024-01-26', delisted=None,
            symbols=('A',), raw_symbol=None, mutate=None):
    store = RawStore(tmp_path / 'raw')
    manifest = {'listed': [], 'delisted': [], 'captures': {}}
    def capture(dataset, rows, source='finmind'):
        return store.put(source_id=source, dataset=dataset, payload=json.dumps({'status':200,'msg':'success','data':rows}).encode(), url='fixture')
    for symbol in symbols:
        rows=[]
        day=date(2021,1,1)
        while day <= date.fromisoformat(end):
            if day.weekday()<5 and day not in closures:
                p = prices(day) if prices and symbol=='A' else D(100)
                rows.append(dict(stock_id=raw_symbol or symbol, date=day.isoformat(), open=str(p), max=str(p), min=str(p), close=str(p),
                                 Trading_Volume=10000000, Trading_money=1000000000, Trading_turnover=1000))
            day += timedelta(days=1)
        bp=capture(f'TaiwanStockPrice/{raw_symbol or symbol}',rows)
        ds=list(dividends) if symbol=='A' else []
        bd=capture(f'TaiwanStockDividend/{symbol}',ds)
        manifest['listed'].append(dict(symbol=symbol,name=symbol,listing_date='2000-01-01'))
        if delisted and symbol=='A':
            manifest['delisted'].append(dict(symbol=symbol,name=symbol,delisting_date=delisted))
        manifest['captures'][symbol]=dict(price=bp.capture_id,price_rows=len(rows),dividend=bd.capture_id,dividend_rows=len(ds))
    if mutate:
        mutate(manifest,store,capture)
    path=tmp_path/'manifest.json'
    path.write_text(json.dumps(manifest),encoding='utf-8')
    cal=TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=closures,source_id='synthetic',recorded_at=taipei(date(2021,1,1)))
    return store,load_market(store,path,cal)

def runner(tmp_path, *, config_end=None, slots=1, notional=100000, extra=False, **kw):
    store,market=fixture(tmp_path,**kw)
    cfg=BacktestConfig(start=date(2024,1,1),end=date.fromisoformat(config_end or kw.get('end','2024-01-26')),
                       slots=slots,notional=notional,commission_per_side=D(0),sell_tax=D(0),slippage_bps=0,block_length=1,n_boot=20,label='Q0')
    fs=[MomentumForecaster(),RandomForecaster(cfg.seed)]
    if extra:
        f=MomentumForecaster(); f.name='EXTRA'; fs.insert(1,f)
    return Runner(store,market,cfg,fs)

def run_demo(tmp_path,monkeypatch,**kw):
    r=runner(tmp_path,**kw)
    result=r.run()
    # Adaptaci├│n de nombres de salida; ninguna modificaci├│n de comportamiento.
    result['summary'].update(result['summary']['forecasters'])
    for w in result['weeks']:
        w.update(w['forecasters'])
        if isinstance(w.get('paired'),dict):
            p=w['paired']['Q0']; w['paired_details']=w['paired']; w['paired']=p['paired']; w['unpaired_reason']=p['unpaired_reason']
    return result,list(r.ledgers.values()),r.store

def run_two_demo(tmp_path,monkeypatch,**kw):
    return run_demo(tmp_path,monkeypatch,symbols=('A','B'),slots=2,**kw)

