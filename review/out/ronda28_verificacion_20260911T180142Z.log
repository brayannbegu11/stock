def test_failed_week_still_manages_inherited_basket(tmp_path, monkeypatch, with_dividend):
    from decimal import Decimal as D
    from review.out.astra_scratch.r10_support import fixture
    now = [datetime(2024, 1, 6, 8, tzinfo=timezone.utc)]
    monkeypatch.setattr(prev.RawStore, '_now', lambda self: now[0])
    def prices(d):
        return D(80) if d >= date(2024, 1, 22) else D(110) if d == date(2024, 1, 19) else D(100)
    raw, market = fixture(tmp_path, prices=prices)
    sid = market.by_symbol['A']
    market.securities[sid].bars = [b for b in market.securities[sid].bars if b.session != date(2024, 1, 12)]
    del market.by_session[sid][date(2024, 1, 12)]
    if with_dividend:
        from twlab.models.q1 import DividendLike
        market.securities[sid].events = [DividendLike('r27-div', date(2024, 1, 17), 'cash',
            cash_per_share=D(10), pay_date=date(2024, 1, 18))]
    cfg = prev.BacktestConfig(date(2024, 1, 1), date(2024, 1, 26), slots=1, notional=10000,
        lot_size=1, commission_per_side=D(0), sell_tax=D(0), slippage_bps=0, label='lab', n_boot=20)
    runner = prev.Runner(raw, market, cfg, [prev.MomentumForecaster(), prev.RandomForecaster(1)])
    runner.run_week(date(2024, 1, 7))
    slot = runner.open_slots['Q0'][0][1][0]
    assert slot.status == 'exit_blocked' and runner.ledgers['Q0'].positions[sid].total_quantity == 100
    original = raw.find
    def fail(**kwargs):
        if kwargs['source_id'] == 'packet' and kwargs['dataset'].endswith('2024-W03'):
            raise OSError('disk failed for W03')
        return original(**kwargs)
    monkeypatch.setattr(raw, 'find', fail)
    runner.run_week(date(2024, 1, 14))
    assert runner.weeks[-1]['status'] == 'invalid:archive'
    after_failed = {'cash': str(runner.ledgers['Q0'].cash), 'cursor': str(runner.cursor['Q0']),
                    'status': slot.status}
    monkeypatch.setattr(raw, 'find', original)
    runner.run_week(date(2024, 1, 21))
    if with_dividend:
        assert runner.ledgers['Q0']._applied_actions == {'r27-div'}
        assert sum(e.cash_delta for e in runner.ledgers['Q0'].events if e.kind == 'receivable_settled') == D(1000)
    assert slot.exit.at.date() == date(2024, 1, 19), (after_failed, str(slot.exit.at), str(slot.exit.gross),
        runner.weeks[-1]['forecasters']['Q0']['portfolio_net_return_week_over_week'])
import copy, hashlib, importlib.util, json, subprocess
from pathlib import Path
from datetime import datetime, date, time, timezone
from dataclasses import replace
import pytest
from review.out.astra_scratch.r10_support import fixture, Runner, BacktestConfig, MomentumForecaster, RandomForecaster, ROOT, taipei
from twlab.store import RawStore
from twlab.packet import Rejection, packet_to_json, packet_from_json
from twlab.weekly import plan_week
from twlab.backtest import ManifestInconsistent, markdown_report

def load(name):
    spec=importlib.util.spec_from_file_location('r21_'+name,ROOT/'scripts'/f'{name}.py')
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

def export_setup(monkeypatch, raw, d, tmp_path):
    ex=load('export_site_data')
    monkeypatch.setattr(ex,'RAW',raw.root)
    monkeypatch.setattr(ex,'STORE',tmp_path)
    monkeypatch.setattr(ex,'SCENARIOS',[('standard','lab','fixture.md')])
    for name,value in [('export_rounds',[]),('export_docs',[]),('count_tests',0),('raw_coverage',{}),('master_stats',{})]:
        monkeypatch.setattr(ex,name,lambda v=value:v)
    (tmp_path/'backtest_lab.json').write_text(json.dumps(d,default=str),encoding='utf8')
    return ex

