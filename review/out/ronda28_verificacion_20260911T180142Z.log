def test_rejected_hash_and_reuse(tmp_path,monkeypatch):
    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
    plan=plan_week(taipei(date(2024,1,7),time(18)),m.calendar)
    p,rec,_=r.build_week_packet(plan)
    altered=replace(p,rejected=p.rejected+(Rejection('X','unknown_availability','availability could not be established'),))
    assert altered.packet_hash()!=p.packet_hash()
    # Corrupt only metadata-compatible archive: RawStore integrity agrees with bytes but packet hash differs.
    payload=packet_to_json(altered);(raw.root/rec.path).write_bytes(payload)
    mf=raw.root/'manifest.jsonl';rows=[json.loads(x) for x in mf.read_text().splitlines()]
    for row in rows:
        if row['capture_id']==rec.capture_id:row['sha256']=hashlib.sha256(payload).hexdigest()
    mf.write_text('\n'.join(map(json.dumps,rows)),encoding='utf8')
    r.store=RawStore(raw.root)
    with pytest.raises(ManifestInconsistent):r.build_week_packet(plan)

