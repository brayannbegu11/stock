def test_conflict_is_atomic_in_archive(tmp_path):
    raw,m=daily(tmp_path)
    a=m.securities['A']; orig=raw.get(a.bar_captures[date(2024,1,4)])
    body=json.loads(raw.read(orig));body['revision']=2
    revised=raw.put(source_id='twse',dataset=orig.dataset,payload=json.dumps(body).encode(),url='fixture')
    b=replace(a,security_id='B',symbol='9999',bar_captures=dict(a.bar_captures))
    b.bar_captures[date(2024,1,4)]=revised.capture_id;m.securities['B']=b
    snapshot=lambda:{str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in tmp_path.rglob('*') if p.is_file()}
    before=snapshot()
    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12)),[MomentumForecaster(),RandomForecaster(1)])
    with pytest.raises(ManifestInconsistent,match='conflicting session captures'):
        r.run_week(date(2024,1,7))
    assert snapshot()==before

