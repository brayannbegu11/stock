def test_created_at_is_only_normal_unhashed_difference_and_labels_isolate(tmp_path):
    raw,m=fixture(tmp_path)
    cfg=BacktestConfig(date(2024,1,1),date(2024,1,7),archive_label='lab')
    plan=plan_week(taipei(date(2024,1,7),time(18)),m.calendar)
    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
    p,c,_=r.build_week_packet(plan);p2,c2,_=r.build_week_packet(plan)
    assert p.packet_hash()==p2.packet_hash() and c==c2
    assert packet_to_json(p)!=packet_to_json(replace(p,created_at=datetime(2024,1,7,tzinfo=timezone.utc)))
    assert raw.read(c)==packet_to_json(p)
    r2=Runner(raw,m,replace(cfg,archive_label='other'),[MomentumForecaster(),RandomForecaster(1)])
    other,oc,_=r2.build_week_packet(plan)
    assert other.packet_hash()!=p.packet_hash() and oc.dataset!=c.dataset
    copy=raw.put(source_id='packet',dataset='other/shared',payload=raw.read(c),url='synthetic',extra={'packet_hash':p.packet_hash()})
    assert raw.find(source_id='packet',dataset=c.dataset,extra_equal={'packet_hash':p.packet_hash()})==c
    assert raw.find(source_id='packet',dataset=copy.dataset,extra_equal={'packet_hash':p.packet_hash()})==copy

