@pytest.mark.parametrize('state', ['prediction', 'late', 'unknown', 'reconstruction'])
def test_sunday_full_chain_four_states(tmp_path, monkeypatch, state):
    now = [datetime(2024, 1, 7 if state == 'late' else 6, 12 if state == 'late' else 8, tzinfo=timezone.utc)]
    monkeypatch.setattr(RawStore, '_now', lambda self: now[0])
    raw, market = prev.fixture(tmp_path, end='2024-01-26', symbols=('A', 'B'))
    now[0] = datetime(2024, 1, 8, 1, tzinfo=timezone.utc) if state == 'reconstruction' else datetime(2024, 1, 7, 12, tzinfo=timezone.utc)
    cfg = prev.BacktestConfig(date(2023, 12, 10), date(2024, 1, 7), slots=1, notional=10000,
                             lot_size=1, label='lab', archive_label='lab', n_boot=20)
    q1 = prev.MomentumForecaster(); q1.name = 'Q1'
    d = prev.Runner(raw, market, cfg, [prev.MomentumForecaster(), q1, prev.RandomForecaster(1)]).run()
    if state == 'unknown':
        p = packet_from_json(raw.read(raw.get(d['weeks'][-1]['packet_capture'])))
        (raw.root / raw.get(p.admitted[0].capture_id).path).unlink()
    ex = prev.export_setup(monkeypatch, raw, d, tmp_path)
    out = ex.build(); w = out['scenarios'][0]['weeks'][-1]
    assert w['pending_outcome'] and w['forecasters']['Q0']['filled'] is None
    assert w['prospective'] is (state == 'prediction')
    if state in ('late', 'unknown'):
        assert w['inputs_reason'] == ('late_inputs' if state == 'late' else 'unverified_inputs')
    asm = prev.load('assemble_backtest_reports')
    original_spec = importlib.util.spec_from_file_location
    def redirected(name, *args, **kwargs):
        spec = original_spec(name, *args, **kwargs)
        if name == 'export_site_data':
            original_exec = spec.loader.exec_module
            def execute(module):
                original_exec(module); module.RAW = raw.root
            spec.loader.exec_module = execute
        return spec
    monkeypatch.setattr(importlib.util, 'spec_from_file_location', redirected)
    phrase = {'prediction': 'predicci├│n del protocolo seg├║n el reloj', 'late': 'datos del paquete recibidos despu├⌐s del corte',
              'unknown': 'procedencia de las entradas no queda acreditada', 'reconstruction': 'es una reconstrucci├│n'}[state]
    for sid, header in [('standard', lambda: asm.header_15(d)), ('user', lambda: asm.header_15b(d, d)), ('longhist', lambda: asm.header_15c(d, d))]:
        path = tmp_path / (sid + '.md')
        path.write_text(prev.markdown_report(d, title='Backtest fixture'), encoding='utf8')
        asm._assemble(path, '# Backtest', header)
        assert phrase in path.read_text(encoding='utf8')
    path = tmp_path / 'site.json'; path.write_text(json.dumps(out), encoding='utf8')
    result = subprocess.run(['node', 'review/out/astra_scratch/r22_render.cjs', 'file', str(path)],
                            cwd=prev.ROOT, capture_output=True, text=True, encoding='utf8', check=True)
    for lang, x in json.loads(result.stdout).items():
        tag = x[{'prediction': 'tag_pro', 'late': 'tag_late', 'unknown': 'tag_unv', 'reconstruction': 'tag_recon'}[state]]
        assert f'<b>{tag} ┬╖' in x['week'], (lang, state)


