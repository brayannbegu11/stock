def test_stale_final_after_clean_last_measured_week_is_preserved(tmp_path,monkeypatch):
    raw,m=fixture(tmp_path,end='2024-01-17',symbols=('A','B'),prices=lambda d:D(100)+D((d-date(2021,1,1)).days)/100)
    a=m.securities[m.by_symbol['A']]
