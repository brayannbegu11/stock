      "contraejemplo": "Generaci├│n inicial: fuente con reloj injected y Q0 con system. Tras comprobar predicciones, una clasificaci├│n anidada de una semana invalid:archive deja _PIN=None; entonces se intercambian los relojes. La clasificaci├│n exterior devuelve prospective=true y reasons=[], aunque la inicial y la final son rechazadas. Ocurre tanto conservando _MANIFEST como poni├⌐ndolo a None. Contradice README y 33 ┬º1/R27-02.",
      "comando_reproduccion": "python -B -m pytest -q -p no:cacheprovider review/out/astra_scratch/test_r28.py -k nested_pin_preserves_outer_generation --basetemp review/out/astra_scratch/r28_01",
      "prueba_propuesta": "from review.out.astra_scratch.test_r23 import setup\nfrom review.out.astra_scratch.test_r25 import rewrite_manifest\nfrom review.out.astra_scratch.test_r27 import source_id\n\ndef test_nested_classification_preserves_outer_pin(tmp_path, monkeypatch):\n    raw, market, data, ex, w = setup(tmp_path, monkeypatch)\n    src = source_id(raw, w)\n    fid = w['forecasters']['Q0']['forecast_capture_id']\n    rewrite_manifest(raw, lambda rows: [r.update(clock_source='injected') for r in rows if r['capture_id'] == src])\n    assert not ex.classify_week('lab', w)['prospective']\n    original = ex.forecast_archive\n    def interleave(*args, **kwargs):\n        result = original(*args, **kwargs)\n        ex.classify_week('lab', {'status': 'invalid:archive'})\n        def mutate(rows):\n            for r in rows:\n                if r['capture_id'] == src: r['clock_source'] = 'system'\n                if r['capture_id'] == fid: r['clock_source'] = 'injected'\n        rewrite_manifest(raw, mutate)\n        return result\n    monkeypatch.setattr(ex, 'forecast_archive', interleave)\n    result = ex.classify_week('lab', w)\n    monkeypatch.setattr(ex, 'forecast_archive', original)\n    assert not ex.classify_week('lab', w)['prospective']\n    assert not result['prospective']\n",
