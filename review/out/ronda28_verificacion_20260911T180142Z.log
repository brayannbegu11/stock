    const open=state.open.has(w.week_id);
    const closure=(sc.weeks_extraordinary_closure_unhandled||[]).includes(w.week_id);
    const status=w.status==="invalid:archive"?`<span class="chip bad">${esc((t("status_reason")||{})["invalid:archive"]||w.status)}</span>`:w.pending_outcome?`<span class="chip warn">${esc(ST.pending)}</span>`:closure?`<span class="chip warn">${esc(ST.closure)}</span>`:w.status!=="valid"?`<span class="chip">${esc((t("status_reason")||{})[w.status]||w.status)}</span>`:"";
    const pro=w.prospective===true?`<span class="chip ok">${esc(t("wk_tag_pro"))}</span>`:"";
    const cell=f=>{ const x=w.forecasters[f]; if(!x) return `<td class="num flat">ΓÇö</td>`; if(w.pending_outcome) return `<td class="num flat">ΓÇª</td>`; const v=x.net; const abst=x.status!=="selected"?` <span class="chip">${esc(ST.nosel)}</span>`:""; if(typeof v!=="number") return `<td class="num flat">ΓÇö${abst}</td>`; return `<td class="num ${cls(v)}">${arrow(v)}${esc(pct(v))}${x.failed?` <span class="chip bad" title="${esc(t("no_lot"))}">ΓêÆ${x.failed}</span>`:""}${abst}</td>`; };
    const main=`<tr class="wk${open?" open":""}" data-week="${esc(w.week_id)}" tabindex="0" aria-expanded="${open}"><td><span class="caret">Γû╕</span></td><td class="mono">${esc(w.week_id)}</td><td>${esc(fmtDay(w.cutoff_at))}</td><td class="num">${nf(w.eligible||0,0)}</td><td class="num ${w.pending_outcome?"flat":cls(w.ew_gross)}">${w.pending_outcome?"ΓÇª":arrow(w.ew_gross)+esc(pct(w.ew_gross))}</td>${FC.map(cell).join("")}<td>${status}${pro}</td></tr>`;
    const detail=`<tr class="detail" data-detail="${esc(w.week_id)}"${open?"":" hidden"}><td colspan="${6+FC.length}"><div class="dgrid">${FC.map(f=>pickList(w,f)).join("")}</div></td></tr>`;
    return main+detail;
  }).join("");
  return `<div class="card weeks"><h3 style="margin-bottom:2px">${esc(t("weeks_title"))}</h3><p class="note" style="margin:0 0 10px">${esc(t("weeks_hint"))}</p><div class="scroll"><table><thead>${head}</thead><tbody>${rows}</tbody></table></div></div>`;
}
function pickList(w,f){
  const x=w.forecasters[f]; const PS=t("pick_status"), RS=t("reason"); if(!x) return "";
  const items=(x.picks||[]).map(p=>{
    const st=p.entry_status||(w.pending_outcome?"pending":"");
    const chip=st?`<span class="chip ${st==="entry_failed"?"bad":st==="exited"||st==="filled"?"":"warn"} soft">${esc(PS[st]||st)}${p.entry_reason?" ┬╖ "+esc(RS[p.entry_reason]||p.entry_reason):""}</span>`:"";
    const g=typeof p.gross_return==="number"?`<span class="num ${cls(p.gross_return)}">${arrow(p.gross_return)}${esc(pct(p.gross_return))}</span>`:chip;
    return `<li><span class="mono">${esc(p.symbol)}</span><span class="nm" lang="zh-Hant">${esc(p.name)}${typeof p.gross_return==="number"&&st==="entry_failed"?" "+chip:""}</span>${g}</li>`;
  }).join("");
  const sub=x.status==="selected"?(w.pending_outcome?"":`${esc(t("th").gross)} ${esc(pct(x.gross_picks))} ┬╖ ${esc(t("th").net(t("fc_short")[f]))} ${esc(pct(x.net))}${x.paired===false&&x.unpaired_reason?` ┬╖ <span class="chip">${esc(RS[x.unpaired_reason]||x.unpaired_reason)}</span>`:""}`):esc(statusReason(x))+(typeof x.net==="number"?` ┬╖ ${esc(t("th").net(t("fc_short")[f]))} ${esc(pct(x.net))}`:"");
  return `<div class="f"><h4><i class="dot ${f}"></i>${esc(t("fc")[f])}</h4><ul>${items||`<li><span></span><span class="nm">${esc(t("st").nosel)}</span><span></span></li>`}</ul><p class="note" style="margin-top:6px">${sub}</p></div>`;
}
function reviewSection(){
  const rounds=DATA.rounds||[]; const SEV=["bloqueante","alta","media","baja"];
  const first=rounds[0]||{findings_new:0,severity:{}}, last=rounds[rounds.length-1]||{findings_new:0,severity:{}};
  const RS=DATA.review_stats||{}; const K=t("rev_k"); const vc=verdictCounts(rounds);
  const list=rounds.map(r=>{
    const bar=SEV.map(s=>{const n=r.severity[s]||0; return n?`<i class="sev-${s}" style="width:${n*7}px" title="${esc(t("sev")[s])}: ${n}"></i>`:"";}).join("");
    const sevtxt=SEV.filter(s=>r.severity[s]).map(s=>`${r.severity[s]} ${esc(t("sev")[s])}`).join(" ┬╖ ");
    return `<div class="round"><div class="n"><small>${esc(t("round_word"))}</small>${r.round}</div><div>
      <div class="meta"><span class="chip ${r.verdict==="rechazado"?"warn":"ok"}">${esc(t("verdicts")[r.verdict]||r.verdict)}</span><span>${esc(t("new_findings")(r.findings_new))}</span><span class="sevbar">${bar}</span><span>${sevtxt}</span></div>
      ${state.lang==="es"?`<p class="sum">${esc(r.summary||"")}</p>`:`<details class="orig"><summary>${esc(t("orig_summary"))}</summary><p class="sum" lang="es">${esc(r.summary||"")}</p></details>`}
      <p class="links"><a href="${esc(gh(r.file))}">${esc(t("astra_out"))} Γåù</a>${r.response?`<a href="${esc(gh(r.response))}">${esc(t("response"))} Γåù</a>`:""}</p>
    </div></div>`;
  }).join("");
  return `<section class="block" id="${IDS.review}"><div class="wrap">
    ${secHead("rev_label",esc(t("rev_title")(rounds.length,vc)),esc(t("rev_sub")))}
    <div class="revgrid">
      <div class="card"><h3>${esc(t("rev_chart"))}</h3>${findingsChart(rounds)}<div class="sevlegend">${SEV.map(s=>`<span><i class="sev-${s}"></i>${esc(t("sev")[s])}</span>`).join("")}</div><p class="note">${esc(t("rev_cap")(first.findings_new,first.severity.bloqueante||0,last.findings_new,lastBlockingRound(rounds)))}</p></div>
      <div class="card side">
        <div><div class="k">${esc(K.total)}</div><div class="v">${nf(RS.new_total||0,0)}</div><div class="s">${esc(verdictText(vc))}</div></div>
        <div><div class="k">${esc(K.verified)}</div><div class="v">${RS.verified_total!=null?nf(RS.verified_total,0):"ΓÇö"}</div><div class="s">${RS.unverified_ids?esc(RS.unverified_ids.slice(0,5).join(" ┬╖ "))+(RS.unverified_ids.length>5?" ΓÇª":""):""}</div></div>
        <div><div class="k">${esc(K.block)}</div><div class="v">${RS.blocking_new!=null?`${nf(RS.blocking_new,0)} ┬╖ ${nf(RS.blocking_verified,0)}`:"ΓÇö"}</div><div class="s">${esc(t("sev").bloqueante)}</div></div>
        <div><div class="k">${esc(K.last)}</div><div class="v">${last.findings_new}</div><div class="s">${(last.severity||{}).alta||0} ${esc(t("sev").alta)} ┬╖ ${(last.severity||{}).media||0} ${esc(t("sev").media)}</div></div>
      </div>
    </div>
    <details class="more"><summary>${esc(t("see_rounds")(rounds.length))}</summary><div class="rounds">${list}</div></details>
  </div></section>`;
}
function findingsChart(rounds){
  if(!rounds.length) return "";
  const SEV=["baja","media","alta","bloqueante"];
  const N=narrow(); const W=N?380:640,H=N?190:220,L=28,R=6,T=14,B=24; const iw=W-L-R, ih=H-T-B;
  const max=Math.max(5,...rounds.map(r=>r.findings_new));
  const bw=iw/rounds.length, gap=Math.min(12,bw*0.34);
  const Y=v=>T+ih*(1-v/max);
  const ticks=[0,Math.round(max/2),max];
  const grid=ticks.map(v=>`<line x1="${L}" x2="${W-R}" y1="${Y(v).toFixed(1)}" y2="${Y(v).toFixed(1)}" stroke="var(--line)"/><text x="${L-6}" y="${(Y(v)+3.5).toFixed(1)}" text-anchor="end">${v}</text>`).join("");
  const bars=rounds.map((r,i)=>{ let acc=0; const x=L+i*bw+gap/2, w=bw-gap; const segs=SEV.map(s=>{const n=r.severity[s]||0; if(!n) return ""; const y1=Y(acc+n), y0=Y(acc); acc+=n; return `<rect x="${x.toFixed(1)}" y="${y1.toFixed(1)}" width="${w.toFixed(1)}" height="${Math.max(0,(y0-y1)-1).toFixed(1)}" rx="1" style="fill:var(--sev-${({bloqueante:"block",alta:"high",media:"mid",baja:"low"})[s]})"/>`;}).join("");
    return segs+`<text x="${(x+w/2).toFixed(1)}" y="${(Y(r.findings_new)-5).toFixed(1)}" text-anchor="middle" style="fill:var(--ink-2)">${r.findings_new}</text><text x="${(x+w/2).toFixed(1)}" y="${H-8}" text-anchor="middle">${r.round}</text>`; }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="${esc(t("rev_chart"))}">${grid}${bars}</svg>`;
}
function dataSection(){
  const rc=DATA.raw_coverage||{}; const m=DATA.master||{}; const base=anyScenario();
    lines.append("|---|" + "---|" * len(names))
    for w in result["weeks"]:
        if w["status"] != "valid":
            lines.append(f"| {w['week_id']} | " + " | ".join([w.get("note", w["status"])] + [""] * (len(names) - 1)) + " |")
            continue
        cells = []
        for n in names:
            fr = w["forecasters"].get(n, {})
            picks = fr.get("picks", [])
            if not picks:
                net0 = fr.get("portfolio_net_return_open_close")
                tail0 = f" ΓåÆ neto del libro {net0*100:+.2f} % (posiciones heredadas)" if net0 is not None else ""
                cells.append(f"({fr.get('forecast_status', 'ΓÇö')}: {fr.get('status_reason') or ''}){tail0}".strip())
                continue
            def _pick(p):
                s = f"{p['symbol']} {p['name']}"
                if p.get("gross_return") is not None:
                    return s + f" {p['gross_return']*100:+.1f} %"
                if p.get("entry_status") == "entry_failed":
                    return s + f" (sin ejecutar: {p.get('entry_reason')})"
                if p.get("entry_status") in ("exit_blocked",):
                    return s + " (salida bloqueada)"
                return s
            txt = ", ".join(_pick(p) for p in picks)
            net = fr.get("portfolio_net_return_open_close")
            if net is not None:
                tail = f" ΓåÆ neto {net*100:+.2f} %"
            elif w.get("pending_outcome"):
                tail = " ΓåÆ pendiente"
            elif fr.get("stale_prices"):
                tail = f" ΓåÆ sin intervalo medible ({fr['stale_prices'][0].split(':')[0]})"
            else:
                tail = " ΓåÆ sin intervalo medible"
            cells.append(txt + tail)
        lines.append(f"| {w['week_id']} | " + " | ".join(cells) + " |")
    return "\n".join(lines) + "\n"
