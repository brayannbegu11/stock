+import copy
+import hashlib
+import json
+from dataclasses import replace
+from datetime import date
+from decimal import Decimal as D
+
+import pytest
+from review.out.astra_scratch import test_r21 as prev
+from review.out.astra_scratch.r10_support import fixture
+from review.out.astra_scratch.test_r25 import rewrite_manifest
+from twlab.models.q1 import DividendLike
+
+
+@pytest.mark.parametrize('right', ['none', 'cash', 'ambiguous'])
+def test_consecutive_failed_weeks_match_empty_valid_books(tmp_path, monkeypatch, right):
+    raw, market = fixture(tmp_path, prices=lambda d: D(100))
+    sid = market.by_symbol['A']
+    market.securities[sid].bars = [b for b in market.securities[sid].bars if b.session != date(2024, 1, 12)]
+    del market.by_session[sid][date(2024, 1, 12)]
+    if right != 'none':
+        market.securities[sid].events = [DividendLike('r28-late-pay', date(2024, 1, 17), 'cash',
+            cash_per_share=D(10), pay_date=date(2024, 1, 24), ambiguous=right == 'ambiguous')]
+    cfg = prev.BacktestConfig(date(2024, 1, 1), date(2024, 1, 26), slots=1, notional=10000,
+        lot_size=1, commission_per_side=D(0), sell_tax=D(0), slippage_bps=0, label='lab', n_boot=20)
+    failed, control = [prev.Runner(raw, market, cfg, [prev.MomentumForecaster(), prev.RandomForecaster(1)]) for _ in range(2)]
+    for r in (failed, control):
+        r.run_week(date(2024, 1, 7))
+        for f in r.forecasters.values():
+            monkeypatch.setattr(f, 'forecast', lambda *a, **kw: ([], {}))
+    original = raw.find
+    def fail(**kw):
+        if kw['source_id'] == 'packet':
+            raise OSError('consecutive archive failures')
+        return original(**kw)
+    for sunday in (date(2024, 1, 14), date(2024, 1, 21)):
+        monkeypatch.setattr(raw, 'find', fail)
+        failed.run_week(sunday)
+        monkeypatch.setattr(raw, 'find', original)
+        control.run_week(sunday)
+        assert failed.cursor == control.cursor
+        assert failed.prev_equity == control.prev_equity
+        assert failed.open_slots == control.open_slots
+        assert failed.ambiguous_claims == control.ambiguous_claims
+        for name in failed.ledgers:
+            a, b = failed.ledgers[name], control.ledgers[name]
+            print(right, sunday, name, 'cash', a.cash, b.cash, 'clock', a._last_at, b._last_at)
+            assert a.cash == b.cash
+            assert {k: v for k, v in vars(a).items() if k != 'owners_seen'} == {k: v for k, v in vars(b).items() if k != 'owners_seen'}
+
+
+@pytest.mark.parametrize('field,value', [('admitted', [None]), ('rejected', [None]), ('cutoff_at', [])])
+def test_hash_valid_bad_packet_fields_contained(tmp_path, monkeypatch, field, value):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    rec = raw.get(data['weeks'][-1]['packet_capture'])
+    body = json.loads(raw.read(rec))
+    body[field] = value
+    payload = json.dumps(body).encode()
+    (raw.root / rec.path).write_bytes(payload)
+    rewrite_manifest(raw, lambda rows: [r.update(sha256=hashlib.sha256(payload).hexdigest(), bytes=len(payload)) for r in rows if r['capture_id'] == rec.capture_id])
+    runner.run_week(date(2024, 1, 7))
+    assert runner.weeks[-1]['status'] == 'invalid:archive'
+
+
+def test_failure_during_second_ledger_does_not_escape(tmp_path, monkeypatch):
+    raw, market, cfg, old, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    runner = prev.Runner(raw, market, replace(cfg, end=date(2024, 1, 26)), list(old.forecasters.values()))
+    original = runner.marks
+    def fail(session, ledger, kind, **kw):
+        if ledger.ledger_id == 'Q1':
+            raise OSError('market mark unavailable for Q1')
+        return original(session, ledger, kind, **kw)
+    monkeypatch.setattr(runner, 'marks', fail)
+    runner.run_week(date(2024, 1, 7))
+    assert runner.weeks[-1]['status'] == 'invalid:archive'
+
+
+def test_stored_markdown_keeps_failure_cause(tmp_path, monkeypatch):
+    from review.out.astra_scratch.test_r28 import history_failed_fixture
+    from twlab.backtest import markdown_report
+    raw, market, data = history_failed_fixture(tmp_path, monkeypatch)
+    text = markdown_report(data, title='history')
+    assert 'ARCHIVE-FAIL-2023-W52' in text
+    assert 'ARCHIVE-FAIL-2024-W02' in text

