def oracle_cost(q,p,c):
    gross=(q*p).quantize(D(1),rounding=ROUND_HALF_UP)
    rnd=ROUND_DOWN if c.rounding=='floor' else ROUND_HALF_UP
    slip=(gross*D(c.slippage_bps_per_side)/10000).quantize(D(1),rounding=rnd)
    ex=gross+slip
    comm=max((ex*c.commission_per_side).quantize(D(1),rounding=rnd),c.min_commission_twd) if ex>0 else D(0)
    return ex+comm

@pytest.mark.parametrize('lot',[1,1000])
@pytest.mark.parametrize('minimum',[0,20])
