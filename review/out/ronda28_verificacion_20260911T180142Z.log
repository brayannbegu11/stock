const ctx = { document: { getElementById: () => ({ textContent: JSON.stringify(data) }) }, Intl, URLSearchParams };
vm.createContext(ctx);
vm.runInContext(code, ctx);
const a = ctx.api, out = {};
for (const lang of ["es", "en", "zh"]) {
