def fixture(tmp_path, *, dividends=(), prices=None, closures=(), end='2024-01-26', delisted=None,
            symbols=('A',), raw_symbol=None, mutate=None):
    store = RawStore(tmp_path / 'raw')
    manifest = {'listed': [], 'delisted': [], 'captures': {}}
    def capture(dataset, rows, source='finmind'):
        return store.put(source_id=source, dataset=dataset, payload=json.dumps({'status':200,'msg':'success','data':rows}).encode(), url='fixture')
    for symbol in symbols:
        rows=[]
        day=date(2021,1,1)
        while day <= date.fromisoformat(end):
            if day.weekday()<5 and day not in closures:
                p = prices(day) if prices and symbol=='A' else D(100)
                rows.append(dict(stock_id=raw_symbol or symbol, date=day.isoformat(), open=str(p), max=str(p), min=str(p), close=str(p),
                                 Trading_Volume=10000000, Trading_money=1000000000, Trading_turnover=1000))
            day += timedelta(days=1)
        bp=capture(f'TaiwanStockPrice/{raw_symbol or symbol}',rows)
        ds=list(dividends) if symbol=='A' else []
        bd=capture(f'TaiwanStockDividend/{symbol}',ds)
        manifest['listed'].append(dict(symbol=symbol,name=symbol,listing_date='2000-01-01'))
        if delisted and symbol=='A':
            manifest['delisted'].append(dict(symbol=symbol,name=symbol,delisting_date=delisted))
        manifest['captures'][symbol]=dict(price=bp.capture_id,price_rows=len(rows),dividend=bd.capture_id,dividend_rows=len(ds))
    if mutate:
        mutate(manifest,store,capture)
    path=tmp_path/'manifest.json'
    path.write_text(json.dumps(manifest),encoding='utf-8')
    cal=TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=closures,source_id='synthetic',recorded_at=taipei(date(2021,1,1)))
    return store,load_market(store,path,cal)

def runner(tmp_path, *, config_end=None, slots=1, notional=100000, extra=False, **kw):
    store,market=fixture(tmp_path,**kw)
    cfg=BacktestConfig(start=date(2024,1,1),end=date.fromisoformat(config_end or kw.get('end','2024-01-26')),
                       slots=slots,notional=notional,commission_per_side=D(0),sell_tax=D(0),slippage_bps=0,block_length=1,n_boot=20,label='Q0')
    fs=[MomentumForecaster(),RandomForecaster(cfg.seed)]
    if extra:
        f=MomentumForecaster(); f.name='EXTRA'; fs.insert(1,f)
    return Runner(store,market,cfg,fs)

