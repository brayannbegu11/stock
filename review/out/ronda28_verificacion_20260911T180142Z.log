def test_visible_symbol_matches_archived_ranking(tmp_path, monkeypatch):
    raw, _, _, _, d, _ = prev.sunday_fixture(tmp_path, monkeypatch)
    x = d['weeks'][-1]['forecasters']['Q0']
    archived = json.loads(raw.read(raw.get(x['forecast_capture_id'])))['forecast']['ranking'][0]
    assert archived['ticker_as_of'] == 'A'
    x['picks'][0].update(symbol='9999', name='EMPRESA INVENTADA')
    ex = prev.export_setup(monkeypatch, raw, d, tmp_path)
    out = ex.build()
    path = tmp_path / 'site.json'; path.write_text(json.dumps(out), encoding='utf8')
    result = subprocess.run(['node', 'review/out/astra_scratch/r22_render.cjs', 'file', str(path)],
                            cwd=prev.ROOT, capture_output=True, text=True, encoding='utf8', check=True)
    for lang, rendered in json.loads(result.stdout).items():
        assert '9999' in rendered['week'] and 'EMPRESA INVENTADA' in rendered['week']
    w = out['scenarios'][0]['weeks'][-1]
    assert not w['prospective'] or w['forecasters']['Q0']['picks'][0]['symbol'] == archived['ticker_as_of'], w


