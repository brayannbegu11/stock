@pytest.mark.parametrize('lang,phrase',[('es','viernes siguiente'),('en','next Friday'),('zh','Σ╕ïΘÇ▒Σ║ö')])
def test_weekly_retry_respects_next_weeks_holiday(tmp_path,lang,phrase):
    from twlab.ledger import Fill
    raw,m=fixture(tmp_path,end='2024-01-19',closures=(date(2024,1,19),))
    s=next(iter(m.securities.values()));missing=date(2024,1,12)
    s.bars=[b for b in s.bars if b.session!=missing]
    del m.by_session[s.security_id][missing];m.traded_days.discard(missing)
    cfg=BacktestConfig(date(2024,1,1),date(2024,1,19),slots=1,notional=10000,lot_size=1)
    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
    r.run_week(date(2024,1,7));old=r.open_slots['Q0'][0][1][0]
    assert old.exit is None
    r.run_week(date(2024,1,14))
    assert isinstance(old.exit,Fill) and old.exit.at.date()==date(2024,1,18)
    x=render()[lang]
    assert phrase not in json.dumps(x['steps'],ensure_ascii=False)

def test_schedule_time_across_dst():
    from zoneinfo import ZoneInfo
    for day,hour in [(date(2026,9,13),20),(date(2026,11,8),21)]:
        local=datetime.combine(day,time(8),ZoneInfo('America/Toronto'))
        tp=local.astimezone(ZoneInfo('Asia/Taipei'))
        assert tp.date()==day and tp.hour==hour
        assert tp>datetime.combine(day,time(18),ZoneInfo('Asia/Taipei'))

def test_readme_current_test_count():
    txt=(ROOT/'README.md').read_text(encoding='utf8')
    assert '304 acceptance tests' not in txt and '304 synthetic tests pass' not in txt

def test_q1_training_config_hashes_confirm_40_and_52():
    import re
    from twlab.models.q1 import MODEL_ID, FEATURE_NAMES, LGBM_PARAMS
    for sid,minimum in [('standard',40),('user',40),('longhist',52)]:
        s=source(sid)['summary']
        for item in s['forecasters']['Q1']['training_history']:
            n=int(re.search(r'rows=(\d+)',item)[1])
            cfg={'model_id':MODEL_ID,'features':FEATURE_NAMES,'ridge_alpha':float(n)*.01,'lgbm':LGBM_PARAMS,
                 'seed':s['assumptions']['seed'],'target':'rank01(total_return_open_close_next_week)','min_weeks':minimum}
            h=hashlib.sha256(json.dumps(cfg,sort_keys=True,default=str).encode()).hexdigest()[:12]
            assert item.endswith('cfg='+h)

