@pytest.mark.parametrize('failure_at', ['packet', 'Q0', 'Q1', 'A1'])
def test_archive_failure_does_not_mutate_books(tmp_path, monkeypatch, failure_at):
    raw, market, cfg, old, _, now = prev.sunday_fixture(tmp_path, monkeypatch)
    cfg = replace(cfg, end=date(2024, 1, 26))
    runner = prev.Runner(raw, market, cfg, list(old.forecasters.values()))
    original = raw.find
    before = copy.deepcopy((runner.ledgers, runner.cursor, runner.prev_equity, runner.open_slots))
    def fail(**kwargs):
        if (failure_at == 'packet' and kwargs['source_id'] == 'packet') or (
            kwargs['source_id'] == 'forecast' and f'/{failure_at}/' in kwargs['dataset']):
            raise OSError('r27 disk failure')
        return original(**kwargs)
    monkeypatch.setattr(raw, 'find', fail)
    runner.run_week(date(2024, 1, 7))
    assert runner.weeks[-1]['status'] == 'invalid:archive'
    for name in runner.ledgers:
        assert vars(runner.ledgers[name]) == vars(before[0][name])
    assert (runner.cursor, runner.prev_equity, runner.open_slots) == before[1:]
    monkeypatch.setattr(raw, 'find', original)
    now[0] = datetime(2024, 1, 14, 12, tzinfo=timezone.utc)
    runner.run_week(date(2024, 1, 14))
    assert runner.weeks[-1]['status'] == 'valid'


