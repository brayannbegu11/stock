+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+root = Path(__file__).resolve().parents[3]
+baseline = root / 'review/out/ronda28_verificacion_20260911T180142Z_baseline.sha256'
+matched, changed, unreadable = [], [], []
+for line in baseline.read_text(encoding='utf-8-sig').splitlines():
+    sha, name = line.split('  ', 1)
+    try:
+        actual = hashlib.sha256((root / name).read_bytes()).hexdigest()
+    except OSError as exc:
+        unreadable.append([name, type(exc).__name__])
+        continue
+    (matched if actual.lower() == sha.lower() else changed).append(name)
+results = {}
+for name in ('r28_current', 'r28_extended_final', 'r28_publication'):
+    p = root / 'review/out/astra_scratch' / (name + '.xml')
+    if p.exists():
+        results[name] = ET.parse(p).getroot().find('testsuite').attrib
+spec = importlib.util.spec_from_file_location('r28_audit_export', root / 'scripts/export_site_data.py')
+ex = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(ex)
+ex.count_tests = lambda: 432
+fresh = ex.build()
+published = json.loads((root / 'docs/site/data.json').read_text(encoding='utf8'))
+scenarios = []
+for sc in fresh['scenarios']:
+    old = next(s for s in published['scenarios'] if s['id'] == sc['id'])
+    scenarios.append({'id': sc['id'], 'weeks': len(sc['weeks']), 'prospective': sc['prospective_weeks'],
+        'invalid_archive': sc['weeks_invalid_archive'], 'same_forecasters': sc['forecasters'] == old['forecasters'],
+        'same_weeks': sc['weeks'] == old['weeks']})
+out = {'baseline': baseline.name, 'matched': len(matched), 'changed': changed, 'unreadable': unreadable,
+       'tests': results, 'fresh_scenarios': scenarios}
+(root / 'review/out/astra_scratch/r28_audit_current.json').write_text(json.dumps(out, indent=2), encoding='utf8')
+print(json.dumps(out, indent=2))
