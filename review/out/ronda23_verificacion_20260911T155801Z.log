def save_forecast(raw, d, mutate):
    w = d['weeks'][-1]
    x = w['forecasters']['Q0']
    old = raw.get(x['forecast_capture_id'])
    body = json.loads(raw.read(old))
    mutate(body['forecast'])
    rec = raw.put(source_id='forecast', dataset=old.dataset,
                  payload=json.dumps(body).encode(), url='fixture')
    x.update(forecast_sha256=rec.sha256, forecast_capture_id=rec.capture_id,
             forecast_status=body['forecast']['status'])
    return body


def exported(raw, d, tmp_path, monkeypatch):
    return prev.export_setup(monkeypatch, raw, d, tmp_path).build()['scenarios'][0]['weeks'][-1]


@pytest.mark.parametrize('kind', ['abstained', 'selected_empty', 'invalid', 'abstained_nonempty', 'duplicate', 'rank_order', 'picks_order'])
def test_forecast_contract(tmp_path, monkeypatch, kind):
    raw, _, _, _, d, _ = prev.sunday_fixture(tmp_path, monkeypatch)
    x = d['weeks'][-1]['forecasters']['Q0']
    def mutate(fc):
        if kind in ('abstained', 'invalid', 'selected_empty'):
            fc.update(status='selected' if kind == 'selected_empty' else kind, ranking=[], status_reason='fixture')
            x['picks'] = []
        elif kind == 'abstained_nonempty':
            fc.update(status='abstained', status_reason='fixture')
            x['picks'] = []
        else:
            fc['ranking'].append(copy.deepcopy(fc['ranking'][0]))
            fc['ranking'][1]['rank'] = 2
            x['picks'].append(copy.deepcopy(x['picks'][0]))
            if kind != 'duplicate':
                fc['ranking'][1]['security_id'] = 'TWSE:B@2000-01-01'
                x['picks'][1].update(security_id='TWSE:B@2000-01-01', symbol='B', name='B')
            if kind == 'rank_order':
                fc['ranking'].reverse()
                x['picks'].reverse()
            if kind == 'picks_order':
                x['picks'].reverse()
    save_forecast(raw, d, mutate)
    w = exported(raw, d, tmp_path, monkeypatch)
    # Aligned array order is sufficient under the current contract; ranks need only be contiguous.
    assert w['prospective'] is (kind in ('abstained', 'rank_order')), (kind, w)


def test_invalid_runner_is_not_prediction(tmp_path, monkeypatch):
    raw, market, cfg, runner, _, _ = prev.sunday_fixture(tmp_path, monkeypatch)
    original = runner.make_forecast
    def invalid(*args, **kwargs):
        obj = original(*args, **kwargs)
        obj['ranking'] = []  # contract validator, not archive tampering, makes this invalid
        return obj
    monkeypatch.setattr(runner, 'make_forecast', invalid)
    runner.weeks = []
    d = runner.run()
    assert all(x['forecast_status'] == 'invalid' for x in d['weeks'][-1]['forecasters'].values())
    w = exported(raw, d, tmp_path, monkeypatch)
    assert w['prospective'] is False, w


