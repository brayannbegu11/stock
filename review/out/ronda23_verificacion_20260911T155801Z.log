import sys, json
from pathlib import Path
ROOT = Path(__file__).resolve().parents[3]
sys.path[:0] = [str(ROOT), str(ROOT / 'src')]
from datetime import date, time, timedelta
from decimal import Decimal as D
from twlab.backtest import BacktestConfig, Runner, load_market, MomentumForecaster, RandomForecaster
from twlab.calendar import TradingCalendar
from twlab.store import RawStore
from twlab.timeutil import taipei

def fixture(tmp_path, *, dividends=(), prices=None, closures=(), end='2024-01-26', delisted=None,
            symbols=('A',), raw_symbol=None, mutate=None):
    store = RawStore(tmp_path / 'raw')
    manifest = {'listed': [], 'delisted': [], 'captures': {}}
    def capture(dataset, rows, source='finmind'):
        return store.put(source_id=source, dataset=dataset, payload=json.dumps({'status':200,'msg':'success','data':rows}).encode(), url='fixture')
    for symbol in symbols:
        rows=[]
        day=date(2021,1,1)
        while day <= date.fromisoformat(end):
            if day.weekday()<5 and day not in closures:
                p = prices(day) if prices and symbol=='A' else D(100)
                rows.append(dict(stock_id=raw_symbol or symbol, date=day.isoformat(), open=str(p), max=str(p), min=str(p), close=str(p),
                                 Trading_Volume=10000000, Trading_money=1000000000, Trading_turnover=1000))
            day += timedelta(days=1)
        bp=capture(f'TaiwanStockPrice/{raw_symbol or symbol}',rows)
        ds=list(dividends) if symbol=='A' else []
        bd=capture(f'TaiwanStockDividend/{symbol}',ds)
        manifest['listed'].append(dict(symbol=symbol,name=symbol,listing_date='2000-01-01'))
        if delisted and symbol=='A':
            manifest['delisted'].append(dict(symbol=symbol,name=symbol,delisting_date=delisted))
        manifest['captures'][symbol]=dict(price=bp.capture_id,price_rows=len(rows),dividend=bd.capture_id,dividend_rows=len(ds))
    if mutate:
        mutate(manifest,store,capture)
    path=tmp_path/'manifest.json'
    path.write_text(json.dumps(manifest),encoding='utf-8')
    cal=TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=closures,source_id='synthetic',recorded_at=taipei(date(2021,1,1)))
    return store,load_market(store,path,cal)

def runner(tmp_path, *, config_end=None, slots=1, notional=100000, extra=False, **kw):
    store,market=fixture(tmp_path,**kw)
    cfg=BacktestConfig(start=date(2024,1,1),end=date.fromisoformat(config_end or kw.get('end','2024-01-26')),
                       slots=slots,notional=notional,commission_per_side=D(0),sell_tax=D(0),slippage_bps=0,block_length=1,n_boot=20,label='Q0')
    fs=[MomentumForecaster(),RandomForecaster(cfg.seed)]
    if extra:
        f=MomentumForecaster(); f.name='EXTRA'; fs.insert(1,f)
    return Runner(store,market,cfg,fs)

def run_demo(tmp_path,monkeypatch,**kw):
    r=runner(tmp_path,**kw)
    result=r.run()
    # Adaptaci├│n de nombres de salida; ninguna modificaci├│n de comportamiento.
    result['summary'].update(result['summary']['forecasters'])
    for w in result['weeks']:
        w.update(w['forecasters'])
        if isinstance(w.get('paired'),dict):
            p=w['paired']['Q0']; w['paired_details']=w['paired']; w['paired']=p['paired']; w['unpaired_reason']=p['unpaired_reason']
    return result,list(r.ledgers.values()),r.store

def run_two_demo(tmp_path,monkeypatch,**kw):
    return run_demo(tmp_path,monkeypatch,symbols=('A','B'),slots=2,**kw)

def stock_div(ex,amount):
    return {'stock_id':'A','year':'2024','StockExDividendTradingDate':ex,'StockEarningsDistribution':amount}
# Inteligencia burs├ítil de Taiw├ín con IA
## Investigaci├│n y especificaci├│n de construcci├│n ΓÇö versi├│n 2.0

**Fecha de revisi├│n de fuentes: 9 de septiembre de 2026.**  
**Alcance confirmado:** todo el mercado de acciones ordinarias de TWSE y TPEx; informaci├│n internacional como contexto y se├▒ales. PCB es solamente un ejemplo hist├│rico de la conversaci├│n, no un filtro, una prioridad ni el punto de partida del sistema.  
**Estado:** investigaci├│n documental y dise├▒o. No se ha descargado el universo financiero completo, entrenado un modelo, ejecutado un backtest, calculado una clasificaci├│n actual de acciones ni activado un servicio de actualizaci├│n.  
**Uso inicial:** investigaci├│n privada, lectura y carteras simuladas, sin conexi├│n a intermediarios ni ├│rdenes reales.  
**Documento sucesor:** sustituye el alcance y las decisiones provisionales de `Investigacion_laboratorio_bursatil_IA.md`. No a├▒ade otro m├│dulo de PCB al dise├▒o anterior: cambia su planteamiento principal.

Las referencias `[Sxx]` remiten al registro de fuentes incluido al final y a `FUENTES.json`. Una especificaci├│n propuesta no es un resultado experimental. Los precios, pol├¡ticas de proveedores y calendarios se deber├ín volver a comprobar al implementar.

---

## 1. Decisi├│n ejecutiva

**Recomiendo construir un laboratorio vivo de inteligencia de mercado, con una arquitectura h├¡brida y una evaluaci├│n prospectiva desde su puesta en marcha.** No recomiendo empezar entrenando un modelo gigantesco ni preguntar a dos asistentes cu├íles ser├ín las cinco acciones ganadoras y aceptar su consenso como validaci├│n.

El sistema debe producir dos bienes diferentes. El primero es informativo: mantener un mapa de empresas, documentos, eventos y cambios de contexto. El segundo es experimental: comprobar si esas observaciones permiten ordenar mejor las acciones para un horizonte definido, frente a alternativas sencillas y despu├⌐s de costes.

La utilidad del primero se puede medir mediante cobertura, exactitud y ahorro de revisi├│n. La rentabilidad del segundo no est├í demostrada para este proyecto. Construir un producto ├║til no exige inventar una ventaja predictiva; demostrar una ventaja exige algo m├ís que un buen producto informativo.

**La v├¡a recomendada:** datos temporales verificables ΓåÆ variables num├⌐ricas para todo el universo ΓåÆ extracci├│n de eventos mediante IA ΓåÆ modelo tabular propio que combine se├▒ales ΓåÆ clasificaci├│n y explicaci├│n ΓåÆ cartera simulada y evaluaci├│n independiente.

Fable 5.1 y Astra son buenos candidatos para construir, revisar y analizar documentos. Su posici├│n exacta dentro del pronosticador tiene que ganarse experimentalmente. No se presupone que el modelo con mejor capacidad general sea el mejor estimador de rendimientos taiwaneses.

## 2. Qu├⌐ significa analizar ┬½todo el mercado┬╗

### 2.1 Universo y l├¡mites expl├¡citos

La cobertura base incluir├í las acciones ordinarias de **TWSE y TPEx**, de todos los sectores. Se identificar├ín tableros, emisores extranjeros de cotizaci├│n primaria, clases de acciones y cambios de mercado. Los directorios oficiales de ambas bolsas y un maestro hist├│rico ser├ín la autoridad, no una lista manual de empresas conocidas. [S01ΓÇôS02, S07ΓÇôS08]

No se excluyen bancos, aseguradoras, comercio, transporte, construcci├│n, alimentos, turismo, materiales o servicios por tener menos relaci├│n con la narrativa tecnol├│gica. Las m├⌐tricas que no sean econ├│micamente comparables entre industrias se tratar├ín por separado; no se eliminar├í una industria entera para facilitar el modelo.

El mercado emergente **ESB/Φêêµ½â** se catalogar├í como cobertura adicional, pero su inclusi├│n en la simulaci├│n requerir├í un adaptador y pruebas propios. No se debe presentar un estudio de TWSE/TPEx como si certificara todos los instrumentos de todos los segmentos. Los fondos, warrants y derivados quedan fuera de la cartera inicial; no son acciones ordinarias intercambiables.

El n├║mero de emisores cambia con el tiempo. Este documento no afirma haber contado el censo actual ni propone un n├║mero fijo de 500 empresas. Cada fecha tendr├í su propio universo elegible, incluyendo compa├▒├¡as posteriormente retiradas.

### 2.2 Cuatro coberturas distintas

| Capa | Qu├⌐ significa | Qu├⌐ debe mostrar la interfaz |
|---|---|---|
| Censo | Instrumentos identificados en cada fecha y segmento. | Total, nuevas altas, bajas, cambios de mercado. |
| An├ílisis num├⌐rico | Empresas para las que se pueden calcular las variables requeridas. | Porcentaje con datos completos y motivos de ausencia. |
| An├ílisis documental profundo | Empresas/eventos revisados con modelos de mayor coste. | Qu├⌐ se revis├│ realmente, cu├índo y con qu├⌐ fuentes. |
| Elegibilidad de simulaci├│n | Empresas con datos y condiciones suficientes para una ejecuci├│n simulada defendible. | Exclusiones por historial, liquidez, suspensi├│n u otros motivos. |

Una empresa puede estar en el censo y tener informaci├│n ├║til, pero carecer de historial para el modelo principal. Una empresa il├¡quida puede analizarse sin simular una entrada irreal. Una empresa sin noticia reciente no debe recibir autom├íticamente una puntuaci├│n negativa.

### 2.3 No convertir el coste computacional en un sesgo oculto

Se calcular├í la capa num├⌐rica para todas las empresas cubiertas. Se procesar├ín y deduplicar├ín los documentos nuevos autorizados, asign├índolos a empresas y eventos. El an├ílisis caro se priorizar├í por novedad, desacuerdo, relevancia y se├▒ales num├⌐ricas; incluir├í una muestra de control de empresas menos conocidas y de distintos sectores.

La cola de revisi├│n profunda es una asignaci├│n de recursos, no una redefinici├│n secreta del universo. Se conservar├í una clasificaci├│n num├⌐rica de respaldo para empresas sin revisi├│n profunda. El sistema indicar├í expl├¡citamente cu├índo una explicaci├│n es parcial.

No ser├í obligatorio encontrar un ┬½tema caliente┬╗ antes de examinar una empresa. Los temas surgir├ín como agrupaciones din├ímicas del flujo de eventos. La estrategia tem├ítica original se conservar├í como un experimento separado.

## 3. ┬┐Es predecible? Estado de la evidencia y l├¡mites

### 3.1 Cuatro afirmaciones que no deben confundirse

**Comprensi├│n:** el modelo identifica correctamente que una empresa anunci├│ un dato nuevo. **Interpretaci├│n:** propone un mecanismo plausible de impacto. **Predicci├│n:** esa informaci├│n mejora el pron├│stico frente a una referencia. **Ventaja econ├│mica:** la mejora sobrevive a precios realmente disponibles, costes y restricciones.

Una explicaci├│n precisa puede no aportar predicci├│n. Un pron├│stico acertado puede describir un movimiento que ocurri├│ antes de poder entrar. Una mejora estad├¡stica peque├▒a puede desaparecer al descontar costes. La aplicaci├│n debe medir los cuatro niveles, no saltar del primero al ├║ltimo.

### 3.2 Evidencia primaria pertinente

| L├¡nea de investigaci├│n | Qu├⌐ aporta | Qu├⌐ no demuestra para este proyecto |
|---|---|---|
| Gu, Kelly y Xiu: aprendizaje autom├ítico en valoraci├│n de activos. [S27] | Justifica comparar m├⌐todos supervisados para rendimientos y relaciones no lineales. | Una ventaja semanal generalizable autom├íticamente a Taiw├ín. |
| Lopez-Lira y Tang: interpretaci├│n de titulares. [S23] | Muestra que el texto puede contener se├▒ales predictivas en la tarea estudiada. | Que cinco acciones elegidas por un asistente superen costes y mercado cada semana. |
| Liao y colaboradores, 2026: fusi├│n de noticias y precios. [S28] | Modelo compartido entre empresas; muestra taiwanesa de seis acciones seleccionadas. | Cobertura de todo Taiw├ín o rentabilidad neta demostrada; reducir error de precio no equivale a ganar dinero. |
| Chen y Pu, 2026: pron├│sticos prospectivos estadounidenses. [S29] | Evidencia preliminar prometedora de predicciones registradas antes del resultado. | Validaci├│n independiente de nuestro horizonte, universo, fuentes y ejecuci├│n. |
| Crisostomo y Mykhalyuk, 2026. [S30] | Documenta problemas de razonamiento e informaci├│n y la importancia de fuentes y supervisi├│n. | Que un di├ílogo aut├│nomo de agentes sea suficiente. |
| FinVerse, agosto de 2026. [S31] | Refuerza la necesidad de evaluar utilidad financiera y no s├│lo error convencional de series. | Que un modelo destacado en un benchmark sea una estrategia lista para usar. |

No se han reproducido aqu├¡ los experimentos de esos trabajos. Algunas referencias son prepublicaciones y sus conclusiones requieren la cautela correspondiente. No hay una prueba localizada que coincida exactamente con ┬½todo TWSE y TPEx, noticias chinas e internacionales, cinco nombres semanales, modelos actuales, costes locales y pruebas prospectivas┬╗.

**Juicio:** existe fundamento suficiente para investigar, pero no para declarar una tasa de acierto o una rentabilidad esperada del sistema antes de medirlas.

### 3.3 Qu├⌐ pedir al pronosticador

El objetivo principal ser├í ordenar empresas por rendimiento relativo esperado durante un horizonte concreto. Las probabilidades se mostrar├ín s├│lo cuando exista un calibrador evaluado fuera de su muestra de ajuste. No se aceptar├í un ┬½87% de confianza┬╗ escrito libremente por un asistente como probabilidad validada. [S37]

Se distinguir├ín `score_de_ranking`, `probabilidad_calibrada`, `fuerza_documental` y `riesgo_estimado`. Una fuente muy fiable puede comunicar un hecho cuyo efecto burs├ítil sea incierto. La interfaz no combinar├í esas dimensiones en un porcentaje ambiguo.

Como ejemplo matem├ítico, acertar el 55% de las veces ganando 1% y perder el 45% restante perdiendo 2% da una media de ΓêÆ0,35% antes de costes. No es una observaci├│n del mercado: ilustra por qu├⌐ el porcentaje de aciertos no basta.

## 4. Actualidad verificada al 9 de septiembre de 2026

La revisi├│n incluy├│ fuentes y publicaciones de 2026, no solamente referencias hist├│ricas. Dos ejemplos permiten convertir la exigencia de actualidad en pruebas concretas.

**Publicaci├│n ya fechada hoy:** el Ministerio de Finanzas public├│ el resumen de comercio exterior de agosto de 2026, con exportaciones de 82.400 millones de USD y crecimiento interanual del 41,0%. La p├ígina est├í fechada el 9 de septiembre. No se verific├│ su hora intrad├¡a; por ello, no es admisible asumir que el dato estaba disponible antes de la apertura de hoy. [S19]

**Evento futuro conocido, resultado a├║n no disponible en el corte de consulta:** el calendario de TSMC situaba la publicaci├│n de ingresos de agosto el 10 de septiembre de 2026. El sistema puede conocer el evento programado, pero no usar anticipadamente el ingreso que se publicar├í. La p├ígina tambi├⌐n advierte que las fechas pueden cambiar. Es un ejemplo temporal, no una selecci├│n burs├ítil ni un foco sectorial del proyecto. [S20]

La pol├¡tica general ser├í conservar el calendario conocido entonces y sus revisiones. Si un evento se aplaza, el sistema registrar├í la actualizaci├│n; no corregir├í el pasado para fingir que siempre supo la fecha final.

**Actualizado** significar├í que cada observaci├│n muestra su fecha y hora de disponibilidad, versi├│n y retraso. No significar├í que el modelo lleva un nombre reciente, ni que navegar una vez al d├¡a garantiza que se han visto todas las noticias.

## 5. Mapa de datos y preguntas que deben responder
# taiwan-ia-lab

**Author: Brayann Benavides.** A living stock-forecasting lab for every common stock on TWSE and TPEx (Taiwan), run under a strict point-in-time clock and reviewed adversarially by an independent model. Analysis and simulated portfolios only: no real orders, no brokers, no credentials.

- **Website (Spanish ┬╖ English ┬╖ τ╣üΘ½öΣ╕¡µûç):** https://brayannbegu11.github.io/stock/ ΓÇö published from the `gh-pages` branch by `scripts/deploy_pages.py`; the source is `docs/index.html` on `main`, with its data embedded by `scripts/export_site_data.py`, so the page also opens directly from disk.
- Specification received (GPT-6 Pro, v2.0, 9 Sep 2026): `docs/spec/v2/`
- Builder's reports (Spanish): `docs/informes/`
- Independent review rounds (GPT-6 Astra via Codex CLI): `review/out/`

## Getting started

```bash
python -m pip install -e ".[dev,model]"
python -m pytest -q -p no:cacheprovider            # acceptance tests, no network (count: python -m pytest --co -q)
python scripts/capture_daily.py                    # daily capture to data/raw (TWSE/TPEx OpenAPI + FinMind), real ingested_at
python scripts/build_master.py                     # SCD2 security master and census -> data/store, docs/informes/10_censo_<date>.md
python scripts/fetch_history_sample.py             # stratified census sample with FinMind bars and dividends (network, ~5 min)
python scripts/fetch_universe_daily.py --start 2024-07-01   # official per-date quotes for the whole market (network, ~2 h; resumable; no dividends)
python scripts/run_q0_demo.py --start 2024-01-01 --end 2025-12-31          # end-to-end demo (no network)
python scripts/run_backtest.py --manifest sample --start 2024-01-01 --end 2025-12-31 --forecasters Q0,Q1,A1
python scripts/run_backtest.py --manifest daily --lookback-start 2024-07-01 --start 2026-05-04 --end 2026-09-09 --forecasters Q0,Q1,A1 --min-train-weeks 40 --report 15_backtest_universo_2026.md
python scripts/run_backtest.py --manifest daily --lookback-start 2024-07-01 --start 2026-05-04 --end 2026-09-09 --forecasters Q0,Q1,A1 --min-train-weeks 40 --notional 15000 --lot-size 1 --min-commission 20 --slippage-bps 20 --label user_75kTWD_oddlots_2026 --report 15b_backtest_universo_2026_lotes_sueltos.md
python scripts/run_backtest.py --manifest daily --lookback-start 2021-01-04 --start 2026-05-04 --end 2026-09-09 --forecasters Q0,Q1,A1 --min-train-weeks 52 --label universe_longhist_2021_2026 --report 15c_backtest_universo_2026_historial_2021.md   # ~2 h 20 min, ~3 GB
python scripts/export_site_data.py                 # refresh docs/site/data.json and embed it in docs/index.html
python scripts/deploy_pages.py                     # publish docs/index.html + docs/site to the gh-pages branch (GitHub Pages)
python scripts/assemble_backtest_reports.py        # rebuild the hand-readable headers of reports 15/15b/15c from their JSONs
```

The last cutoff without an outcome is emitted as `pending_outcome`: that is the current week's list (five securities per forecaster), archived in `data/raw` with a real timestamp.

The daily capture runs as a Windows scheduled task since 9 Sep 2026 (18:30 local time) via `scripts/register_daily_capture.ps1`; remove it with `-Eliminar`.


