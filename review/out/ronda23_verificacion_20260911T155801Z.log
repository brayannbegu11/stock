@pytest.mark.parametrize('mutation',['packet_corrupt','source_missing','source_corrupt','unreferenced_admitted','empty_manifest','injected_source','packet_substitution'])
def test_inputs_evidence_must_be_complete(tmp_path,monkeypatch,mutation):
    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
    w=d['weeks'][-1];pr=raw.get(w['packet_capture']);body=json.loads(raw.read(pr))
    source=raw.get(body['admitted'][0]['capture_id'])
    if mutation=='packet_corrupt':
        body['admitted'][0]['payload']={'fabricated':123}
        (raw.root/pr.path).write_text(json.dumps(body),encoding='utf8')
    elif mutation=='source_missing': (raw.root/source.path).unlink()
    elif mutation=='source_corrupt': (raw.root/source.path).write_bytes(b'broken')
    elif mutation in ('unreferenced_admitted','empty_manifest'):
        if mutation=='unreferenced_admitted': body['admitted'].append({'kind':'price_bar_series','payload':{'fabricated':123}})
        else: body['admitted'].append({'kind':'capture_manifest','capture_id':source.capture_id,'payload':{'session_captures':{}}})
        p=raw.put(source_id='packet',dataset='lab/other',payload=json.dumps(body).encode(),url='fixture')
        w['packet_capture']=p.capture_id
    elif mutation=='injected_source':
        path=raw.root/'manifest.jsonl';rows=[json.loads(x) for x in path.read_text().splitlines()]
        for x in rows:
            if x['capture_id']==source.capture_id:x['clock_source']='injected'
        path.write_text('\n'.join(map(json.dumps,rows)),encoding='utf8')
    else:
        changed=replace(packet_from_json(raw.read(pr)),packet_id='unrelated-packet')
        p=raw.put(source_id='packet',dataset='unrelated/2024-W02',payload=packet_to_json(changed),url='fixture')
        assert packet_from_json(raw.read(p)).packet_hash()!=w['packet_hash']
        w['packet_capture']=p.capture_id
    ex=export_setup(monkeypatch,raw,d,tmp_path)
    result=ex.build()['scenarios'][0]['weeks'][-1]
    assert result['prospective'] is False,result

