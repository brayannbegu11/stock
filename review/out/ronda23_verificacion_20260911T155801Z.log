def test_all_scenario_summary_metrics_and_report_tables():
    from statistics import fmean
    for sid,_,report in ex.SCENARIOS:
        d=source(sid)
        for f,s in d['summary']['forecasters'].items():
            ws=[w['forecasters'][f] for w in d['weeks'] if w['status']=='valid' and not w.get('pending_outcome')]
            rs=[w['portfolio_net_return_open_close'] for w in ws if w.get('portfolio_net_return_open_close') is not None]
            cs=[w['costs_over_invested'] for w in ws if w.get('costs_over_invested') is not None]
            assert len(rs)==s['weeks_measured'] and sum(r>0 for r in rs)==s['weeks_positive']
            assert fmean(rs)==s['mean_weekly_net_return_open_close'] and fmean(cs)==s['mean_costs_over_invested']
        txt=(ROOT/'docs/informes'/report).read_text(encoding='utf8')
        generated=markdown_report(d,title='x').split('\n',1)[1]
        assert txt.split('## Informe generado:',1)[1].split('\n',1)[1].strip()==generated.strip()

