+
+def setup(tmp_path, monkeypatch):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    ex = prev.export_setup(monkeypatch, raw, data, tmp_path)
+    week = data['weeks'][-1]
+    assert ex.classify_week('lab', week)['prospective'] is True
+    return raw, market, data, ex, week
+
+
+def classify(ex, week):
+    ex._MANIFEST = None
+    ex._INPUTS_CACHE.clear()
+    return ex.classify_week('lab', week)
+
+
+def rearchive_packet(raw, data, packet):
+    week = data['weeks'][-1]
+    rec = raw.put(source_id='packet', dataset='lab/' + week['week_id'],
+                  payload=packet_to_json(packet), url='fixture', extra={'packet_hash': packet.packet_hash()})
+    assert packet_from_json(raw.read(rec)).packet_hash() == packet.packet_hash()
+    week.update(packet_capture=rec.capture_id, packet_hash=packet.packet_hash())
+    for f, x in week['forecasters'].items():
+        old = raw.get(x['forecast_capture_id'])
+        body = json.loads(raw.read(old))
+        body['packet_hash'] = packet.packet_hash()
+        new = raw.put(source_id='forecast', dataset=old.dataset, payload=json.dumps(body).encode(), url='fixture')
+        x.update(forecast_sha256=new.sha256, forecast_capture_id=new.capture_id)
+
+
+def test_ticker_of_other_security(tmp_path, monkeypatch):
