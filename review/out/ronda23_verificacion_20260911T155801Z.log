def load(name):
    spec=importlib.util.spec_from_file_location('r21_'+name,ROOT/'scripts'/f'{name}.py')
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

def export_setup(monkeypatch, raw, d, tmp_path):
    ex=load('export_site_data')
    monkeypatch.setattr(ex,'RAW',raw.root)
    monkeypatch.setattr(ex,'STORE',tmp_path)
    monkeypatch.setattr(ex,'SCENARIOS',[('standard','lab','fixture.md')])
    for name,value in [('export_rounds',[]),('export_docs',[]),('count_tests',0),('raw_coverage',{}),('master_stats',{})]:
        monkeypatch.setattr(ex,name,lambda v=value:v)
    (tmp_path/'backtest_lab.json').write_text(json.dumps(d,default=str),encoding='utf8')
    return ex

