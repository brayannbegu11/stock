+import copy
+import json
+from dataclasses import replace
+from datetime import timedelta
+
+import pytest
+from review.out.astra_scratch import test_r21 as prev
+from review.out.astra_scratch.test_r22 import save_forecast
+from twlab.packet import packet_from_json, packet_to_json
+from twlab.schemas import prediction_validator, validate_prediction
+
+
+def setup(tmp_path, monkeypatch):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    ex = prev.export_setup(monkeypatch, raw, data, tmp_path)
+    week = data['weeks'][-1]
+    assert ex.classify_week('lab', week)['prospective'] is True
+    return raw, market, data, ex, week
+
+
+def classify(ex, week):
+    ex._MANIFEST = None
+    ex._INPUTS_CACHE.clear()
+    return ex.classify_week('lab', week)
+
+
+def rearchive_packet(raw, data, packet):
+    week = data['weeks'][-1]
+    rec = raw.put(source_id='packet', dataset='lab/' + week['week_id'],
+                  payload=packet_to_json(packet), url='fixture', extra={'packet_hash': packet.packet_hash()})
+    assert packet_from_json(raw.read(rec)).packet_hash() == packet.packet_hash()
+    week.update(packet_capture=rec.capture_id, packet_hash=packet.packet_hash())
+    for f, x in week['forecasters'].items():
+        old = raw.get(x['forecast_capture_id'])
+        body = json.loads(raw.read(old))
+        body['packet_hash'] = packet.packet_hash()
+        new = raw.put(source_id='forecast', dataset=old.dataset, payload=json.dumps(body).encode(), url='fixture')
+        x.update(forecast_sha256=new.sha256, forecast_capture_id=new.capture_id)
+
+
+def test_ticker_of_other_security(tmp_path, monkeypatch):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    body = save_forecast(raw, data, lambda f: f['ranking'][0].update(ticker_as_of='B'))
+    prediction_validator().validate(body['forecast'])
+    assert body['forecast']['ranking'][0]['security_id'] == market.by_symbol['A']
+    w['forecasters']['Q0']['picks'][0]['symbol'] = 'B'
+    result = classify(ex, w)
+    assert result['prospective'] is False, result
+
+
+@pytest.mark.parametrize('in_packet', [False, True])
+def test_unknown_security(tmp_path, monkeypatch, in_packet):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    ghost = 'TWSE:GHOST@2000-01-01'
+    assert ghost not in market.securities
+    assert all(v.security_id != ghost for v in market.master.universe(as_of=prev.date(2024, 1, 7)))
+    if in_packet:
+        packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+        source = next(d for d in packet.admitted if d.kind == 'price_bar_series')
+        payload = json.loads(json.dumps(dict(source.payload), default=list))
+        payload['name'] = 'GHOST'
+        extra = replace(source, doc_id='GHOST:bars:2024-W02', security_ids=(ghost,), payload=payload)
+        rearchive_packet(raw, data, replace(packet, admitted=packet.admitted + (extra,)))
+    body = save_forecast(raw, data, lambda f: f['ranking'][0].update(security_id=ghost, ticker_as_of='GHOST'))
+    prediction_validator().validate(body['forecast'])
+    w['forecasters']['Q0']['picks'][0].update(security_id=ghost, symbol='GHOST', name='GHOST')
+    result = classify(ex, w)
+    assert result['prospective'] is False, result
+
+
+@pytest.mark.parametrize('kind', ['missing_name', 'different_name', 'absent_security'])
+def test_packet_names_and_membership(tmp_path, monkeypatch, kind):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    docs = []
+    for d in packet.admitted:
+        if d.kind == 'price_bar_series':
+            if kind == 'absent_security' and market.by_symbol['A'] in d.security_ids:
+                continue
+            if kind == 'absent_security':
+                docs.append(d)
+                continue
+            payload = json.loads(json.dumps(dict(d.payload), default=list))
+            if kind == 'missing_name':
+                payload.pop('name', None)
+            else:
+                payload['name'] = 'OTHER'
+            d = replace(d, payload=payload)
+        docs.append(d)
+    rearchive_packet(raw, data, replace(packet, admitted=tuple(docs)))
+    result = classify(ex, w)
+    assert result['prospective'] is False and 'name_mismatch:Q0' in result['reasons'], result
+
+
+def test_real_packet_cutoff_differs_from_forecasts(tmp_path, monkeypatch):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    packet = replace(packet, cutoff_at=packet.cutoff_at + timedelta(hours=1))
+    rearchive_packet(raw, data, packet)
+    w['cutoff_at'] = packet.cutoff_at.isoformat()
+    result = classify(ex, w)
+    assert result['prospective'] is False and 'cutoff_mismatch:Q0' in result['reasons'], result
+
+
+@pytest.mark.parametrize('kind', ['forecast_sid_list', 'forecast_time_number', 'forecast_dataset_list', 'packet_extra_list'])
+def test_malformed_archive_fails_closed(tmp_path, monkeypatch, kind):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    if kind == 'forecast_sid_list':
+        save_forecast(raw, data, lambda f: f['ranking'][0].update(security_id=['A']))
+    else:
+        path = raw.root / 'manifest.jsonl'
+        rows = [json.loads(line) for line in path.read_text(encoding='utf8').splitlines()]
+        for row in rows:
+            if kind == 'packet_extra_list' and row['capture_id'] == w['packet_capture']:
+                row['extra'] = ['bad']
+            if row['capture_id'] == w['forecasters']['Q0']['forecast_capture_id']:
+                if kind == 'forecast_time_number':
+                    row['ingested_at'] = 42
+                elif kind == 'forecast_dataset_list':
+                    row['dataset'] = ['bad']
+        path.write_text('\n'.join(map(json.dumps, rows)), encoding='utf8')
+    result = classify(ex, w)
+    assert result['prospective'] is False, result
+
+
+@pytest.mark.parametrize('value', [True, 1.0])
+def test_rank_requires_integer_not_bool_or_float(tmp_path, monkeypatch, value):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    body = save_forecast(raw, data, lambda f: f['ranking'][0].update(rank=value))
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    assert any('rank_not_int' in e for e in validate_prediction(body['forecast'], packet, calendar=market.calendar))
+    result = classify(ex, w)
+    assert result['prospective'] is False, result
+
+
+@pytest.mark.parametrize('fix_ticker', [False, True])
+def test_r22_rank_order_reason(tmp_path, monkeypatch, fix_ticker):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    x = w['forecasters']['Q0']
+    def mutate(f):
+        second = copy.deepcopy(f['ranking'][0])
+        second.update(security_id=market.by_symbol['B'], rank=2)
+        if fix_ticker:
+            second['ticker_as_of'] = 'B'
+        f['ranking'] = [second, f['ranking'][0]]
+    save_forecast(raw, data, mutate)
+    x['picks'].insert(0, dict(security_id=market.by_symbol['B'], symbol='B', name='B'))
+    result = classify(ex, w)
+    assert result['prospective'] is False
+    assert 'forecast_contract:Q0:rank_order' in result['reasons']
+    assert ('symbol_mismatch:Q0' in result['reasons']) is (not fix_ticker)
+
+
+def test_packet_registry_hash_required(tmp_path, monkeypatch):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    path = raw.root / 'manifest.jsonl'
+    rows = [json.loads(line) for line in path.read_text(encoding='utf8').splitlines()]
+    for row in rows:
+        if row['capture_id'] == w['packet_capture']:
+            row['extra'].pop('packet_hash')
+    path.write_text('\n'.join(map(json.dumps, rows)), encoding='utf8')
+    result = classify(ex, w)
