+from review.out.astra_scratch.r10_support import *
+from twlab.ledger import CostModel, q_twd
+import hashlib, collections
+import pytest
+
+LABELS=('universe_2026-05-04_2026-09-09','user_75kTWD_oddlots_2026')
+
+@pytest.fixture(scope='module')
+def manifest():
+    return [json.loads(line) for line in (ROOT/'data/raw/manifest.jsonl').read_text(encoding='utf8').splitlines()]
+
+def last_record(manifest,src,dataset):
+    return [r for r in manifest if r['source_id']==src and r['dataset']==dataset][-1]
+
+def read_record(rec):
+    raw=(ROOT/'data/raw'/rec['path']).read_bytes()
+    assert hashlib.sha256(raw).hexdigest()==rec['sha256']
+    return json.loads(raw)
+
+def bars_from_body(rec):
+    body=read_record(rec)
+    assert body['date']==rec['dataset'].split('/')[-1].replace('-','')
+    tw=rec['source_id']=='twse'
+    table=next(t for t in body['tables'] if ('µ»ÅµùÑµö╢τ¢ñΦíîµâà' in t['title'] if tw else t['title'].startswith('Σ╕èµ½âΦéíτÑ¿Φíîµâà')))
+    fields=table['fields']; keys=['Φ¡ëσê╕Σ╗úΦÖƒ','Θûïτ¢ñσâ╣','µö╢τ¢ñσâ╣','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì'] if tw else ['Σ╗úΦÖƒ','Θûïτ¢ñ','µö╢τ¢ñ','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì(σàâ)']
+    indices=[fields.index(k) for k in keys]
+    return {str(row[indices[0]]):[str(row[i]).replace(',','') for i in indices[1:]] for row in table['data']}
+
+def test_real_daily_packets_trace_every_window_row(manifest):
+    records={r['capture_id']:r for r in manifest}; cache={}; n=0; docs=0
+    for label in LABELS:
+        for week in ('2026-W20','2026-W37'):
+            packet=read_record(last_record(manifest,'packet',f'{label}/{week}'))
+            by_id={d['doc_id']:d for d in packet['admitted']}
+            for doc in packet['admitted']:
+                if doc['kind']!='price_bar_series':
+                    continue
+                docs+=1
+                captures=by_id[doc['payload']['captures_doc']]['payload']['session_captures']
+                symbol=doc['doc_id'].split(':')[0]
+                assert doc['capture_id']==captures[doc['payload']['last_session']]
+                assert doc['source_sha256']==records[doc['capture_id']]['sha256']
+                for row in doc['payload']['sessions']:
+                    capture_id=captures[row[0]]; rec=records[capture_id]
+                    assert rec['source_id']==doc['source_id'] and rec['dataset'].endswith(row[0])
+                    if capture_id not in cache:
+                        cache[capture_id]=bars_from_body(rec)
+                    source=cache[capture_id][symbol]
+                    assert [D(str(x)) for x in row[1:]]==[D(x) for x in source],(label,week,symbol,row,source)
+                    n+=1
+            forecast=read_record(last_record(manifest,'forecast',f'{label}/Q0/{week}'))
+            assert forecast['packet_hash']==packet['packet_hash']
+    print({'packets':4,'series':docs,'rows_verified':n,'source_captures':len(cache)})
+
+def test_real_odd_lot_orders_stay_inside_slot_budgets(manifest):
+    label=LABELS[1]; data=json.loads((ROOT/'data/store'/f'backtest_{label}.json').read_text(encoding='utf8'))
+    costs=CostModel(D('.001425'),sell_tax=D('.003'),slippage_bps_per_side=20,min_commission_twd=D(20))
+    overruns=[]; count=0; cache={}
+    for w in data['weeks']:
+        packet=read_record(last_record(manifest,'packet',f"{label}/{w['week_id']}"))
+        session=packet['entry_at'][:10]
+        for f,x in w['forecasters'].items():
+            for p in x['picks']:
+                if p.get('entry_status')=='entry_failed':
+                    continue
+                src=p['security_id'].split(':')[0].lower(); ds='MI_INDEX_ALLBUT0999' if src=='twse' else 'dailyQuotes'
+                key=(src,session)
+                if key not in cache:
+                    cache[key]=bars_from_body(last_record(manifest,src,f'{ds}/{session}'))
+                price=D(cache[key][p['symbol']][0]); notional=D(str(x['notional_per_slot']))
+                quantity=int(notional/(price*(1+costs.slippage)*(1+costs.commission_per_side)))
+                if quantity<=0:
+                    continue
+                executed=q_twd(price*quantity); executed+=costs.round(executed*costs.slippage)
+                debit=executed+costs.commission(executed); count+=1
+                if debit>notional:
+                    overruns.append((w['week_id'],f,p['symbol'],str(price),str(notional),quantity,str(debit)))
+    print({'orders_checked':count,'overruns':overruns})
+    assert not overruns, overruns
+
+def test_report_tables_match_json_numeric_results():
+    for label,name in [(LABELS[0],'15_backtest_universo_2026.md'),(LABELS[1],'15b_backtest_universo_2026_lotes_sueltos.md'),('sample_2024_2025','14_backtest_muestra_2024-2025.md')]:
+        d=json.loads((ROOT/'data/store'/f'backtest_{label}.json').read_text(encoding='utf8'))
+        report=(ROOT/'docs/informes'/name).read_text(encoding='utf8')
+        for f,x in d['summary']['forecasters'].items():
+            row=next(r for r in report.splitlines() if r.startswith(f'| {f} (`'))
+            for k in ('mean_weekly_net_return_open_close','mean_weekly_gross_pick_return','mean_costs_over_invested'):
+                assert f"{x[k]*100:+.2f} %" in row
+            assert f"{x['final_equity']:,.0f} TWD" in row
+
+def test_real_pending_entries_have_per_pick_execution_status():
+    d=json.loads((ROOT/'data/store'/f'backtest_{LABELS[0]}.json').read_text(encoding='utf8'))
+    x=d['weeks'][-1]['forecasters']['Q1']
+    assert x['filled']==2 and x['failed']==3
+    assert sum(p.get('entry_status')=='entry_failed' for p in x['picks'])==3, x
