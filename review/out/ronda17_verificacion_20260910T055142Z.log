KNOWN_REJECTION_REASONS = frozenset({
    R_AVAILABLE_AFTER_CUTOFF, R_UNKNOWN_AVAILABILITY, R_NOT_RECEIVED_BEFORE_CUTOFF, R_INCONSISTENT_METADATA,
