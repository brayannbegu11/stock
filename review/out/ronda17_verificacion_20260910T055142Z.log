+from review.out.astra_scratch.test_r16_attacks import (
+    test_payload_date_must_match_session,
+    test_price_capture_tracks_last_kept_bar,
+    test_duplicate_symbol_is_not_last_wins,
+    test_missing_required_columns_are_not_zero_volume,
+    test_hash_covers_calendar_and_ex_date,
+    daily,
+)
+from review.out.astra_scratch.test_r16_previous import test_market_mutation_without_new_capture_cannot_reuse_rows
+from review.out.astra_scratch.test_r16_reports import (
+    test_final_stale_price_is_qualified_in_markdown,
+    test_absent_rights_are_price_only_control,
+    test_pending_and_rights_disclosure_controls,
+    saved,
+)
+from review.out.astra_scratch.r10_support import *
+from twlab.weekly import plan_week
+import pytest
+
+@pytest.mark.parametrize('exchange', ['TWSE', 'TPEX'])
+def test_r16_02_current_manifest_provenance(tmp_path, exchange):
+    store, market = daily(tmp_path, exchange)
+    r = Runner(store, market, BacktestConfig(date(2024,1,1), date(2024,1,12)), [MomentumForecaster(), RandomForecaster(1)])
+    packet, _, _ = r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)), market.calendar))
+    doc = next(d for d in packet.admitted if d.kind == 'price_bar_series')
+    manifest = next(d for d in packet.admitted if d.doc_id == doc.payload['captures_doc'])
+    for row in doc.payload['sessions']:
+        rec = store.get(manifest.payload['session_captures'][row[0]])
+        assert rec.dataset.endswith(row[0]) and rec.source_id == doc.source_id
+    assert doc.capture_id == manifest.payload['session_captures'][doc.payload['last_session']]
+    assert doc.source_sha256 == store.get(doc.capture_id).sha256
+    assert doc.derivation == ('twse_mi_index_daily_v1' if exchange=='TWSE' else 'tpex_daily_quotes_v1')
+
+def test_r16_06_report_corrected_values():
+    r = saved()
+    fs = r['summary']['forecasters']
+    attempts = sum(len(w['forecasters']['Q1']['picks']) for w in r['weeks'] if not w.get('pending_outcome'))
+    assert attempts == 80 and fs['Q1']['entry_failures'] == 16
+    assert fs['A1']['mean_weekly_net_return_open_close'] - fs['Q1']['mean_weekly_net_return_open_close'] > max(f['mean_costs_over_invested'] for f in fs.values())
+    assert 795000 < r['weeks'][-1]['forecasters']['Q1']['notional_per_slot'] < 797000
