diff --git a/review/out/astra_scratch/r17_render.cjs b/review/out/astra_scratch/r17_render.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..bdb9fed6e77595db2322cb838e3e1d70305890eb
--- /dev/null
+++ b/review/out/astra_scratch/r17_render.cjs
@@ -0,0 +1,17 @@
+const fs = require('fs'), vm = require('vm');
+const html = fs.readFileSync('docs/index.html', 'utf8');
+const payload = html.match(/<script type="application\/json" id="site-data">([\s\S]*?)<\/script>/)[1];
+let code = [...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].pop()[1];
+code = code.replace('state.lang = detectLang();\nrender();', `globalThis.api = { S, DATA, state, howSection, reviewSection, limitsSection, kpiAndChart, weekSection, pickList };`);
+const context = {document:{getElementById:()=>({textContent:payload})}, Intl, URLSearchParams};
+vm.createContext(context); vm.runInContext(code,context);
+const api=context.api, out={};
+for(const lang of ['es','en','zh']){
+  api.state.lang=lang;
+  out[lang]={strings:api.S[lang], protocol:api.howSection(), review:api.reviewSection(api.DATA.rounds), limits:api.limitsSection()};
+  for(const sc of api.DATA.scenarios){
+    api.state.scenario=sc.id;
+    out[lang][sc.id]={kpi:api.kpiAndChart(sc),week:api.weekSection(sc,null)};
+  }
+}
+process.stdout.write(JSON.stringify(out));
diff --git a/review/out/astra_scratch/test_r17_attacks.py b/review/out/astra_scratch/test_r17_attacks.py
new file mode 100644
index 0000000000000000000000000000000000000000..ef704083e03c41997a5e42abe4e8fa1c1b03724c
--- /dev/null
+++ b/review/out/astra_scratch/test_r17_attacks.py
@@ -0,0 +1,79 @@
+from review.out.astra_scratch.r10_support import *
+from review.out.astra_scratch.test_r16_attacks import daily
+from twlab.ledger import PaperLedger, CostModel, CorporateAction, Fill
+from twlab.simulation import enter_basket, exit_basket
+from twlab.backtest import TabularForecaster
+from twlab.weekly import plan_week
+from fractions import Fraction
+import pytest
+
+def cost():
+    return CostModel(D('.001425'), sell_tax=D('.003'), slippage_bps_per_side=20, min_commission_twd=D(20))
+
+def basket(cash, notional, slots=1, price='10'):
+    lg = PaperLedger(ledger_id='test', initial_cash=D(cash), cost_model=cost(), lot_size=1)
+    picks = [str(i) for i in range(slots)]
+    ss = enter_basket(lg, picks=picks, slots=slots, notional_per_slot=D(notional), open_prices={s:D(price) for s in picks}, at=taipei(date(2024,1,8),time(9)), week_id='2024-W02')
+    return lg, ss
+
+def test_minimum_commission_does_not_reject_affordable_smaller_order():
+    lg, slots = basket(1000,1000)
+    # 97 shares cost 970 + floor(970*.002) + 20 = 991 <= 1000.
+    assert slots[0].status == 'filled', (slots[0].status, slots[0].reason, lg.cash)
+    assert slots[0].entry.shares == 97
+
+def test_minimum_commission_respects_each_slot_budget():
+    lg, slots = basket(5000,1000,5)
+    assert all(s.entry and -s.entry.cash_delta <= 1000 for s in slots), [(s.status, -s.entry.cash_delta if s.entry else s.reason) for s in slots]
+
+def test_odd_lot_minimum_applies_buy_sell_and_fraction_survives():
+    lg = PaperLedger(ledger_id='t', initial_cash=D(1000), cost_model=cost(), lot_size=1)
+    slots=enter_basket(lg,picks=['A'],slots=1,notional_per_slot=D(400),open_prices={'A':D(100)},at=taipei(date(2024,1,8),time(9)),week_id='w')
+    assert slots[0].entry.commission == 20
+    lg.apply_corporate_action(CorporateAction('split','A','split',taipei(date(2024,1,9)),split_ratio=D('.5')))
+    exit_basket(lg,slots,close_prices={'A':D(200)},at=taipei(date(2024,1,12),time(13,30)),week_id='w')
+    assert slots[0].exit.shares == 1 and slots[0].exit.commission == 20
+    assert lg.positions['A'].lots[0].rational() == Fraction(1,2)
+    assert lg.positions['A'].unresolved_fraction == D('.5')
+    before=lg.cash
+    exit_basket(lg,slots,close_prices={'A':D(200)},at=taipei(date(2024,1,19),time(13,30)),week_id='w')
+    assert lg.cash == before and slots[0].status == 'exit_blocked'
+
+def test_daily_missing_capture_in_series_must_not_be_admitted(tmp_path):
+    store, market = daily(tmp_path)
+    del market.securities['A'].bar_captures[date(2024,1,4)]
+    r=Runner(store,market,BacktestConfig(date(2024,1,1),date(2024,1,12)),[MomentumForecaster(),RandomForecaster(1)])
+    try:
+        p,_,_=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),market.calendar))
+    except (ValueError, KeyError):
+        return
+    for doc in p.admitted:
+        if doc.kind=='price_bar_series':
+            m=next(d for d in p.admitted if d.doc_id==doc.payload['captures_doc'])
+            assert all(row[0] in m.payload['session_captures'] for row in doc.payload['sessions']), (doc.payload,m.payload)
+
+def test_data_version_covers_session_capture_change(tmp_path):
+    _,market=daily(tmp_path)
+    f=TabularForecaster(market,min_weeks=1)
+    before=market.data_version
+    market.securities['A'].bar_captures[date(2024,1,4)]=market.securities['A'].bar_captures[date(2024,1,5)]
+    with pytest.raises(ValueError):
+        f.maybe_train(taipei(date(2024,1,7),time(18)))
+    assert market.data_version != before
+
+def test_liquidity_scales_with_configured_notional_and_odd_lot_exposure(tmp_path):
+    store, market=fixture(tmp_path,end='2024-01-12')
+    from dataclasses import replace
+    sec=next(iter(market.securities.values()))
+    sec.bars=[replace(b,value_twd=D(300000)) for b in sec.bars]
+    market.by_session[sec.security_id]={b.session:b for b in sec.bars}
+    elig=[]
+    for notional,lot in [(15000,1),(1000000,1000)]:
+        cfg=BacktestConfig(date(2024,1,1),date(2024,1,12),notional=notional,lot_size=lot,min_commission_twd=D(20),slippage_bps=20)
+        r=Runner(store,market,cfg,[MomentumForecaster(),RandomForecaster(1)])
+        _,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),market.calendar))
+        elig.append(cs[0].eligible)
+        if lot==1:
+            w=r.run()['weeks'][0]['forecasters']['Q0']
+            assert w['filled']==1 and w['failed']==0 and 0 < w['exposure_at_open'] <= D('.2')
+    assert elig == [True,False]
