+const fs = require('fs'), vm = require('vm');
+const html = fs.readFileSync('docs/index.html', 'utf8');
+const payload = html.match(/<script type="application\/json" id="site-data">([\s\S]*?)<\/script>/)[1];
+let code = [...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].pop()[1];
+code = code.replace('state.lang = detectLang();\nrender();', `globalThis.api = { S, DATA, state, howSection, reviewSection, limitsSection, kpiAndChart, weekSection, pickList };`);
+const context = {document:{getElementById:()=>({textContent:payload})}, Intl, URLSearchParams};
+vm.createContext(context); vm.runInContext(code,context);
+const api=context.api, out={};
+for(const lang of ['es','en','zh']){
+  api.state.lang=lang;
+  out[lang]={strings:api.S[lang], protocol:api.howSection(), review:api.reviewSection(api.DATA.rounds), limits:api.limitsSection()};
+  for(const sc of api.DATA.scenarios){
+    api.state.scenario=sc.id;
+    out[lang][sc.id]={kpi:api.kpiAndChart(sc),week:api.weekSection(sc,null)};
+  }
+}
+process.stdout.write(JSON.stringify(out));
