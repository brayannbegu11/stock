@@ -0,0 +1,88 @@
+from review.out.astra_scratch.r10_support import *
+import re, subprocess, importlib.util
+import pytest
+
+spec=importlib.util.spec_from_file_location('site_export',ROOT/'scripts/export_site_data.py')
+export=importlib.util.module_from_spec(spec); spec.loader.exec_module(export)
+
+def source(label):
+    return json.loads((ROOT/'data/store'/f'backtest_{label}.json').read_text(encoding='utf8'))
+
+@pytest.fixture(scope='module')
+def site():
+    return json.loads((ROOT/'docs/site/data.json').read_text(encoding='utf8'))
+
+@pytest.fixture(scope='module')
+def rendered():
+    proc=subprocess.run(['node','review/out/astra_scratch/r17_render.cjs'],cwd=ROOT,capture_output=True,text=True,encoding='utf8',check=True)
+    return json.loads(proc.stdout)
+
+def test_exported_scenarios_match_sources_and_inline(site):
+    html=(ROOT/'docs/index.html').read_text(encoding='utf8')
+    embedded=json.loads(re.search(r'<script type="application/json" id="site-data">(.*?)</script>',html,re.S)[1])
+    assert embedded == site
+    for sid,label,report in export.SCENARIOS:
+        actual=next(s for s in site['scenarios'] if s['id']==sid).copy()
+        actual.pop('current_week',None)
+        assert actual == export.export_scenario(sid,label,report)
+
+def test_review_round_exports_match_original_artifacts(site):
+    assert site['rounds'] == export.export_rounds()
+
+def test_master_segments_excludes_terminal_events(site):
+    rows=[json.loads(x) for x in (ROOT/'data/store'/site['master']['file']).read_text(encoding='utf8').splitlines()]
+    assert site['master']['segments'] == sum(r['kind']=='segment' for r in rows), (site['master']['segments'], {k:sum(r['kind']==k for r in rows) for k in {'segment','delisting'}})
+
+def test_export_preserves_bootstrap_uncertainty(site):
+    sc=next(s for s in site['scenarios'] if s['id']=='user')
+    original=source(sc['label'])['summary']['forecasters']['Q0']['paired_excess_vs_baseline']
+    assert original['n_fixed_observations']==4 and original['variability_limited']
+    for key in ('n_fixed_observations','variability_limited'):
+        assert sc['forecasters']['Q0']['paired'].get(key)==original[key], (key,sc['forecasters']['Q0']['paired'])
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_p7_approximation_is_disclosed_in_every_language(rendered,lang):
+    text=rendered[lang]['user']['kpi'] + rendered[lang]['protocol'] + rendered[lang]['limits']
+    # The declared scenario must say that these are REGULAR-session prices approximating odd-lot executions.
+    assert any(token in text.lower() for token in {'es':['precios de sesi├│n regular','precios de la sesi├│n regular'], 'en':['regular-session prices','regular session prices'], 'zh':['Σ╕ÇΦê¼Σ║ñµÿôσâ╣µá╝','Σ╕ÇΦê¼Σ║ñµÿôµÖéµ«╡','µò┤Φéíσâ╣µá╝','µò┤ΦéíΣ║ñµÿô','µÖ«ΘÇÜΣ║ñµÿôσâ╣µá╝']}[lang])
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_historical_readmission_claim_is_conditional(rendered,lang):
+    controls=rendered[lang]['strings']['controls']
+    claim=controls[2]['p']
+    # This code path explicitly has no multi-capture extractor yet.
+    assert any(x in claim.lower() for x in {'es':['pendiente','registro de extractores'], 'en':['pending','extractor registry','if '], 'zh':['σ░Üµ£¬','σ╛à','ΦïÑ','σâàσ£¿']}[lang]), claim
+
+def test_reviews_do_not_present_new_findings_as_closed(rendered,site):
+    n=sum(r['findings_new'] for r in site['rounds'])
+    original=json.loads((ROOT/'review/out/ronda16_verificacion_20260910T014302Z.json').read_text(encoding='utf8'))
+    assert original['veredicto']=='rechazado'
+    assert not ('Hallazgos corregidos' in rendered['es']['review'] and f'>{n}<' in rendered['es']['review']), n
+
+def test_no_global_denial_of_user_confidence_intervals(rendered,site):
+    user=next(s for s in site['scenarios'] if s['id']=='user')
+    assert user['forecasters']['Q1']['paired']['ci95'] is not None
+    assert 'no hay intervalo de confianza que publicar' not in rendered['es']['limits']
+
+def test_published_sample_equity_keeps_flags():
+    d=source('sample_2024_2025')
+    assert d['summary']['forecasters']['Q0']['final_valuation']['flags']
+    report=(ROOT/'docs/informes/14_backtest_muestra_2024-2025.md').read_text(encoding='utf8')
+    row=next(s for s in report.splitlines() if s.startswith('| Q0 (`'))
+    assert any(x in row.lower() for x in ('provisional','inciert','fractional')), row
+
+def test_abstention_does_not_hide_return_of_held_positions(rendered,site):
+    sc=next(s for s in site['scenarios'] if s['id']=='standard')
+    w=next(w for w in sc['weeks'] if w['week_id']=='2026-W29')
+    assert w['forecasters']['Q0']['net'] == pytest.approx(-.0629250122596161)
+    assert w['forecasters']['Q0']['status']=='abstained'
+    row=re.search(r'<tr class="wk[^>]+data-week="2026-W29".*?</tr>',rendered['es']['standard']['table'],re.S)[0]
+    assert '6,29' in row, row
+
+def test_equity_chart_marks_obsolete_prices(rendered,site):
