        {"title": f"{date_str} µ»ÅµùÑµö╢τ¢ñΦíîµâà(σà¿Θâ¿(Σ╕ìσÉ½µ¼èΦ¡ëπÇüτë¢τåèΦ¡ëπÇüσÅ»σ▒òσ╗╢τë¢τåèΦ¡ë))", "fields": fields, "data": rows}]}


def tpex_body(date_str, rows, fields=TPEX_FIELDS):
    return {"date": date_str, "tables": [{"title": "Σ╕èµ½âΦéíτÑ¿Φíîµâà", "fields": fields, "data": rows}, {"title": "τ«íτÉåΦéíτÑ¿", "fields": fields, "data": []}]}


