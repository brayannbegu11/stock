            if pe.get("n_fixed_observations"):
                pe_txt += f" (variabilidad limitada: {pe['n_fixed_observations']} semanas fijas)"
TPEX_DATASET = "dailyQuotes"
TWSE_DERIVATION = "twse_mi_index_daily_v1"
