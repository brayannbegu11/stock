@@ -0,0 +1,95 @@
+from review.out.astra_scratch.r10_support import *
+from twlab.ledger import CostModel, q_twd
+import hashlib, collections
+import pytest
+
+LABELS=('universe_2026-05-04_2026-09-09','user_75kTWD_oddlots_2026')
+
+@pytest.fixture(scope='module')
+def manifest():
+    return [json.loads(line) for line in (ROOT/'data/raw/manifest.jsonl').read_text(encoding='utf8').splitlines()]
+
+def last_record(manifest,src,dataset):
+    return [r for r in manifest if r['source_id']==src and r['dataset']==dataset][-1]
+
+def read_record(rec):
+    raw=(ROOT/'data/raw'/rec['path']).read_bytes()
+    assert hashlib.sha256(raw).hexdigest()==rec['sha256']
+    return json.loads(raw)
+
+def bars_from_body(rec):
+    body=read_record(rec)
+    assert body['date']==rec['dataset'].split('/')[-1].replace('-','')
+    tw=rec['source_id']=='twse'
+    table=next(t for t in body['tables'] if ('µ»ÅµùÑµö╢τ¢ñΦíîµâà' in t['title'] if tw else t['title'].startswith('Σ╕èµ½âΦéíτÑ¿Φíîµâà')))
+    fields=table['fields']; keys=['Φ¡ëσê╕Σ╗úΦÖƒ','Θûïτ¢ñσâ╣','µö╢τ¢ñσâ╣','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì'] if tw else ['Σ╗úΦÖƒ','Θûïτ¢ñ','µö╢τ¢ñ','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì(σàâ)']
+    indices=[fields.index(k) for k in keys]
+    return {str(row[indices[0]]):[str(row[i]).replace(',','') for i in indices[1:]] for row in table['data']}
+
+def test_real_daily_packets_trace_every_window_row(manifest):
+    records={r['capture_id']:r for r in manifest}; cache={}; n=0; docs=0
+    for label in LABELS:
+        for week in ('2026-W20','2026-W37'):
+            packet=read_record(last_record(manifest,'packet',f'{label}/{week}'))
+            by_id={d['doc_id']:d for d in packet['admitted']}
+            for doc in packet['admitted']:
+                if doc['kind']!='price_bar_series':
+                    continue
+                docs+=1
+                captures=by_id[doc['payload']['captures_doc']]['payload']['session_captures']
+                symbol=doc['doc_id'].split(':')[0]
+                assert doc['capture_id']==captures[doc['payload']['last_session']]
+                assert doc['source_sha256']==records[doc['capture_id']]['sha256']
+                for row in doc['payload']['sessions']:
+                    capture_id=captures[row[0]]; rec=records[capture_id]
+                    assert rec['source_id']==doc['source_id'] and rec['dataset'].endswith(row[0])
+                    if capture_id not in cache:
+                        cache[capture_id]=bars_from_body(rec)
+                    source=cache[capture_id][symbol]
+                    assert [D(str(x)) for x in row[1:]]==[D(x) for x in source],(label,week,symbol,row,source)
+                    n+=1
+            forecast=read_record(last_record(manifest,'forecast',f'{label}/Q0/{week}'))
+            assert forecast['packet_hash']==packet['packet_hash']
+    print({'packets':4,'series':docs,'rows_verified':n,'source_captures':len(cache)})
+
+def test_real_odd_lot_orders_stay_inside_slot_budgets(manifest):
+    label=LABELS[1]; data=json.loads((ROOT/'data/store'/f'backtest_{label}.json').read_text(encoding='utf8'))
+    costs=CostModel(D('.001425'),sell_tax=D('.003'),slippage_bps_per_side=20,min_commission_twd=D(20))
+    overruns=[]; count=0; cache={}
+    for w in data['weeks']:
+        packet=read_record(last_record(manifest,'packet',f"{label}/{w['week_id']}"))
+        session=packet['entry_at'][:10]
+        for f,x in w['forecasters'].items():
+            for p in x['picks']:
+                if p.get('entry_status')=='entry_failed':
+                    continue
+                src=p['security_id'].split(':')[0].lower(); ds='MI_INDEX_ALLBUT0999' if src=='twse' else 'dailyQuotes'
+                key=(src,session)
+                if key not in cache:
+                    cache[key]=bars_from_body(last_record(manifest,src,f'{ds}/{session}'))
+                price=D(cache[key][p['symbol']][0]); notional=D(str(x['notional_per_slot']))
+                quantity=int(notional/(price*(1+costs.slippage)*(1+costs.commission_per_side)))
+                if quantity<=0:
+                    continue
+                executed=q_twd(price*quantity); executed+=costs.round(executed*costs.slippage)
+                debit=executed+costs.commission(executed); count+=1
+                if debit>notional:
+                    overruns.append((w['week_id'],f,p['symbol'],str(price),str(notional),quantity,str(debit)))
+    print({'orders_checked':count,'overruns':overruns})
+    assert not overruns, overruns
+
+def test_report_tables_match_json_numeric_results():
+    for label,name in [(LABELS[0],'15_backtest_universo_2026.md'),(LABELS[1],'15b_backtest_universo_2026_lotes_sueltos.md'),('sample_2024_2025','14_backtest_muestra_2024-2025.md')]:
+        d=json.loads((ROOT/'data/store'/f'backtest_{label}.json').read_text(encoding='utf8'))
+        report=(ROOT/'docs/informes'/name).read_text(encoding='utf8')
+        for f,x in d['summary']['forecasters'].items():
+            row=next(r for r in report.splitlines() if r.startswith(f'| {f} (`'))
+            for k in ('mean_weekly_net_return_open_close','mean_weekly_gross_pick_return','mean_costs_over_invested'):
+                assert f"{x[k]*100:+.2f} %" in row
+            assert f"{x['final_equity']:,.0f} TWD" in row
+
+def test_real_pending_entries_have_per_pick_execution_status():
+    d=json.loads((ROOT/'data/store'/f'backtest_{LABELS[0]}.json').read_text(encoding='utf8'))
+    x=d['weeks'][-1]['forecasters']['Q1']
+    assert x['filled']==2 and x['failed']==3
+    assert sum(p.get('entry_status')=='entry_failed' for p in x['picks'])==3, x
diff --git a/review/out/astra_scratch/test_r17_attacks.py b/review/out/astra_scratch/test_r17_attacks.py
new file mode 100644
index 0000000000000000000000000000000000000000..ef704083e03c41997a5e42abe4e8fa1c1b03724c
--- /dev/null
+++ b/review/out/astra_scratch/test_r17_attacks.py
@@ -0,0 +1,79 @@
+from review.out.astra_scratch.r10_support import *
+from review.out.astra_scratch.test_r16_attacks import daily
+from twlab.ledger import PaperLedger, CostModel, CorporateAction, Fill
+from twlab.simulation import enter_basket, exit_basket
+from twlab.backtest import TabularForecaster
+from twlab.weekly import plan_week
+from fractions import Fraction
+import pytest
+
+def cost():
+    return CostModel(D('.001425'), sell_tax=D('.003'), slippage_bps_per_side=20, min_commission_twd=D(20))
+
+def basket(cash, notional, slots=1, price='10'):
+    lg = PaperLedger(ledger_id='test', initial_cash=D(cash), cost_model=cost(), lot_size=1)
+    picks = [str(i) for i in range(slots)]
+    ss = enter_basket(lg, picks=picks, slots=slots, notional_per_slot=D(notional), open_prices={s:D(price) for s in picks}, at=taipei(date(2024,1,8),time(9)), week_id='2024-W02')
+    return lg, ss
+
+def test_minimum_commission_does_not_reject_affordable_smaller_order():
+    lg, slots = basket(1000,1000)
+    # 97 shares cost 970 + floor(970*.002) + 20 = 991 <= 1000.
+    assert slots[0].status == 'filled', (slots[0].status, slots[0].reason, lg.cash)
+    assert slots[0].entry.shares == 97
+
+def test_minimum_commission_respects_each_slot_budget():
+    lg, slots = basket(5000,1000,5)
+    assert all(s.entry and -s.entry.cash_delta <= 1000 for s in slots), [(s.status, -s.entry.cash_delta if s.entry else s.reason) for s in slots]
+
+def test_odd_lot_minimum_applies_buy_sell_and_fraction_survives():
+    lg = PaperLedger(ledger_id='t', initial_cash=D(1000), cost_model=cost(), lot_size=1)
+    slots=enter_basket(lg,picks=['A'],slots=1,notional_per_slot=D(400),open_prices={'A':D(100)},at=taipei(date(2024,1,8),time(9)),week_id='w')
+    assert slots[0].entry.commission == 20
+    lg.apply_corporate_action(CorporateAction('split','A','split',taipei(date(2024,1,9)),split_ratio=D('.5')))
+    exit_basket(lg,slots,close_prices={'A':D(200)},at=taipei(date(2024,1,12),time(13,30)),week_id='w')
+    assert slots[0].exit.shares == 1 and slots[0].exit.commission == 20
+    assert lg.positions['A'].lots[0].rational() == Fraction(1,2)
+    assert lg.positions['A'].unresolved_fraction == D('.5')
+    before=lg.cash
+    exit_basket(lg,slots,close_prices={'A':D(200)},at=taipei(date(2024,1,19),time(13,30)),week_id='w')
+    assert lg.cash == before and slots[0].status == 'exit_blocked'
+
+def test_daily_missing_capture_in_series_must_not_be_admitted(tmp_path):
+    store, market = daily(tmp_path)
+    del market.securities['A'].bar_captures[date(2024,1,4)]
+    r=Runner(store,market,BacktestConfig(date(2024,1,1),date(2024,1,12)),[MomentumForecaster(),RandomForecaster(1)])
+    try:
+        p,_,_=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),market.calendar))
+    except (ValueError, KeyError):
+        return
+    for doc in p.admitted:
+        if doc.kind=='price_bar_series':
+            m=next(d for d in p.admitted if d.doc_id==doc.payload['captures_doc'])
+            assert all(row[0] in m.payload['session_captures'] for row in doc.payload['sessions']), (doc.payload,m.payload)
+
+def test_data_version_covers_session_capture_change(tmp_path):
+    _,market=daily(tmp_path)
+    f=TabularForecaster(market,min_weeks=1)
+    before=market.data_version
+    market.securities['A'].bar_captures[date(2024,1,4)]=market.securities['A'].bar_captures[date(2024,1,5)]
+    with pytest.raises(ValueError):
+        f.maybe_train(taipei(date(2024,1,7),time(18)))
+    assert market.data_version != before
+
+def test_liquidity_scales_with_configured_notional_and_odd_lot_exposure(tmp_path):
+    store, market=fixture(tmp_path,end='2024-01-12')
+    from dataclasses import replace
+    sec=next(iter(market.securities.values()))
+    sec.bars=[replace(b,value_twd=D(300000)) for b in sec.bars]
+    market.by_session[sec.security_id]={b.session:b for b in sec.bars}
+    elig=[]
+    for notional,lot in [(15000,1),(1000000,1000)]:
+        cfg=BacktestConfig(date(2024,1,1),date(2024,1,12),notional=notional,lot_size=lot,min_commission_twd=D(20),slippage_bps=20)
+        r=Runner(store,market,cfg,[MomentumForecaster(),RandomForecaster(1)])
+        _,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),market.calendar))
+        elig.append(cs[0].eligible)
+        if lot==1:
+            w=r.run()['weeks'][0]['forecasters']['Q0']
+            assert w['filled']==1 and w['failed']==0 and 0 < w['exposure_at_open'] <= D('.2')
+    assert elig == [True,False]
