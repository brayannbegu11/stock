[31;1mdef test_ridge_recovers_a_linear_signal():[0m
[31;1m    import random[0m
[31;1m    rng = random.Random(0)[0m
[31;1m    X = [[rng.gauss(0, 1) for _ in range(3)] for _ in range(400)][0m
[31;1m    y = [2 * x[0] - x[1] + 0.1 * rng.gauss(0, 1) for x in X][0m
[31;1m    m = q1.RidgeRank(alpha=0.1).fit(X, y)[0m
[31;1m    pred = m.predict(X)[0m
[31;1m    corr = sum((p - sum(pred) / len(pred)) * (t - sum(y) / len(y)) for p, t in zip(pred, y))[0m
[31;1m    assert corr > 0 and abs(m.w[0] / m.w[1] + 2) < 0.2[0m
