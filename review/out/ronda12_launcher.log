[31;1m                    stale.append(f"stale_price:{sec}:{prev[-1].session.isoformat()}")[0m
[31;1m            else:[0m
[31;1m                out[sec] = b.open if kind == "open" else b.close[0m
[31;1m        return out, stale[0m
[31;1m[0m
[31;1m    def apply_actions(self, name: str, upto: date) -> int:[0m
[31;1m        ledger = self.ledgers[name][0m
[31;1m        since = self.cursor[name][0m
[31;1m        if upto <= since:[0m
[31;1m            return 0[0m
[31;1m        events = [][0m
[31;1m        for sec in list(ledger.positions):[0m
[31;1m            s = self.market.securities[sec][0m
[31;1m            for dv in s.dividends:[0m
[31;1m                for kind, exd in (("cash", dv.cash_ex_date), ("stock", dv.stock_ex_date)):[0m
[31;1m                    if exd is not None and since < exd <= upto:[0m
[31;1m                        events.append((exd, kind, sec, dv))[0m
[31;1m            if s.delisting_date and since < s.delisting_date <= upto:[0m
[31;1m                events.append((s.delisting_date, "delisting", sec, None))[0m
[31;1m        n = 0[0m
[31;1m        for exd, kind, sec, dv in sorted(events, key=lambda e: (e[0], e[1])):[0m
[31;1m            at = taipei(exd, PRE_OPEN)[0m
[31;1m            try:[0m
[31;1m                if kind == "cash" and dv.cash_per_share > 0:[0m
[31;1m                    pay = taipei(dv.cash_pay_date, time(9, 0)) if dv.cash_pay_date else None[0m
[31;1m                    ledger.apply_corporate_action(CorporateAction(f"{sec}:cash:{exd}:{dv.period}", sec, "cash_dividend", at,[0m
[31;1m                                                                  per_share_cash=dv.cash_per_share, pay_at=pay))[0m
[31;1m                elif kind == "stock" and dv.stock_per_share > 0:[0m
[31;1m                    ledger.apply_corporate_action(CorporateAction(f"{sec}:stock:{exd}:{dv.period}", sec, "stock_dividend", at,[0m
[31;1m                                                                  stock_ratio=dv.stock_per_share / self.cfg.par_value))[0m
[31;1m                elif kind == "delisting":[0m
[31;1m                    ledger.apply_corporate_action(CorporateAction(f"{sec}:delisting:{exd}", sec, "delisting", at, terminal_price=None))[0m
[31;1m                else:[0m
[31;1m                    continue[0m
[31;1m                n += 1[0m
[31;1m            except LedgerError as exc:[0m
[31;1m                self.weeks[-1].setdefault("action_errors", []).append(f"{name}:{sec}:{kind}:{exd}:{exc}")[0m
[31;1m        self.cursor[name] = upto[0m
[31;1m        return n[0m
