[31;1m            status_ok = doc.payload["last_session"] == last_session.isoformat()[0m
[31;1m            cov = classify_coverage(sv, price_history_sessions=int(doc.payload["history_sessions"]),[0m
[31;1m                                    min_history_sessions=self.cfg.min_history_sessions,[0m
