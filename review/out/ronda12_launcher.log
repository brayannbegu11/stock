[31;1m            known = [b for b in s.bars if b.available_at <= cutoff][0m
[31;1m            if not known:[0m
[31;1m                continue[0m
[31;1m            docs.append(Document([0m
[31;1m                doc_id=f"{s.symbol}:bars:{plan.week_id}", kind="price_bar_series", source_id="finmind", security_ids=(sec_id,),[0m
[31;1m                available_at=known[-1].available_at, availability_quality=AvailabilityQuality.CONSERVATIVE_INFERENCE,[0m
[31;1m                capture_id=s.price_capture.capture_id, source_sha256=s.price_capture.sha256, derivation="finmind_price_bars_v1",[0m
[31;1m                payload={"history_sessions": len(known), "last_session": known[-1].session.isoformat(),[0m
[31;1m                         "sessions": [[b.session.isoformat(), str(b.open), str(b.close), b.volume_shares, str(b.value_twd)] for b in known[-130:]]},[0m
[31;1m            ))[0m
[31;1m        packet = build_packet(packet_id=f"pkt-{self.cfg.label}-{plan.week_id}", cutoff_at=cutoff, documents=docs, mode="historical",[0m
[31;1m                              evidence_class=EVIDENCE, calendar=self.market.calendar)[0m
[31;1m        rec = self.store.put(source_id="packet", dataset=f"{self.cfg.label}/{plan.week_id}", payload=packet_to_json(packet),[0m
