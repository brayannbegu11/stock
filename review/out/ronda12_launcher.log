[31;1mdef parse_date(value: str) -> date:[0m
[31;1m    """Convierte cualquiera de los formatos observados a ``date``.[0m
[31;1m[0m
[31;1m    Falla en vez de adivinar: cadenas vacías, formatos desconocidos o[0m
[31;1m    fechas imposibles levantan ``DateParseError``.[0m
[31;1m    """[0m
[31;1m    s = (value or "").strip()[0m
[31;1m    if not s:[0m
[31;1m        raise DateParseError("empty date")[0m
[31;1m    try:[0m
[31;1m        m = _ISO.match(s)[0m
[31;1m        if m:[0m
[31;1m            return date(int(m[1]), int(m[2]), int(m[3]))[0m
[31;1m        m = _GREG_COMPACT.match(s)[0m
[31;1m        if m:[0m
[31;1m            return date(int(m[1]), int(m[2]), int(m[3]))[0m
[31;1m        m = _ROC_COMPACT.match(s)[0m
[31;1m        if m:[0m
[31;1m            return date(roc_year_to_gregorian(int(m[1])), int(m[2]), int(m[3]))[0m
[31;1m        m = _SLASH.match(s)[0m
[31;1m        if m:[0m
[31;1m            y = int(m[1])[0m
[31;1m            y = y if len(m[1]) == 4 else roc_year_to_gregorian(y)[0m
[31;1m            return date(y, int(m[2]), int(m[3]))[0m
[31;1m        m = _ROC_CJK.match(s)[0m
[31;1m        if m:[0m
[31;1m            return date(roc_year_to_gregorian(int(m[1])), int(m[2]), int(m[3]))[0m
[31;1m    except ValueError as exc:  # fecha imposible (mes 13, día 32...)[0m
