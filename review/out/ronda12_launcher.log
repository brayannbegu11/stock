[31;1m        return time(int(s[0:2]), int(s[2:4]), int(s[4:6]))[0m
[31;1m    except ValueError as exc:[0m
[31;1m        raise DateParseError(f"invalid HHMMSS time {value!r}: {exc}") from exc[0m
