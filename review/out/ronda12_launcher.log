[31;1m            s = self.market.securities[sec_id][0m
[31;1m            sessions = list(doc.payload["sessions"])[0m
[31;1m            values = [D(x[4]) for x in sessions[-20:]][0m
[31;1m            try:[0m
[31;1m                sv = self.market.master.resolve_symbol(s.symbol, as_of=last_session)[0m
[31;1m            except UnknownSymbol:[0m
[31;1m                candidates.append(Candidate(sec_id, s.symbol, doc.doc_id, sessions, False, False, ("not_in_catalog_as_of_last_session",)))[0m
[31;1m                continue[0m
