[31;1m    # -- precios y eventos --------------------------------------------------------------------------[0m
[31;1m    def marks(self, session: date, ledger: PaperLedger, kind: str) -> tuple[dict[str, D], list[str]]:[0m
[31;1m        out, stale = {}, [][0m
[31;1m        for sec, pos in ledger.positions.items():[0m
[31;1m            if pos.status.startswith("delisted"):[0m
[31;1m                continue[0m
[31;1m            b = self.market.by_session.get(sec, {}).get(session)[0m
[31;1m            if b is None:[0m
[31;1m                prev = [x for x in self.market.securities[sec].bars if x.session <= session][0m
[31;1m                if prev:[0m
