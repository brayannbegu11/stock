[31;1mdef _rank01(values: Sequence[float]) -> list[float]:[0m
[31;1m    """Rango en [0, 1]; los empates reciben el rango medio (R10-04): una señal constante vale 0,5 para todos."""[0m
[31;1m    n = len(values)[0m
[31;1m    if n <= 1:[0m
[31;1m        return [0.5] * n[0m
[31;1m    order = sorted(range(n), key=lambda i: values[i])[0m
[31;1m    out = [0.0] * n[0m
[31;1m    i = 0[0m
[31;1m    while i < n:[0m
[31;1m        j = i[0m
[31;1m        while j + 1 < n and values[order[j + 1]] == values[order[i]]:[0m
[31;1m            j += 1[0m
[31;1m        avg = (i + j) / 2 / (n - 1)[0m
[31;1m        for k in range(i, j + 1):[0m
[31;1m            out[order[k]] = avg[0m
[31;1m        i = j + 1[0m
[31;1m    return out[0m
