[31;1m_ISO = re.compile(r"^(\d{4})-(\d{2})-(\d{2})$")[0m
[31;1m_GREG_COMPACT = re.compile(r"^(\d{4})(\d{2})(\d{2})$")[0m
[31;1m_ROC_COMPACT = re.compile(r"^(\d{2,3})(\d{2})(\d{2})$")[0m
