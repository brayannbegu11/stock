function scenarioTabs(){
  return `<div class="tabs" role="tablist">${["standard","user","longhist"].filter(id=>scenario(id)||id!=="longhist").map(id=>{ const has=!!scenario(id);
    return `<button type="button" class="tab" role="tab" aria-selected="${id===state.scenario}" data-scenario="${id}"><span>${esc(t("scen")[id])}</span><span class="sub">${esc(t("scen_sub")[id])}${has?"":" ┬╖ "+esc(t("no_scenario"))}</span></button>`; }).join("")}</div>${(t("scen_note")||{})[state.scenario]?`<p class="note" style="margin:-6px 0 14px">${esc(t("scen_note")[state.scenario])}</p>`:""}`;
}
