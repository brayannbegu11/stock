ROOT = Path(__file__).resolve().parents[1]
if str(ROOT / "src") not in sys.path:
    sys.path.insert(0, str(ROOT / "src"))          # twlab.packet se necesita para recalcular el hash l├│gico (R22-02), tambi├⌐n fuera de pytest
STORE = ROOT / "data" / "store"
RAW = ROOT / "data" / "raw"
_TAIPEI = ZoneInfo("Asia/Taipei")
SITE = ROOT / "docs" / "site"
