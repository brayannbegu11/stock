def test_all_sunday_weeks_have_exact_archive_and_temporal_contract(tmp_path, monkeypatch):
    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
    # Config end is Sunday 2024-01-07. Replay several cutoffs with the same capture clock.
    q1 = prev.MomentumForecaster()
