+@pytest.mark.parametrize('corrupt', [False, True])
+def test_sunday_master_reuse_between_runs(tmp_path, monkeypatch, corrupt):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    old = raw.get(data['weeks'][-1]['master_capture'])
+    if corrupt:
+        (raw.root / old.path).write_bytes(b'corrupt')
+    now[0] = datetime(2024, 1, 9, 12, tzinfo=timezone.utc)
+    q1 = prev.MomentumForecaster(); q1.name = 'Q1'
+    again = prev.Runner(raw, market, cfg, [prev.MomentumForecaster(), q1, prev.RandomForecaster(1)]).run()
+    w = again['weeks'][-1]
+    assert (w['master_capture'] == old.capture_id) is (not corrupt)
+    assert all(x['master_capture'] == w['master_capture'] for x in again['weeks'])
+    assert [x['forecast_sha256'] for x in w['forecasters'].values()] == [x['forecast_sha256'] for x in data['weeks'][-1]['forecasters'].values()]
+    ex = prev.export_setup(monkeypatch, raw, again, tmp_path)
+    result = classify(ex, w)
+    assert result['prospective'] is (not corrupt), result
+
