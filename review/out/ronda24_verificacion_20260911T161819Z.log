+import copy
+import json
+import subprocess
+from dataclasses import replace
+from datetime import datetime, timezone
+
+import pytest
+from review.out.astra_scratch import test_r21 as prev
+from review.out.astra_scratch.test_r23 import setup, classify, rearchive_packet
+from twlab.packet import packet_from_json
+from twlab.master import SecurityMaster, SecurityVersion
+
+
+def rows_of(raw, w):
+    return [json.loads(x) for x in raw.read(raw.get(w['master_capture'])).splitlines()]
+
+
+def save_master(raw, w, rows, source='master', dataset='lab/master'):
+    rec = raw.put(source_id=source, dataset=dataset,
+                  payload=('\n'.join(json.dumps(x) for x in rows)+'\n').encode(), url='fixture')
+    w['master_capture'] = rec.capture_id
+    return rec
+
+
+@pytest.mark.parametrize('kind', ['symbol', 'expired', 'nonsegment', 'future', 'future_revision', 'past_revision'])
+def test_master_effective_view(tmp_path, monkeypatch, kind):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    rows = rows_of(raw, w)
+    row = next(x for x in rows if x['symbol'] == 'A')
+    row['recorded_at'] = '2024-01-06T08:00:00+00:00'
+    if kind == 'symbol': row['symbol'] = 'B'
+    if kind == 'expired': row['valid_to'] = '2024-01-07'
+    if kind == 'nonsegment': row['kind'] = 'terminal'
+    if kind == 'future': row['recorded_at'] = '2024-01-07T11:00:00+00:00'
+    if kind in ('future_revision', 'past_revision'):
+        revised = dict(row, recorded_at='2024-01-07T11:00:00+00:00' if kind == 'future_revision' else '2024-01-07T09:00:00+00:00')
+        row['symbol'] = 'OLD'
+        rows.append(revised)
+    save_master(raw, w, rows)
+    result = classify(ex, w)
+    assert result['prospective'] is (kind == 'past_revision'), (kind, result)
+
+
+@pytest.mark.parametrize('field,value', [('valid_to', False), ('valid_to', 0), ('valid_to', []), ('valid_to', ''),
+    ('recorded_at', '2024-01-06T08:00:00'), ('recorded_at', 42), ('valid_from', []),
+    ('security_id', ['A']), ('symbol', ['A']), ('valid_to', 42)])
+def test_master_types_fail_closed(tmp_path, monkeypatch, field, value):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    rows = rows_of(raw, w)
+    next(x for x in rows if x['symbol'] == 'A')[field] = value
+    save_master(raw, w, rows)
+    result = classify(ex, w)
+    assert result['prospective'] is False, (field, value, result)
+
+
+@pytest.mark.parametrize('value', [None, '', 42, [], {}, True])
+def test_master_capture_types(tmp_path, monkeypatch, value):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    w['master_capture'] = value
+    result = classify(ex, w)
+    assert result['prospective'] is False and 'no_master_identity' in result['reasons']
+
+
+@pytest.mark.parametrize('kind', ['symbol', 'unselected_ghost'])
+def test_packet_master_consistency(tmp_path, monkeypatch, kind):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    docs = list(packet.admitted)
+    i = next(i for i, d in enumerate(docs) if d.kind == 'price_bar_series' and market.by_symbol['A'] in d.security_ids)
+    d = docs[i]
+    payload = json.loads(json.dumps(dict(d.payload), default=list))
+    if kind == 'symbol':
+        assert payload['symbol'] == 'A'
+        payload['symbol'] = 'B'
+        docs[i] = replace(d, payload=payload)
+    else:
+        payload.update(symbol='GHOST', name='GHOST')
+        docs.append(replace(d, doc_id='GHOST:bars:2024-W02', security_ids=('TWSE:GHOST@2000-01-01',), payload=payload))
+    rearchive_packet(raw, data, replace(packet, admitted=tuple(docs)))
+    result = classify(ex, w)
+    assert result['prospective'] is False, (kind, result)
+
+
+def test_master_record_source_contract(tmp_path, monkeypatch):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    save_master(raw, w, rows_of(raw, w), source='untrusted', dataset='other/not-master')
+    result = classify(ex, w)
+    assert result['prospective'] is False, result
+
+
+def test_master_late_replacement(tmp_path, monkeypatch):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    w = data['weeks'][-1]
+    original = raw.get(w['master_capture'])
+    now[0] = datetime(2024, 1, 9, 12, tzinfo=timezone.utc)
+    rec = save_master(raw, w, rows_of(raw, w))
+    assert rec.ingested_at_dt > datetime.fromisoformat(w['cutoff_at'])
+    assert rec.ingested_at_dt > datetime.fromisoformat(w['forecasters']['Q0']['deadline_at'])
+    (raw.root / original.path).write_bytes(b'corrupt')
+    ex = prev.export_setup(monkeypatch, raw, data, tmp_path)
+    result = classify(ex, w)
+    assert result['prospective'] is False, result
+
+
+@pytest.mark.parametrize('corrupt', [False, True])
+def test_sunday_master_reuse_between_runs(tmp_path, monkeypatch, corrupt):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    old = raw.get(data['weeks'][-1]['master_capture'])
+    if corrupt:
+        (raw.root / old.path).write_bytes(b'corrupt')
+    now[0] = datetime(2024, 1, 9, 12, tzinfo=timezone.utc)
+    q1 = prev.MomentumForecaster(); q1.name = 'Q1'
+    again = prev.Runner(raw, market, cfg, [prev.MomentumForecaster(), q1, prev.RandomForecaster(1)]).run()
+    w = again['weeks'][-1]
+    assert (w['master_capture'] == old.capture_id) is (not corrupt)
+    assert all(x['master_capture'] == w['master_capture'] for x in again['weeks'])
+    assert [x['forecast_sha256'] for x in w['forecasters'].values()] == [x['forecast_sha256'] for x in data['weeks'][-1]['forecasters'].values()]
+    ex = prev.export_setup(monkeypatch, raw, again, tmp_path)
+    result = classify(ex, w)
+    assert result['prospective'] is (not corrupt), result
+
+
+@pytest.mark.parametrize('kind', ['identity_symbol', 'identity_unknown', 'no_master', 'classification_error', 'packet_record_hash_missing', 'prediction', 'late', 'reconstruction'])
+def test_new_reasons_site_all_languages(tmp_path, monkeypatch, kind):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    if kind in ('identity_symbol', 'identity_unknown'):
+        rows = rows_of(raw, w)
+        row = next(x for x in rows if x['symbol'] == 'A')
+        row['symbol' if kind == 'identity_symbol' else 'valid_to'] = 'B' if kind == 'identity_symbol' else '2024-01-07'
+        save_master(raw, w, rows)
+    elif kind == 'no_master': w.pop('master_capture')
+    elif kind == 'classification_error': w['packet_capture'] = ['malformed']
+    elif kind in ('packet_record_hash_missing', 'late', 'reconstruction'):
+        path = raw.root / 'manifest.jsonl'
+        rows = [json.loads(line) for line in path.read_text(encoding='utf8').splitlines()]
+        for row in rows:
+            if kind == 'packet_record_hash_missing' and row['capture_id'] == w['packet_capture']: row['extra'].pop('packet_hash')
+            if kind == 'late' and row['source_id'] not in ('packet', 'forecast', 'master'): row['ingested_at'] = '2024-01-07T12:00:00+00:00'
+            if kind == 'reconstruction' and row['source_id'] == 'forecast': row['ingested_at'] = '2024-01-08T01:00:00+00:00'
+        path.write_text('\n'.join(map(json.dumps, rows)), encoding='utf8')
+    ex = prev.export_setup(monkeypatch, raw, data, tmp_path)
+    output = ex.build()
+    current = output['scenarios'][0]['current_week']
+    target = {'prediction': 'tag_pro', 'late': 'tag_late', 'reconstruction': 'tag_recon'}.get(kind, 'tag_unv')
+    path = tmp_path / 'site.json'; path.write_text(json.dumps(output), encoding='utf8')
+    rendered = json.loads(subprocess.run(['node', 'review/out/astra_scratch/r22_render.cjs', 'file', str(path)],
+                                         capture_output=True, text=True, encoding='utf8', check=True).stdout)
+    for lang, x in rendered.items():
+        assert f'<b>{x[target]} ┬╖' in x['week'], (kind, lang, current)
+        if kind not in ('prediction', 'late', 'reconstruction'):
+            assert all(reason in x['week'] for reason in current['reasons']), (kind, lang, current)

