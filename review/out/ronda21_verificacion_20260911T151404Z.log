+++ b/review/out/astra_scratch/test_r21.py
@@ -0,0 +1,233 @@
+import copy, hashlib, importlib.util, json, subprocess
+from pathlib import Path
+from datetime import datetime, date, time, timezone
+from dataclasses import replace
+import pytest
+from review.out.astra_scratch.r10_support import fixture, Runner, BacktestConfig, MomentumForecaster, RandomForecaster, ROOT, taipei
+from twlab.store import RawStore
+from twlab.packet import Rejection, packet_to_json, packet_from_json
+from twlab.weekly import plan_week
+from twlab.backtest import ManifestInconsistent, markdown_report
+
+def load(name):
+    spec=importlib.util.spec_from_file_location('r21_'+name,ROOT/'scripts'/f'{name}.py')
+    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m
+
+def export_setup(monkeypatch, raw, d, tmp_path):
+    ex=load('export_site_data')
+    monkeypatch.setattr(ex,'RAW',raw.root)
+    monkeypatch.setattr(ex,'STORE',tmp_path)
+    monkeypatch.setattr(ex,'SCENARIOS',[('standard','lab','fixture.md')])
+    for name,value in [('export_rounds',[]),('export_docs',[]),('count_tests',0),('raw_coverage',{}),('master_stats',{})]:
+        monkeypatch.setattr(ex,name,lambda v=value:v)
+    (tmp_path/'backtest_lab.json').write_text(json.dumps(d,default=str),encoding='utf8')
+    return ex
+
+def sunday_fixture(tmp_path,monkeypatch):
+    now=[datetime(2024,1,6,8,tzinfo=timezone.utc)]
+    monkeypatch.setattr(RawStore,'_now',lambda self:now[0])
+    raw,m=fixture(tmp_path,end='2024-01-26',symbols=('A','B'))
+    now[0]=datetime(2024,1,7,12,tzinfo=timezone.utc)
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,7),slots=1,notional=10000,lot_size=1,label='lab',archive_label='lab',n_boot=20)
+    q1=MomentumForecaster();q1.name='Q1'
+    r=Runner(raw,m,cfg,[MomentumForecaster(),q1,RandomForecaster(1)])
+    d=r.run()
+    return raw,m,cfg,r,d,now
+
+@pytest.mark.parametrize('value',[None,''])
+def test_partial_missing_forecast_identity(tmp_path,monkeypatch,value):
+    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
+    d['weeks'][-1]['forecasters']['Q1']['forecast_sha256']=value
+    ex=export_setup(monkeypatch,raw,d,tmp_path)
+    w=ex.build()['scenarios'][0]['weeks'][-1]
+    assert w['forecast_before_deadline'] is False,w
+
+def test_changed_displayed_picks(tmp_path,monkeypatch):
+    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
+    q=d['weeks'][-1]['forecasters']['Q0'];rec=raw.get(q['forecast_capture_id'])
+    original=json.loads(raw.read(rec))['forecast']['ranking'][0]['security_id']
+    q['picks']=[{'security_id':'TWSE:FAKE@2000-01-01','symbol':'FAKE','name':'FAKE'}]
+    ex=export_setup(monkeypatch,raw,d,tmp_path)
+    w=ex.build()['scenarios'][0]['weeks'][-1]
+    assert not w['prospective'] or w['forecasters']['Q0']['picks'][0]['security_id']==original,w
+
+@pytest.mark.parametrize('mutation',['packet_corrupt','source_missing','source_corrupt','unreferenced_admitted','empty_manifest','injected_source','packet_substitution'])
+def test_inputs_evidence_must_be_complete(tmp_path,monkeypatch,mutation):
+    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
+    w=d['weeks'][-1];pr=raw.get(w['packet_capture']);body=json.loads(raw.read(pr))
+    source=raw.get(body['admitted'][0]['capture_id'])
+    if mutation=='packet_corrupt':
+        body['admitted'][0]['payload']={'fabricated':123}
+        (raw.root/pr.path).write_text(json.dumps(body),encoding='utf8')
+    elif mutation=='source_missing': (raw.root/source.path).unlink()
+    elif mutation=='source_corrupt': (raw.root/source.path).write_bytes(b'broken')
+    elif mutation in ('unreferenced_admitted','empty_manifest'):
+        if mutation=='unreferenced_admitted': body['admitted'].append({'kind':'price_bar_series','payload':{'fabricated':123}})
+        else: body['admitted'].append({'kind':'capture_manifest','capture_id':source.capture_id,'payload':{'session_captures':{}}})
+        p=raw.put(source_id='packet',dataset='lab/other',payload=json.dumps(body).encode(),url='fixture')
+        w['packet_capture']=p.capture_id
+    elif mutation=='injected_source':
+        path=raw.root/'manifest.jsonl';rows=[json.loads(x) for x in path.read_text().splitlines()]
+        for x in rows:
+            if x['capture_id']==source.capture_id:x['clock_source']='injected'
+        path.write_text('\n'.join(map(json.dumps,rows)),encoding='utf8')
+    else:
+        changed=replace(packet_from_json(raw.read(pr)),packet_id='unrelated-packet')
+        p=raw.put(source_id='packet',dataset='unrelated/2024-W02',payload=packet_to_json(changed),url='fixture')
+        assert packet_from_json(raw.read(p)).packet_hash()!=w['packet_hash']
+        w['packet_capture']=p.capture_id
+    ex=export_setup(monkeypatch,raw,d,tmp_path)
+    result=ex.build()['scenarios'][0]['weeks'][-1]
+    assert result['prospective'] is False,result
+
+def test_inputs_cache_uses_cutoff(tmp_path,monkeypatch):
+    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
+    ex=export_setup(monkeypatch,raw,d,tmp_path);pid=d['weeks'][-1]['packet_capture']
+    assert ex.inputs_before_cutoff(pid,'2024-01-07T18:00:00+08:00')['ok'] is True
+    assert ex.inputs_before_cutoff(pid,'2024-01-05T18:00:00+08:00')['ok'] is False
+
+@pytest.mark.parametrize('cutoff',['2024-01-07T18:00:00', '2024-01-05T18:00:00+08:00'])
+def test_inputs_bad_cutoff_fresh_fails_closed(tmp_path,monkeypatch,cutoff):
+    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
+    ex=export_setup(monkeypatch,raw,d,tmp_path)
+    assert ex.inputs_before_cutoff(d['weeks'][-1]['packet_capture'],cutoff)['ok'] is False
+
+@pytest.mark.parametrize('body',[{}, {'admitted':[]},{'admitted':[{'kind':'price_bar_series'}]}, {'admitted':[],'rejected':[{'capture_id':'late'}]}])
+def test_no_admitted_capture_fails_closed(tmp_path,monkeypatch,body):
+    raw=RawStore(tmp_path/'raw')
+    p=raw.put(source_id='packet',dataset='x',payload=json.dumps(body).encode(),url='fixture')
+    ex=load('export_site_data');monkeypatch.setattr(ex,'RAW',raw.root)
+    assert ex.inputs_before_cutoff(p.capture_id,'2024-01-07T18:00:00+08:00')['ok'] is False
+
+def test_rejected_hash_and_reuse(tmp_path,monkeypatch):
+    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
+    plan=plan_week(taipei(date(2024,1,7),time(18)),m.calendar)
+    p,rec,_=r.build_week_packet(plan)
+    altered=replace(p,rejected=p.rejected+(Rejection('X','unknown_availability','availability could not be established'),))
+    assert altered.packet_hash()!=p.packet_hash()
+    # Corrupt only metadata-compatible archive: RawStore integrity agrees with bytes but packet hash differs.
+    payload=packet_to_json(altered);(raw.root/rec.path).write_bytes(payload)
+    mf=raw.root/'manifest.jsonl';rows=[json.loads(x) for x in mf.read_text().splitlines()]
+    for row in rows:
+        if row['capture_id']==rec.capture_id:row['sha256']=hashlib.sha256(payload).hexdigest()
+    mf.write_text('\n'.join(map(json.dumps,rows)),encoding='utf8')
+    r.store=RawStore(raw.root)
+    with pytest.raises(ManifestInconsistent):r.build_week_packet(plan)
+
+def test_corrupt_forecast_replacement_identity(tmp_path,monkeypatch):
+    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
+    q=d['weeks'][-1]['forecasters']['Q0'];old=raw.get(q['forecast_capture_id'])
