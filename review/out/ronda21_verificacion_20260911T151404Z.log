+    doc=p.admitted[0]
+    if mutation=='missing_capture':extra=replace(doc,doc_id='unverified',capture_id=None,source_sha256=None)
+    else:extra=Document(doc_id='empty-manifest',kind='capture_manifest',source_id=doc.source_id,security_ids=(),available_at=doc.available_at,availability_quality=AvailabilityQuality.CONSERVATIVE_INFERENCE,capture_id=doc.capture_id,source_sha256=doc.source_sha256,payload={'session_captures':{}})
+    altered=replace(p,admitted=p.admitted+(extra,))
