import hashlib
import json
from pathlib import Path

root = Path(__file__).resolve().parents[3]
baseline = root / 'review/out/ronda27_verificacion_20260911T171847Z_baseline.sha256'
matched, changed, unreadable = [], [], []
for line in baseline.read_text(encoding='utf-8-sig').splitlines():
    sha, name = line.split('  ', 1)
    try:
        actual = hashlib.sha256((root / name).read_bytes()).hexdigest()
    except OSError as exc:
        unreadable.append([name, type(exc).__name__])
        continue
    (matched if actual.lower() == sha.lower() else changed).append(name)
logs = {}
for name in ['r27_final', 'r27_regress', 'r27_publish']:
    p = root / f'review/out/astra_scratch/{name}.log'
    raw = p.read_bytes()
    text = raw.decode('utf-16') if raw[:2] in (b'\xff\xfe', b'\xfe\xff') else raw.decode('utf-8', errors='replace')
    logs[name] = {k: sum(s.startswith(k + ' ') for s in text.splitlines()) for k in ['PASSED', 'FAILED', 'SKIPPED']}
out = {'hashes_matched': len(matched), 'changed': changed, 'unreadable': unreadable, 'test_results': logs}
(root / 'review/out/astra_scratch/r27_audit.json').write_text(json.dumps(out, indent=2), encoding='utf8')
print(json.dumps(out, indent=2))
