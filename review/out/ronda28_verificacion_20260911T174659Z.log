+@pytest.mark.parametrize('reset', [False, True])
+def test_nested_pin_preserves_outer_generation(tmp_path, monkeypatch, reset):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    src = source_id(raw, w)
+    fid = w['forecasters']['Q0']['forecast_capture_id']
+    rewrite_manifest(raw, lambda rows: [r.update(clock_source='injected') for r in rows if r['capture_id'] == src])
+    assert not ex.classify_week('lab', w)['prospective']
+    original = ex.forecast_archive
+    def interleave(*args, **kwargs):
+        result = original(*args, **kwargs)
+        # A nested classification must restore, not release, the caller's pin.
+        ex.classify_week('lab', {'status': 'invalid:archive'})
+        def mutate(rows):
+            for r in rows:
+                if r['capture_id'] == src: r['clock_source'] = 'system'
+                if r['capture_id'] == fid: r['clock_source'] = 'injected'
+        rewrite_manifest(raw, mutate)
+        if reset: ex._MANIFEST = None
+        return result
+    monkeypatch.setattr(ex, 'forecast_archive', interleave)
+    mixed = ex.classify_week('lab', w)
+    monkeypatch.setattr(ex, 'forecast_archive', original)
+    assert not ex.classify_week('lab', w)['prospective']
+    assert not mixed['prospective'], mixed['reasons']
+
+
+@pytest.mark.parametrize('stage', ['forecast_archive', 'master_identity', 'inputs_before_cutoff'])
+def test_stage_exception_releases_pin(tmp_path, monkeypatch, stage):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    original = getattr(ex, stage)
+    def fail(*a, **kw): raise RuntimeError('stage failure')
+    monkeypatch.setattr(ex, stage, fail)
+    assert not ex.classify_week('lab', w)['prospective']
+    assert ex._PIN is None
+    monkeypatch.setattr(ex, stage, original)
+    assert ex.classify_week('lab', w)['prospective']
+
