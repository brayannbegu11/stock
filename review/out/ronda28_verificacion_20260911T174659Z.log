+    original=raw.find
+    failed={'2023-W52','2024-W02'} if multiple else {'2024-W02'}
+    def fail(**kw):
+        if kw['source_id']=='packet' and kw['dataset'].split('/')[-1] in failed:
+            raise OSError('ARCHIVE-FAIL-'+kw['dataset'].split('/')[-1])
+        return original(**kw)
+    monkeypatch.setattr(raw,'find',fail)
+    data=runner.run()
+    assert data['weeks'][-1]['status']=='valid'
+    return raw, market, data
