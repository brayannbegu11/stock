def load(name):
    spec=importlib.util.spec_from_file_location('r21_'+name,ROOT/'scripts'/f'{name}.py')
    m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m

def export_setup(monkeypatch, raw, d, tmp_path):
    ex=load('export_site_data')
    monkeypatch.setattr(ex,'RAW',raw.root)
    monkeypatch.setattr(ex,'STORE',tmp_path)
    monkeypatch.setattr(ex,'SCENARIOS',[('standard','lab','fixture.md')])
    for name,value in [('export_rounds',[]),('export_docs',[]),('count_tests',0),('raw_coverage',{}),('master_stats',{})]:
        monkeypatch.setattr(ex,name,lambda v=value:v)
    (tmp_path/'backtest_lab.json').write_text(json.dumps(d,default=str),encoding='utf8')
    return ex

def sunday_fixture(tmp_path,monkeypatch):
    now=[datetime(2024,1,6,8,tzinfo=timezone.utc)]
    monkeypatch.setattr(RawStore,'_now',lambda self:now[0])
    raw,m=fixture(tmp_path,end='2024-01-26',symbols=('A','B'))
    now[0]=datetime(2024,1,7,12,tzinfo=timezone.utc)
    cfg=BacktestConfig(date(2024,1,1),date(2024,1,7),slots=1,notional=10000,lot_size=1,label='lab',archive_label='lab',n_boot=20)
    q1=MomentumForecaster();q1.name='Q1'
    r=Runner(raw,m,cfg,[MomentumForecaster(),q1,RandomForecaster(1)])
    d=r.run()
    return raw,m,cfg,r,d,now

@pytest.mark.parametrize('value',[None,''])
def test_partial_missing_forecast_identity(tmp_path,monkeypatch,value):
    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
    d['weeks'][-1]['forecasters']['Q1']['forecast_sha256']=value
    ex=export_setup(monkeypatch,raw,d,tmp_path)
    w=ex.build()['scenarios'][0]['weeks'][-1]
    assert w['forecast_before_deadline'] is False,w

def test_changed_displayed_picks(tmp_path,monkeypatch):
    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
    q=d['weeks'][-1]['forecasters']['Q0'];rec=raw.get(q['forecast_capture_id'])
    original=json.loads(raw.read(rec))['forecast']['ranking'][0]['security_id']
    q['picks']=[{'security_id':'TWSE:FAKE@2000-01-01','symbol':'FAKE','name':'FAKE'}]
    ex=export_setup(monkeypatch,raw,d,tmp_path)
    w=ex.build()['scenarios'][0]['weeks'][-1]
    assert not w['prospective'] or w['forecasters']['Q0']['picks'][0]['security_id']==original,w

