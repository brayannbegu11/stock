+    assert current['week_id']==data['weeks'][-1]['week_id'],current
+    assert asm.current_week(data['weeks'])['week_id']==data['weeks'][-1]['week_id']
+
+
+@pytest.mark.parametrize('pending',[False,True])
+def test_table_keeps_historical_failure_causes(tmp_path,monkeypatch,pending):
