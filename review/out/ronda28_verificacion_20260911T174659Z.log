formes/28_respuesta_ronda22_astra.md","title":"Respuesta del constructor a la ronda 22 de revisi├│n (GPT-6 Astra)"},{"file":"docs/informes/29_respuesta_ronda23_astra.md","title":"Respuesta del constructor a la ronda 23 de revisi├│n (GPT-6 Astra)"},{"file":"docs/informes/30_respuesta_ronda24_astra.md","title":"Respuesta del constructor a la ronda 24 de revisi├│n (GPT-6 Astra)"},{"file":"docs/informes/31_respuesta_ronda25_astra.md","title":"Respuesta del constructor a la ronda 25 de revisi├│n (GPT-6 Astra)"},{"file":"docs/informes/32_respuesta_ronda26_astra.md","title":"Respuesta del constructor a la ronda 26 de revisi├│n (GPT-6 Astra)"},{"file":"docs/informes/33_respuesta_ronda27_astra.md","title":"Respuesta del constructor a la ronda 27 de revisi├│n (GPT-6 Astra)"}],"spec":[{"file":"docs/spec/v2/CONTRATOS_DATOS.md"},{"file":"docs/spec/v2/EXPERIMENTOS.json"},{"file":"docs/spec/v2/FUENTES.json"},{"file":"docs/spec/v2/FUENTES.md"},{"file":"docs/spec/v2/INVESTIGACION.md"},{"file":"docs/spec/v2/LEEME.md"},{"file":"docs/spec/v2/MANIFEST.json"},{"file":"docs/spec/v2/Paquete_Taiwan_IA_v2_2026-09-09.zip"},{"file":"docs/spec/v2/PREDICCION.schema.json"},{"file":"docs/spec/v2/PROTOCOLO.yaml"},{"file":"docs/spec/v2/PRUEBAS_ACEPTACION.md"},{"file":"docs/spec/v2/TRASPASO_FABLE_ASTRA.md"}]},"generated_at":"2026-09-11T17:46:41+00:00","master":{"as_of":"2026-09-09","file":"master_2026-09-09.jsonl","other_rows":{"delisting":1},"segments":2348},"raw_coverage":{"tpex":{"first":"2021-01-04","last":"2026-09-11","sessions":1387},"twse":{"first":"2021-01-04","last":"2026-09-11","sessions":1388}},"repo":"https://github.com/brayannbegu11/stock","review_stats":{"blocking_new":19,"blocking_verified":12,"new_total":263,"unverified_ids":["R01-02","R01-04","R01-06","R01-09","R01-12","R01-18","R01-20","R01-21","R01-22","R04-01","R04-02","R04-03","R04-04","R04-05","R04-06","R04-07","R04-08","R04-09","R04-10","R04-11","R04-12","R04-13","R04-14","R27-01","R27-02","R27-03","R27-04","R27-05","R27-06","R27-07","R27-08"],"verified_total":232},"rounds":[{"file":"review/out/ronda1_nucleo_20260909T180407Z.json","findings_new":25,"findings_total":25,"new_findings":[{"category":"tiempo","claim":"El adaptador interpreta todas las filas del calendario como cierres. La muestra incluye expresamente d├¡as de inicio y ├║ltimo d├¡a de negociaci├│n. Los tests codifican la misma interpretaci├│n equivocada y los informes 01/02 atribuyen falsamente el error a exchange_calendars.","file":"src/twlab/calendar.py","id":"R01-01","severity":"bloqueante"},{"category":"tiempo","claim":"El paquete prospectivo conf├¡a en available_at y first_seen_at suministrados por el llamante, sin vincularlos a una captura real ni comprobar contradicciones con published_at. La preservaci├│n de ingested_at en RawStore no protege este camino: Document no exige una referencia a ese registro.","file":"src/twlab/packet.py","id":"R01-02","severity":"bloqueante"},{"category":"tiempo","claim":"Exigir timestamps conscientes de zona no basta: comparar directamente dos datetime con la misma ZoneInfo puede ordenar por hora local e ignorar fold durante el cambio de horario. La API admite cortes en cualquier zona consciente; debe comparar instantes normalizados a UTC.","file":"src/twlab/packet.py","id":"R01-03","severity":"alta"},{"category":"contrato","claim":"El contenido entregado puede modificarse sin cambiar packet_hash: payload sigue siendo mutable y el hash utiliza un manifiesto calculado anteriormente. Adem├ís, content_hash omite fuente, identidades y metadatos temporales. No garantiza paquetes id├⌐nticos ni integridad de la evidencia temporal.","file":"src/twlab/packet.py","id":"R01-04","severity":"bloqueante"},{"category":"seguridad","claim":"GuardedWorkspace no implementa el aislamiento por permisos exigido: guarda los resultados dentro del objeto accesible al predictor y permite modificar role. El test PIT-11 comprueba ├║nicamente una llamada disciplinada al m├⌐todo.","file":"src/twlab/packet.py","id":"R01-05","severity":"bloqueante"},{"category":"identidad","claim":"Se admiten segmentos solapados sin rechazarlos ni cerrar el anterior. Al cerrar el segmento m├ís reciente, universe y resolve_symbol pueden resucitar el segmento antiguo. El problema debe impedirse al insertar o resolverse con reglas expl├¡citas de vigencia.","file":"src/twlab/master.py","id":"R01-06","severity":"alta"},{"category":"identidad","claim":"Los eventos terminales no son versionados: una revisi├│n sobrescribe la anterior en _terminal. terminal_event(known_at=...) deja de reconstruir lo que se sab├¡a antes de la revisi├│n.","file":"src/twlab/master.py","id":"R01-07","severity":"alta"},{"category":"contrato","claim":"classify_coverage ignora mercado, tablero y tipo de instrumento al conceder elegibilidad. El bloqueo expl├¡cito de ESB del protocolo puede eludirse con historial suficiente y liquidity_ok=True.","file":"src/twlab/master.py","id":"R01-08","severity":"alta"},{"category":"contabilidad","claim":"exit_basket vende las acciones originales de entrada, sin ajustar la cantidad del puesto por acciones corporativas. Tambi├⌐n calcula gross_pick_return con precios nominales sin incorporar el split.","file":"src/twlab/simulation.py","id":"R01-09","severity":"alta"},{"category":"contabilidad","claim":"Una salida bloqueada deja de ser procesable por exit_basket, incluso despu├⌐s de reanudarse la negociaci├│n. Conservar la posici├│n es correcto; perder su mecanismo de resoluci├│n no lo es.","file":"src/twlab/simulation.py","id":"R01-10","severity":"alta"},{"category":"contabilidad","claim":"El identificador de una acci├│n corporativa se consume antes de validar y aplicar el evento. Un error impide reintentar la misma acci├│n corregida aunque nunca se haya contabilizado. Los dividendos en acciones no soportados deben bloquear la simulaci├│n afectada hasta disponer de tratamiento expl├¡cito; no deben omitirse para continuar la evaluaci├│n.","file":"src/twlab/ledger.py","id":"R01-11","severity":"alta"},{"category":"contabilidad","claim":"Los dividendos se asignan a las acciones presentes al llamar al m├⌐todo, sin comprobar propiedad en la fecha correspondiente ni orden temporal. CorporateAction tampoco separa derechos y pago, necesarios para conservar derechos tras una venta y evitar reutilizar anticipadamente efectivo.","file":"src/twlab/ledger.py","id":"R01-12","severity":"alta"},{"category":"contabilidad","claim":"La comisi├│n de venta usa el importe despu├⌐s del deslizamiento, pero el impuesto usa el importe previo. Si el deslizamiento modifica el precio ejecutado, como presupone la f├│rmula de comisi├│n, ambos deben partir del importe bruto realmente ejecutado antes de comisiones e impuestos.","file":"src/twlab/ledger.py","id":"R01-13","severity":"media"},{"category":"contabilidad","claim":"El efectivo se redondea sobre el total sin redondear, mientras Fill informa componentes redondeados individualmente. Sus importes no concilian y no se registra una diferencia de redondeo.","file":"src/twlab/ledger.py","id":"R01-14","severity":"media"},{"category":"contabilidad","claim":"Una venta parcial reduce shares pero mantiene ├¡ntegro cost_twd. La base de coste de la posici├│n restante queda inflada y no se registra la parte realizada.","file":"src/twlab/ledger.py","id":"R01-15","severity":"media"},{"category":"contabilidad","claim":"El libro no valida que los precios sean positivos antes de operar. Un precio negativo crea efectivo mediante una compra. Deben validarse tambi├⌐n finitud y dominios de cantidades, ratios y costes antes de modificar el estado.","file":"src/twlab/ledger.py","id":"R01-16","severity":"alta"},{"category":"contabilidad","claim":"Las ventas omiten la restricci├│n de lotes aplicada a las compras. Se ejecutan lotes menores con el mismo precio de la sesi├│n ordinaria, sin adaptador ni identificaci├│n de una simulaci├│n no ejecutable.","file":"src/twlab/ledger.py","id":"R01-17","severity":"alta"},{"category":"contrato","claim":"La validaci├│n no comprueba orden temporal, plazo de emisi├│n ni igualdad del corte con el paquete. Una predicci├│n posterior al horizonte sigue siendo selected y v├ílida. El esquema valida formatos de fecha, no esas relaciones; falta una barrera operativa antes de simular.","file":"src/twlab/schemas.py","id":"R01-18","severity":"bloqueante"},{"category":"contrato","claim":"No se exige unicidad de security_id ni de rank. Una selecci├│n repetida puede ocupar los cinco puestos y concentrar la cesta en un solo valor. maxItems=20 no es por s├¡ solo un error, pues la investigaci├│n contempla una variante de veinte emisores; falta vincular l├¡mites y selecci├│n al experimento registrado.","file":"src/twlab/schemas.py","id":"R01-19","severity":"alta"},{"category":"tiempo","claim":"prospectively_sealed equivale a dos cadenas no vac├¡as, sin verificar recibo, autoridad, hash ni instante acreditado. Incluso los registros con reloj injected pueden declararse sellados. El esquema de predicci├│n presenta el mismo problema al aceptar un identificador arbitrario.","file":"src/twlab/store.py","id":"R01-20","severity":"bloqueante"},{"category":"estadistica","claim":"evaluation.py proporciona primitivas, pero no implementa la m├⌐trica principal validada: IntervalReturn carece de exposici├│n, moneda, procedencia neta, semana y v├¡nculo a predicci├│n sellada. El bootstrap conserva bloques de posiciones del array solo si el llamante ya entreg├│ semanas ordenadas y emparejadas; no garantiza STA-01. Tampoco hay controles para contaminaci├│n de reserva, registro de ensayos, cobertura de semanas inv├ílidas, p├⌐rdidas absolutas, afirmaciones tras doce semanas o ventaja solo bruta de STA-02..STA-07.","file":"src/twlab/evaluation.py","id":"R01-21","severity":"alta"},{"category":"contrato","claim":"TXT-07 solo est├í cubierto sint├ícticamente: una cadena cualquiera como calibration_model_id permite presentar calibrated_probability sin comprobar existencia, entrenamiento pasado o validaci├│n del calibrador.","file":"src/twlab/schemas.py","id":"R01-22","severity":"media"},{"category":"contabilidad","claim":"La presencia de un precio en el mapping evita la rama que marca la suspensi├│n. valuation puede devolver una valoraci├│n sin ninguna bandera para una posici├│n suspendida; el mapping tampoco acredita la fecha del precio.","file":"src/twlab/ledger.py","id":"R01-23","severity":"media"},{"category":"datos","claim":"Un plazo legal de publicaci├│n no acredita disponibilidad del valor concreto ni de su revisi├│n. Clasificar ingresos hist├│ricos sin create_time como conservative_inference a partir del d├¡a 10/15 puede introducir publicaciones tard├¡as o cifras corregidas despu├⌐s. La presencia de hora en otros endpoints tampoco acredita por s├¡ sola que el cuerpo capturado sea la versi├│n original.","file":"docs/informes/02_auditoria_fuentes_entrega_A.md","id":"R01-24","severity":"alta"},{"category":"unidades","claim":"La comparaci├│n citada no verifica equivalencia entre fuentes: usa empresas y per├¡odos diferentes. Los tests de timeutil validan formatos temporales y el nuevo test_catalog verifica etiquetas de unidad declaradas, sin normalizar dos observaciones equivalentes. La afirmaci├│n de verificaci├│n excede esa evidencia.","file":"docs/informes/01_entendimiento_bloqueantes_y_plan.md","id":"R01-25","severity":"media"}],"response":"docs/informes/03_respuesta_ronda1_astra.md","round":1,"severity":{"alta":13,"bloqueante":6,"media":6},"summary":"Rechazado. La captura oficial contradice la interpretaci├│n del calendario: se eliminaron tres d├¡as de negociaci├│n, no tres festivos. Tambi├⌐n reproduje filtraci├│n temporal, alteraci├│n de paquetes sin cambiar su hash, evasi├│n del aislamiento, p├⌐rdida de historia del maestro y errores contables. Ejecut├⌐ el comando solicitado: fall├│ antes de recolectar pruebas porque el entorno de solo lectura impide crear temporales. La ejecuci├│n alternativa con captura desactivada termin├│ con 71 passed, 4 errors; los cuatro errores son de preparaci├│n de tmp_path en test_store.py, no fallos de sus aserciones. Al cierre hab├¡a 75 casos, incluido test_catalog.py, incorporado durante la revisi├│n. Ejecut├⌐ adem├ís 23 pruebas adversariales mediante un recolector de pytest en memoria: 23 failed, demostrando los contraejemplos detallados. No modifiqu├⌐ archivos. Las pruebas propuestas importan utilidades existentes de tests/ cuando corresponde.","tests_passing":23,"timestamp":"20260909T180407Z","verdict":"rechazado","verifications":[]},{"file":"review/out/ronda2_correcciones_20260909T182736Z.json","findings_new":21,"findings_total":37,"new_findings":[{"category":"tiempo","claim":"Verificaci├│n R01-02: parcial. Se rechazan published_at contradictorio y first_seen inventado, pero capture_id s├│lo selecciona un registro: no acredita que el documento proceda de esos bytes, fuente o versi├│n.","file":"src/twlab/packet.py","id":"R02-01","severity":"bloqueante"},{"category":"contrato","claim":"Verificaci├│n R01-04: parcial. La mutaci├│n del payload queda impedida, pero manifest colapsa doc_id repetidos y omite contenido efectivamente entregado.","file":"src/twlab/packet.py","id":"R02-02","severity":"bloqueante"},{"category":"identidad","claim":"Verificaci├│n R01-06: parcial. add comprueba solapes contra la vista m├ís reciente, pero permite introducirlos en consultas hist├│ricas.","file":"src/twlab/master.py","id":"R02-03","severity":"alta"},{"category":"contabilidad","claim":"Verificaci├│n R01-09: parcial. El split 2:1 pasa, pero la nueva restricci├│n de lotes convierte salidas parciales en rendimientos completos de selecci├│n.","file":"src/twlab/simulation.py","id":"R02-04","severity":"alta"},{"category":"contabilidad","claim":"Verificaci├│n R01-12: parcial. Se rechaza el dividendo anterior a la compra y se separan derechos cuando hay pay_at; si falta, se inventa un pago inmediato utilizable.","file":"src/twlab/ledger.py","id":"R02-05","severity":"alta"},{"category":"tiempo","claim":"Verificaci├│n R01-18: parcial. La prueba original pasa, pero el plazo sigue controlado por la propia predicci├│n y no por el calendario/protocolo. Tampoco se cumple el cutoff < issued_at anunciado.","file":"src/twlab/schemas.py","id":"R02-06","severity":"bloqueante"},{"category":"tiempo","claim":"Verificaci├│n R01-20: parcial. Se rechazan capturas injected, pero status='verified' sigue siendo una declaraci├│n fabricable. schemas.py acepta recibos arbitrarios y evidencia incompatible; evaluation.py permite evaluar prospectivas sin sello por defecto.","file":"src/twlab/store.py","id":"R02-07","severity":"bloqueante"},{"category":"estadistica","claim":"Verificaci├│n R01-21: parcial. Se rechazan exposiciones distintas y cadenas semanales duplicadas, pero no se valida la unidad semanal y se comprimen los huecos antes del bootstrap. STA-02/03/05/06/07 permanecen pendientes, como reconoce el informe.","file":"src/twlab/evaluation.py","id":"R02-08","severity":"alta"},{"category":"contrato","claim":"Verificaci├│n R01-22: parcial. La lista permitida rechaza identificadores desconocidos, pero no constituye el registro de calibradores evaluados y temporalmente admisibles que afirma el informe.","file":"src/twlab/schemas.py","id":"R02-09","severity":"media"},{"category":"contrato","claim":"La combinaci├│n de congelaci├│n y enlace prospectivo introduce una regresi├│n: replace vuelve a copiar un payload que contiene MappingProxyType y falla.","file":"src/twlab/packet.py","id":"R02-10","severity":"alta"},{"category":"datos","claim":"El cambio de esquema de recibos rompe la lectura del archivo real existente. Los informes 02 ┬º6 y 03 ┬º3.6 afirman que RawStore.verify() verifica unos manifiestos incompatibles con CaptureRecord.","file":"src/twlab/store.py","id":"R02-11","severity":"alta"},{"category":"identidad","claim":"change_segment no es at├│mico, contradiciendo expresamente el informe 03: cierra el segmento anterior antes de validar el nuevo.","file":"src/twlab/master.py","id":"R02-12","severity":"alta"},{"category":"contabilidad","claim":"Los contrasplits redondean el incremento negativo hacia cero y descartan su fracci├│n negativa, creando acciones.","file":"src/twlab/ledger.py","id":"R02-13","severity":"alta"},{"category":"contabilidad","claim":"Vender todas las acciones enteras retira de las posiciones activas los derechos fraccionarios todav├¡a pendientes y elimina sus banderas de valoraci├│n.","file":"src/twlab/ledger.py","id":"R02-14","severity":"alta"},{"category":"tiempo","claim":"valuation modifica last_price sin comprobar ni avanzar el reloj del libro; permite introducir un precio futuro en una valoraci├│n pasada.","file":"src/twlab/ledger.py","id":"R02-15","severity":"bloqueante"},{"category":"contabilidad","claim":"Los cobros vencidos se registran por orden de declaraci├│n, no por fecha de pago, rompiendo el orden cronol├│gico prometido del diario.","file":"src/twlab/ledger.py","id":"R02-16","severity":"media"},{"category":"contabilidad","claim":"Los pagos s├│lo se procesan al ejecutar otra operaci├│n o cambio de estado. Una valoraci├│n posterior al vencimiento conserva el efectivo como pendiente; no existe una operaci├│n p├║blica espec├¡fica para avanzar pagos.","file":"src/twlab/ledger.py","id":"R02-17","severity":"media"},{"category":"tiempo","claim":"CalendarStore almacena y devuelve referencias a calendarios mutables: una edici├│n modifica retrospectivamente la versi├│n conocida sin anexar revisi├│n.","file":"src/twlab/calendar.py","id":"R02-18","severity":"alta"},{"category":"tiempo","claim":"El clasificador acepta como inequ├¡vocos textos contradictorios o con negaci├│n. La pol├¡tica de detener filas desconocidas no protege esos casos.","file":"src/twlab/calendar.py","id":"R02-19","severity":"alta"},{"category":"contrato","claim":"El validador contin├║a las comprobaciones sem├ínticas sobre campos cuyo tipo ya rechaz├│ JSON Schema y lanza excepciones en lugar de devolver problemas.","file":"src/twlab/schemas.py","id":"R02-20","severity":"media"},{"category":"especificacion","claim":"Los informes no reflejan de forma consistente el alcance comprobado ni todas las posiciones finales declaradas.","file":"docs/informes/03_respuesta_ronda1_astra.md","id":"R02-21","severity":"media"}],"response":"docs/informes/04_respuesta_ronda2_astra.md","round":2,"severity":{"alta":11,"bloqueante":5,"media":5},"summary":"Rechazado. Pasan las 111 pruebas del constructor y 17 contraejemplos originales ejecutados sin modificaciones. La bater├¡a adicional contiene 25 pruebas fallidas y 2 comprobaciones satisfactorias, conservadas en review/out/astra_scratch/. R01-02/04/06/09/12/18/20/21/22 quedan parcialmente corregidos y se desarrollan, respectivamente, en R02-01..09; los restantes tienen entrada de verificaci├│n. R01-24/25 se cierran ├║nicamente como rectificaciones documentales, sin certificar adaptadores pendientes. Los 37 crudos coinciden con sus hashes, pero RawStore no puede leer su manifiesto. Los 48 archivos legibles del manifiesto inicial permanecen id├⌐nticos; .pytest_cache/README.md no permiti├│ lectura.","tests_passing":111,"timestamp":"20260909T182736Z","verdict":"rechazado","verifications":[{"claim":"Corregido el contraejemplo original: las pruebas conservan los tres d├¡as de negociaci├│n y verifican 243 sesiones.","id":"R01-01","severity":"baja","state":"reproducido"},{"claim":"Corregido: las comparaciones UTC rechazan el documento posterior durante el cambio de horario.","id":"R01-03","severity":"baja","state":"reproducido"},{"claim":"Corregido el acceso mediante el objeto: PredictorView no recibe resultados ni permite cambiar role; esto no certifica permisos de procesos todav├¡a inexistentes.","id":"R01-05","severity":"baja","state":"reproducido"},{"claim":"Corregido: los eventos terminales conservan ambas versiones y responden seg├║n known_at.","id":"R01-07","severity":"baja","state":"reproducido"},{"claim":"Corregido: ESB y los instrumentos distintos de acciones ordinarias quedan fuera de elegibilidad.","id":"R01-08","severity":"baja","state":"reproducido"},{"claim":"Corregido: exit_blocked vuelve a procesarse despu├⌐s de la reanudaci├│n.","id":"R01-10","severity":"baja","state":"reproducido"},{"claim":"Corregido el contraejemplo original: la validaci├│n del dividendo precede al consumo del identificador.","id":"R01-11","severity":"baja","state":"reproducido"},{"claim":"Corregido: impuesto y comisi├│n utilizan el importe ejecutado.","id":"R01-13","severity":"baja","state":"reproducido"},{"claim":"Corregido: los componentes redondeados concilian exactamente con efectivo; el cambio floor/half_up est├í documentado.","id":"R01-14","severity":"baja","state":"reproducido"},{"claim":"Corregido: la venta parcial reduce proporcionalmente la base y registra el resultado realizado.","id":"R01-15","severity":"baja","state":"reproducido"},{"claim":"Corregido el contraejemplo original: precios negativos o NaN y cantidades inv├ílidas se rechazan antes de modificar la compra.","id":"R01-16","severity":"baja","state":"reproducido"},{"claim":"Corregido: las ventas ordinarias tambi├⌐n exigen m├║ltiplos del lote.","id":"R01-17","severity":"baja","state":"reproducido"},{"claim":"Corregido: valores y rangos duplicados se rechazan; enter_basket tambi├⌐n rechaza picks repetidos.","id":"R01-19","severity":"baja","state":"reproducido"},{"claim":"Corregido: una posici├│n suspendida conserva su bandera aunque se suministre precio.","id":"R01-23","severity":"baja","state":"reproducido"},{"claim":"Corregida la pol├¡tica documental: el plazo legal no acredita publicaci├│n; la exclusi├│n gen├⌐rica de versiones unknown pasa, pero el adaptador sigue pendiente.","id":"R01-24","severity":"baja","state":"reproducido"},{"claim":"Corregida la afirmaci├│n documental: se retira la equivalencia entre observaciones no emparejadas; la normalizaci├│n entre proveedores sigue sin prueba.","id":"R01-25","severity":"baja","state":"reproducido"}]},{"file":"review/out/ronda3_verificacion_20260909T184924Z.json","findings_new":17,"findings_total":38,"new_findings":[{"category":"datos","claim":"La igualdad de fuente y hash declarado no vincula el contenido documental a los bytes; verified_version sigue admiti├⌐ndose sin extractor ni derivation.","file":"src/twlab/packet.py","id":"R03-01","severity":"bloqueante"},{"category":"tiempo","claim":"El plazo sigue siendo libre: trasladarlo al paquete no lo deriva del protocolo. Omitir el paquete tambi├⌐n omite la comprobaci├│n.","file":"src/twlab/packet.py","id":"R03-02","severity":"bloqueante"},{"category":"tiempo","claim":"weekly_deadline busca cualquier sesi├│n posterior y convierte una semana sin sesiones en una previsi├│n para la siguiente.","file":"src/twlab/schemas.py","id":"R03-03","severity":"alta"},{"category":"seguridad","claim":"Un recibo del archivo puede acreditar cualquier predicci├│n: sealed_receipts pierde el digest, la captura y su relaci├│n con el paquete.","file":"src/twlab/schemas.py","id":"R03-04","severity":"bloqueante"},{"category":"datos","claim":"is_sealed no comprueba la integridad de los bytes archivados antes de declarar completo el sello.","file":"src/twlab/store.py","id":"R03-05","severity":"alta"},{"category":"tiempo","claim":"not_after limita el instante acreditado, pero no acredita que el registro prospectivo se archivara antes del plazo.","file":"src/twlab/store.py","id":"R03-06","severity":"alta"},{"category":"identidad","claim":"Comprobar s├│lo la vista actual y la fecha de registro nueva permite solapes en estados hist├│ricos intermedios.","file":"src/twlab/master.py","id":"R03-07","severity":"alta"},{"category":"tiempo","claim":"set_payment_date registra informaci├│n nueva con la fecha antigua de declaraci├│n y rompe el orden del diario.","file":"src/twlab/ledger.py","id":"R03-08","severity":"alta"},{"category":"tiempo","claim":"valuation acepta fechas anteriores al estado del libro y devuelve efectivo y posiciones posteriores con una etiqueta temporal pasada.","file":"src/twlab/ledger.py","id":"R03-09","severity":"alta"},{"category":"contabilidad","claim":"La cantidad residual se atribuye ├¡ntegramente a la entrada del puesto actual, incluyendo acciones conservadas de semanas anteriores.","file":"src/twlab/simulation.py","id":"R03-10","severity":"alta"},{"category":"tiempo","claim":"Los horarios aceptados como listas conservan alias mutables; bloquear __setattr__ no congela sus elementos.","file":"src/twlab/calendar.py","id":"R03-11","severity":"media"},{"category":"tiempo","claim":"La detecci├│n de negaciones sigue incompleta: una cancelaci├│n de festivo se convierte en cierre efectivo.","file":"src/twlab/calendar.py","id":"R03-12","severity":"alta"},{"category":"contrato","claim":"El validador contin├║a usando campos inv├ílidos en operaciones que requieren hash, pese a haber detectado su tipo incorrecto.","file":"src/twlab/schemas.py","id":"R03-13","severity":"media"},{"category":"estadistica","claim":"El bootstrap acepta rendimientos no finitos como observaciones v├ílidas y produce medias e intervalos NaN o infinitos.","file":"src/twlab/evaluation.py","id":"R03-14","severity":"media"},{"category":"contabilidad","claim":"Un dividendo pagadero en el instante de su aplicaci├│n queda sin abonar porque _touch liquida antes de a├▒adir el cobro.","file":"src/twlab/ledger.py","id":"R03-15","severity":"media"},{"category":"identidad","claim":"change_segment prolonga un segmento ya cerrado hasta la nueva apertura y resucita cotizaci├│n durante el intervalo sin vigencia.","file":"src/twlab/master.py","id":"R03-16","severity":"alta"},{"category":"estadistica","claim":"CalibratorRecord no valida sus campos y la comprobaci├│n fuera de muestra usa veracidad gen├⌐rica en lugar de un booleano v├ílido.","file":"src/twlab/schemas.py","id":"R03-17","severity":"media"}],"response":"docs/informes/05_respuesta_ronda3_astra.md","round":3,"severity":{"alta":9,"bloqueante":3,"media":5},"summary":"Rechazado. Pasan las 135 pruebas del constructor y los 27 casos reutilizados en test_ronda2_adaptada_r3.py. Las adaptaciones conservan los valores originales y admiten el rechazo expl├¡cito como correcci├│n. La bater├¡a test_ronda3.py reproduce 19 fallos, agrupados en R03-01..17. Se incluyen las 21 verificaciones solicitadas; ┬½reproducido┬╗ en una verificaci├│n cerrada significa que ejecut├⌐ y confirm├⌐ la correcci├│n. Los informes todav├¡a exageran algunas garant├¡as. S├│lo escrib├¡ bajo review/out/astra_scratch/.","tests_passing":135,"timestamp":"20260909T184924Z","verdict":"rechazado","verifications":[{"claim":"Parcial: la prueba nombrada conserva y rechaza la captura de otra fuente; una captura de la misma fuente todav├¡a acredita contenido inventado, R03-01.","id":"R02-01","severity":"bloqueante","state":"reproducido"},{"claim":"Corregido: la prueba nombrada conserva los documentos same con valores 1 y 999 y exige rechazo por identificador duplicado.","id":"R02-02","severity":"baja","state":"reproducido"},{"claim":"Parcial: la prueba nombrada conserva y rechaza la apertura registrada antes del cierre; faltan vistas hist├│ricas intermedias, R03-07.","id":"R02-03","severity":"alta","state":"reproducido"},{"claim":"Parcial: la prueba nombrada conserva el split 1,1 y obtiene retorno cero; el residuo contamina la selecci├│n de la semana siguiente, R03-10.","id":"R02-04","severity":"alta","state":"reproducido"},{"claim":"Corregido el contraejemplo original: la prueba nombrada y la reutilizada mantienen no disponible el dividendo sin pay_at.","id":"R02-05","severity":"baja","state":"reproducido"},{"claim":"Parcial: las pruebas nombradas rechazan issued_at igual al corte y el plazo distinto del paquete; no demuestran que el plazo del paquete proceda del protocolo, R03-02/03.","id":"R02-06","severity":"bloqueante","state":"reproducido"},{"claim":"Parcial: se rechazan el recibo declarativamente verified y sealed=False; la prueba nombrada tambi├⌐n exige aceptar un recibo inventado si el llamante lo incluye en un frozenset. Falta acreditar la predicci├│n concreta, R03-04..06.","id":"R02-07","severity":"bloqueante","state":"reproducido"},{"claim":"Corregido: la prueba nombrada conserva las filas diarias y el hueco W30/W31 inv├ílida/W32; ambos se rechazan para el uso indebido original.","id":"R02-08","severity":"baja","state":"reproducido"},{"claim":"Corregido el contraejemplo original: la prueba nombrada rechaza conjuntos sin metadatos, entrenamiento en 2027 y evaluated_out_of_sample=False; queda la validaci├│n de tipos del registro, R03-17.","id":"R02-09","severity":"baja","state":"reproducido"},{"claim":"Corregido: la prueba nombrada conserva el payload anidado y a├▒ade listas; el original adaptado con source_sha256 tambi├⌐n pasa con reloj real.","id":"R02-10","severity":"baja","state":"reproducido"},{"claim":"Corregido: pasan las tres pruebas nombradas y la lectura independiente reutilizada del archivo real.","id":"R02-11","severity":"baja","state":"reproducido"},{"claim":"Corregida la atomicidad del contraejemplo original: la prueba nombrada y la reutilizada dejan intactas las versiones cuando la fila nueva es inv├ílida.","id":"R02-12","severity":"baja","state":"reproducido"},{"claim":"Corregido: la prueba nombrada conserva el contrasplit extremo original y comprueba tambi├⌐n precio y valoraci├│n.","id":"R02-13","severity":"baja","state":"reproducido"},{"claim":"Corregido: la prueba nombrada conserva la venta de todas las enteras y exige mantener posici├│n, fracci├│n y bandera.","id":"R02-14","severity":"baja","state":"reproducido"},{"claim":"Corregida la mutaci├│n original: la prueba nombrada conserva el precio futuro 999 y comprueba que ni last_price ni el reloj cambian.","id":"R02-15","severity":"baja","state":"reproducido"},{"claim":"Corregido el orden de liquidaci├│n original: la prueba nombrada conserva declaraciones y vencimientos invertidos y exige diario cronol├│gico.","id":"R02-16","severity":"baja","state":"reproducido"},{"claim":"Corregido el caso original: la prueba nombrada conserva el pago sin negociaci├│n y distingue valoraci├│n pura de abono mediante advance_to.","id":"R02-17","severity":"baja","state":"reproducido"},{"claim":"Parcial: la prueba nombrada conserva y bloquea c.OPEN=time(12), pero s├│lo comprueba asignaciones de atributos; quedan alias mutables en horarios aceptados, R03-11.","id":"R02-18","severity":"media","state":"reproducido"},{"claim":"Parcial: las pruebas nombradas conservan las dos frases originales; la lista limitada de negaciones sigue clasificando cancelaciones como cierres, R03-12.","id":"R02-19","severity":"alta","state":"reproducido"},{"claim":"Parcial: la prueba nombrada conserva security_id=[] y devuelve problemas; el mismo error de tipo sobre experiment_id todav├¡a interrumpe el validador, R03-13.","id":"R02-20","severity":"media","state":"reproducido"},{"claim":"Parcial: A2/A6 est├ín rectificados y existen pruebas de una/dos sesiones y pagos sin negociaci├│n. Persisten afirmaciones que exceden el c├│digo y las pruebas.","id":"R02-21","severity":"media","state":"reproducido"}]},{"file":"review/out/ronda4_verificacion_20260909T190848Z.json","findings_new":14,"findings_total":31,"new_findings":[{"category":"seguridad","claim":"El bloqueo prospectivo depende de booleanos suministrados por el llamante. SealInfo.production=True basta para validar un sello fabricado; evaluation.py:118 permite evaluar mediante WeeklyObservation.sealed=True sin registro verificable. Contradice el informe 05:33 y las garant├¡as de 01:121, 03 ┬º3.5 y 04:19.","file":"src/twlab/schemas.py","id":"R04-01","severity":"bloqueante"},{"category":"contrato","claim":"Comparar raw_response_hash con seal.digest no vincula el objeto validado con la respuesta archivada. Ranking, forecast_id y dem├ís campos pueden cambiar sin invalidar el sello.","file":"src/twlab/schemas.py","id":"R04-02","severity":"bloqueante"},{"category":"contrato","claim":"El v├¡nculo al paquete reside en capture_extra, un diccionario mutable que no forma parte de los bytes cuyo digest acredita el recibo. Puede