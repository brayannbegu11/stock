+import copy
+import hashlib
+import json
+import subprocess
+from dataclasses import replace
+from datetime import date, datetime, timezone
+from decimal import Decimal as D
+from pathlib import Path
+
+import pytest
+from review.out.astra_scratch import test_r21 as prev
+from review.out.astra_scratch.test_r23 import setup
+from review.out.astra_scratch.test_r25 import rewrite_manifest
+from review.out.astra_scratch.test_r27 import source_id, mature_failed_fixture
+from review.out.astra_scratch.r10_support import fixture
+from twlab.store import RawStore, CaptureRecord, safe_relative_path
+from twlab.models.q1 import DividendLike
+
+
+@pytest.mark.parametrize('reset', [False, True])
+def test_nested_pin_preserves_outer_generation(tmp_path, monkeypatch, reset):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    src = source_id(raw, w)
+    fid = w['forecasters']['Q0']['forecast_capture_id']
+    rewrite_manifest(raw, lambda rows: [r.update(clock_source='injected') for r in rows if r['capture_id'] == src])
+    assert not ex.classify_week('lab', w)['prospective']
+    original = ex.forecast_archive
+    def interleave(*args, **kwargs):
+        result = original(*args, **kwargs)
+        # A nested classification must restore, not release, the caller's pin.
+        ex.classify_week('lab', {'status': 'invalid:archive'})
+        def mutate(rows):
+            for r in rows:
+                if r['capture_id'] == src: r['clock_source'] = 'system'
+                if r['capture_id'] == fid: r['clock_source'] = 'injected'
+        rewrite_manifest(raw, mutate)
+        if reset: ex._MANIFEST = None
+        return result
+    monkeypatch.setattr(ex, 'forecast_archive', interleave)
+    mixed = ex.classify_week('lab', w)
+    monkeypatch.setattr(ex, 'forecast_archive', original)
+    assert not ex.classify_week('lab', w)['prospective']
+    assert not mixed['prospective'], mixed['reasons']
+
+
+@pytest.mark.parametrize('stage', ['forecast_archive', 'master_identity', 'inputs_before_cutoff'])
+def test_stage_exception_releases_pin(tmp_path, monkeypatch, stage):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    original = getattr(ex, stage)
+    def fail(*a, **kw): raise RuntimeError('stage failure')
+    monkeypatch.setattr(ex, stage, fail)
+    assert not ex.classify_week('lab', w)['prospective']
+    assert ex._PIN is None
+    monkeypatch.setattr(ex, stage, original)
+    assert ex.classify_week('lab', w)['prospective']
+
+
+def test_manifest_none_during_classification(tmp_path, monkeypatch):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    original = ex.forecast_archive
+    def reset(*a, **kw):
+        result = original(*a, **kw)
+        ex._MANIFEST = None
+        rewrite_manifest(raw, lambda rows: [r.update(clock_source='injected') for r in rows])
+        return result
+    monkeypatch.setattr(ex, 'forecast_archive', reset)
+    assert ex.classify_week('lab', w)['prospective']
+    monkeypatch.setattr(ex, 'forecast_archive', original)
+    assert not ex.classify_week('lab', w)['prospective']
+
+
+@pytest.mark.parametrize('kind', ['directory', 'nested_json', 'none_week', 'list_week'])
+def test_classify_no_exception(tmp_path, monkeypatch, kind):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    mf = raw.root / 'manifest.jsonl'
+    if kind == 'directory':
+        mf.unlink()
+        mf.mkdir()
+    elif kind == 'nested_json': mf.write_text('[' * 2000 + '0' + ']' * 2000, encoding='utf8')
+    elif kind == 'none_week': w = None
+    else: w = []
+    result = ex.classify_week('lab', w)
+    assert result['prospective'] is False
+
+
+@pytest.mark.parametrize('field,value', [('calendar', None), ('by_session', None), ('securities', None), ('master_rows', [None])])
+def test_runner_malformed_market_no_escape(tmp_path, monkeypatch, field, value):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    if field == 'master_rows': market.master._versions = value
+    else: setattr(market, field, value)
+    runner.run_week(date(2024, 1, 7))
+    assert runner.weeks[-1]['status'] == 'invalid:archive'
+
+
+@pytest.mark.parametrize('kind', ['nested_json', 'invalid_utf8'])
+def test_runner_bad_manifest_no_escape(tmp_path, monkeypatch, kind):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    (raw.root / 'manifest.jsonl').write_bytes(b'\xff' if kind == 'invalid_utf8' else b'[' * 2000 + b'0' + b']' * 2000)
+    runner.run_week(date(2024, 1, 7))
+    assert runner.weeks[-1]['status'] == 'invalid:archive'
+
+
+@pytest.mark.parametrize('value', [None, [], {'cutoff_at': []}])
+def test_runner_bad_prediction_no_escape(tmp_path, monkeypatch, value):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    monkeypatch.setattr(runner, 'make_forecast', lambda *a, **kw: value)
+    runner.run_week(date(2024, 1, 7))
+    assert runner.weeks[-1]['status'] == 'invalid:archive' or all(x['forecast_status'] == 'invalid' for x in runner.weeks[-1]['forecasters'].values())
+
+
+@pytest.mark.parametrize('target', ['source', 'packet', 'master', 'forecast'])
+@pytest.mark.parametrize('kind', ['unicode', 'case', 'dot', 'mixed'])
+def test_safe_path_legitimate_variants(tmp_path, monkeypatch, target, kind):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    cid = {'source':source_id(raw,w), 'packet':w['packet_capture'], 'master':w['master_capture'], 'forecast':w['forecasters']['Q0']['forecast_capture_id']}[target]
+    rec = raw.get(cid)
+    path = {'unicode':'Φ│çµûÖ/Φç║τüú-├⌐.bin', 'case': rec.path.upper(), 'dot':'./'+rec.path, 'mixed':rec.path.replace('/', '\\', 1)}[kind]
+    if kind == 'unicode':
+        p = raw.root / path
+        p.parent.mkdir()
+        p.write_bytes(raw.read(rec))
+    rewrite_manifest(raw, lambda rows:[r.update(path=path) for r in rows if r['capture_id']==cid])
+    assert raw.read(raw.get(cid))
+    assert ex.classify_week('lab',w)['prospective']
+
+
+def test_real_manifest_compatible():
+    p = Path('data/raw/manifest.jsonl')
+    count = 0
+    for line in p.read_text(encoding='utf8').splitlines():
+        if line.strip():
+            CaptureRecord.from_manifest_line(json.loads(line))
+            count += 1
+    print('REAL_MANIFEST_ROWS', count)
+    assert count > 0
+
+
+@pytest.mark.parametrize('right', ['none', 'cash', 'ambiguous'])
+@pytest.mark.parametrize('blocked', [False, True])
+def test_carry_matches_valid_empty_week(tmp_path, monkeypatch, right, blocked):
+    raw, market = fixture(tmp_path, prices=lambda d: D(110) if d >= date(2024,1,15) else D(100))
+    sid = market.by_symbol['A']
+    days = [date(2024,1,12)] + ([date(2024,1,19)] if blocked else [])
+    market.securities[sid].bars = [b for b in market.securities[sid].bars if b.session not in days]
+    for day in days: del market.by_session[sid][day]
+    if right != 'none':
+        market.securities[sid].events = [DividendLike('r28-div',date(2024,1,17),'cash',cash_per_share=D(10),pay_date=date(2024,1,18),ambiguous=right=='ambiguous')]
+    cfg = prev.BacktestConfig(date(2024,1,1),date(2024,1,26),slots=1,notional=10000,lot_size=1,commission_per_side=D(0),sell_tax=D(0),slippage_bps=0,label='lab',n_boot=20)
+    runners = [prev.Runner(raw,market,cfg,[prev.MomentumForecaster(),prev.RandomForecaster(1)]) for _ in range(2)]
+    for r in runners: r.run_week(date(2024,1,7))
+    original = raw.find
+    def fail(**kw):
+        if kw['source_id']=='packet' and kw['dataset'].endswith('2024-W03'): raise OSError('r28 failure')
+        return original(**kw)
+    monkeypatch.setattr(raw,'find',fail)
+    runners[0].run_week(date(2024,1,14))
+    monkeypatch.setattr(raw,'find',original)
+    for r in runners:
+        for f in r.forecasters.values(): monkeypatch.setattr(f,'forecast',lambda *a,**kw:([],{}))
+    runners[1].run_week(date(2024,1,14))
+    for week in [None, date(2024,1,21)]:
+        if week:
+            for r in runners: r.run_week(week)
+        a,b=runners
+        assert a.cursor==b.cursor
+        assert a.prev_equity==b.prev_equity
+        assert a.open_slots==b.open_slots
+        assert a.ambiguous_claims==b.ambiguous_claims
+        for name in a.ledgers:
+            assert vars(a.ledgers[name])==vars(b.ledgers[name])
+            assert a.weeks[-1]['forecasters'][name]['equity_end']==b.weeks[-1]['forecasters'][name]['equity_end']
+
+
+def history_failed_fixture(tmp_path,monkeypatch, multiple=True, pending=False):
+    raw,market,cfg,old,_,now=prev.sunday_fixture(tmp_path,monkeypatch)
+    cfg=replace(cfg,start=date(2023,12,10),end=date(2024,1,21) if pending else date(2024,1,20))
+    runner=prev.Runner(raw,market,cfg,list(old.forecasters.values()))
+    original=raw.find
+    failed={'2023-W52','2024-W02'} if multiple else {'2024-W02'}
+    def fail(**kw):
+        if kw['source_id']=='packet' and kw['dataset'].split('/')[-1] in failed:
+            raise OSError('ARCHIVE-FAIL-'+kw['dataset'].split('/')[-1])
+        return original(**kw)
+    monkeypatch.setattr(raw,'find',fail)
+    data=runner.run()
+    assert data['weeks'][-1]['status']=='valid'
+    return raw, market, data
+
+
+@pytest.mark.parametrize('header',['header_15','header_15b','header_15c'])
+@pytest.mark.parametrize('pending',[False,True])
+def test_headers_keep_all_historical_failure_reasons(tmp_path,monkeypatch,header,pending):
+    raw,market,data=history_failed_fixture(tmp_path,monkeypatch,pending=pending)
+    asm=prev.load('assemble_backtest_reports')
+    fn=getattr(asm,header)
+    text=fn(data) if header=='header_15' else fn(data,data)
+    for week in ['2023-W52','2024-W02']:
+        assert 'ARCHIVE-FAIL-'+week in text, text[-1700:]
+
+
+def test_current_week_not_stuck_on_historical_failure(tmp_path,monkeypatch):
+    raw,market,data=history_failed_fixture(tmp_path,monkeypatch)
+    asm=prev.load('assemble_backtest_reports')
+    ex=prev.export_setup(monkeypatch,raw,data,tmp_path)
