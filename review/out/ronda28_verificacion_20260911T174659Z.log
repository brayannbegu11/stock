@pytest.mark.parametrize('body',[{}, {'admitted':[]},{'admitted':[{'kind':'price_bar_series'}]}, {'admitted':[],'rejected':[{'capture_id':'late'}]}])
def test_no_admitted_capture_fails_closed(tmp_path,monkeypatch,body):
