      "prueba_propuesta": "def test_receipt_binds_prediction(tmp_path):\n    from datetime import timedelta\n    from tests.test_schema import base\n    from twlab.packet import build_packet\n    from twlab.store import RawStore\n    from twlab.schemas import validate_prediction\n    s = RawStore(tmp_path)\n    r = s.put(source_id='test', dataset='weather', payload=b'weather:rain=0', url='u')\n    s.register_verifier('fixture', lambda rec, receipt: receipt.digest == r.sha256 and receipt.attested_at == r.ingested_at)\n    s.attach_receipt(r.capture_id, receipt_id='fixture:r', authority='fixture', digest=r.sha256, attested_at=r.ingested_at)\n    cut = r.ingested_at_dt + timedelta(seconds=1)\n    end = cut + timedelta(hours=1)\n    p = build_packet(packet_id='pkt-1', cutoff_at=cut, deadline_at=end, documents=[], mode='prospective', evidence_class='prospective_registered', captures={})\n    o = base(evidence_class='prospective_registered', cutoff_at=cut.isoformat(), issued_at=(cut+timedelta(seconds=1)).isoformat(), deadline_at=end.isoformat(), independent_timestamp_receipt_id='fixture:r')\n    o['ranking'][0]['document_ids'] = []\n    assert validate_prediction(o, p, sealed_receipts=s.sealed_receipt_ids(not_after=end))\n",
