+import sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
+
+from datetime import date, datetime, time, timedelta
+from decimal import Decimal as D
+import math
+import pytest
+from tests.test_ledger import MON, FRI, FREE, ledger
+from tests.test_master import R, sv
+from tests.test_packet import doc
+from tests.test_schema import base, packet
+from twlab.packet import build_packet
+from twlab.store import RawStore, IntegrityError
+from twlab.ledger import CorporateAction, LedgerError
+from twlab.master import SecurityMaster, OverlappingSegment
+from twlab.calendar import TradingCalendar, CalendarStore, classify_holiday_row, ROW_UNKNOWN
+from twlab.schemas import validate_prediction, weekly_deadline, CalibratorRecord
+from twlab.simulation import enter_basket, exit_basket
+from twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError
+from twlab.timeutil import AvailabilityQuality as Q, UTC
+
+
+def bought():
+    lg = ledger(costs=FREE)
+    lg.buy(security_id='A', price=D(100), shares=1000, at=MON, event_id='b')
+    return lg
+
+
+def test_same_source_hash_does_not_attest_fabricated_version(tmp_path):
+    store = RawStore(tmp_path)
+    rec = store.put(source_id='test', dataset='revenue', payload=b'{"revenue":100}', url='u')
+    d = doc('revenue-v2', rec.ingested_at_dt, capture=rec, quality=Q.VERIFIED_VERSION,
+            version=2, payload={'revenue': 999})
+    p = build_packet(packet_id='p', cutoff_at=rec.ingested_at_dt, documents=[d],
+                     mode='prospective', evidence_class='prospective_registered',
+                     captures={rec.capture_id: rec})
+    assert not p.admitted, 'bytes say 100; admitted verified_version says 999, derivation=None'
+
+
+@pytest.mark.parametrize('provide_packet', [True, False])
+def test_deadline_must_be_derived_not_merely_copied(provide_packet):
+    late = datetime.fromisoformat('2026-09-13T08:30:00+08:00')
+    p = packet(deadline_at=late) if provide_packet else None
+    o = base(issued_at='2026-09-12T10:00:00+08:00', deadline_at=late.isoformat())
+    assert validate_prediction(o, p), 'selected after Friday close accepted'
+
+
+def test_no_session_week_must_not_borrow_next_week_deadline():
+    closures = [date(2026, 9, d) for d in range(7, 12)]
+    cal = TradingCalendar(start=date(2026, 1, 1), end=date(2026, 12, 31), closures=closures,
+                          recorded_at=R(2026, 1, 1), source_id='synthetic')
+    cutoff = datetime.fromisoformat('2026-09-06T18:00:00+08:00')
+    try:
+        deadline = weekly_deadline(cutoff, cal)
+    except ValueError:
+        return
+    assert deadline is None, f'empty week received deadline {deadline}'
+
+
+def signed_fixture(store, *, payload=b'weather:rain=0', attested=None):
+    # A deterministic test authority: validates exactly one digest/time pair.
+    # It is deliberately NOT a cryptographic verifier or real prospective evidence.
+    rec = store.put(source_id='test', dataset='fixture', payload=payload, url='u')
+    stamp = attested or rec.ingested_at
+    store.register_verifier('fixture', lambda r, receipt:
+                            receipt.digest == rec.sha256 and receipt.attested_at == stamp)
+    return store.attach_receipt(rec.capture_id, receipt_id='fixture:receipt', authority='fixture',
+                                digest=rec.sha256, attested_at=stamp)
+
+
+def test_receipt_for_unrelated_bytes_cannot_seal_prediction(tmp_path):
+    store = RawStore(tmp_path)
+    rec = signed_fixture(store)
+    cutoff = rec.ingested_at_dt + timedelta(seconds=1)
+    deadline = cutoff + timedelta(hours=1)
+    p = build_packet(packet_id='pkt-1', cutoff_at=cutoff, deadline_at=deadline, documents=[],
+                     mode='prospective', evidence_class='prospective_registered', captures={})
+    o = base(evidence_class='prospective_registered', cutoff_at=cutoff.isoformat(),
+             issued_at=(cutoff + timedelta(seconds=1)).isoformat(), deadline_at=deadline.isoformat(),
+             independent_timestamp_receipt_id='fixture:receipt')
+    o['ranking'][0]['document_ids'] = []
+    ids = store.sealed_receipt_ids(not_after=deadline)
+    assert ids == frozenset({'fixture:receipt'})
+    assert validate_prediction(o, p, sealed_receipts=ids), 'receipt signs weather, not forecast'
+
+
+def test_is_sealed_rejects_corrupted_archived_bytes(tmp_path):
+    store = RawStore(tmp_path)
+    rec = signed_fixture(store)
+    (tmp_path / rec.path).write_bytes(b'CHANGED')
+    with pytest.raises(IntegrityError):
+        store.read(rec)
+    assert not store.is_sealed(rec), 'archive fails integrity but remains sealed'
+
+
+def test_not_after_checks_late_capture_even_with_older_receipt(tmp_path):
+    store = RawStore(tmp_path)
+    old = datetime(2020, 1, 1, tzinfo=UTC)
+    rec = signed_fixture(store, attested=old.isoformat())
+    assert rec.ingested_at_dt > old + timedelta(days=1)
+    assert not store.is_sealed(rec, not_after=old + timedelta(days=1)), 'late archived capture passes historical deadline'
+
+
+def test_master_checks_intermediate_historical_views():
+    m = SecurityMaster()
+    for recorded, end in [(2020, 2021), (2022, 2023), (2024, 2021)]:
+        m.add(sv(security_id='A', symbol='1111', valid_from=date(2020, 1, 1),
+                 valid_to=date(end, 1, 1), recorded_at=R(recorded, 1, 1)))
+    try:
+        m.add(sv(security_id='A', symbol='2222', valid_from=date(2021, 1, 1), recorded_at=R(2021, 1, 1)))
+    except OverlappingSegment:
+        return
+    rows = m._effective(R(2022, 6, 1))
+    assert sum(v.covers(date(2022, 7, 1)) for v in rows) <= 1, rows
+
+
+def test_setting_payment_date_does_not_backdate_journal():
+    lg = bought()
+    lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', MON, per_share_cash=D(1)))
+    lg.mark_suspended('A', at=FRI)
+    lg.set_payment_date('div', pay_at=FRI + timedelta(days=3))
+    ats = [e.at for e in lg.events]
+    assert ats == sorted(ats), [(e.kind, e.at) for e in lg.events]
+
+
+def test_advance_then_historical_valuation_does_not_show_future_cash():
+    lg = bought()
+    lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', MON,
+                                             per_share_cash=D(1), pay_at=FRI))
+    lg.advance_to(FRI)
+    try:
+        v = lg.valuation(prices={'A': D(100)}, at=MON + timedelta(days=1))
+    except LedgerError:
+        return
+    assert v.cash == D(900000) and v.receivables == D(1000), v
+
+
+def test_residual_from_previous_week_is_not_next_pick_profit():
+    lg = ledger('300000', FREE)
+    args = dict(picks=['A'], slots=1, notional_per_slot=D(100000), open_prices={'A': D(100)})
+    w1 = enter_basket(lg, **args, at=MON, week_id='w1')
+    lg.apply_corporate_action(CorporateAction('sp', 'A', 'split', MON, split_ratio=D('1.1')))
+    exit_basket(lg, w1, close_prices={'A': D(100) / D('1.1')}, at=FRI, week_id='w1')
+    assert lg.positions['A'].shares == 100
+    w2 = enter_basket(lg, **args, at=MON + timedelta(days=7), week_id='w2')
+    exit_basket(lg, w2, close_prices={'A': D(100)}, at=FRI + timedelta(days=7), week_id='w2')
+    assert w2[0].gross_pick_return == D(0), w2[0]
+
+
+def test_calendar_returned_hours_cannot_mutate_stored_version():
+    day = date(2026, 9, 7)
+    hours = [time(9), time(13, 30)]
+    try:
+        cal = TradingCalendar(start=date(2026, 1, 1), end=date(2026, 12, 31), closures=[],
+                              session_overrides={day: hours}, recorded_at=R(2026, 1, 1), source_id='t')
+    except (TypeError, ValueError):
+        return
+    store = CalendarStore()
+    store.add(cal)
+    before = store.as_known_at(MON).session_open(day)
+    try:
+        cal.session_hours(day)[0] = time(12)
+    except TypeError:
+        pass
+    assert store.as_known_at(MON).session_open(day) == before
+
+
+def test_cancellation_of_holiday_is_not_classified_as_closure():
+    assert classify_holiday_row({'Date': '1150102', 'Name': '公告',
+                                  'Description': '取消放假'}) == ROW_UNKNOWN
+
+
+def test_invalid_experiment_type_returns_problems():
+    assert validate_prediction(base(experiment_id=[]), packet())
+
+
+@pytest.mark.parametrize('value', [float('nan'), float('inf')])
+def test_bootstrap_rejects_nonfinite_returns(value):
+    row = WeeklyObservation('2026-W37', 'f', 'historical_numeric_temporally_controlled', False, True, value)
+    try:
+        result = block_bootstrap_mean([row], block_length=1, n_boot=10, seed=1)
+    except ObservationError:
+        return
+    assert all(math.isfinite(v) for v in [result.mean, result.ci_low, result.ci_high]), result
+
+
+def test_cash_dividend_due_now_is_available_after_action():
+    lg = bought()
+    lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', FRI,
+                                             per_share_cash=D(1), pay_at=FRI))
+    assert lg.available_cash() == D(901000), (lg.available_cash(), lg.valuation(prices={'A': D(100)}, at=FRI))

