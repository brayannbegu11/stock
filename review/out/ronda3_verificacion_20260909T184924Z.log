      "prueba_propuesta": "def test_provenance(tmp_path):\n    from tests.test_packet import doc\n    from twlab.packet import build_packet\n    from twlab.store import RawStore\n    from twlab.timeutil import AvailabilityQuality as Q\n    r = RawStore(tmp_path).put(source_id='test', dataset='revenue', payload=b'{\"revenue\":100}', url='u')\n    d = doc('v2', r.ingested_at_dt, capture=r, quality=Q.VERIFIED_VERSION, version=2, payload={'revenue':999})\n    p = build_packet(packet_id='p', cutoff_at=r.ingested_at_dt, documents=[d], mode='prospective', evidence_class='prospective_registered', captures={r.capture_id:r})\n    assert not p.admitted\n",
