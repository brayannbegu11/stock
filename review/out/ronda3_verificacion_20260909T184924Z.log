+    p = build_packet(packet_id='pkt-1', cutoff_at=cutoff, deadline_at=deadline, documents=[],
+                     mode='prospective', evidence_class='prospective_registered', captures={})
+    o = base(evidence_class='prospective_registered', cutoff_at=cutoff.isoformat(),
+             issued_at=(cutoff + timedelta(seconds=1)).isoformat(), deadline_at=deadline.isoformat(),
+             independent_timestamp_receipt_id='fixture:receipt')
+    o['ranking'][0]['document_ids'] = []
+    ids = store.sealed_receipt_ids(not_after=deadline)
+    assert ids == frozenset({'fixture:receipt'})
+    assert validate_prediction(o, p, sealed_receipts=ids), 'receipt signs weather, not forecast'
+
