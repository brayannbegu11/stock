+@pytest.mark.parametrize('field', ['packet_id', 'evidence_class', 'calendar_version'])
+@pytest.mark.parametrize('mode', ['historical', 'prospective'])
+def test_free_packet_metadata_cannot_carry_unadmitted_content(tmp_path, field, mode):
+    cal = TradingCalendar(start=date(2021,1,1), end=date(2026,12,31), closures=(),
+                          source_id='synthetic', version=MARKER if field == 'calendar_version' else 'v1',
+                          recorded_at=taipei(date(2021,1,1)))
+    try:
+        p = build_packet(packet_id=MARKER if field == 'packet_id' else 'p',
+                         cutoff_at=taipei(date(2024,1,7),time(18)), documents=[], mode=mode,
+                         evidence_class=MARKER if field == 'evidence_class' else
+                         ('prospective_registered' if mode == 'prospective' else 'historical_numeric_temporally_controlled'),
+                         calendar=cal, captures={}, read_bytes=lambda r: b'', extractors={})
+        p = packet_from_json(packet_to_json(p))
+    except ValueError:
+        return
+    problems = readmission_problems(p, store=RawStore(tmp_path/'raw'))
+    visible = getattr(PredictorView(p).packet(), field)
+    assert problems or MARKER not in str(visible), (problems, visible)
+
+@pytest.mark.parametrize('field', ['kind', 'supersedes', 'security_ids'])
+def test_admitted_metadata_cannot_bypass_extractor(tmp_path, field):
+    store = RawStore(tmp_path/'raw')
+    raw = b'{"allowed": 1}'
+    rec = store.put(source_id='test', dataset='filing', payload=raw, url='fixture')
+    ids = ('TWSE:A@2000-01-01',)
+    payload = {'allowed': 1}
+    extractor = lambda b: {'payload': payload, 'security_ids': ids}
+    d = Document('d', 'filing', 'test', ids, rec.ingested_at_dt, AvailabilityQuality.VERIFIED_ORIGINAL,
+                 capture_id=rec.capture_id, source_sha256=rec.sha256, derivation='extract-v1', payload=payload)
+    d = replace(d, **{field: (MARKER,) if field == 'security_ids' else MARKER})
+    p = build_packet(packet_id='p', cutoff_at=rec.ingested_at_dt+timedelta(seconds=1), documents=[d],
+                     mode='prospective', evidence_class='prospective_registered', captures={rec.capture_id: rec},
+                     read_bytes=store.read, extractors={'extract-v1': extractor})
+    p = packet_from_json(packet_to_json(p))
+    assert not readmission_problems(p, store=store, extractors={'extract-v1': extractor})
+    assert MARKER not in str(PredictorView(p).packet().admitted), p.admitted
+
+@pytest.mark.parametrize('kind', ['cash', 'stock'])
+@pytest.mark.parametrize('bad_amount', [0, -1])
+def test_zero_or_negative_collision_is_not_silently_ignored(tmp_path, kind, bad_amount):
+    mk = cash if kind == 'cash' else stock
+    r = runner(tmp_path, end='2024-01-12', dividends=[mk(10), mk(bad_amount)])
+    sec = next(iter(r.market.securities.values()))
+    result = r.run()
+    assert not sec.events and r.market.warnings, (sec.events, r.market.warnings,
+           result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close'])
+
+def test_distinct_known_at_does_not_turn_dividend_into_zero_label(tmp_path):
+    r = runner(tmp_path, end='2024-01-12', dividends=[cash(10), cash(10, AnnouncementDate='2024-02-01')])
+    sec = next(iter(r.market.securities.values()))
+    label = q1.weekly_label(r.market.by_session[sec.security_id], date(2024,1,8), date(2024,1,12), sec.events)
+    result = r.run()
+    print('KNOWN_AT', sec.events, r.market.warnings, label, result['weeks'][0]['paired'])
+    assert label is None or label[0] == pytest.approx(.10), label
+
+def test_missing_period_cannot_duplicate_identical_right(tmp_path):
+    r = runner(tmp_path, end='2024-01-12', dividends=[cash(10), cash(10, year='')])
+    sec = next(iter(r.market.securities.values()))
+    result = r.run()
+    actual = result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']
+    assert actual == pytest.approx(.10) or r.market.warnings, (actual, sec.events, r.market.warnings)
+
+def test_delisted_zero_is_not_measurable_market_close(tmp_path):
+    r = runner(tmp_path, end='2024-01-12', delisted='2024-01-09', dividends=[stock(10)])
+    result = r.run()
+    w = result['weeks'][0]
+    print('DELISTED', w['forecasters']['Q0'], w['paired']['Q0'])
+    assert w['forecasters']['Q0']['portfolio_net_return_open_close'] is None
+    assert not w['paired']['Q0']['paired']
+
+@pytest.mark.parametrize('missing_price', [False, True])
+def test_right_exactly_on_valuation_session_control(tmp_path, missing_price):
+    r = runner(tmp_path, end='2024-01-12', dividends=[stock(10)])
+    r.run_week(date(2024,1,7))
+    # Replay separately through an end inside the week, with an optional absent stock bar.
+    r = runner(tmp_path/'short', end='2024-01-12', config_end='2024-01-10', dividends=[stock(10)],
+               prices=(lambda d: D(0) if d == date(2024,1,10) else D(100)) if missing_price else None)
+    fv = r.run()['summary']['forecasters']['Q0']['final_valuation']
+    assert any('price_predates_right' in f for f in fv['flags']) == missing_price, fv
+
+def test_non_session_ex_is_applied_identically_control(tmp_path):
+    r = runner(tmp_path, end='2024-01-12', closures=[date(2024,1,10)], dividends=[cash(10)])
+    sec = next(iter(r.market.securities.values()))
+    label = q1.weekly_label(r.market.by_session[sec.security_id], date(2024,1,8), date(2024,1,12), sec.events)
+    result = r.run()
+    assert label[0] == pytest.approx(result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close'])
+
+def test_stock_ratio_rounding_does_not_destroy_whole_lot(tmp_path):
+    store, market = fixture(tmp_path, end='2024-01-12', dividends=[stock(1)])
+    market = load_market(store, tmp_path/'manifest.json', market.calendar, par_value=D(3))
+    cfg = BacktestConfig(start=date(2024,1,1), end=date(2024,1,12), slots=1, notional=300000,
+                         commission_per_side=D(0), sell_tax=D(0), slippage_bps=0, par_value=D(3), n_boot=20)
+    r = Runner(store, market, cfg, [MomentumForecaster(), RandomForecaster(cfg.seed)])
+    result = r.run()
+    fv = result['summary']['forecasters']['Q0']['final_valuation']
+    print('ROUNDING', fv, result['summary']['forecasters']['Q0']['open_positions_at_end'])
+    assert fv['cash'] == 400000 and not r.ledgers['Q0'].positions, fv
+
+@pytest.mark.parametrize('name', ['11_demo_q0_2024-2025.md', '14_backtest_muestra_2024-2025.md'])
+def test_documented_finmind_limit_is_present_in_reports(name):
+    text = (ROOT/'docs/informes'/name).read_text(encoding='utf-8')
+    assert 'revisiones' in text or 'versiones de FinMind' in text, name
+
+def test_doc_id_identifier_boundaries_control():
+    assert not is_valid_doc_id(MARKER)
+    assert is_valid_doc_id('TWSE:A@2000-01-01')
+    assert not is_valid_doc_id('A\n')
+
+@pytest.mark.parametrize('kind', ['cash', 'stock'])
+def test_nonfinite_event_cannot_pass_shared_validation(tmp_path, kind):
+    r = runner(tmp_path, end='2024-01-12', dividends=[cash('Infinity') if kind == 'cash' else stock('Infinity')])
+    sec = next(iter(r.market.securities.values()))
