      "comando_reproduccion": "python -B -m pytest -q -p no:cacheprovider review/out/astra_scratch/test_r13_attacks.py -k documented_finmind_limit --basetemp review/out/astra_scratch/repro13_docs",
      "prueba_propuesta": "from pathlib import Path\nimport pytest\n\n@pytest.mark.parametrize('name', ['11_demo_q0_2024-2025.md', '14_backtest_muestra_2024-2025.md'])\ndef test_promised_revision_limit_is_disclosed(name):\n    text = (Path('docs/informes')/name).read_text(encoding='utf-8')\n    assert 'revisiones' in text or 'versiones de FinMind' in text\n",
