"""Calendario de sesiones construido desde la lista oficial, versionada.

Correcci├â┬│n tras la ronda 1 de Astra (R01-01): el endpoint
``holidaySchedule`` de TWSE mezcla dos clases de filas. Las de cierre
(├é┬½├ñ┬╛┬¥├¿┬ª┬Å├Ñ┬«┼í├ªΓÇ¥┬╛├Ñ┬üΓÇí├é┬╗, ├é┬½├¿┬ú┼ô├Ñ┬üΓÇí├é┬╗, ├é┬½├Ñ┬╕ΓÇÜ├Ñ┬á┬┤├ºΓÇ₧┬í├ñ┬║┬ñ├ª╦£ΓÇ£├»┬╝┼Æ├Ñ╞ÆΓÇª├¿┬╛┬ª├º┬ÉΓÇá├º┬╡┬É├º┬«ΓÇö├ñ┬║┬ñ├ÑΓÇ░┬▓├ñ┬╜┼ô├ª┬Ñ┬¡├é┬╗) y las **informativas
de negociaci├â┬│n** (├é┬½├Ñ┼ôΓÇ╣├ªΓÇ║ΓÇá├ªΓÇô┬░├Ñ┬╣┬┤├⌐ΓÇôΓÇ╣├Ñ┬ºΓÇ╣├ñ┬║┬ñ├ª╦£ΓÇ£├ªΓÇö┬Ñ├é┬╗, ├é┬½├¿┬╛┬▓├ªΓÇ║ΓÇá├ª╦£┬Ñ├º┬»Γé¼├ÑΓÇ░┬ì├ª┼ôΓé¼├Ñ┬╛┼Æ├ñ┬║┬ñ├ª╦£ΓÇ£├ªΓÇö┬Ñ├é┬╗,
├é┬½├¿┬╛┬▓├ªΓÇ║ΓÇá├ª╦£┬Ñ├º┬»Γé¼├Ñ┬╛┼Æ├⌐ΓÇôΓÇ╣├Ñ┬ºΓÇ╣├ñ┬║┬ñ├ª╦£ΓÇ£├ªΓÇö┬Ñ├é┬╗), que son sesiones. Cada fila se clasifica y una fila
no reconocida, contradictoria o con negaci├â┬│n detiene la carga en vez de
adivinarse (R02-19).

El calendario es inmutable tras construirse (R02-18) y se versiona:
``CalendarStore`` conserva cada versi├â┬│n con su ``recorded_at`` para poder
consultar ├é┬½el calendario conocido al corte├é┬╗.
"""
from __future__ import annotations

import json
from datetime import date, datetime, time, timedelta
from pathlib import Path
from types import MappingProxyType
from typing import Iterable, Mapping, Optional, Sequence

from .timeutil import TAIPEI, ensure_aware, parse_date, taipei, to_utc

REPO_ROOT = Path(__file__).resolve().parents[2]
REFERENCE_DIR = REPO_ROOT / "data" / "reference"

ROW_SESSION_MARKER = "session_marker"
ROW_CLOSURE = "closure"
ROW_UNKNOWN = "unknown"

_SESSION_MARKERS = ("├⌐ΓÇôΓÇ╣├Ñ┬ºΓÇ╣├ñ┬║┬ñ├ª╦£ΓÇ£", "├ª┼ôΓé¼├Ñ┬╛┼Æ├ñ┬║┬ñ├ª╦£ΓÇ£", "├ª┬¡┬ú├Ñ┬╕┬╕├ñ┬║┬ñ├ª╦£ΓÇ£")
_CLOSURE_MARKERS = ("├ªΓÇ¥┬╛├Ñ┬üΓÇí", "├¿┬ú┼ô├Ñ┬üΓÇí", "├Ñ┬╕ΓÇÜ├Ñ┬á┬┤├ºΓÇ₧┬í├ñ┬║┬ñ├ª╦£ΓÇ£", "├ñ┬╝ΓÇÿ├Ñ┬╕ΓÇÜ")
_NEGATION_PREFIXES = ("├ñ┬╕┬ì", "├ª┼ô┬¬", "├Ñ┬ÅΓÇô├ª┬╢╦å", "├⌐┬¥┼╛", "├ºΓÇ₧┬í")   # cualquier marcador precedido de negaci├â┬│n ├óΓÇáΓÇÖ revisi├â┬│n (R03-12)


class CalendarRangeError(ValueError):
    pass


class UnclassifiedCalendarRow(ValueError):
    pass


# Frases completas observadas en el endpoint heredado en ingl├â┬⌐s (2021-2026). Un texto se clasifica s├â┬│lo si es
# exactamente una de estas frases o una combinaci├â┬│n de frases de cierre separadas por ├é┬½/├é┬╗ o ├é┬½&├é┬╗; cualquier otra
# cosa (negaciones, condiciones, anuncios, cierres por tif├â┬│n redactados de otro modo) es ``unknown`` y detiene
# la carga para inspecci├â┬│n humana (R08-02, R09-04). Sin coincidencia por subcadenas.
_EN_CLOSURE_PHRASES = frozenset({
    "adjusted holiday", "chinese new year", "chinese new year's eve", "new year", "new year's day",
    "no trading. market opens only for clearing & settlement", "no trading market opens only for clearing & settlement",
    "tomb-sweeping day", "tomb sweeping day", "labor day", "labour day", "mid-autumn", "mid-autumn festival", "moon festival",
    "peace memorial day", "dragon boat festival", "national day", "children's day", "teacher's day", "teachers' day",
    "taiwan restoration day", "restoration day", "constitution day",
})
_EN_SESSION_PHRASES = frozenset({
    "market open", "last trading day", "last trading day of the year", "first trading day", "first trading day of the year",
})


def _normalize_en(description: str) -> str:
    t = " ".join(str(description).replace("\n", " ").split()).lower().replace("├óΓé¼Γäó", "'").replace("├óΓé¼╦£", "'")
    if t.endswith(")") and "(" in t:                       # sufijo de a├â┬▒o: ├é┬½Adjusted Holiday (2021)├é┬╗
        head, _, tail = t.rpartition("(")
        if tail[:-1].strip().isdigit() and len(tail[:-1].strip()) == 4:
            t = head
    return t.strip().rstrip(".").strip()


def classify_holiday_row_en(description: str) -> str:
    """Clasifica una fila del endpoint hist├â┬│rico en ingl├â┬⌐s (``rwd/en/holidaySchedule``); ante duda, ``unknown``.

    S├â┬│lo frases completas del cat├â┬ílogo (o combinaciones de frases de cierre con ├é┬½/├é┬╗ o ├é┬½&├é┬╗); nunca
    subcadenas. As├â┬¡ ├é┬½Not a Holiday├é┬╗, ├é┬½Typhoon warning: trading continues├é┬╗ o ├é┬½Market Open is not
    confirmed├é┬╗ son ``unknown`` y detienen la carga (R08-02, R09-04).
    """
    t = _normalize_en(description)
    if not t:
        return ROW_UNKNOWN
    if t in _EN_CLOSURE_PHRASES:
        return ROW_CLOSURE
    if t in _EN_SESSION_PHRASES:
        return ROW_SESSION_MARKER
    parts = [p.strip().rstrip(".").strip() for p in t.replace("&", "/").split("/")]
    if parts and all(p in _EN_CLOSURE_PHRASES for p in parts):
        return ROW_CLOSURE
    return ROW_UNKNOWN


def classify_holiday_row(row: Mapping[str, str]) -> str:
    """Clasifica una fila del endpoint oficial; ante ambig├â┬╝edad o negaci├â┬│n devuelve ``unknown``."""
    name = str(row.get("Name", ""))
    desc = str(row.get("Description", ""))
    text = name + " " + desc
    for marker in _CLOSURE_MARKERS + _SESSION_MARKERS:
        if any(prefix + marker in text for prefix in _NEGATION_PREFIXES):
            return ROW_UNKNOWN
    if "├Ñ┬ÅΓÇô├ª┬╢╦å" in text:
        return ROW_UNKNOWN
    is_session = any(m in text for m in _SESSION_MARKERS)
"""Registro de verificadores de sello temporal de **producci├â┬│n**.

Modelo de confianza (precisado en la ronda 6, R06-01): la garant├â┬¡a del
protocolo se enuncia para *consumidores por defecto dentro de un proceso de
confianza*, es decir, con este m├â┬│dulo importado sin alterar, el registro de
producci├â┬│n tal como est├â┬í en el c├â┬│digo versionado y
``allow_test_authorities=False`` en el validador y en la evaluaci├â┬│n. En esas
condiciones ning├â┬║n sello de autoridad de prueba se acepta y, mientras el
registro est├â┬⌐ vac├â┬¡o, ning├â┬║n registro puede estar sellado para el protocolo.
La garant├â┬¡a **no** cubre la mutaci├â┬│n del entorno de importaci├â┬│n
(monkeypatch, sustituci├â┬│n del m├â┬│dulo): eso queda fuera del modelo, como en
cualquier programa Python, y se mitiga con el registro como mapa de s├â┬│lo
lectura y con la comprobaci├â┬│n de integridad del ├â┬írbol en cada ronda.

Estado: **vac├â┬¡o**. Los adaptadores OpenTimestamps (verificaci├â┬│n de una
prueba .ots contra la cadena de Bitcoin) y RFC 3161 (verificaci├â┬│n de un
token TSA con su certificado) a├â┬║n no existen.
"""
from __future__ import annotations

from types import MappingProxyType
from typing import Callable, Mapping

PRODUCTION_AUTHORITIES = frozenset({"opentimestamps", "rfc3161"})

# authority -> verifier(record, receipt) -> bool. S├â┬│lo lectura; vac├â┬¡o a prop├â┬│sito: ver docstring.
PRODUCTION_VERIFIERS: Mapping[str, Callable] = MappingProxyType({})


def is_production_authority(authority: str) -> bool:
    return authority in PRODUCTION_AUTHORITIES


def production_verifier(authority: str):
    return PRODUCTION_VERIFIERS.get(authority)

