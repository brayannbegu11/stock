      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner\nfrom review.out.astra_scratch.test_r13_attacks import stock\n\ndef test_unresolved_delisting_is_not_a_market_interval(tmp_path):\n    r = runner(tmp_path, end='2024-01-12', delisted='2024-01-09', dividends=[stock(10)])\n    w = r.run()['weeks'][0]\n    assert w['forecasters']['Q0']['portfolio_net_return_open_close'] is None\n    assert not w['paired']['Q0']['paired']\n",
