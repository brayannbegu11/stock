    divs = {"A": dividend_rows("A", ex_date=date(2024, 1, 10), cash=2.0, pay=date(2024, 2, 1))}
    store, path = make_market(tmp_path, dividends=divs, overrides={"A": {"dividend_rows": 0}})
    with pytest.raises(ManifestInconsistent):
