      "prueba_propuesta": "from decimal import Decimal as D\nfrom tests.test_ledger import ledger, FREE, MON, FRI\nfrom twlab.simulation import exit_basket\nfrom review.out.astra_scratch.test_ronda6 import enter\n\ndef test_fifo_atribuye_ingresos_a_los_lotes_consumidos():\n    lg = ledger('400000', FREE)\n    w = enter(lg, amount=200000)\n    other = enter(lg, week='other')\n    lg.sell(security_id='A', price=D(110), shares=1000, at=MON, event_id='fifo')\n    assert lg.positions['A'].owner_quantity(other[0].owner) == D(1000)\n    exit_basket(lg, w, close_prices={'A': D(90)}, at=FRI, week_id='2030-W02')\n    assert w[0].gross_pick_return == D(0)\n",
