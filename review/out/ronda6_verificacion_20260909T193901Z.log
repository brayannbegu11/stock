      "prueba_propuesta": "import pytest\nfrom twlab.evaluation import ObservationError\nfrom tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal\nfrom review.out.astra_scratch.test_ronda6 import evaluate\n\n@pytest.mark.parametrize('deadline', ['2021-01-03T18:00:00+08:00', '2099-01-05T08:30:00+08:00'])\ndef test_plazo_archivado_no_autoriza_retroactividad(tmp_path, deadline):\n    p = prospective_packet()\n    o = prospective_forecast(p, cutoff_at='2021-01-03T18:00:00+08:00', issued_at='2021-01-03T18:30:00+08:00', deadline_at=deadline)\n    s, r = archive_and_seal(tmp_path, o, p)\n    assert r.ingested_at_dt.year == 2026\n    with pytest.raises(ObservationError):\n        evaluate(s, r, '2021-W01', allow_test_authorities=True)\n",
