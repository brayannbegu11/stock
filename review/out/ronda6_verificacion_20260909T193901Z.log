+
+def enter(lg, week='2030-W02', amount=100000):
+    return enter_basket(lg, picks=['A'], slots=1, notional_per_slot=D(amount),
+                        open_prices={'A': D(100)}, at=MON, week_id=week)
+
+
+def evaluate(s, r, week, forecast='f-1', **kw):
+    row = WeeklyObservation(week, forecast, 'prospective_registered', r.capture_id, True, .10)
+    return block_bootstrap_mean([row], block_length=1, n_boot=20, seed=1, store=s, **kw)
+
+
+def archive_body(tmp_path, body):
+    s = RawStore(tmp_path, verifiers={'fixture': lambda r, c: True})
+    r = s.put(source_id='forecast', dataset='L1', payload=json.dumps(body).encode(), url='fixture')
+    s.attach_receipt(r.capture_id, receipt_id='fixture:f', authority='fixture', digest=r.sha256,
+                     attested_at=r.ingested_at)
+    return s, r
+
+
+def test_p2_runtime_registry_is_not_a_security_boundary(tmp_path, monkeypatch):
+    p = prospective_packet()
+    o = prospective_forecast(p)
+    s, r = archive_and_seal(tmp_path, o, p)
+    assert validate_prediction(o, p, store=s)
+    monkeypatch.setitem(seals.PRODUCTION_VERIFIERS, 'opentimestamps', lambda r, c: True)
+    s.attach_receipt(r.capture_id, receipt_id=o['independent_timestamp_receipt_id'],
+                     authority='opentimestamps', digest=r.sha256, attested_at=r.ingested_at)
+    assert validate_prediction(o, p, store=s), 'Runtime registry mutation authorizes production without flag'
+
+
+def test_control_alternative_import_has_separate_registry():
+    spec = importlib.util.spec_from_file_location('astra_alternative_seals', seals.__file__)
+    alternative = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(alternative)
+    alternative.PRODUCTION_VERIFIERS['opentimestamps'] = lambda r, c: True
+    assert alternative.production_verifier('opentimestamps') is not None
+    assert seals.production_verifier('opentimestamps') is None
+
+
+def test_control_test_authorities_require_flag_at_consumers(tmp_path):
