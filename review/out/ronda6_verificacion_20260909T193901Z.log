      "prueba_propuesta": "from decimal import Decimal as D\nfrom tests.test_ledger import ledger, FREE, MON, FRI\nfrom twlab.simulation import exit_basket\nfrom review.out.astra_scratch.test_ronda6 import enter\n\ndef test_liquidacion_previa_conserva_resultado():\n    lg = ledger('300000', FREE)\n    w = enter(lg)\n    lg.sell(security_id='A', price=D(110), shares=1000, at=MON, event_id='full', owner=w[0].owner)\n    exit_basket(lg, w, close_prices={'A': D(110)}, at=FRI, week_id='2030-W02')\n    assert w[0].gross_pick_return == D('.1')\n",
