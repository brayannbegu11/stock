      "prueba_propuesta": "import pytest\nfrom decimal import Decimal as D\nfrom tests.test_ledger import ledger, FREE, MON\nfrom twlab.simulation import enter_basket\nfrom review.out.astra_scratch.test_ronda6 import enter\n\n@pytest.mark.parametrize('picks', [[], ['A']])\ndef test_cesta_sin_compra_tambien_reserva_identidad(picks):\n    lg = ledger('300000', FREE)\n    first = enter_basket(lg, picks=picks, slots=1, notional_per_slot=D(100000), open_prices={}, at=MON, week_id='2030-W02')\n    assert first[0].status in ('empty', 'entry_failed')\n    with pytest.raises(ValueError):\n        enter(lg)\n",
