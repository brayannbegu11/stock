      "prueba_propuesta": "from tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal\nfrom twlab.schemas import validate_prediction\n\ndef test_produccion_rechaza_verificador_trivial(tmp_path):\n    p = prospective_packet()\n    obj = prospective_forecast(p)\n    store, _ = archive_and_seal(tmp_path, obj, p, verifier=lambda rec, receipt: True)\n    assert validate_prediction(obj, p, store=store)\n",
