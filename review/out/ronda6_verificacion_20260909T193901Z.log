import json
from copy import deepcopy
from dataclasses import replace
from datetime import date, datetime, time, timedelta
from decimal import Decimal as D
import pytest

from tests.test_schema import (base, packet, prospective_packet, prospective_forecast,
    archive_and_seal, CUTOFF, CUTOFF_2030, CAL_2030)
from tests.test_ledger import ledger, FREE, MON, FRI
from twlab.store import RawStore
from twlab.schemas import validate_prediction, sealed_forecast_bytes, sealed_forecast_digest
from twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError
from twlab.packet import Rejection as PacketRejection, PredictorView
from twlab.ledger import CorporateAction, DuplicateCorporateAction, Fill
from twlab.simulation import enter_basket, exit_basket
from twlab.weekly import plan_week, ProtocolViolation
from twlab.calendar import TradingCalendar


def enter(lg, week='2030-W02', amount=100000):
    return enter_basket(lg, picks=['A'], slots=1, notional_per_slot=D(amount),
                        open_prices={'A': D(100)}, at=MON, week_id=week)


def observe(rec, *, week='2026-W37', forecast='never-archived'):
    return WeeklyObservation(week, forecast, 'prospective_registered', rec.capture_id, True, 0.10)


def test_production_cannot_use_caller_trivial_verifier(tmp_path):
    p = prospective_packet()
    o = prospective_forecast(p)
    store, rec = archive_and_seal(tmp_path, o, p, verifier=lambda rec, receipt: True)
    assert rec.sha256 == sealed_forecast_digest(o, p)
    assert validate_prediction(o, p, store=store), 'Trivial verifier accepted as production'


def test_evaluation_rejects_weather_capture_and_reused_seal(tmp_path):
    store = RawStore(tmp_path, verifiers={'opentimestamps': lambda rec, receipt: True})
    rec = store.put(source_id='weather', dataset='rain', payload=b'weather:rain=0', url='fixture')
    store.attach_receipt(rec.capture_id, receipt_id='weather', authority='opentimestamps',
                         digest=rec.sha256, attested_at=rec.ingested_at)
    rows = [observe(rec, week='2021-W01'), observe(rec, week='2021-W02')]
    with pytest.raises(ObservationError):
        block_bootstrap_mean(rows, block_length=1, n_boot=20, seed=1, store=store)


def test_evaluation_rejects_late_forecast_seal(tmp_path):
    p = prospective_packet()
    o = prospective_forecast(p)
    late = (p.deadline_at + timedelta(days=7)).isoformat()
    store, rec = archive_and_seal(tmp_path, o, p, attested_at=late)
    assert validate_prediction(o, p, store=store)
    with pytest.raises(ObservationError):
        block_bootstrap_mean([observe(rec, week=p.week_id, forecast=o['forecast_id'])],
                             block_length=1, n_boot=20, seed=1, store=store)


def test_seal_covers_rejection_details_visible_to_predictor(tmp_path):
    p = prospective_packet()
    o = prospective_forecast(p)
    store, _ = archive_and_seal(tmp_path, o, p)
    changed = replace(p, rejected=(PacketRejection('future', 'available_after_cutoff',
                                                  '2030-W02 future winner A +50%'),))
    assert PredictorView(changed).packet().rejected != p.rejected
    assert validate_prediction(o, changed, store=store), 'Changed predictor-visible packet still authenticates'


def test_duplicate_basket_owner_does_not_sell_second_entry():
    lg = ledger('300000', FREE)
    first = enter(lg)
    try:
        second = enter(lg)
    except ValueError:
        return  # Rejecting a duplicate basket is sufficient.
    exit_basket(lg, first, close_prices={'A': D(100)}, at=FRI, week_id='2030-W02')
    assert first[0].gross_pick_return == D(0), (first[0], second[0])


def test_partial_owner_sale_is_in_total_pick_return():
    lg = ledger('400000', FREE)
    w = enter(lg, amount=200000)
    other = enter(lg, week='other')
    partial = lg.sell(security_id='A', price=D(110), shares=1000, at=MON,
                      event_id='partial', owner=w[0].owner)
    assert isinstance(partial, Fill)
    assert lg.positions['A'].owner_quantity(other[0].owner) == D(1000)
    exit_basket(lg, w, close_prices={'A': D(90)}, at=FRI, week_id='2030-W02')
    assert w[0].gross_pick_return == D(0), w[0].gross_pick_return


def test_fraction_flags_do_not_cancel_between_owners():
    lg = ledger('300000', FREE)
    enter(lg, week='owner-a')
    enter(lg, week='owner-b')
    lg.apply_corporate_action(CorporateAction('split', 'A', 'split', MON, split_ratio=D('0.5005')))
    assert [lot.quantity for lot in lg.positions['A'].lots] == [D('500.5000'), D('500.5000')]
    v = lg.valuation(prices={'A': D(100)/D('0.5005')}, at=FRI)
    assert 'A:fractional_shares_unresolved' in v.flags, v


def test_dividend_cash_is_invariant_to_same_owner_acquisition_lots():
    def paid(quantities):
        lg = ledger('300000', FREE)
        for i, n in enumerate(quantities):
            lg.buy(security_id='A', price=D(100), shares=n, at=MON, event_id=f'b{i}', owner='same')
        lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', MON,
                                                per_share_cash=D('1.2345'), pay_at=FRI))
        lg.advance_to(FRI)
        return lg.cash
    assert paid([1000, 1000]) == paid([2000])


def test_invalid_prospective_week_can_be_registered_after_cutoff(tmp_path):
    # Pick a past Sunday so the archive uses its real system clock after cutoff.
    now = datetime.now(CUTOFF.tzinfo)
    sunday = now.date() - timedelta(days=(now.weekday()+1) % 7 + 7)
    cutoff = datetime.combine(sunday, time(18), tzinfo=CUTOFF.tzinfo)
    monday = sunday + timedelta(days=1)
    cal = TradingCalendar(start=sunday, end=sunday+timedelta(days=14),
                          closures=[monday+timedelta(days=i) for i in range(5)],
                          source_id='no-sessions', recorded_at=cutoff-timedelta(days=1))
    p = prospective_packet(cutoff=cutoff, calendar=cal)
    o = base(packet_id=p.packet_id, cutoff_at=cutoff.isoformat(), issued_at=now.isoformat(),
             deadline_at=cutoff.isoformat(), evidence_class='prospective_registered',
             status='invalid', ranking=[], status_reason='no_sessions')
    store, rec = archive_and_seal(tmp_path, o, p)
    assert rec.ingested_at_dt > cutoff
    assert validate_prediction(o, p, store=store) == []


def test_invalid_unsealed_run_is_counted_in_prospective_coverage(tmp_path):
    p = prospective_packet()
    o = prospective_forecast(p)
    store, rec = archive_and_seal(tmp_path, o, p)
    rows = [observe(rec, week=p.week_id, forecast=o['forecast_id']),
            WeeklyObservation('2030-W03', 'failed-run', 'prospective_registered', None, False, None)]
    result = block_bootstrap_mean(rows, block_length=1, n_boot=20, seed=1, store=store)
    assert result.n_used == 1 and result.n_invalid_excluded == 1


