    requested_model: claude-fable-5-1
  reviewer:
    provider: OpenAI
    requested_model: gpt-6-astra
  predictor_comparison: "independent_same_packet"
  immutable_model_revisions: null
  must_record_requested_and_returned_model: true
  provider_documents_recheck_before_use: true
