      "contraejemplo": "Dos propietarios con 1.000 acciones cada uno reciben split_ratio=0,5005. Cada lote queda en 500,5, pero la suma es 1.001: unresolved_fraction=0 y Valuation.flags=(), aunque ambos propietarios conservan media acción sin resolver.",
      "comando_reproduccion": "python -B -m pytest -q -p no:cacheprovider review/out/astra_scratch/test_ronda5.py::test_fraction_flags_do_not_cancel_between_owners",
      "prueba_propuesta": "from decimal import Decimal as D\nfrom tests.test_ledger import ledger, FREE, MON, FRI\nfrom review.out.astra_scratch.test_ronda5 import enter\nfrom twlab.ledger import CorporateAction\n\ndef test_fracciones_de_propietarios_no_se_ocultan():\n    lg = ledger('300000', FREE)\n    enter(lg, week='owner-a')\n    enter(lg, week='owner-b')\n    lg.apply_corporate_action(CorporateAction('split', 'A', 'split', MON, split_ratio=D('0.5005')))\n    assert [lot.quantity for lot in lg.positions['A'].lots] == [D('500.5'), D('500.5')]\n    v = lg.valuation(prices={'A': D(100)/D('0.5005')}, at=FRI)\n    assert 'A:fractional_shares_unresolved' in v.flags\n",
