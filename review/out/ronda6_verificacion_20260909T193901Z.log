  permitted_format_repair_retries: 1
  frontier_model_weights_finetuning_assumed: false

point_in_time:
  preserve_raw_versions: true
  immutable_prediction_archive: true
  independent_timestamp_evidence_required: true
  historical_predictor_open_web: false
  outcome_store_access_for_predictor: false
  preserve_actual_ingested_at: true
  require_original_availability_evidence: true
  date_without_time_policy_proposed: "admit_next_session_unless_earlier_time_verified"
  availability_quality: [verified_original, verified_version, conservative_inference, unknown]
  unknown_availability_admitted_to_primary: false
  live_first_seen_before_cutoff_required: true
