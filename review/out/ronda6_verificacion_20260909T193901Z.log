      "prueba_propuesta": "from decimal import Decimal as D\nfrom tests.test_ledger import ledger, FREE, FRI\nfrom review.out.astra_scratch.test_ronda5 import enter\nfrom twlab.simulation import exit_basket\n\ndef test_entrada_duplicada_no_comparte_lotes():\n    lg = ledger('300000', FREE)\n    first = enter(lg)\n    try:\n        enter(lg)\n    except ValueError:\n        return\n    exit_basket(lg, first, close_prices={'A': D(100)}, at=FRI, week_id='2030-W02')\n    assert first[0].gross_pick_return == D(0)\n",
