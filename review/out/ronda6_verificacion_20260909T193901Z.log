      "prueba_propuesta": "from dataclasses import replace\nfrom datetime import datetime\nfrom tests.test_schema import base, packet, CUTOFF\nfrom twlab.schemas import validate_prediction\n\ndef test_validador_rechaza_corte_intermedio():\n    cutoff = datetime.fromisoformat('2026-09-10T02:00:00+08:00')\n    p = replace(packet(), cutoff_at=cutoff, deadline_at=datetime.fromisoformat('2026-09-10T08:30:00+08:00'), entry_at=datetime.fromisoformat('2026-09-10T09:00:00+08:00'))\n    obj = base(cutoff_at=cutoff.isoformat(), issued_at='2026-09-10T07:00:00+08:00', deadline_at=p.deadline_at.isoformat())\n    assert validate_prediction(obj, p)\n\ndef test_estado_semanal_desconocido_no_autoriza_ventana_nula():\n    p = replace(packet(), week_status='valid_typo')\n    obj = base(status='invalid', ranking=[], status_reason='fake-no-sessions', deadline_at=CUTOFF.isoformat())\n    assert validate_prediction(obj, p)\n",
