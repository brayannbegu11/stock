def test_control_fifo_partial_sales_corporate_actions_and_collections():
    lg = ledger('1000000', FREE)
    for event, owner, price in [('a1', 'A', 100), ('b1', 'B', 200), ('a2', 'A', 120)]:
        lg.buy(security_id='S', price=D(price), shares=1000, at=MON, event_id=event, owner=owner)
    lg.apply_corporate_action(CorporateAction('split', 'S', 'split', MON, split_ratio=D('1.1')))
    lg.apply_corporate_action(CorporateAction('stock', 'S', 'stock_dividend', MON, stock_ratio=D('0.1')))
    pos = lg.positions['S']
    assert pos.owner_quantity('A') == D(2420)
    assert pos.owner_quantity('B') == D(1210)
    before_b = [(lot.quantity, lot.cost_twd) for lot in pos.lots if lot.owner == 'B']
    fill = lg.sell(security_id='S', price=D(100), shares=2000, at=MON, event_id='sale', owner='A')
    assert isinstance(fill, Fill)
    assert pos.owner_quantity('A') == D(420)
    assert [(lot.quantity, lot.cost_twd) for lot in pos.lots if lot.owner == 'B'] == before_b
    assert sum(l.cost_twd for l in pos.lots if l.owner == 'A') + (fill.gross-fill.realized_pnl) == D(220000)
    action = CorporateAction('div', 'S', 'cash_dividend', MON, per_share_cash=D(2))
    lg.apply_corporate_action(action)
    assert lg.declared_dividends('S', 'A') == D(840)
    assert lg.declared_dividends('S', 'B') == D(2420)
    with pytest.raises(DuplicateCorporateAction):
        lg.apply_corporate_action(action)
    cash = lg.cash
    lg.advance_to(FRI)
    lg.set_payment_date('div', pay_at=MON+timedelta(days=1), at=FRI)
    assert lg.cash == cash + D(3260)
    assert not lg.receivables
    assert [e.at for e in lg.events] == sorted(e.at for e in lg.events)
    lg.advance_to(FRI+timedelta(days=7))
    assert lg.cash == cash + D(3260)


def test_control_canonical_forecast_all_fields_except_receipt_are_bound():
    p = prospective_packet()
    o = prospective_forecast(p, raw_response_hash='0'*64, independent_timestamp_receipt_id='a')
    digest = sealed_forecast_digest(o, p)
    for key in o:
        changed = deepcopy(o)
        changed[key] = {'changed': True}
        if key == 'independent_timestamp_receipt_id':
            assert sealed_forecast_digest(changed, p) == digest
        else:
            assert sealed_forecast_digest(changed, p) != digest, key
    assert json.loads(sealed_forecast_bytes(o, p))['packet_hash'] == p.packet_hash()


@pytest.mark.parametrize('offset', [-1, 1, 60, 86400])
def test_control_week_plan_rejects_off_cutoff(offset):
    with pytest.raises(ProtocolViolation):
        plan_week(CUTOFF_2030+timedelta(seconds=offset), CAL_2030)


@pytest.mark.parametrize('opening', [time(8), time(8, 30), time(8, 31)])
def test_control_only_one_session_open_must_follow_deadline(opening):
    monday = date(2030, 1, 7)
    cal = TradingCalendar(start=date(2030,1,1), end=date(2030,1,31),
        closures=[monday+timedelta(days=i) for i in range(1,5)],
        session_overrides={monday: (opening,time(13,30))}, source_id='one', recorded_at=CUTOFF_2030)
    plan = plan_week(CUTOFF_2030, cal)
    assert plan.is_valid == (opening > time(8,30))
    if plan.is_valid:
        assert plan.deadline_at < plan.entry_at < plan.exit_at
    else:
        assert plan.entry_at is None and plan.exit_at is None
"""Cesta semanal de hasta cinco puestos de igual peso (PROTOCOLO.yaml weekly_experiment).

Desde la ronda 4 (R04-09/10/11) cada puesto es **propietario** de los lotes
que compró (``owner = "<week_id>:<rank>"``): la salida vende sólo esos lotes,
la cantidad atribuible es exactamente la del propietario (escala con las
acciones corporativas) y la rentabilidad bruta de la selección incluye los
dividendos declarados sobre esos lotes. Un residuo de otra cesta nunca
entra en la cuenta de esta.
"""
from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from decimal import ROUND_DOWN, Decimal
from typing import Mapping, Optional, Sequence

from .ledger import Fill, PaperLedger, Rejection

D = Decimal
_Q = D("1E-12")


def slot_owner(week_id: str, rank: int) -> str:
    return f"{week_id}:{rank}"


@dataclass
class Slot:
    rank: int
    security_id: Optional[str]
    status: str                      # filled | entry_failed | empty | exited | exit_blocked
    reason: str = ""
    owner: Optional[str] = None
    entry: Optional[Fill] = None
    exit: Optional[Fill] = None
    exit_attributed_quantity: Decimal = D(0)   # cantidad del propietario justo antes de vender
    exit_residual_quantity: Decimal = D(0)     # cantidad del propietario que quedó en el libro tras vender
    dividends_declared: Decimal = D(0)         # dividendos en efectivo declarados sobre los lotes del propietario
    notes: list[str] = field(default_factory=list)

    sale_gross_total: Decimal = D(0)           # importe bruto de todas las ventas del propietario, incluida la salida

    @property
    def gross_pick_return(self) -> Optional[Decimal]:
        """Rentabilidad bruta total de la selección: (ventas brutas acumuladas del propietario + residuo × precio de
        salida + dividendos declarados) / importe de entrada − 1. Respeta splits, ventas parciales previas, residuos
        y dividendos (R02-04, R03-10, R04-11, R05-06)."""
        if self.entry and self.exit and self.entry.shares:
            value = self.sale_gross_total + self.exit.price * self.exit_residual_quantity + self.dividends_declared
            r = value / (self.entry.price * self.entry.shares) - 1
            return r.quantize(_Q)
        return None


def enter_basket(
    ledger: PaperLedger,
    *,
    picks: Sequence[str],
    slots: int,
    notional_per_slot: Decimal,
    open_prices: Mapping[str, Decimal],
    at: datetime,
    week_id: str,
    eligibility: Optional[Mapping[str, tuple[bool, str]]] = None,
) -> list[Slot]:
    """Entra en cada selección con importe nocional fijo por puesto.

    Un puesto fallido conserva su efectivo (SIM-09); no se redistribuye a los
    demás. Los puestos sin selección quedan en efectivo
    (``fill_unavailable_slots_with_cash``).
    """
    if len(picks) > slots:
        raise ValueError(f"{len(picks)} picks exceed {slots} slots")
    if len(set(picks)) != len(picks):
        raise ValueError(f"duplicate selections are not allowed: {list(picks)}")
    already = [slot_owner(week_id, r) for r in range(1, slots + 1) if slot_owner(week_id, r) in ledger.owners_seen]
    if already:
        raise ValueError(f"basket {week_id} already entered in this ledger (owners {already}); a basket is entered once (R05-05)")
    out: list[Slot] = []
    for rank in range(1, slots + 1):
        if rank > len(picks):
            out.append(Slot(rank, None, "empty", "no_selection"))
            continue
        sid = picks[rank - 1]
        owner = slot_owner(week_id, rank)
        if eligibility is not None:
            ok, why = eligibility.get(sid, (False, "not_in_eligibility_table"))
            if not ok:
                out.append(Slot(rank, sid, "entry_failed", f"ineligible:{why}", owner=owner))
                continue
        price = open_prices.get(sid)
        if price is None:
            out.append(Slot(rank, sid, "entry_failed", "no_open_price", owner=owner))
            continue
        price = D(price)
        unit_cost = price * (1 + ledger.costs.slippage) * (1 + ledger.costs.commission_per_side)
        lots = int((D(notional_per_slot) / (unit_cost * ledger.lot_size)).to_integral_value(rounding=ROUND_DOWN))
        shares = lots * ledger.lot_size
        if shares <= 0:
            out.append(Slot(rank, sid, "entry_failed", "notional_below_one_lot", owner=owner))
            continue
        existing = ledger.positions.get(sid)
        pre_qty = existing.total_quantity if existing is not None else D(0)
        res = ledger.buy(security_id=sid, price=price, shares=shares, at=at, event_id=f"{owner}:entry:{sid}", owner=owner)
        if isinstance(res, Rejection):
            out.append(Slot(rank, sid, "entry_failed", res.reason, owner=owner))
        else:
            slot = Slot(rank, sid, "filled", owner=owner, entry=res)
            if pre_qty:
                slot.notes.append(f"pre_existing_quantity_in_ledger_not_attributed:{pre_qty}")
            out.append(slot)
    return out


def exit_basket(
    ledger: PaperLedger,
    slots: Sequence[Slot],
    *,
    close_prices: Mapping[str, Decimal],
    at: datetime,
    week_id: str,
) -> list[Slot]:
    for s in slots:
        if s.status not in ("filled", "exit_blocked") or s.entry is None or s.security_id is None or s.owner is None:
            continue
        pos = ledger.positions.get(s.security_id)
        if pos is None:
            s.status = "exit_blocked"
            s.reason = "position_not_in_ledger"
            continue
        price = close_prices.get(s.security_id)
        if price is None:
            s.status = "exit_blocked"
            s.reason = "no_close_price"
            s.notes.append(f"exit_attempt_blocked:no_close_price@{at.isoformat()}")
            continue
        owned = pos.owner_quantity(s.owner)
        sellable = (int(owned.to_integral_value(rounding=ROUND_DOWN)) // ledger.lot_size) * ledger.lot_size
        if sellable <= 0:
            s.status = "exit_blocked"
            s.reason = "odd_lot_remainder_only"
            s.notes.append(f"exit_attempt_blocked:odd_lot_remainder_only@{at.isoformat()}")
            continue
        attempt = sum(1 for n in s.notes if n.startswith("exit_attempt_blocked"))
        res = ledger.sell(security_id=s.security_id, price=D(price), shares=sellable, at=at,
                          event_id=f"{s.owner}:exit:{s.security_id}:attempt{attempt}", owner=s.owner)
        if isinstance(res, Rejection):
            s.status = "exit_blocked"
            s.reason = res.reason
            s.notes.append(f"exit_attempt_blocked:{res.reason}@{at.isoformat()}")
        else:
            s.status = "exited"
            s.exit = res
            s.exit_attributed_quantity = owned
            remaining = ledger.positions.get(s.security_id)
            s.exit_residual_quantity = remaining.owner_quantity(s.owner) if remaining is not None else D(0)
            s.dividends_declared = ledger.declared_dividends(s.security_id, s.owner)
            s.sale_gross_total = ledger.owner_sale_gross(s.security_id, s.owner)
            if s.exit_residual_quantity:
                s.notes.append(f"residual_quantity_in_ledger:{s.exit_residual_quantity}")
    return list(slots)


@dataclass(frozen=True)
class BasketReport:
    week_id: str
    filled_slots: int
    empty_slots: int
    failed_slots: int
    exit_blocked_slots: int
    mean_gross_pick_return: Optional[Decimal]   # media de selecciones ejecutadas, bruta, con dividendos declarados
    portfolio_net_return: Decimal               # (patrimonio_fin - patrimonio_ini)/patrimonio_ini


def basket_report(week_id: str, slots: Sequence[Slot], *, equity_start: Decimal, equity_end: Decimal) -> BasketReport:
    """SIM-11: la media de las selecciones no es la rentabilidad de la cartera."""
    rets = [s.gross_pick_return for s in slots if s.gross_pick_return is not None]
    mean = (sum(rets, D(0)) / len(rets)) if rets else None
    return BasketReport(
        week_id=week_id,
        filled_slots=sum(1 for s in slots if s.status in ("filled", "exited", "exit_blocked")),
        empty_slots=sum(1 for s in slots if s.status == "empty"),
        failed_slots=sum(1 for s in slots if s.status == "entry_failed"),
        exit_blocked_slots=sum(1 for s in slots if s.status == "exit_blocked"),
        mean_gross_pick_return=mean,
        portfolio_net_return=(D(equity_end) - D(equity_start)) / D(equity_start),
    )
"""Plan semanal derivado del protocolo y del calendario oficial.

PROTOCOLO.yaml ``weekly_experiment``: corte **domingo 18:00 Asia/Taipei**;
plazo de emisión 08:30 de la primera sesión real de la semana natural
siguiente; entrada en la primera apertura válida **posterior al plazo**;
salida en el último cierre real de esa misma semana natural.

Reglas (rondas 3 y 4 de Astra):
- El experimento semanal sólo acepta cortes de domingo 18:00 Taipei; cualquier
  otro corte es una violación del protocolo, no una variante silenciosa
  (R04-05). El comparador diario (``daily_challenger``) está desactivado en el
  protocolo y tendrá su propio plan cuando se registre.
- Una semana sin sesiones produce ``invalid:no_sessions`` sin plazo, entrada
  ni salida; el plazo nunca salta a la semana siguiente (R03-03).
- La entrada es la primera apertura estrictamente posterior al plazo; si la
  primera sesión abre antes del plazo (horario especial), se usa la siguiente
  (R04-06).
"""
from __future__ import annotations

from dataclasses import dataclass
from datetime import date, datetime, time, timedelta
from typing import Optional

from .calendar import TradingCalendar
from .timeutil import TAIPEI, taipei, to_utc

WEEKLY_CUTOFF_TIME = time(18, 0)      # domingo
WEEKLY_DEADLINE_TIME = time(8, 30)
STATUS_VALID = "valid"
STATUS_NO_SESSIONS = "invalid:no_sessions"


class NoSessionsInWeek(ValueError):
    pass


class ProtocolViolation(ValueError):
    pass


@dataclass(frozen=True)
class WeekPlan:
    week_id: str                   # semana ISO objetivo, p. ej. 2026-W37
    target_monday: date
    cutoff_at: datetime
    status: str                    # valid | invalid:no_sessions
    sessions: tuple[date, ...]
    deadline_at: Optional[datetime]
    entry_at: Optional[datetime]   # apertura de la primera sesión posterior al plazo
    exit_at: Optional[datetime]    # cierre de la última sesión de la semana

    @property
    def is_valid(self) -> bool:
        return self.status == STATUS_VALID

    @property
    def registration_deadline_at(self) -> datetime:
        """Último instante para archivar y acreditar el registro de la corrida.

        Semana válida: el plazo de emisión. Semana sin sesiones: el final de la
        semana natural objetivo (domingo 24:00 Taipei), porque la corrida
        ``invalid:no_sessions`` se registra sin predicción y no hay plazo de
        emisión que la acote (R05-09).
        """
        if self.deadline_at is not None and self.is_valid:
            return self.deadline_at
        return taipei(self.target_monday + timedelta(days=7), time(0, 0))


def is_weekly_cutoff(cutoff_at: datetime) -> bool:
    local = to_utc(cutoff_at).astimezone(TAIPEI)
    return local.weekday() == 6 and local.time() == WEEKLY_CUTOFF_TIME


def target_monday_for(cutoff_at: datetime) -> date:
    """Lunes de la semana natural que empieza después del corte (en hora de Taipei)."""
    local = to_utc(cutoff_at).astimezone(TAIPEI)
    d = local.date() + timedelta(days=1)
    return d - timedelta(days=d.weekday())


def plan_week(cutoff_at: datetime, calendar: TradingCalendar) -> WeekPlan:
    if not is_weekly_cutoff(cutoff_at):
        raise ProtocolViolation(
            f"weekly experiment requires a Sunday {WEEKLY_CUTOFF_TIME.strftime('%H:%M')} Asia/Taipei cutoff; "
            f"got {to_utc(cutoff_at).astimezone(TAIPEI).isoformat()} (R04-05)"
        )
    monday = target_monday_for(cutoff_at)
    iso = monday.isocalendar()
    week_id = f"{iso[0]}-W{iso[1]:02d}"
    sessions = tuple(calendar.week_sessions(monday))
    if not sessions:
        return WeekPlan(week_id, monday, cutoff_at, STATUS_NO_SESSIONS, (), None, None, None)
    deadline = taipei(sessions[0], WEEKLY_DEADLINE_TIME)
    entry_sessions = [s for s in sessions if to_utc(calendar.session_open(s)) > to_utc(deadline)]
    if not entry_sessions:
        return WeekPlan(week_id, monday, cutoff_at, STATUS_NO_SESSIONS, sessions, deadline, None, None)
    return WeekPlan(
        week_id, monday, cutoff_at, STATUS_VALID, sessions,
        deadline_at=deadline,
        entry_at=calendar.session_open(entry_sessions[0]),
        exit_at=calendar.session_close(sessions[-1]),
    )


def weekly_deadline(cutoff_at: datetime, calendar: TradingCalendar) -> datetime:
    """Plazo del protocolo para el corte dado; falla si la semana objetivo no tiene sesiones."""
    plan = plan_week(cutoff_at, calendar)
    if plan.deadline_at is None or not plan.is_valid:
        raise NoSessionsInWeek(f"week {plan.week_id} starting {plan.target_monday} has no usable sessions; run must be {STATUS_NO_SESSIONS}")
    return plan.deadline_at

