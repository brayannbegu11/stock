      "prueba_propuesta": "from decimal import Decimal as D\nfrom tests.test_ledger import ledger, FREE, MON, FRI\nfrom twlab.ledger import CorporateAction\nfrom twlab.simulation import exit_basket\nfrom review.out.astra_scratch.test_ronda6 import enter\n\ndef test_promesa_documental_de_atribucion_sin_redondeo():\n    lg = ledger('200000', FREE)\n    w = enter(lg)\n    lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', MON, per_share_cash=D('1.2345'), pay_at=FRI))\n    exit_basket(lg, w, close_prices={'A': D(100)}, at=FRI, week_id='2030-W02')\n    assert w[0].gross_pick_return == D('.012345')\n",
