131:.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px 20px}
135:.phases{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
136:.phase{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px 16px 14px;position:relative}
