function t(k){ const v=S[state.lang][k]; return v===undefined?S.es[k]:v; }
function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function nf(x,d){ let o={minimumFractionDigits:d,maximumFractionDigits:d}; try{ o.useGrouping="always"; return new Intl.NumberFormat(LOC[state.lang],o).format(x); }catch(e){ delete o.useGrouping; return new Intl.NumberFormat(LOC[state.lang],o).format(x); } }
function pct(x,d,sign){ if(x==null||isNaN(x)) return "ΓÇö"; d=d==null?2:d; const s=x<0?"ΓêÆ":(sign===false?"":(x>0?"+":"")); return s+nf(Math.abs(x*100),d)+(state.lang==="es"?" %":"%"); }
function pp(x,d){ if(x==null||isNaN(x)) return "ΓÇö"; const s=x<0?"ΓêÆ":(x>0?"+":""); return s+nf(Math.abs(x*100),d==null?2:d); }
function twd(x){ if(x==null) return "ΓÇö"; return state.lang==="es"? nf(x,0)+" TWD" : "NT$"+nf(x,0); }
function twdShort(x){ const a=Math.abs(x); if(a>=1e6) return nf(x/1e6,1)+"M"; if(a>=1e3) return nf(x/1e3,0)+"k"; return nf(x,0); }
function cls(x){ return x==null?"flat":x>0?"up":x<0?"down":"flat"; }
function arrow(x){ return x==null?"":x>0?"Γû▓ ":x<0?"Γû╝ ":""; }
function fmtDate(iso,opts){ if(!iso) return "ΓÇö"; const d=new Date(iso); return new Intl.DateTimeFormat(LOC[state.lang],Object.assign({timeZone:"Asia/Taipei"},opts||{day:"numeric",month:"short",year:"numeric"})).format(d); }
function fmtDateTime(iso){ return fmtDate(iso,{weekday:"short",day:"numeric",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit",hour12:false}); }
function fmtDay(iso){ return fmtDate(iso,{day:"numeric",month:"short"}); }
function fmtPlainDate(ymd){ if(!ymd) return "ΓÇö"; return fmtDate(ymd+"T12:00:00+08:00",{day:"numeric",month:"short",year:"numeric"}); }
function fmtMonthRange(a,b){ if(!a||!b) return ""; const f=x=>new Intl.DateTimeFormat(LOC[state.lang],{month:"long",timeZone:"Asia/Taipei"}).format(new Date(x+"T12:00:00+08:00")); const y=b.slice(0,4); return state.lang==="zh"?`${y} σ╣┤${f(a)}Φç│${f(b)}`:`${f(a)}ΓÇô${f(b)} ${y}`; }
function narrow(){ try{ return matchMedia("(max-width:700px)").matches; }catch(e){ return false; } }
function scenario(id){ return (DATA.scenarios||[]).find(s=>s.id===id)||null; }
function anyScenario(){ return scenario("standard")||scenario("user")||(DATA.scenarios||[])[0]||null; }
function currentWeek(sc){ if(!sc) return null; const w=sc.weeks.filter(w=>w.pending_outcome); return w.length?w[w.length-1]:null; }
function gh(path){ return (DATA.repo||"#")+"/blob/main/"+path; }
function verdictCounts(rounds){ const c={rechazado:0,aprobado_con_cambios:0,aprobado:0}; for(const r of rounds||[]){ const v=r.verdict in c?r.verdict:(r.verdict==="aceptado"?"aprobado":"rechazado"); c[v]++; } return c; }
function verdictText(vc){ vc=vc||{}; return t("verdict_counts")(vc.rechazado||0,vc.aprobado_con_cambios||0,vc.aprobado||0); }
function lastBlockingRound(rounds){ let lb=0; for(const r of rounds||[]){ if((r.severity||{}).bloqueante) lb=r.round; } return lb; }
function statusReason(x){ const SR=t("status_reason")||{}; const k=x.status_reason||x.status||""; return SR[k]||SR[String(k).split(":")[0]]||k; }
function docTitle(d){
  const f=(d.file||"").split("/").pop(); const T=t("doc_titles"); let m;
  if(/^00_perfil/.test(f)) return T.profile; if(/^01_entendimiento/.test(f)) return T.plan; if(/^02_auditoria/.test(f)) return T.audit;
  if((m=f.match(/respuesta_ronda(\d+)/))) return T.response(parseInt(m[1],10));
  if((m=f.match(/^10_censo_(\d{4}-\d{2}-\d{2})/))) return `${T.census} ┬╖ ${m[1]}`;
  if(/^11_demo_q0/.test(f)) return T.demo; if(/^14_backtest_muestra/.test(f)) return T.sample;
  if(/^15c_/.test(f)) return T.longhist; if(/^15b_/.test(f)) return T.user; if(/^15_backtest_universo/.test(f)) return T.universe;
  return d.title;
}
/* facts derived from the data, shared by several sections */
function facts(){
  const std=scenario("standard"), usr=scenario("user"), base=anyScenario();
  const rounds=DATA.rounds||[], RS=DATA.review_stats||{}, ST=DATA.status||{};
  const net=(sc,f)=> sc&&sc.forecasters[f]? sc.forecasters[f].mean_weekly_net : null;
  const tots=[std,usr].filter(Boolean).flatMap(sc=>FC.map(f=>sc.forecasters[f]&&sc.forecasters[f].total_net_return).filter(x=>typeof x==="number"));
  const ci=usr&&usr.forecasters.Q1&&usr.forecasters.Q1.paired&&usr.forecasters.Q1.paired.ci95;
  const prospective=ST.prospective_weeks||[];
  return {
    w: base?base.weeks_operated:0, period: base?fmtMonthRange(base.period[0],base.period[1]):"",
    scenarios:(DATA.scenarios||[]).length, rounds:rounds.length, newTotal:RS.new_total||0, verified:RS.verified_total||0,
    std, usr, q0s:pct(net(std,"Q0")), q1s:pct(net(std,"Q1")), a1s:pct(net(std,"A1")),
    stdBelow: !!std && net(std,"Q0")<net(std,"A1") && net(std,"Q1")<net(std,"A1"),
    anyBeat: [std,usr].filter(Boolean).some(sc=> net(sc,"Q0")>net(sc,"A1") || net(sc,"Q1")>net(sc,"A1")),
    allLose: tots.length>0 && tots.every(x=>x<0), anyWin: tots.some(x=>x>0),
    ciKnown: !!ci, ciZero: !!ci && ci[0]<=0 && ci[1]>=0,
    prospective: prospective.length, firstProspective: prospective[0]||null, nextCutoff: ST.next_cutoff?fmtPlainDate(ST.next_cutoff):"ΓÇö",
    phase: ST.phase||2, phasesTotal: ST.phases_total||4
  };
}

/* =================================================================== render */
function render(){
  document.documentElement.lang = state.lang==="zh"?"zh-Hant-TW":state.lang;
  const v = facts();
  document.getElementById("app").innerHTML = [
    topbar(), hero(v), answers(v), statusSection(v), weekSection(), howSection(), resultsSection(), reviewSection(),
    dataSection(), glossSection(), docsSection(), footer()
  ].join("");
  wire();
}
const IDS={answers:"resumen",status:"estado",week:"semana",how:"como-funciona",results:"resultados",review:"revision",gloss:"palabras",docs:"documentos"};
function secHead(labelKey,titleHtml,sub){ return `<div class="sechead"><div class="eyebrow">${esc(t(labelKey))}</div><h2>${titleHtml}</h2>${sub?`<p>${sub}</p>`:""}</div>`; }
function topbar(){
  const nav=t("nav");
  return `<header class="top"><div class="wrap">
    <a class="brand" href="#top"><span class="mark">TW</span><b>Taiwan IA Lab</b></a>
    <nav class="nav" aria-label="${esc(t("nav_label"))}">${Object.keys(nav).map(k=>`<a href="#${IDS[k]}">${esc(nav[k])}</a>`).join("")}</nav>
    <div class="controls">
      <div class="seg" role="group" aria-label="Idioma / Language / Φ¬₧Φ¿Ç">${Object.keys(S).map(l=>`<button type="button" data-lang="${l}" aria-pressed="${l===state.lang}" lang="${l==="zh"?"zh-Hant":l}" title="${l==="es"?"Espa├▒ol":l==="en"?"English":"τ╣üΘ½öΣ╕¡µûç"}">${LANG_LABEL[l]}</button>`).join("")}</div>
      <button type="button" class="iconbtn" id="theme" title="${esc(t("theme"))}" aria-label="${esc(t("theme"))}">ΓùÉ</button>
    </div>
  </div></header>`;
}
function hero(v){
  const nav=t("nav");
  return `<a id="top"></a><section class="hero"><div class="wrap">
    <div class="eyebrow">${esc(t("eyebrow"))}</div>
    <h1>${esc(t("title"))}</h1>
    <p class="deck">${esc(t("deck"))}</p>
    <div class="statusbar"><span class="pill"><i></i>${esc(t("st_running"))} ┬╖ ${esc(t("st_phase")(v.phase,v.phasesTotal))}</span><span>${esc(t("st_updated")(fmtDate(DATA.generated_at,{day:"numeric",month:"long",year:"numeric"})))}</span></div>
    <div class="toc">${Object.keys(nav).map(k=>`<a href="#${IDS[k]}">${esc(nav[k])}</a>`).join("")}</div>
  </div></section>`;
}
function miniBars(v){
  const sc=v.std; if(!sc) return "";
  const vals=FC.map(f=>({f,v:sc.forecasters[f]?sc.forecasters[f].mean_weekly_net:null})).filter(x=>typeof x.v==="number");
  if(!vals.length) return "";
  const max=Math.max(...vals.map(x=>Math.abs(x.v)),0.001);
  const W=300,H=96,L=76,R=56,rowH=26; const zero=L+(W-L-R)/2;
  const rows=vals.map((x,i)=>{ const y=10+i*rowH; const len=(W-L-R)/2*Math.abs(x.v)/max; const x0=x.v<0?zero-len:zero; const col=x.v>0?"var(--up)":x.v<0?"var(--down)":"var(--fog)";
    return `<text x="${L-8}" y="${y+12}" text-anchor="end" style="fill:var(--ink-2);font-family:var(--font-sans);font-size:12px">${esc(t("fc_short")[x.f])}</text><rect x="${x0.toFixed(1)}" y="${y}" width="${Math.max(len,1.5).toFixed(1)}" height="16" rx="3" style="fill:${col}"/><text x="${(x.v<0?x0-6:x0+len+6).toFixed(1)}" y="${y+12}" text-anchor="${x.v<0?"end":"start"}" style="fill:var(--ink)">${esc(pct(x.v))}</text>`; }).join("");
  return `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="${esc(t("bars_cap"))}"><line x1="${zero}" x2="${zero}" y1="4" y2="${H-8}" stroke="var(--line-2)"/>${rows}</svg>`;
}
function answers(v){
  const works=t("a_works")(v); const worksCls=v.stdBelow&&v.allLose?"no":"mid";
  return `<section class="block" id="${IDS.answers}"><div class="wrap">
