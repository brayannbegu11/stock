+import importlib.util, json, hashlib, subprocess
+from pathlib import Path
+from datetime import datetime, date, time, timezone
+from dataclasses import replace
+import pytest
+from review.out.astra_scratch.r10_support import fixture, Runner, BacktestConfig, MomentumForecaster, RandomForecaster, D, ROOT, taipei
+from twlab.store import RawStore, IntegrityError
+from twlab.weekly import plan_week
+from twlab.packet import packet_to_json
+from twlab.backtest import _sundays, markdown_report
+
+def load(name):
+    s=importlib.util.spec_from_file_location('r20_'+name,ROOT/'scripts'/f'{name}.py')
+    m=importlib.util.module_from_spec(s);s.loader.exec_module(m);return m
+ex=load('export_site_data')
+asm=load('assemble_backtest_reports')
+
+def source(sid):
+    _,pattern,_=next(s for s in ex.SCENARIOS if s[0]==sid)
+    return json.loads(ex.latest_json(pattern).read_text(encoding='utf8'))
+
+def render(mode='normal'):
+    p=subprocess.run(['node','review/out/astra_scratch/r20_render.cjs',mode],cwd=ROOT,capture_output=True,text=True,encoding='utf8',check=True)
+    return json.loads(p.stdout)
+
+def archive(tmp_path, monkeypatch, rows):
+    # Explicitly synthetic records under scratch; no production clocks or records changed.
+    monkeypatch.setattr(ex,'RAW',tmp_path)
+    records=[]
+    for i,(f,at,dl) in enumerate(rows):
+        body={'forecast':{'deadline_at':dl,'ranking':[{'security_id':str(i)}]}}
+        payload=json.dumps(body).encode();path=f'{i}.json';(tmp_path/path).write_bytes(payload)
+        records.append(dict(source_id='forecast',dataset=f'lab/{f}/2026-W38',ingested_at=at,path=path,sha256=hashlib.sha256(payload).hexdigest(),clock_source='system'))
+    (tmp_path/'manifest.jsonl').write_text('\n'.join(map(json.dumps,records)),encoding='utf8')
+    return ex.forecast_archive('lab','2026-W38')
+
+@pytest.mark.parametrize('missing',[False,True])
+def test_each_forecaster_must_meet_own_deadline(tmp_path,monkeypatch,missing):
+    result=archive(tmp_path,monkeypatch,[('Q0','2026-09-14T00:20:00+00:00','2026-09-14T10:30:00+08:00'),('Q1','2026-09-14T00:40:00+00:00',None if missing else '2026-09-14T08:30:00+08:00'),('A1','2026-09-14T00:20:00+00:00','2026-09-14T08:30:00+08:00')])
+    assert result['before_deadline'] is not True,result
+
+def test_injected_clock_is_not_system_evidence(tmp_path,monkeypatch):
+    raw=RawStore(tmp_path,clock=lambda:datetime(2026,9,13,12,tzinfo=timezone.utc))
+    raw.put(source_id='forecast',dataset='lab/Q0/2026-W38',payload=b'{"forecast":{"deadline_at":"2026-09-14T08:30:00+08:00"}}',url='synthetic',content_type='application/json')
+    monkeypatch.setattr(ex,'RAW',tmp_path)
+    assert ex.forecast_archive('lab','2026-W38')['before_deadline'] is not True
+
+def test_missing_forecasters_not_complete_list(tmp_path,monkeypatch):
+    result=archive(tmp_path,monkeypatch,[('Q0','2026-09-13T12:00:00+00:00','2026-09-14T08:30:00+08:00')])
+    assert result['before_deadline'] is not True,result
+
+def test_naive_deadline_fails_closed(tmp_path,monkeypatch):
+    result=archive(tmp_path,monkeypatch,[('Q0','2026-09-13T12:00:00+00:00','2026-09-14T08:30:00')])
+    assert result['before_deadline'] is not True
+
+def test_late_changed_list_not_given_first_list_timestamp(tmp_path,monkeypatch):
+    raw,m=fixture(tmp_path,symbols=('A','B'))
+    now=[datetime(2024,1,7,12,tzinfo=timezone.utc)]
+    monkeypatch.setattr(raw,'_now',lambda:now[0]) # synthetic test clock
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,7),slots=1,notional=10000,lot_size=1,label='first',archive_label='lab')
+    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)]);r.run_week(date(2024,1,7))
+    old=r.weeks[-1]['forecasters']['A1']['picks'];first=raw.captures(source_id='forecast',dataset='lab/A1/2024-W02')[0]
+    now[0]=datetime(2024,1,8,1,tzinfo=timezone.utc)
+    for seed in range(2,30):
+        r2=Runner(raw,m,replace(cfg,label='later'),[MomentumForecaster(),RandomForecaster(seed)])
+        r2.run_week(date(2024,1,7))
+        if r2.weeks[-1]['forecasters']['A1']['picks']!=old:break
+    assert r2.weeks[-1]['forecasters']['A1']['picks']!=old
+    monkeypatch.setattr(ex,'RAW',raw.root)
+    result=ex.forecast_archive('lab','2024-W02')
+    assert raw.read(first) and first.ingested_at=='2024-01-07T12:00:00+00:00'
+    assert result['before_deadline'] is not True,{'old':old,'new':r2.weeks[-1]['forecasters']['A1']['picks'],'archive':result,'seed':seed}
+
+@pytest.mark.parametrize('sid',['standard','user','longhist'])
+def test_sunday_pending_entry_report_does_not_crash(tmp_path,sid):
+    raw,m=fixture(tmp_path)
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,7),slots=1,notional=10000,lot_size=1)
