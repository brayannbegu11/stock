+            if not rs:bad.append((w['week_id'],f,'missing'));continue
+            r=rs[0];payload=(raw/r['path']).read_bytes()
+            if hashlib.sha256(payload).hexdigest()!=r['sha256']:bad.append((w['week_id'],f,'sha'))
+            archived=json.loads(payload)['forecast']['ranking']
+            old=[p['security_id'] for p in archived];new=[p['security_id'] for p in x['picks']]
+            if old!=new:mismatches.append({'week':w['week_id'],'f':f,'first':old,'displayed':new,'first_at':r['ingested_at'],'latest_at':rs[-1]['ingested_at']})
+            entries.append({'week':w['week_id'],'f':f,'n':len(rs),'unique_bytes':len({r['sha256'] for r in rs})})
+    out[sid]={'source':ex.latest_json(pattern).name,'bad':bad,'first_list_mismatches':mismatches,'multiple_payloads':[r for r in entries if r['unique_bytes']>1],'training':s['forecasters']['Q1'].get('training_history'),'pro':ex.forecast_archive(label,d['weeks'][-1]['week_id'])}
+print(json.dumps(out,ensure_ascii=False,indent=2))
