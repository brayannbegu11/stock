+            if hashlib.sha256(payload).hexdigest()!=r['sha256']:bad.append((w['week_id'],f,'sha'))
+            archived=json.loads(payload)['forecast']['ranking']
+            old=[p['security_id'] for p in archived];new=[p['security_id'] for p in x['picks']]
+            if old!=new:mismatches.append({'week':w['week_id'],'f':f,'first':old,'displayed':new,'first_at':r['ingested_at'],'latest_at':rs[-1]['ingested_at']})
+            entries.append({'week':w['week_id'],'f':f,'n':len(rs),'unique_bytes':len({r['sha256'] for r in rs})})
+    out[sid]={'source':ex.latest_json(pattern).name,'bad':bad,'first_list_mismatches':mismatches,'multiple_payloads':[r for r in entries if r['unique_bytes']>1],'training':s['forecasters']['Q1'].get('training_history'),'pro':ex.forecast_archive(label,d['weeks'][-1]['week_id'])}
+print(json.dumps(out,ensure_ascii=False,indent=2))
diff --git a/review/out/astra_scratch/r20_render.cjs b/review/out/astra_scratch/r20_render.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..1e36f6960a814f6abd299d04585ff58f3781e984
--- /dev/null
+++ b/review/out/astra_scratch/r20_render.cjs
@@ -0,0 +1,19 @@
+const fs=require('fs'),vm=require('vm');
+const html=fs.readFileSync('docs/index.html','utf8');
+const data=JSON.parse(fs.readFileSync('docs/site/data.json','utf8'));
+let code=[...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].pop()[1];
+code=code.replace(/state.lang\s*=\s*detectLang\(\);\s*render\(\);/,'globalThis.api={S,DATA,state,facts,answers,statusSection,weekSection,reviewSection,kpiAndChart};');
+const mode=process.argv[2];
+if(mode==='profitable'||mode==='longhist') for(const sc of data.scenarios){
+ if(mode==='longhist'&&sc.id!=='longhist')continue;
+ for(const [f,x] of Object.entries(sc.forecasters)){
+  x.total_net_return=.25;x.final_equity=sc.assumptions.initial_cash_twd*1.25;x.mean_weekly_net=f==='A1'?.01:.03;
+  if(x.paired)Object.assign(x.paired,{mean:.02,ci95:[.01,.03],degenerate:false});
+ }
+}
+if(mode==='prospective') Object.assign(data.status,{phase:3,prospective_weeks:['2026-W38'],prospective_count:1});
+if(mode==='review') data.rounds=[{round:1,findings_new:0,severity:{},verdict:'aprobado',summary:'',new_findings:[]},{round:2,findings_new:0,severity:{},verdict:'aprobado_con_cambios',summary:'',new_findings:[]}];
+const ctx={document:{getElementById:()=>({textContent:JSON.stringify(data)})},Intl,URLSearchParams};
+vm.createContext(ctx);vm.runInContext(code,ctx);const a=ctx.api,out={};
+for(const lang of ['es','en','zh']){a.state.lang=lang;const v=a.facts();out[lang]={facts:v,works:a.S[lang].works_p(v),answer:a.S[lang].a_works(v),status:a.statusSection(v),invest:a.S[lang].invest_p(v),review:a.reviewSection(),cost:a.S[lang].kpi.costs,kpi:a.kpiAndChart(a.DATA.scenarios[1]),limits:a.S[lang].limits,steps:a.S[lang].steps};}
+process.stdout.write(JSON.stringify(out));
