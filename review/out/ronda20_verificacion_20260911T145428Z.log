  --accent:#7FB2EE; --accent-ink:#0B1A2C; --accent-soft:#1C2E44; --accent-line:#3C5F8A;
  --up:#F0746A; --down:#4FCB8C; --up-soft:#3B1F1C; --down-soft:#173327;
  --warn:#E2B95B; --warn-soft:#3A2E15; --ok:#4FCB8C; --ok-soft:#173327;
  --q0:#7FB2EE; --q1:#B9A0F5; --a1:#9A9CA4;
  --sev-block:#F08C8C; --sev-high:#F5A27E; --sev-mid:#E2B95B; --sev-low:#6A6D75;
  color-scheme:dark;
}

/* ---------- base ---------- */
*{box-sizing:border-box;min-width:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto} *,*::before,*::after{transition:none!important;animation:none!important}}
body{margin:0;background:var(--canvas);color:var(--ink);font-family:var(--font-sans);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:clip}
a{color:var(--accent);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
a:hover{text-decoration-thickness:2px}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
h1,h2,h3,h4{margin:0;line-height:1.15;text-wrap:balance}
h1,h2{font-family:var(--font-display);font-weight:500;letter-spacing:-.01em}
h1{font-size:clamp(2rem,5.5vw,3.4rem);line-height:1.08;font-variation-settings:"opsz" 144}
h2{font-size:clamp(1.55rem,3.6vw,2.2rem);font-variation-settings:"opsz" 72}
h3{font-family:var(--font-sans);font-weight:600;font-size:1.1rem}
h4{font-family:var(--font-sans);font-weight:600;font-size:1rem}
p{margin:0}
.mono{font-family:var(--font-mono);font-feature-settings:"zero"}
.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums;font-feature-settings:"zero","tnum"}
.eyebrow{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;color:var(--fog)}
.wrap{max-width:1040px;margin:0 auto;padding:0 clamp(16px,4vw,32px)}
.up{color:var(--up)} .down{color:var(--down)} .flat{color:var(--fog)}
.scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
.dot{width:10px;height:10px;border-radius:50%;flex:none;background:var(--fog)}
.dot.Q0{background:var(--q0)} .dot.Q1{background:var(--q1)} .dot.A1{background:var(--a1)}
.chip{display:inline-flex;align-items:center;gap:5px;font-family:var(--font-mono);font-size:.68rem;letter-spacing:.03em;padding:2px 8px;border-radius:999px;border:1px solid var(--line-2);color:var(--ink-2);background:var(--surface);white-space:nowrap;vertical-align:middle}
.chip.ok{color:var(--ok);border-color:transparent;background:var(--ok-soft)}
.chip.bad{color:var(--up);border-color:transparent;background:var(--up-soft)}
.chip.warn{color:var(--warn);border-color:transparent;background:var(--warn-soft)}
.chip.info{color:var(--accent);border-color:transparent;background:var(--accent-soft)}
.chip.Q0{color:var(--q0);border-color:var(--q0)} .chip.Q1{color:var(--q1);border-color:var(--q1)} .chip.A1{color:var(--ink-2);border-color:var(--line-2)}
.chip.soft{white-space:normal;border-radius:6px;text-align:left}

/* ---------- top bar ---------- */
.top{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--canvas) 88%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;gap:16px;height:54px}
.brand{display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--ink);white-space:nowrap}
.brand .mark{width:24px;height:24px;border-radius:6px;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;font-family:var(--font-mono);font-size:.62rem;font-weight:500}
.brand b{font-weight:600;font-size:.95rem}
.nav{display:flex;gap:2px;margin-left:auto;overflow-x:auto;scrollbar-width:none}
.nav::-webkit-scrollbar{display:none}
.nav a{font-size:.86rem;color:var(--ink-2);text-decoration:none;padding:6px 9px;border-radius:var(--r-sm);white-space:nowrap}
.nav a:hover{background:var(--surface-2);color:var(--ink)}
.controls{display:flex;gap:8px;align-items:center;flex-shrink:0;margin-left:auto}
.nav + .controls{margin-left:0}
.seg{display:inline-flex;border:1px solid var(--line-2);border-radius:var(--r-sm);padding:2px;background:var(--surface)}
.seg button{border:0;background:transparent;color:var(--fog);font:inherit;font-size:.8rem;font-weight:600;padding:4px 9px;border-radius:5px;cursor:pointer;line-height:1.3}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--canvas)}
.iconbtn{border:1px solid var(--line-2);background:var(--surface);color:var(--fog);width:32px;height:32px;border-radius:var(--r-sm);cursor:pointer;display:inline-grid;place-items:center;font-size:.9rem}

/* ---------- hero ---------- */
.hero{padding:clamp(40px,7vw,88px) 0 clamp(24px,4vw,40px)}
.hero h1{margin:14px 0 18px;max-width:18ch}
.hero .deck{font-size:clamp(1.05rem,2vw,1.25rem);color:var(--ink-2);max-width:60ch;line-height:1.55}
.statusbar{margin-top:26px;display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;font-size:.9rem;color:var(--ink-2)}
.statusbar .pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:var(--surface);border:1px solid var(--line-2);font-weight:600;color:var(--ink)}
.statusbar .pill i{width:9px;height:9px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 3px var(--ok-soft)}
.toc{margin-top:22px;display:flex;flex-wrap:wrap;gap:6px}
.toc a{font-size:.86rem;color:var(--ink-2);text-decoration:none;padding:6px 11px;border:1px solid var(--line-2);border-radius:999px;background:var(--surface)}
.toc a:hover{border-color:var(--accent);color:var(--accent)}

/* ---------- sections ---------- */
section.block{padding:clamp(40px,6vw,72px) 0;border-top:1px solid var(--line)}
.sechead{margin-bottom:24px;max-width:760px}
.sechead .eyebrow{margin-bottom:8px}
.sechead p{color:var(--ink-2);margin-top:10px;max-width:66ch}
.answers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.ans{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:20px 20px 18px;display:flex;flex-direction:column;gap:8px}
.ans .q{font-size:.95rem;color:var(--fog);font-weight:600}
.ans .a{font-family:var(--font-display);font-size:2rem;font-weight:600;line-height:1.05;font-variation-settings:"opsz" 72;letter-spacing:-.01em}
.ans .a.no{color:var(--up)} .ans .a.yes{color:var(--down)} .ans .a.mid{color:var(--warn)}
.ans p{font-size:.95rem;color:var(--ink-2);line-height:1.5}
.ans svg{margin-top:6px}
.callout{position:relative;border:1px solid var(--line);border-radius:var(--r);padding:14px 18px 14px 20px;background:var(--surface);color:var(--ink-2);font-size:.97rem;max-width:860px}
.callout::before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:3px;border-radius:3px;background:var(--warn)}
.callout.info::before{background:var(--accent)}
.callout.ok::before{background:var(--ok)}
.callout b{color:var(--ink)}
.note{color:var(--fog);font-size:.88rem;line-height:1.5;margin-top:10px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px 20px}
.card h3{margin-bottom:12px}

/* ---------- roadmap ---------- */
.phases{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.phase{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px 16px 14px;position:relative}
.phase .n{font-family:var(--font-mono);font-size:.7rem;color:var(--fog);letter-spacing:.08em;text-transform:uppercase;display:flex;justify-content:space-between;align-items:center;gap:8px}
.phase h4{margin:8px 0 6px;font-size:1.02rem}
.phase p{font-size:.9rem;color:var(--ink-2);line-height:1.45}
.phase.done{border-color:color-mix(in srgb,var(--ok) 45%,var(--line))}
.phase.now{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.twocol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}
ul.plain{margin:8px 0 0;padding-left:1.15em;color:var(--ink-2);font-size:.95rem}
ul.plain li{margin:5px 0}
ul.plain li b{color:var(--ink);font-weight:600}

/* ---------- week board ---------- */
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
.tab{border:1px solid var(--line-2);background:var(--surface);color:var(--ink-2);border-radius:999px;padding:8px 14px;font:inherit;font-size:.88rem;font-weight:600;cursor:pointer;display:inline-flex;flex-direction:column;align-items:flex-start;gap:1px;text-align:left}
.tab .sub{font-family:var(--font-mono);font-size:.66rem;font-weight:400;color:var(--fog);letter-spacing:.02em}
.tab[aria-selected="true"]{background:var(--ink);color:var(--canvas);border-color:var(--ink)}
58:body{margin:0;background:var(--canvas);color:var(--ink);font-family:var(--font-sans);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:clip}
