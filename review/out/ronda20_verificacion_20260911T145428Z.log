151:.tab[aria-selected="true"]{background:var(--ink);color:var(--canvas);border-color:var(--ink)}
154:.col{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
165:.col footer{padding:10px 16px 12px;border-top:1px solid var(--line);background:var(--surface-2);font-size:.85rem;color:var(--ink-2);display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}
170:.step{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px}
195:.kcard{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--surface-2)}
205:.weeks tbody tr.wk:hover td{background:var(--surface-2)}
206:.weeks tr.detail td{background:var(--surface-2);padding:12px 14px}
209:.dgrid .f{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:12px 14px}
235:.rounds{border-top:1px solid var(--line);margin-top:8px}
236:.round{display:grid;grid-template-columns:56px 1fr;gap:14px;padding:14px 0;border-bottom:1px solid var(--line)}
237:.round .n{font-family:var(--font-display);font-size:1.5rem;line-height:1}
