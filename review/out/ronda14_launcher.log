[31;1m    while i < n:[0m
[31;1m        j = i[0m
[31;1m        while j + 1 < n and values[order[j + 1]] == values[order[i]]:[0m
[31;1m            j += 1[0m
[31;1m        avg = (i + j) / 2 / (n - 1)[0m
[31;1m        for k in range(i, j + 1):[0m
