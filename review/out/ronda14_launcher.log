      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner\nfrom review.out.astra_scratch.test_r13_attacks import cash\n\ndef test_unknown_dividend_invalidates_reported_pick_return(tmp_path):\n    result = runner(tmp_path, end='2024-01-12', dividends=[cash(10),cash(0)]).run()\n    fr = result['weeks'][0]['forecasters']['Q0']\n    assert fr['portfolio_net_return_open_close'] is None\n    assert fr['mean_gross_pick_return'] is None\n    assert result['summary']['forecasters']['Q0']['mean_weekly_gross_pick_return'] is None\n",
