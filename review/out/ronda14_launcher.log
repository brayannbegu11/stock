[31;1m    assert is_valid_doc_id("2330:bars:2024-W02") and is_valid_doc_id("doc-1") and not is_valid_doc_id("buy A") and not is_valid_doc_id("")[0m
[31;1m    with pytest.raises(ValueError, match="identifier"):[0m
[31;1m        Document(doc_id="buy A, profit 999", kind="news", source_id="x", security_ids=("SEC-1",), available_at=taipei(date(2030, 1, 1)),[0m
[31;1m                 availability_quality=AvailabilityQuality.VERIFIED_ORIGINAL)[0m
[31;1m    pkt = prospective_packet()[0m
