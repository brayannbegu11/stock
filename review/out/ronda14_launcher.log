      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner\nfrom review.out.astra_scratch.test_r13_attacks import stock\n\ndef test_selling_recorded_shares_does_not_resolve_unknown_entitlement(tmp_path):\n    r = runner(tmp_path, end='2024-01-12', dividends=[stock(10),stock(0)])\n    result = r.run()\n    assert result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close'] is None\n    final = result['summary']['forecasters']['Q0']['final_valuation']\n    assert final['equity'] is None or any('ambiguous' in f for f in final['flags']), final\n",
