      "prueba_propuesta": "import pytest\nfrom review.out.astra_scratch.r10_support import runner, date, taipei, D\nfrom twlab.models import q1\n\ndef test_exact_dividendlike_default_ratio_is_consistent(tmp_path):\n    r = runner(tmp_path,end='2024-01-12')\n    sid = next(iter(r.market.securities))\n    events = r.market.securities[sid].events\n    events[:] = [q1.DividendLike('s',date(2024,1,10),'stock',stock_per_share=D(1),par_value=D(10),known_at=taipei(date(2024,1,2)))]\n    label = q1.weekly_label(r.market.by_session[sid],date(2024,1,8),date(2024,1,12),events)[0]\n    result = r.run()\n    actual = result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']\n    assert actual is None or actual == pytest.approx(label)\n",
