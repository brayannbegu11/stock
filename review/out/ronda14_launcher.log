[31;1mdef features_from_bars(bars: Sequence[BarLike], cutoff_at: datetime, *, sessions_expected_20: int = 20) -> Optional[dict[str, float]]:[0m
[31;1m    """Características de un valor en el corte; ``None`` si no hay historial suficiente (121 barras)."""[0m
[31;1m    known = [b for b in bars if to_utc(b.available_at) <= to_utc(cutoff_at) and b.close > 0 and b.open > 0][0m
[31;1m    if len(known) < 121:[0m
[31;1m        return None[0m
[31;1m    closes = [float(b.close) for b in known][0m
[31;1m    values = [float(b.value_twd) for b in known][0m
[31;1m    c = closes[-1][0m
[31;1m    rets = [math.log(closes[i] / closes[i - 1]) for i in range(1, len(closes)) if closes[i - 1] > 0][0m
[31;1m    return {[0m
[31;1m        "ret_5": math.log(c / closes[-6]), "ret_20": math.log(c / closes[-21]), "ret_60": math.log(c / closes[-61]),[0m
[31;1m        "ret_120": math.log(c / closes[-121]),[0m
[31;1m        "vol_20": statistics.pstdev(rets[-20:]) if len(rets) >= 20 else 0.0,[0m
[31;1m        "vol_60": statistics.pstdev(rets[-60:]) if len(rets) >= 60 else 0.0,[0m
[31;1m        "log_value_20": math.log(max(statistics.median(values[-20:]), 1.0)),[0m
[31;1m        "value_ratio_5_60": (statistics.fmean(values[-5:]) / max(statistics.fmean(values[-60:]), 1.0)),[0m
[31;1m        "dist_high_120": c / max(closes[-120:]) - 1.0,[0m
[31;1m        "missing_20": float(sessions_expected_20 - min(20, sum(1 for b in known[-20:] if (cutoff_at.date() - b.session).days <= 35))),[0m
[31;1m        "ret_5_lag_20": math.log(closes[-21] / closes[-26]),[0m
[31;1m    }[0m
