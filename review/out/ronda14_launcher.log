[31;1m    with tempfile.TemporaryDirectory() as tmp:[0m
[31;1m        store = RawStore(pathlib.Path(tmp))[0m
[31;1m        assert any("not one of the templates" in p for p in rp(smuggling, store=store))[0m
[31;1m        canonical = replace(pkt, rejected=(Rejection("ghost", "available_after_cutoff", ok),))[0m
[31;1m        assert rp(canonical, store=store) == [][0m
