[31;1mdef test_r10_07_r09_06_period_end_is_respected_and_entries_before_the_bound_are_executed(tmp_path):[0m
[31;1m    store, path = make_market(tmp_path)                          # datos hasta el viernes 29-03-2024[0m
[31;1m    m = load_market(store, path, CAL)[0m
[31;1m    # fin del periodo un miércoles: la entrada del lunes 8-01 se ejecuta, la salida del viernes 12-01 queda pendiente[0m
[31;1m    cfg = BacktestConfig(start=date(2024, 1, 1), end=date(2024, 1, 10), label="t")[0m
[31;1m    res = Runner(store, m, cfg, [MomentumForecaster(), RandomForecaster(1)]).run()[0m
[31;1m    s = res["summary"][0m
[31;1m    assert s["simulation_bound"] == "2024-01-10" and s["weeks_pending_outcome"] == ["2024-W02"][0m
[31;1m    w = next(w for w in res["weeks"] if w["week_id"] == "2024-W02")[0m
[31;1m    assert w["forecasters"]["Q0"]["filled"] == 5 and w["forecasters"]["Q0"].get("portfolio_net_return_open_close") is None[0m
[31;1m    assert s["forecasters"]["Q0"]["final_valuation"]["valued_at"].startswith("2024-01-10")[0m
[31;1m    assert s["forecasters"]["Q0"]["final_valuation"]["positions_value"] > 0          # las posiciones siguen abiertas[0m
[31;1m    assert s["forecasters"]["Q0"]["baskets_in_follow_up_at_end"] == ["2024-W02"][0m
[31;1m    # y con más datos archivados que el periodo pedido no se consulta nada posterior: mismo resultado[0m
[31;1m    store2, path2 = make_market(tmp_path / "longer", end=date(2024, 6, 28))[0m
[31;1m    res2 = Runner(store2, load_market(store2, path2, CAL), cfg, [MomentumForecaster(), RandomForecaster(1)]).run()[0m
[31;1m    assert res2["summary"]["simulation_bound"] == "2024-01-10" and res2["summary"]["weeks_pending_outcome"] == ["2024-W02"][0m
