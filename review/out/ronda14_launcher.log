      "prueba_propuesta": "from review.out.astra_scratch.r10_support import fixture, date, time, taipei\nfrom review.out.astra_scratch.test_r13_attacks import cash\nfrom twlab.backtest import TabularForecaster\n\ndef test_updated_capture_invalidates_cached_training(tmp_path):\n    _, m = fixture(tmp_path/'clean', end='2024-01-12', dividends=[cash(10)])\n    _, n = fixture(tmp_path/'ambiguous', end='2024-01-12', dividends=[cash(10),cash(0)])\n    sid = next(iter(m.securities))\n    f = TabularForecaster(m, min_weeks=1, retrain_every_weeks=1)\n    f.maybe_train(taipei(date(2024,1,14),time(18)))\n    old_id = f.model.training_manifest_id\n    m.securities[sid].events[:] = n.securities[sid].events\n    m.securities[sid].dividend_capture = n.securities[sid].dividend_capture\n    assert m.data_version != f.data_version\n    try:\n        f.maybe_train(taipei(date(2024,1,21),time(18)))\n    except ValueError:\n        return\n    assert f.model.training_manifest_id != old_id\n",
