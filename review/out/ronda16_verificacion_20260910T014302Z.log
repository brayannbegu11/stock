+def daily(tmp_path, market='TWSE', days=('2024-01-04','2024-01-05'), body_day=None, listing='2000-01-01', zero_last=False):
+    raw=RawStore(tmp_path/'raw'); master=SecurityMaster()
+    master.add(SecurityVersion('A','issuer','2330','A',market,'main','ordinary_equity',date.fromisoformat(listing),None,taipei(date(2024,1,1)),'test'))
+    cal=TradingCalendar(start=date(2024,1,1),end=date(2024,1,31),closures=[],source_id='test',recorded_at=taipei(date(2024,1,1)))
+    source='twse' if market=='TWSE' else 'tpex'; dataset=td.TWSE_DATASET if market=='TWSE' else td.TPEX_DATASET
+    fields=['Φ¡ëσê╕Σ╗úΦÖƒ','Θûïτ¢ñσâ╣','µ£ÇΘ½ÿσâ╣','µ£ÇΣ╜Äσâ╣','µö╢τ¢ñσâ╣','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì','µêÉΣ║ñτ¡åµò╕'] if market=='TWSE' else ['Σ╗úΦÖƒ','Θûïτ¢ñ','µ£ÇΘ½ÿ','µ£ÇΣ╜Ä','µö╢τ¢ñ','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì(σàâ)','µêÉΣ║ñτ¡åµò╕']
+    for day in days:
+        p='--' if zero_last and day==days[-1] else '100'
+        body={'stat':'OK','date':(body_day or day).replace('-',''),'tables':[{'title':'µ»ÅµùÑµö╢τ¢ñΦíîµâà' if market=='TWSE' else 'Σ╕èµ½âΦéíτÑ¿Φíîµâà','fields':fields,'data':[['2330',p,p,p,p,'1,000','100,000','10'],['0050','100','100','100','100','1000','100000','10']]}]}
+        raw.put(source_id=source,dataset=f'{dataset}/{day}',payload=json.dumps(body).encode(),url='fixture',http_status=200)
+    m=load_market_daily(raw,cal,master,as_of=date(2024,1,7),start=date.fromisoformat(days[0]),end=date.fromisoformat(days[-1]))
+    return raw,m
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_payload_date_must_match_session(tmp_path,market):
+    try:
+        raw,m=daily(tmp_path,market,days=('2024-01-05',),body_day='2024-01-12')
+    except ValueError:
+        return
+    assert not m.securities, [(b.session,b.close) for b in m.securities['A'].bars]
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_daily_packet_has_real_provenance(tmp_path,market):
+    raw,m=daily(tmp_path,market)
+    cfg=BacktestConfig(start=date(2024,1,1),end=date(2024,1,12))
+    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
+    p,_,_=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    d=p.admitted[0]; capture=raw.get(d.capture_id)
+    assert d.source_id==capture.source_id, (d.source_id,capture.source_id,d.derivation)
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_price_capture_tracks_last_kept_bar(tmp_path,market):
+    raw,m=daily(tmp_path,market,zero_last=True)
+    s=m.securities['A']
+    assert s.price_capture.dataset.endswith(s.bars[-1].session.isoformat()),(s.price_capture.dataset,s.bars[-1].session)
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_listing_and_ordinary_equity_control(tmp_path,market):
+    raw,m=daily(tmp_path,market,listing='2024-01-05')
+    assert set(m.securities)=={'A'} and m.bars_before_listing_dropped==1
+    assert [b.session for b in m.securities['A'].bars]==[date(2024,1,5)]
+    assert len(m.warnings)==2 and 'sin captura' in m.warnings[1]
+
+
+@pytest.mark.parametrize('change',['calendar','ex_date'])
+def test_hash_covers_calendar_and_ex_date(tmp_path,change):
+    _,m=fixture(tmp_path,end='2024-01-12',dividends=[cash(10)])
+    f=TabularForecaster(m,min_weeks=1,retrain_every_weeks=1)
