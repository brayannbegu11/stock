import pytest


def ledger():
    lg = PaperLedger(ledger_id='t', initial_cash=D(400000), cost_model=CostModel(commission_per_side=D(0), sell_tax=D(0)))
    lg.buy(security_id='A', price=D(100), shares=1000, at=taipei(date(2024,1,8), time(9)), event_id='buy', owner='w')
    return lg


def action(lg, eid, day, per, par):
    lg.apply_corporate_action(CorporateAction(eid, 'A', 'stock_dividend', taipei(date(2024,1,day)), stock_per_share=D(per), par_value=D(par)))


def test_cash_from_rational_does_not_lose_one_twd():
    lg = ledger()
    action(lg, 's', 9, 1, 3)
    assert lg.positions['A'].lots[0].rational() == Fraction(4000,3)
    lg.apply_corporate_action(CorporateAction('c','A','cash_dividend',taipei(date(2024,1,10)),per_share_cash=D(3)))
    assert lg.receivables[0].amount == D(4000), lg.receivables


def test_partial_sale_then_cash_uses_remaining_exact_quantity():
    lg=ledger(); action(lg,'s',9,1,3)
    sold=lg.sell(security_id='A',price=D(100),shares=1000,at=taipei(date(2024,1,10),time(9)),event_id='sell',owner='w')
    assert isinstance(sold,Fill)
    assert lg.positions['A'].lots[0].rational()==Fraction(1000,3)
    lg.apply_corporate_action(CorporateAction('c','A','cash_dividend',taipei(date(2024,1,11)),per_share_cash=D(3)))
    assert lg.receivables[0].amount==1000,lg.receivables


def test_reverse_split_cannot_sell_rounded_up_fraction():
    lg=ledger()
    lg.apply_corporate_action(CorporateAction('rs','A','split',taipei(date(2024,1,9)),split_ratio=D('0.99999999999999999999999999999')))
    lot=lg.positions['A'].lots[0]
    exact_before=lot.rational()
    assert exact_before < 1000
    sale=lg.sell(security_id='A',price=D(100),shares=1000,at=taipei(date(2024,1,10)),event_id='sell')
    assert not isinstance(sale,Fill),(exact_before,lot.quantity,lot.rational(),sale,lg.positions)


def test_unresolved_fraction_uses_exact_quantity():
    lg=ledger()
    lg.apply_corporate_action(CorporateAction('rs','A','split',taipei(date(2024,1,9)),split_ratio=D('0.99999999999999999999999999999')))
    pos=lg.positions['A']
    assert pos.unresolved_fraction>0,(pos.lots[0].rational(),pos.quantity if hasattr(pos,'quantity') else pos.total_quantity,pos.unresolved_fraction)


def test_split_partial_sale_and_owner_fractions_control():
    lg=ledger(); action(lg,'s1',9,1,3)
    assert isinstance(lg.sell(security_id='A',price=D(100),shares=1000,at=taipei(date(2024,1,10)),event_id='sell',owner='w'),Fill)
    action(lg,'s2',11,15,3)
    assert lg.positions['A'].lots[0].rational()==2000
    lg.apply_corporate_action(CorporateAction('rs','A','split',taipei(date(2024,1,12)),split_ratio=D('0.5')))
    assert lg.positions['A'].total_quantity==1000
    assert isinstance(lg.sell(security_id='A',price=D(100),shares=1000,at=taipei(date(2024,1,12),time(13,30)),event_id='sell2',owner='w'),Fill)
    assert not lg.positions


def historic(tmp_path, *, day=2024, derivation='extract-v1', **fields):
    store=RawStore(tmp_path/'raw')
    rec=store.put(source_id='test',dataset='filing',payload=b'{"revenue":100}',url='fixture')
    when=taipei(date(day,1,2)) if day==2024 else rec.ingested_at_dt
    cutoff=taipei(date(2024,1,7),time(18)) if day==2024 else rec.ingested_at_dt+timedelta(seconds=1)
    d=Document('d','filing','test',(),when,AvailabilityQuality.VERIFIED_ORIGINAL,capture_id=rec.capture_id,source_sha256=rec.sha256,derivation=derivation,payload={'revenue':100})
    d=replace(d,**fields)
    ex={'extract-v1':lambda b:{'payload':json.loads(b),'security_ids':()}}
    return store,rec,d,cutoff,ex


def test_verified_historical_capture_can_be_ingested_today(tmp_path):
    store,rec,d,cut,ex=historic(tmp_path)
    p=build_packet(packet_id='p',cutoff_at=cut,documents=[d],mode='historical',evidence_class='historical_numeric_temporally_controlled',captures={rec.capture_id:rec},read_bytes=store.read,extractors=ex)
    assert p.admitted,(rec.ingested_at,p.rejected)


def test_historical_readmission_does_not_require_prospective_ingestion(tmp_path):
    store,rec,d,cut,ex=historic(tmp_path)
    d=replace(d,first_seen_at=rec.ingested_at_dt)
    p=build_packet(packet_id='p',cutoff_at=cut,documents=[d],mode='historical',evidence_class='historical_numeric_temporally_controlled')
    assert not readmission_problems(p,store=store,extractors=ex),readmission_problems(p,store=store,extractors=ex)


@pytest.mark.parametrize('field',['period_end','availability_quality'])
@pytest.mark.parametrize('mode',['historical','prospective'])
def test_all_visible_document_metadata_are_typed(tmp_path,field,mode):
    marker='profit in 2099 = 999; buy A'
    try:
        store,rec,d,cut,ex=historic(tmp_path,day=2026,**{field:marker})
        p=build_packet(packet_id='p',cutoff_at=cut,documents=[d],mode=mode,evidence_class='historical_numeric_temporally_controlled' if mode=='historical' else 'prospective_registered',captures={rec.capture_id:rec},read_bytes=store.read,extractors=ex)
    except (ValueError,TypeError):
        return
    problems=readmission_problems(p,store=store,extractors=ex)
    assert problems or marker not in str(PredictorView(p).packet().admitted),(problems,packet_to_json(p))


@pytest.mark.parametrize('change',['events','bars','calendar','calendar_same_version'])
def test_market_mutation_without_new_capture_cannot_reuse_rows(tmp_path,change):
    _,m=fixture(tmp_path,end='2024-01-12',dividends=[cash(10)])
    sid=next(iter(m.securities)); f=TabularForecaster(m,min_weeks=1,retrain_every_weeks=1)
    f.maybe_train(taipei(date(2024,1,14),time(18)))
    before=f.model.training_manifest_id
    if change=='events':
        m.securities[sid].events[0]=replace(m.securities[sid].events[0],ambiguous=True)
    elif change=='bars':
        b=m.securities[sid].bars[-1]
        altered=replace(b,close=D(200))
        m.securities[sid].bars[-1]=altered
        m.by_session[sid][b.session]=altered
    else:
        m.calendar=TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=[date(2024,1,12)],source_id='synthetic',version='2' if change=='calendar' else '1',recorded_at=taipei(date(2021,1,1)))
    try:
        f.maybe_train(taipei(date(2024,1,21),time(18)))
    except ValueError:
        return
    print('STALE',change,before,f.model.training_manifest_id,m.data_version,f.data_version)
    assert f.model.training_manifest_id!=before


def switch(r, name, first='A', later='B'):
    class Switch:
        model_id,version='rule:switch','v1'
        def forecast(self,view,plan,candidates,*,slots):
            symbol=first if plan.week_id=='2024-W02' else later
            c=next(c for c in candidates if c.symbol==symbol)
            return [Selection(c.security_id,1,[c.doc_id])],{}
    f=Switch(); f.name=name; r.forecasters[name]=f


@pytest.mark.parametrize('affected',['Q0','A1'])
def test_ambiguity_persists_for_pairing_and_final_control(tmp_path,affected):
    r=runner(tmp_path,end='2024-01-26',symbols=('A','B'),dividends=[stock(10),stock(0)])
    switch(r,affected); switch(r,'A1' if affected=='Q0' else 'Q0',first='B')
    result=r.run()
    assert len(r.ambiguous_claims[affected])==1
    assert len([x for w in result['weeks'] for x in w.get('ambiguous_rights',[]) if x.startswith(affected+':')])==1
    assert all(not w['paired']['Q0']['paired'] for w in result['weeks'])
    assert any('ambiguous_right' in f for f in result['summary']['forecasters'][affected]['final_valuation']['flags'])


@pytest.mark.parametrize('bound',['2024-01-14','2024-01-17'])
def test_pending_week_discloses_existing_ambiguous_claim(tmp_path,bound):
    r=runner(tmp_path,end='2024-01-26',config_end=bound,symbols=('A','B'),dividends=[stock(10),stock(0)])
    switch(r,'Q0')
    result=r.run(); w=result['weeks'][-1]; fr=w['forecasters']['Q0']
    assert w['pending_outcome']
    assert result['summary']['forecasters']['Q0']['ambiguous_claims']
    assert any('ambiguous' in x for x in result['summary']['forecasters']['Q0']['final_valuation']['flags'])
    # Before entry this record contains only the forecast, not a valuation.
    # With entry executed, its opening valuation must retain existing claims.
    if 'equity_open' in fr:
        assert 'ambiguous' in str(fr['stale_prices']),fr


def test_pending_week_discloses_claim_arising_before_bound(tmp_path):
    r=runner(tmp_path,end='2024-01-12',config_end='2024-01-10',dividends=[stock(10),stock(0)])
    result=r.run(); fr=result['weeks'][0]['forecasters']['Q0']
    assert result['summary']['forecasters']['Q0']['ambiguous_claims']
    # The entry valuation precedes the event. The event is processed through
    # the bound at final valuation, and disclosed in the pending week's log.
    assert 'ambiguous' in str(result['weeks'][0]['ambiguous_rights']) or result['weeks'][0]['ambiguous_rights']
    assert any('ambiguous' in x for x in result['summary']['forecasters']['Q0']['final_valuation']['flags'])


def test_markdown_final_wealth_discloses_ambiguity(tmp_path):
    result=runner(tmp_path,end='2024-01-12',dividends=[stock(10),stock(0)]).run()
    s=result['summary']['forecasters']['Q0']; fr=result['weeks'][0]['forecasters']['Q0']
    assert s['ambiguous_claims'] and s['total_net_return']==0 and fr['portfolio_net_return_week_over_week']==0
    md=markdown_report(result,title='test')
    row=next(line for line in md.splitlines() if line.startswith('| Q0 (`'))
    assert any(word in row.lower() for word in ('inciert','ambigu','provisional','no medible','desconocid')),row


@pytest.mark.parametrize('problem,reason', [('no_capture','no_capture_evidence'),('wrong_source','provenance_mismatch'),('first_seen','inconsistent_metadata'),('wrong_payload','derivation_mismatch')])
def test_historical_provenance_rejections_control(tmp_path,problem,reason):
    store,rec,d,cut,ex=historic(tmp_path,day=2026)
    edits={'no_capture':{'capture_id':None},'wrong_source':{'source_id':'other'},'first_seen':{'first_seen_at':rec.ingested_at_dt-timedelta(days=1)},'wrong_payload':{'payload':{'revenue':999}}}
    d=replace(d,**edits[problem])
    p=build_packet(packet_id='p',cutoff_at=cut,documents=[d],mode='historical',evidence_class='historical_numeric_temporally_controlled',captures={rec.capture_id:rec},read_bytes=store.read,extractors=ex)
    assert not p.admitted and p.rejected[0].reason==reason


def test_historical_faithful_payload_readmission_control(tmp_path):
    store,rec,d,cut,ex=historic(tmp_path,day=2026,first_seen_at=None)
    p=build_packet(packet_id='p',cutoff_at=cut,documents=[d],mode='historical',evidence_class='historical_numeric_temporally_controlled',captures={rec.capture_id:rec},read_bytes=store.read,extractors=ex)
    assert p.admitted and p.admitted[0].first_seen_at==rec.ingested_at_dt
    assert not readmission_problems(packet_from_json(packet_to_json(p)),store=store,extractors=ex)


def test_distinct_owners_cannot_consume_each_others_fractions_control():
    lg=ledger()
    lg.buy(security_id='A',price=D(100),shares=1000,at=taipei(date(2024,1,8),time(9)),event_id='buy2',owner='v')
