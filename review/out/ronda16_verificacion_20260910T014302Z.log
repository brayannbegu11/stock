@@ -0,0 +1,40 @@
+from r10_support import *
+from twlab.sources import twse_daily as td, finmind
+from collections import Counter
+from twlab.packet import packet_from_json
+raw=RawStore(ROOT/'data/raw')
+manifest=json.loads((ROOT/'data/store/sample_universe.json').read_text(encoding='utf-8'))
+records={r.capture_id:r for r in raw.captures()}
+fm={s:{b.session:b for b in finmind.bars_from_rows(finmind.rows(raw,records[c['price']]),stock_id=s)} for s,c in manifest['captures'].items() if c.get('price_rows',0)>0}
+counts=Counter(); missing=Counter(); mismatches=[]; examples=[]; symbols=set()
+for d,r in td.captured_sessions(raw,'twse',td.TWSE_DATASET).items():
+    if d.year!=2025: continue
+    rows=td.twse_rows(raw,r)
+    if rows is None: continue
+    bs=td.bars_twse(d,rows)
+    for s,bars in fm.items():
+        a,b=bars.get(d),bs.get(s)
+        if a is None or b is None:
+            missing[(s,'both' if a is None and b is None else 'FinMind' if a is None else 'TWSE')]+=1
+            continue
+        counts['pairs']+=1; symbols.add(s)
+        if not a.has_regular_price: counts['zero_price_pairs']+=1
+        for k in ('open','close','volume_shares','value_twd'):
+            if getattr(a,k)!=getattr(b,k): mismatches.append((s,str(d),k,str(getattr(a,k)),str(getattr(b,k))))
+print('RAW_EQUIVALENCE',dict(counts),'symbols',len(symbols),'missing',sorted(missing.items()),'mismatches',mismatches,flush=True)
+rec=next(r for r in records.values() if r.source_id=='packet' and r.dataset=='universe_2026-05-04_2026-09-09/2026-W20')
+p=packet_from_json(raw.read(rec)); d=p.admitted[0]; c=records[d.capture_id]
+print('REAL_PROVENANCE',d.source_id,d.derivation,c.source_id,c.dataset,d.payload['last_session'],len(d.payload['sessions']),flush=True)
+r=json.loads((ROOT/'data/store/backtest_universe_2026-05-04_2026-09-09.json').read_text(encoding='utf-8'))
+for name in ('Q0','Q1','A1'):
+    ws=[w['forecasters'][name] for w in r['weeks'] if not w.get('pending_outcome')]
+    print('ATTEMPTS',name,sum(len(w['picks']) for w in ws),sum(w.get('failed',0) for w in ws),flush=True)
+for source,dataset,reader,parser in [('twse',td.TWSE_DATASET,td.twse_rows,td.bars_twse),('tpex',td.TPEX_DATASET,td.tpex_rows,td.bars_tpex)]:
+    for day in [date(2026,7,10),date(2026,9,7)]:
+        rec=td.captured_sessions(raw,source,dataset)[day]; body=json.loads(raw.read(rec))
+        if day.month==7:
+            print('CLOSED_BODY',source,json.dumps(body,ensure_ascii=True)[:1800],flush=True)
+        else:
+            bars=parser(day,reader(raw,rec))
+            for symbol in ('3406','3037','2317'):
+                if symbol in bars: print('PENDING_PRICE',symbol,bars[symbol].open,flush=True)
