      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner, date\nfrom twlab.backtest import markdown_report\n\ndef test_stale_final_equity_is_qualified(tmp_path):\n    r = runner(tmp_path, end='2024-01-12', symbols=('A','B'))\n    sid = r.market.by_symbol['A']\n    r.market.securities[sid].bars.pop()\n    del r.market.by_session[sid][date(2024,1,12)]\n    result = r.run()\n    assert any(f.startswith('stale_price:') for f in result['summary']['forecasters']['Q0']['final_valuation']['flags'])\n    row = next(x for x in markdown_report(result, title='test').splitlines() if x.startswith('| Q0 (`'))\n    assert any(word in row.lower() for word in ('inciert','obsolet','stale','provisional','desconocid'))\n",
