+
+def saved():
+    return json.loads((ROOT/'data/store/backtest_universe_2026-05-04_2026-09-09.json').read_text(encoding='utf-8'))
+
+def test_report15_claimed_85_q1_attempts():
+    r=saved()
+    n=sum(len(w['forecasters']['Q1']['picks']) for w in r['weeks'] if not w.get('pending_outcome'))
+    assert n==85,n
+
+def test_report15_claimed_costs_exceed_all_forecaster_differences():
+    fs=saved()['summary']['forecasters']
+    spread=abs(fs['A1']['mean_weekly_net_return_open_close']-fs['Q1']['mean_weekly_net_return_open_close'])
+    costs=max(f['mean_costs_over_invested'] for f in fs.values())
+    assert costs>spread,(costs,spread)
+
+def test_pending_and_rights_disclosure_controls():
+    r=saved(); w=r['weeks'][-1]
+    assert w['week_id']=='2026-W37' and w['pending_outcome']
+    assert [w['forecasters'][n]['filled'] for n in ('Q0','Q1','A1')]==[4,2,5]
+    assert all('portfolio_net_return_open_close' not in f for f in w['forecasters'].values())
+    assert 'sin derechos' in str(r['summary']['market_warnings'])
+    assert all(f['paired_excess_vs_baseline']['ci95'] is None for n,f in r['summary']['forecasters'].items() if n!='A1')
+    assert r['summary']['forecasters']['Q1']['training_history'][0].split('|weeks=')[1].startswith('69|')
+
+def test_absent_rights_are_price_only_control(tmp_path):
+    def prices(day): return D(100) if day<date(2024,1,10) else D(90)
+    a=runner(tmp_path/'with',end='2024-01-12',prices=prices,dividends=[cash(10)])
+    b=runner(tmp_path/'without',end='2024-01-12',prices=prices)
+    sid=next(iter(a.market.securities))
+    lab=lambda r: weekly_label(r.market.by_session[sid],date(2024,1,8),date(2024,1,12),r.market.securities[sid].events)[0]
+    assert lab(a)==pytest.approx(0) and lab(b)==pytest.approx(-.1)
+    assert a.run()['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']==pytest.approx(0)
+    assert b.run()['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']==pytest.approx(-.1)

