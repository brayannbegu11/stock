+    d=p.admitted[0]; capture=raw.get(d.capture_id)
+    assert d.source_id==capture.source_id, (d.source_id,capture.source_id,d.derivation)
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
