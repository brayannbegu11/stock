"""Cotizaciones diarias oficiales por fecha (todas las acciones): TWSE ``MI_INDEX`` y TPEx ``dailyQuotes``.

Fuente oficial e hist├│rica (una petici├│n por sesi├│n y mercado), alternativa al nivel gratuito de
FinMind para el universo completo. Se archiva la respuesta ├¡ntegra en ``RawStore``; la lectura tipada
produce ``Bar`` por s├¡mbolo con la misma pol├¡tica de disponibilidad (cierre 13:30 Taipei + 24 h).
**Sin derechos**: esta fuente s├│lo trae precios y vol├║menes; el mercado construido con ella no tiene
dividendos y as├¡ debe declararse.

Formatos observados el 9-09-2026 (sesiones desde 2021 hasta hoy):
- TWSE ``rwd/zh/afterTrading/MI_INDEX?date=YYYYMMDD&type=ALLBUT0999&response=json`` ΓåÆ ``stat`` (┬½OK┬╗ o texto
  de ┬½sin datos┬╗ en cierres) y ``tables`` con una tabla ┬½µ»ÅµùÑµö╢τ¢ñΦíîµâà┬╗ (campos Φ¡ëσê╕Σ╗úΦÖƒ, µêÉΣ║ñΦéíµò╕, µêÉΣ║ñτ¡åµò╕,
  µêÉΣ║ñΘçæΘíì, Θûïτ¢ñσâ╣, µ£ÇΘ½ÿσâ╣, µ£ÇΣ╜Äσâ╣, µö╢τ¢ñσâ╣, ΓÇª; n├║meros con comas; ┬½--┬╗ sin precio).
- TPEx ``www/zh-tw/afterTrading/dailyQuotes?date=YYYY/MM/DD&response=json`` ΓåÆ ``tables`` con ┬½Σ╕èµ½âΦéíτÑ¿Φíîµâà┬╗
  (campos Σ╗úΦÖƒ, σÉìτ¿▒, µö╢τ¢ñ, µ╝▓Φ╖î, Θûïτ¢ñ, µ£ÇΘ½ÿ, µ£ÇΣ╜Ä, σ¥çσâ╣, µêÉΣ║ñΦéíµò╕, µêÉΣ║ñΘçæΘíì(σàâ), µêÉΣ║ñτ¡åµò╕, ΓÇª); filas m├ís largas que
  la lista de campos (se toman las primeras columnas).
"""
from __future__ import annotations

import json
import time
from datetime import date
from decimal import Decimal, InvalidOperation
from typing import Iterable, Optional

import requests

from ..store import CaptureRecord, RawStore
from ..timeutil import taipei
from .finmind import PRICE_AVAILABILITY_LAG, Bar

TWSE_URL = "https://www.twse.com.tw/rwd/zh/afterTrading/MI_INDEX"
TPEX_URL = "https://www.tpex.org.tw/www/zh-tw/afterTrading/dailyQuotes"
HEADERS = {"User-Agent": "Mozilla/5.0 taiwan-ia-lab/0.1 (private research)", "Accept": "application/json"}
TWSE_DATASET = "MI_INDEX_ALLBUT0999"
TPEX_DATASET = "dailyQuotes"
_PLACEHOLDERS = {"--", "---", "-", "X", "ΘÖñµ¼è", "ΘÖñµü»", "ΘÖñµ¼èµü»", ""}


def _num(v) -> Optional[Decimal]:
    s = str(v).replace(",", "").strip()
    if s in _PLACEHOLDERS:
        return None
    try:
        d = Decimal(s)
    except InvalidOperation:
        return None
    return d if d.is_finite() else None


def fetch_twse(store: RawStore, d: date, *, pause_s: float = 3.0) -> CaptureRecord:
    r = requests.get(TWSE_URL, params={"date": d.strftime("%Y%m%d"), "type": "ALLBUT0999", "response": "json"}, headers=HEADERS, timeout=90)
    rec = store.put(source_id="twse", dataset=f"{TWSE_DATASET}/{d.isoformat()}", payload=r.content, url=r.url, http_status=r.status_code,
                    content_type=r.headers.get("Content-Type"), extra={"session": d.isoformat()})
    time.sleep(pause_s)
    return rec


def fetch_tpex(store: RawStore, d: date, *, pause_s: float = 3.0) -> CaptureRecord:
    r = requests.get(TPEX_URL, params={"date": d.strftime("%Y/%m/%d"), "response": "json"}, headers=HEADERS, timeout=90)
    rec = store.put(source_id="tpex", dataset=f"{TPEX_DATASET}/{d.isoformat()}", payload=r.content, url=r.url, http_status=r.status_code,
                    content_type=r.headers.get("Content-Type"), extra={"session": d.isoformat()})
    time.sleep(pause_s)
    return rec


def twse_rows(store: RawStore, rec: CaptureRecord) -> Optional[list[dict]]:
    """Filas de ┬½µ»ÅµùÑµö╢τ¢ñΦíîµâà┬╗ como diccionarios; ``None`` si la fecha no tuvo datos (cierre)."""
    body = json.loads(store.read(rec).decode("utf-8"))
    if body.get("stat") != "OK":
        return None
    for t in body.get("tables", []):
        if "µ»ÅµùÑµö╢τ¢ñΦíîµâà" in str(t.get("title", "")) and t.get("data"):
            fields = t["fields"]
            return [dict(zip(fields, row)) for row in t["data"]]
    return None


def tpex_rows(store: RawStore, rec: CaptureRecord) -> Optional[list[dict]]:
    body = json.loads(store.read(rec).decode("utf-8"))
    for t in body.get("tables", []):
        if str(t.get("title", "")).startswith("Σ╕èµ½âΦéíτÑ¿Φíîµâà"):
            if not t.get("data"):
                return None
            fields = t["fields"]
            return [dict(zip(fields, row[: len(fields)])) for row in t["data"]]
    return None


def _bar(session: date, o, h, l, c, vol, val, n) -> Bar:
    close_at = taipei(session).replace(hour=13, minute=30)
    return Bar(session=session, open=o if o is not None else Decimal(0), high=h if h is not None else Decimal(0),
               low=l if l is not None else Decimal(0), close=c if c is not None else Decimal(0),
               volume_shares=int(vol or 0), value_twd=val if val is not None else Decimal(0), transactions=int(n or 0),
               available_at=close_at + PRICE_AVAILABILITY_LAG)


def bars_twse(session: date, rows: Iterable[dict]) -> dict[str, Bar]:
    out: dict[str, Bar] = {}
    for r in rows:
        sid = str(r.get("Φ¡ëσê╕Σ╗úΦÖƒ", "")).strip()
        if not sid:
            continue
        out[sid] = _bar(session, _num(r.get("Θûïτ¢ñσâ╣")), _num(r.get("µ£ÇΘ½ÿσâ╣")), _num(r.get("µ£ÇΣ╜Äσâ╣")), _num(r.get("µö╢τ¢ñσâ╣")),
                        _num(r.get("µêÉΣ║ñΦéíµò╕")), _num(r.get("µêÉΣ║ñΘçæΘíì")), _num(r.get("µêÉΣ║ñτ¡åµò╕")))
    return out


def bars_tpex(session: date, rows: Iterable[dict]) -> dict[str, Bar]:
    out: dict[str, Bar] = {}
    for r in rows:
        sid = str(r.get("Σ╗úΦÖƒ", "")).strip()
        if not sid:
            continue
        out[sid] = _bar(session, _num(r.get("Θûïτ¢ñ")), _num(r.get("µ£ÇΘ½ÿ")), _num(r.get("µ£ÇΣ╜Ä")), _num(r.get("µö╢τ¢ñ")),
                        _num(r.get("µêÉΣ║ñΦéíµò╕")), _num(r.get("µêÉΣ║ñΘçæΘíì(σàâ)")), _num(r.get("µêÉΣ║ñτ¡åµò╕")))
    return out


def captured_sessions(store: RawStore, source_id: str, dataset: str) -> dict[date, CaptureRecord]:
    """├Ültima captura con HTTP 200 por sesi├│n para un conjunto de datos por fecha."""
    out: dict[date, CaptureRecord] = {}
    for rec in store.captures(source_id=source_id):
        if rec.dataset.startswith(dataset + "/") and rec.http_status == 200:
            out[date.fromisoformat(rec.dataset.split("/", 1)[1])] = rec
    return out
"""Pruebas del adaptador de cotizaciones diarias oficiales por fecha (TWSE MI_INDEX, TPEx dailyQuotes): sin red."""
import json
from datetime import date, time
from decimal import Decimal as D

from twlab.sources import twse_daily as td
from twlab.store import RawStore
from twlab.timeutil import taipei


def _put(store, source_id, dataset, body):
    return store.put(source_id=source_id, dataset=dataset, payload=json.dumps(body, ensure_ascii=False).encode("utf-8"), url="u",
                     http_status=200, content_type="application/json", extra={})


def test_num_parses_commas_and_placeholders():
    assert td._num("1,234,567") == D("1234567") and td._num("15.26") == D("15.26")
    assert td._num("--") is None and td._num("") is None and td._num("ΘÖñµü»") is None and td._num("X") is None and td._num("Infinity") is None


def test_twse_rows_and_bars_from_mi_index(tmp_path):
    store = RawStore(tmp_path)
    body = {"stat": "OK", "date": "20260904", "tables": [
        {"title": "115σ╣┤09µ£ê04µùÑ σâ╣µá╝µîçµò╕(Φç║τüúΦ¡ëσê╕Σ║ñµÿôµëÇ)", "fields": ["µîçµò╕", "µö╢τ¢ñµîçµò╕"], "data": [["τÖ╝ΦíîΘçÅσèáµ¼èΦéíσâ╣µîçµò╕", "1"]]},
        {"title": "115σ╣┤09µ£ê04µùÑ µ»ÅµùÑµö╢τ¢ñΦíîµâà(σà¿Θâ¿(Σ╕ìσÉ½µ¼èΦ¡ëπÇüτë¢τåèΦ¡ëπÇüσÅ»σ▒òσ╗╢τë¢τåèΦ¡ë))",
         "fields": ["Φ¡ëσê╕Σ╗úΦÖƒ", "Φ¡ëσê╕σÉìτ¿▒", "µêÉΣ║ñΦéíµò╕", "µêÉΣ║ñτ¡åµò╕", "µêÉΣ║ñΘçæΘíì", "Θûïτ¢ñσâ╣", "µ£ÇΘ½ÿσâ╣", "µ£ÇΣ╜Äσâ╣", "µö╢τ¢ñσâ╣", "µ╝▓Φ╖î(+/-)", "µ╝▓Φ╖îσâ╣σ╖«"],
         "data": [["2330", "σÅ░τ⌐ìΘ¢╗", "14,102,018", "43,438", "33,917,316,870", "2,415.00", "2,415.00", "2,390.00", "2,410.00", "+", "5.00"],
                  ["9999", "sin precio", "48", "18", "1,606", "--", "--", "--", "--", " ", "0.00"]]}]}
    rec = _put(store, "twse", f"{td.TWSE_DATASET}/2026-09-04", body)
