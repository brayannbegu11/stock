diff --git a/review/out/astra_scratch/r16_audit.py b/review/out/astra_scratch/r16_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..7dcf3f1b4563cf2504d6922965441bc03e27fd11
--- /dev/null
+++ b/review/out/astra_scratch/r16_audit.py
@@ -0,0 +1,46 @@
+from r10_support import *
+from twlab.backtest import load_market_daily, load_master_file, markdown_report
+from twlab.calendar import load_twse_reference_calendar
+from twlab.sources import twse_daily as td, finmind
+from collections import Counter
+
+raw=RawStore(ROOT/'data/raw'); cal=load_twse_reference_calendar()
+sample=load_market(raw,ROOT/'data/store/sample_universe.json',cal)
+captures=td.captured_sessions(raw,'twse',td.TWSE_DATASET)
+counts=Counter(); diffs=[]; missing=[]
+for day,rec in sorted(captures.items()):
+    if day.year!=2025: continue
+    rr=td.twse_rows(raw,rec)
+    if rr is None:
+        missing.append(str(day)); continue
+    bs=td.bars_twse(day,rr)
+    for sid,s in sample.securities.items():
+        a=sample.by_session[sid].get(day); b=bs.get(s.symbol)
+        if not a or not b:
+            counts['missing_pair']+=1; continue
+        counts['pairs']+=1
+        for key in ('open','close','volume_shares','value_twd'):
+            if getattr(a,key)!=getattr(b,key):
+                counts[key]+=1
+                diffs.append([s.symbol,str(day),key,str(getattr(a,key)),str(getattr(b,key))])
+equiv={'counts':dict(counts),'missing_sessions':missing,'diffs':diffs}
+(ROOT/'review/out/astra_scratch/r16_equivalence.json').write_text(json.dumps(equiv,indent=2),encoding='utf-8')
+print('EQUIVALENCE',json.dumps({**equiv,'diffs':diffs[:15]}),flush=True)
+master=load_master_file(ROOT/'data/store/master_2026-09-09.jsonl')
+m=load_market_daily(raw,cal,master,as_of=date(2026,9,9),start=date(2024,7,1),end=date(2026,9,9))
+print('MARKET',len(m.securities),sum(len(s.bars) for s in m.securities.values()),m.dropped_no_regular_price,m.bars_before_listing_dropped,m.warnings,flush=True)
+stale=[(s.symbol,str(s.bars[-1].session),s.price_capture.dataset) for s in m.securities.values() if not s.price_capture.dataset.endswith(s.bars[-1].session.isoformat())]
+print('LAST_CAPTURE_NOT_LAST_BAR',len(stale),stale[:10],flush=True)
+saved=json.loads((ROOT/'data/store/backtest_universe_2026-05-04_2026-09-09.json').read_text(encoding='utf-8'))
+print('SUMMARY',json.dumps(saved['summary'],ensure_ascii=True),flush=True)
+print('PENDING',json.dumps(saved['weeks'][-1],ensure_ascii=True),flush=True)
+print('W28',json.dumps(next(w for w in saved['weeks'] if w['week_id']=='2026-W28'),ensure_ascii=True),flush=True)
+packets=list(raw.captures(source_id='packet'))
+rec=next(r for r in packets if r.dataset=='universe_2026-05-04_2026-09-09/2026-W20')
+body=json.loads(raw.read(rec)); print('PACKET_KEYS',list(body),flush=True)
+print('PACKET_DOCUMENT',json.dumps(body['admitted'][0],ensure_ascii=True)[:3000],flush=True)
+for name in ('backtest_sample_2024_2025.json','q0_demo_2024-01-01_2025-12-31.json'):
+    b=json.loads((ROOT/'data/store'/name).read_text(encoding='utf-8'))
+    print('SAMPLE_SUMMARY',name,json.dumps(b['summary'],ensure_ascii=True),flush=True)
+report=(ROOT/'docs/informes/15_backtest_universo_2026.md').read_text(encoding='utf-8')
+print('REPORT15_GENERATED_EQUAL',markdown_report(saved,title='Informe generado: backtest universe_2026-05-04_2026-09-09').split('\n',1)[1] in report,flush=True)
diff --git a/review/out/astra_scratch/test_r16_attacks.py b/review/out/astra_scratch/test_r16_attacks.py
new file mode 100644
index 0000000000000000000000000000000000000000..c045073b62cc7391c17e9ca53e52e5f61e585b45
--- /dev/null
+++ b/review/out/astra_scratch/test_r16_attacks.py
@@ -0,0 +1,90 @@
+from review.out.astra_scratch.r10_support import *
+from review.out.astra_scratch.test_r13_attacks import cash
+from twlab.backtest import load_market_daily, TabularForecaster
+from twlab.master import SecurityMaster, SecurityVersion
+from twlab.sources import twse_daily as td
+from twlab.weekly import plan_week
+from dataclasses import replace
+import pytest
+
+
+def daily(tmp_path, market='TWSE', days=('2024-01-04','2024-01-05'), body_day=None, listing='2000-01-01', zero_last=False):
+    raw=RawStore(tmp_path/'raw'); master=SecurityMaster()
+    master.add(SecurityVersion('A','issuer','2330','A',market,'main','ordinary_equity',date.fromisoformat(listing),None,taipei(date(2024,1,1)),'test'))
+    cal=TradingCalendar(start=date(2024,1,1),end=date(2024,1,31),closures=[],source_id='test',recorded_at=taipei(date(2024,1,1)))
+    source='twse' if market=='TWSE' else 'tpex'; dataset=td.TWSE_DATASET if market=='TWSE' else td.TPEX_DATASET
+    fields=['Φ¡ëσê╕Σ╗úΦÖƒ','Θûïτ¢ñσâ╣','µ£ÇΘ½ÿσâ╣','µ£ÇΣ╜Äσâ╣','µö╢τ¢ñσâ╣','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì','µêÉΣ║ñτ¡åµò╕'] if market=='TWSE' else ['Σ╗úΦÖƒ','Θûïτ¢ñ','µ£ÇΘ½ÿ','µ£ÇΣ╜Ä','µö╢τ¢ñ','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì(σàâ)','µêÉΣ║ñτ¡åµò╕']
+    for day in days:
+        p='--' if zero_last and day==days[-1] else '100'
+        body={'stat':'OK','date':(body_day or day).replace('-',''),'tables':[{'title':'µ»ÅµùÑµö╢τ¢ñΦíîµâà' if market=='TWSE' else 'Σ╕èµ½âΦéíτÑ¿Φíîµâà','fields':fields,'data':[['2330',p,p,p,p,'1,000','100,000','10'],['0050','100','100','100','100','1000','100000','10']]}]}
+        raw.put(source_id=source,dataset=f'{dataset}/{day}',payload=json.dumps(body).encode(),url='fixture',http_status=200)
+    m=load_market_daily(raw,cal,master,as_of=date(2024,1,7),start=date.fromisoformat(days[0]),end=date.fromisoformat(days[-1]))
+    return raw,m
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_payload_date_must_match_session(tmp_path,market):
+    try:
+        raw,m=daily(tmp_path,market,days=('2024-01-05',),body_day='2024-01-12')
+    except ValueError:
+        return
+    assert not m.securities, [(b.session,b.close) for b in m.securities['A'].bars]
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_daily_packet_has_real_provenance(tmp_path,market):
+    raw,m=daily(tmp_path,market)
+    cfg=BacktestConfig(start=date(2024,1,1),end=date(2024,1,12))
+    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
+    p,_,_=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    d=p.admitted[0]; capture=raw.get(d.capture_id)
+    assert d.source_id==capture.source_id, (d.source_id,capture.source_id,d.derivation)
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_price_capture_tracks_last_kept_bar(tmp_path,market):
+    raw,m=daily(tmp_path,market,zero_last=True)
+    s=m.securities['A']
+    assert s.price_capture.dataset.endswith(s.bars[-1].session.isoformat()),(s.price_capture.dataset,s.bars[-1].session)
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_listing_and_ordinary_equity_control(tmp_path,market):
+    raw,m=daily(tmp_path,market,listing='2024-01-05')
+    assert set(m.securities)=={'A'} and m.bars_before_listing_dropped==1
+    assert [b.session for b in m.securities['A'].bars]==[date(2024,1,5)]
+    assert len(m.warnings)==2 and 'sin captura' in m.warnings[1]
+
