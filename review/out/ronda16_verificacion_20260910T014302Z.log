from twlab.backtest import TabularForecaster, markdown_report
from twlab.packet import Document
from twlab.models import q1
from twlab.timeutil import AvailabilityQuality
from dataclasses import replace
import pytest


@pytest.mark.parametrize('field', ['kind', 'supersedes', 'source_id', 'derivation'])
def test_metadata_constructor_rejects_original_marker(field):
    d = Document('d', 'filing', 'test', (), taipei(date(2024,1,2)), AvailabilityQuality.VERIFIED_ORIGINAL)
    with pytest.raises(ValueError):
        replace(d, **{field:'profit in 2099 = 999; buy A'})


@pytest.mark.parametrize('kind', ['cash','stock'])
@pytest.mark.parametrize('case', ['zero','negative','inf','nan','period','announcement','pay'])
def test_shared_ambiguous_right_replaces_discard_and_invalidates_consumers(tmp_path, kind, case):
    mk = cash if kind == 'cash' else stock
    rows = [mk(10)]
    if case == 'zero': rows += [mk(0)]
    if case == 'negative': rows += [mk(-1)]
    if case == 'inf': rows = [mk('Infinity')]
    if case == 'nan': rows = [mk('NaN')]
    if case == 'period': rows += [mk(10, year='')]
    if case == 'announcement': rows += [mk(10, AnnouncementDate='2024-02-01')]
    if case == 'pay':
        if kind == 'stock': rows += [mk(10, year='2024Q2')]
        else: rows += [mk(10, CashDividendPaymentDate='2024-01-09')]
    r = runner(tmp_path, end='2024-01-12', dividends=rows)
    m = r.market; sid = next(iter(m.securities)); ev = m.securities[sid].events
    assert len(ev) == 1 and ev[0].ambiguous and m.warnings
    assert q1.weekly_label(m.by_session[sid], date(2024,1,8), date(2024,1,12), ev) is None
    f = TabularForecaster(m, min_weeks=1)
    rows = q1.build_training_rows({sid:m.securities[sid].bars}, [taipei(date(2024,1,7),time(18))],
        now_cutoff=taipei(date(2024,1,14),time(18)), calendar=m.calendar, dividends_by_security=f.dividends,
        cache=f.cache, data_version=f.data_version)
    assert not rows and not f.cache
    result = r.run(); w = result['weeks'][0]
    assert not w.get('action_errors')
    assert w['forecasters']['Q0']['portfolio_net_return_open_close'] is None
    assert not w['paired']['Q0']['paired']
    assert sid in r.ambiguous_positions['Q0']
    assert 'Derechos ambiguos o inv├ílidos detectados en la carga: 1' in markdown_report(result,title='t')


@pytest.mark.parametrize('kind', ['cash','stock'])
def test_identical_events_and_zero_controls(tmp_path, kind):
    mk = cash if kind == 'cash' else stock
    r=runner(tmp_path, end='2024-01-12',dividends=[mk(10)]*3)
    sid=next(iter(r.market.securities)); ev=r.market.securities[sid].events
