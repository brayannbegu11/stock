+        m.calendar=TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=[date(2024,1,12)],source_id='synthetic',version='1',recorded_at=taipei(date(2021,1,1)))
+    else:
+        m.securities[sid].events[0]=replace(m.securities[sid].events[0],ex_date=date(2024,1,16))
+    with pytest.raises(ValueError):
+        f.maybe_train(taipei(date(2024,1,21),time(18)))
+
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_duplicate_symbol_is_not_last_wins(market):
+    fields=['Φ¡ëσê╕Σ╗úΦÖƒ','Θûïτ¢ñσâ╣','µ£ÇΘ½ÿσâ╣','µ£ÇΣ╜Äσâ╣','µö╢τ¢ñσâ╣','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì','µêÉΣ║ñτ¡åµò╕'] if market=='TWSE' else ['Σ╗úΦÖƒ','Θûïτ¢ñ','µ£ÇΘ½ÿ','µ£ÇΣ╜Ä','µö╢τ¢ñ','µêÉΣ║ñΦéíµò╕','µêÉΣ║ñΘçæΘíì(σàâ)','µêÉΣ║ñτ¡åµò╕']
