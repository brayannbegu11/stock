    assert isinstance(sale,Fill)
    assert [lot.rational() for lot in pos.lots]==[Fraction(1,2),Fraction(1,2)]


def test_ambiguous_claim_still_holds_later_rights_after_registered_shares_sold(tmp_path):
    # A 10/0 stock right may create 1,000 extra shares. Those unregistered shares
    # still receive the following week's cash dividend after the known shares sell.
    r=runner(tmp_path,end='2024-01-26',symbols=('A','B'),dividends=[stock(10),stock(0),cash(5,CashExDividendTradingDate='2024-01-16')])
    switch(r,'Q0'); result=r.run()
    assert len(r.ambiguous_claims['Q0'])==1
    assert all(w['forecasters']['Q0']['portfolio_net_return_open_close'] is None for w in result['weeks'])
    assert any('ambiguous' in x for x in result['summary']['forecasters']['Q0']['final_valuation']['flags'])


def test_new_lot_after_ex_date_has_clean_gross_return_despite_old_claim(tmp_path):
    r=runner(tmp_path,end='2024-01-19',dividends=[stock(10),stock(0)])
    result=r.run()
    old,new=[w['forecasters']['Q0'] for w in result['weeks']]
    assert old['picks'][0]['gross_return'] is None
    assert new['filled']==1 and new['portfolio_net_return_open_close'] is None
    assert new['picks'][0]['gross_return']==0 and new['mean_gross_pick_return']==0,new
