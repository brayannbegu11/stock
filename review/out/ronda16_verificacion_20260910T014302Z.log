+from r10_support import *
+from twlab.packet import packet_from_json
+from collections import Counter
+raw=RawStore(ROOT/'data/raw'); records={r.capture_id:r for r in raw.captures()}
+for week in ['2026-W20','2026-W37']:
+    rec=max((r for r in records.values() if r.source_id=='packet' and r.dataset==f'universe_2026-05-04_2026-09-09/{week}'),key=lambda r:r.ingested_at)
+    p=packet_from_json(raw.read(rec))
+    print('LATEST',week,rec.ingested_at,'documents',len(p.admitted),'mismatches',sum(d.source_id!=records[d.capture_id].source_id for d in p.admitted))
+    for symbol in ['1101','2035','4154']:
+        d=next((d for d in p.admitted if d.doc_id.startswith(symbol+':')),None)
+        if d:
+            c=records[d.capture_id]
+            print(symbol,d.source_id,d.derivation,c.dataset,d.payload['last_session'],len(d.payload['sessions']))
