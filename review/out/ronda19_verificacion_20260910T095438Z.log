+const data=JSON.parse(html.match(/<script type="application\/json" id="site-data">([\s\S]*?)<\/script>/)[1]);
+let code=[...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].pop()[1];
+code=code.replace('state.lang = detectLang();\nrender();','globalThis.api={S,DATA,state,hero,reviewSection,kpiAndChart,equityChart,weeksTable,verdictCounts,lastBlockingRound};');
+const change=process.argv[2];
+if(change==='review'){
+ data.rounds=[{round:1,findings_new:0,severity:{},verdict:'aprobado',summary:''},
+ {round:24,findings_new:1,severity:{bloqueante:1},verdict:'rechazado',summary:''},
+ {round:25,findings_new:0,severity:{},verdict:'aprobado_con_cambios',summary:''}];
+ data.review_stats={new_total:1,verified_total:0,blocking_new:1,blocking_verified:0,unverified_ids:['R24-01']};
+}
+if(change==='profitable') for(const sc of data.scenarios) for(const [f,x] of Object.entries(sc.forecasters)){
+ x.total_net_return=.25; x.final_equity=sc.assumptions.initial_cash_twd*1.25;
+ x.mean_weekly_net=f==='A1'?.01:.03;
+ if(x.paired) Object.assign(x.paired,{mean:.02,ci95:[.01,.03],degenerate:false});
+}
+if(change==='final') for(const sc of data.scenarios){
+ const x=sc.forecasters.Q0;
+ Object.assign(x,{final_equity:123456,final_flags:['stale_price:fixture:2026-09-08'],final_valued_at:'2026-09-09T23:59:00+08:00',final_prices_session:'2026-09-09'});
+}
+const ctx={document:{getElementById:()=>({textContent:JSON.stringify(data)})},Intl,URLSearchParams};
+vm.createContext(ctx);vm.runInContext(code,ctx);const a=ctx.api,out={};
+for(const lang of ['es','en','zh']){
+ a.state.lang=lang;
+ out[lang]={strings:a.S[lang],hero:a.hero(a.DATA.scenarios[0],a.DATA.rounds),review:a.reviewSection(a.DATA.rounds),counts:a.verdictCounts(a.DATA.rounds),lastBlocking:a.lastBlockingRound(a.DATA.rounds)};
+ for(const sc of a.DATA.scenarios){a.state.scenario=sc.id;out[lang][sc.id]={kpi:a.kpiAndChart(sc),chart:a.equityChart(sc),table:a.weeksTable(sc)};}
+}
+process.stdout.write(JSON.stringify(out));
