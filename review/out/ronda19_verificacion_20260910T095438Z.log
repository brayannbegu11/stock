+from review.out.astra_scratch.test_r18_verification import ROOT, D, date, time, taipei, daily, fixture, Runner, BacktestConfig, MomentumForecaster, RandomForecaster, plan_week, export, read_source
+from twlab.backtest import ManifestInconsistent, markdown_report
+from dataclasses import replace
+from statistics import fmean
+import hashlib, json, re, subprocess, pytest
+
+def render(mode=None):
+    r=subprocess.run(['node','review/out/astra_scratch/r19_render.cjs']+([mode] if mode else []),cwd=ROOT,capture_output=True,text=True,encoding='utf8',check=True)
+    return json.loads(r.stdout)
+
+def test_conflict_is_atomic_in_archive(tmp_path):
+    raw,m=daily(tmp_path)
+    a=m.securities['A']; orig=raw.get(a.bar_captures[date(2024,1,4)])
+    body=json.loads(raw.read(orig));body['revision']=2
+    revised=raw.put(source_id='twse',dataset=orig.dataset,payload=json.dumps(body).encode(),url='fixture')
+    b=replace(a,security_id='B',symbol='9999',bar_captures=dict(a.bar_captures))
+    b.bar_captures[date(2024,1,4)]=revised.capture_id;m.securities['B']=b
+    snapshot=lambda:{str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in tmp_path.rglob('*') if p.is_file()}
+    before=snapshot()
+    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12)),[MomentumForecaster(),RandomForecaster(1)])
+    with pytest.raises(ManifestInconsistent,match='conflicting session captures'):
+        r.run_week(date(2024,1,7))
+    assert snapshot()==before
+
+def test_finmind_single_capture_remains_admitted(tmp_path):
+    raw,m=fixture(tmp_path)
+    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12)),[MomentumForecaster(),RandomForecaster(1)])
+    p,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    docs=[d for d in p.admitted if d.kind=='price_bar_series']
+    assert len(docs)==1 and docs[0].source_id=='finmind' and cs[0].eligible
+
+@pytest.mark.parametrize('sid,label,report',export.SCENARIOS)
+def test_all_summary_denominators_means_and_generated_tables(sid,label,report):
+    d=read_source(label);txt=(ROOT/'docs/informes'/report).read_text(encoding='utf8')
+    generated=markdown_report(d,title='t').split('\n',1)[1]
+    assert txt.split('## Informe generado:',1)[1].split('\n',1)[1].strip()==generated.strip()
+    for f,s in d['summary']['forecasters'].items():
+        ws=[w['forecasters'][f] for w in d['weeks'] if w['status']=='valid' and not w.get('pending_outcome')]
+        rs=[w['portfolio_net_return_open_close'] for w in ws if w.get('portfolio_net_return_open_close') is not None]
+        assert s['weeks_positive']==sum(x>0 for x in rs)<=s['weeks_measured']==len(rs)==16
+        assert s['mean_weekly_net_return_open_close']==fmean(rs)
+        costs=[w['costs_twd']/w['costs_denominator_twd'] for w in ws if w.get('costs_denominator_twd')]
+        assert s['mean_costs_over_invested']==pytest.approx(fmean(costs),abs=1e-15)
+        summaryrow=next(l for l in txt.splitlines() if l.startswith('| Coste medio sobre importe'))
+        assert f"{s['mean_costs_over_invested']*100:.2f}".replace('.',',')+' %' in summaryrow
+        assert s['final_valuation']['valued_at']=='2026-09-09T23:59:00+08:00'
+        assert s['final_valuation']['prices_session']=='2026-09-09'
+        assert s['final_equity']!=ws[-1]['equity_end']
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_review_text_changes_exactly_with_in_memory_rounds(lang):
+    x=render('review')[lang]
+    assert x['counts']=={'rechazado':1,'aprobado_con_cambios':1,'aprobado':1}
+    assert x['lastBlocking']==24
+    expected={'es':'1 rechazada ┬╖ 1 aprobada con cambios ┬╖ 1 aprobada','en':'1 rejected ┬╖ 1 approved with changes ┬╖ 1 approved','zh':'1 σ¢₧Θºüσ¢₧ ┬╖ 1 σ¢₧µ£ëµó¥Σ╗╢ΘÇÜΘüÄ ┬╖ 1 σ¢₧ΘÇÜΘüÄ'}[lang]
+    assert expected in x['hero'] and expected in x['review']
+    assert {'es':'├║ltimo bloqueante en la ronda 24','en':'last blocking finding in round 24','zh':'µ£Çσ╛îΣ╕ÇσÇïΘÿ╗µû╖τ┤Üτ╝║ΘÖ╖σç║τÅ╛σ£¿τ¼¼ 24 σ¢₧σÉê'}[lang] in x['review']
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_final_flags_independent_of_last_week_and_final_date(lang):
+    x=render('final')[lang]
+    for sid in ('standard','user'):
+        assert 'stale_price:fixture:2026-09-08' in x[sid]['kpi']
+        assert x['strings']['provisional'] in x[sid]['kpi']
+        assert '2026' in x[sid]['kpi']
+        assert 'stale_price:fixture:2026-09-08' not in x[sid]['chart']
+
+def test_document_counts_and_p7_references():
+    txt=(ROOT/'docs/informes/23_respuesta_ronda17_astra.md').read_text(encoding='utf8')
+    assert 'review_stats.new_total' in txt and '197 en 17 rondas al cierre de esta respuesta' in txt
+    assert 'the 16 review rounds' not in (ROOT/'README.md').read_text(encoding='utf8')
+    p7=(ROOT/'docs/informes/22_respuesta_ronda16_astra.md').read_text(encoding='utf8').split('## 2.',1)[1].split('## 3.',1)[0]
+    assert 'P7 (adenda, ronda 17)' in p7
+
+def test_stale_final_after_clean_last_measured_week_is_preserved(tmp_path,monkeypatch):
+    raw,m=fixture(tmp_path,end='2024-01-17',symbols=('A','B'),prices=lambda d:D(100)+D((d-date(2021,1,1)).days)/100)
+    a=m.securities[m.by_symbol['A']]
+    a.bars=[b for b in a.bars if b.session!=date(2024,1,17)]
+    del m.by_session[a.security_id][date(2024,1,17)]
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,17),slots=1,notional=10000,lot_size=1,label='final_test')
+    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
+    result=r.run();s=result['summary']['forecasters']['Q0']
+    last=result['weeks'][-2]['forecasters']['Q0']
+    assert last['portfolio_net_return_open_close'] is not None and last['flags']==[]
+    fv=s['final_valuation']
+    assert fv['valued_at']=='2024-01-17T23:59:00+08:00' and fv['prices_session']=='2024-01-17'
+    assert fv['flags']==[f'stale_price:{a.security_id}:2024-01-16']
+    assert s['final_equity']!=last['equity_end']
+    assert 'PROVISIONAL' in markdown_report(result,title='final_test')
+    (tmp_path/'backtest_final_test.json').write_text(json.dumps(result,default=str),encoding='utf8')
+    monkeypatch.setattr(export,'STORE',tmp_path)
+    public=export.export_scenario('standard','final_test','x.md')['forecasters']['Q0']
+    assert public['final_flags']==fv['flags'] and public['final_valued_at']==fv['valued_at'] and public['final_prices_session']==fv['prices_session']

