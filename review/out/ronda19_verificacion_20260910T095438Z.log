def review_stats(rounds: list[dict]) -> dict:
    """Recuentos derivados s├│lo de entradas identificables (R17-05): hallazgos nuevos emitidos y verificaciones de Astra.

    Una verificaci├│n cuenta como tal si Astra la registr├│ con estado ``reproducido`` en una ronda posterior; el texto de la
    verificaci├│n puede declararla parcial, y eso no se interpreta aqu├¡: se publica el recuento y el enlace al JSON."""
    new_by_id: dict[str, str] = {}
    emitted_round: dict[str, int] = {}
    for r in rounds:
        for h in r["new_findings"]:
            new_by_id[h["id"]] = h.get("severity") or ""
            emitted_round[h["id"]] = r["round"]
    verified: set[str] = set()
    for r in rounds:
        for v in r["verifications"]:
            # s├│lo cuenta una verificaci├│n de un hallazgo existente, en una ronda posterior a su emisi├│n (R18-03)
            if v["id"] in new_by_id and v["state"] == "reproducido" and r["round"] > emitted_round[v["id"]]:
