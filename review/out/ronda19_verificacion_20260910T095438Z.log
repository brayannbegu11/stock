+from review.out.astra_scratch.test_r19_verification import ROOT, D, date, fixture, Runner, BacktestConfig, MomentumForecaster, RandomForecaster, export, read_source, render
+from twlab.ledger import Fill
+import pytest
+
+@pytest.mark.parametrize('lang,word',[('es','heredad'),('en','inherited'),('zh','µë┐µÄÑ')])
+def test_cost_label_discloses_sales_denominator(lang,word):
+    x=render()[lang]
+    # W29 has no new investment: denominator is solely inherited gross sales.
+    w=next(w for w in read_source(export.SCENARIOS[0][1])['weeks'] if w['week_id']=='2026-W29')['forecasters']['Q0']
+    assert w['picks']==[] and w['costs_denominator_twd']==6159300 and w['costs_twd']==33381
+    assert word in x['strings']['kpi']['costs'].lower(),x['strings']['kpi']['costs']
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_positive_final_returns_do_not_render_universal_loss(lang):
+    x=render('profitable')[lang]
+    phrase={'es':'ninguna cartera gana dinero','en':'no portfolio makes money','zh':'µ▓Æµ£ëΣ╗╗Σ╜òµèòΦ│çτ╡äσÉêσ£¿µëúΘÖñµêÉµ£¼σ╛îτì▓σê⌐'}[lang]
+    assert phrase not in x['hero'],x['hero']
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_interval_excluding_zero_is_not_described_as_including_it(lang):
+    x=render('profitable')[lang]
+    phrase={'es':'intervalo de confianza del exceso incluye el cero','en':'confidence interval of the excess includes zero','zh':'Φ╢àΘíìσá▒Θà¼τÜäΣ┐íΦ│┤σìÇΘûôσîàσÉ½Θ¢╢'}[lang]
+    assert phrase not in x['hero'],x['hero']
+
+def test_pending_week_reports_costs_of_entries_already_executed(tmp_path):
+    raw,m=fixture(tmp_path,end='2024-01-10')
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,10),slots=1,notional=10000,lot_size=1,min_commission_twd=D(20),slippage_bps=0)
+    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
+    r.run_week(date(2024,1,7))
+    w=r.weeks[-1]; fr=w['forecasters']['Q0']; slot=r.open_slots['Q0'][0][1][0]
+    assert w['pending_outcome'] and isinstance(slot.entry,Fill) and fr['filled']==1
+    cost=slot.entry.commission+slot.entry.tax+slot.entry.slippage_cost
+    assert cost==20 and slot.entry.gross==9900
+    assert fr.get('costs_twd')==float(cost),(fr,cost)
+
+@pytest.mark.parametrize('sid,label,report',export.SCENARIOS)
+def test_report_cost_heading_states_its_actual_denominator(sid,label,report):
+    txt=(ROOT/'docs/informes'/report).read_text(encoding='utf8')
+    heading=next(l for l in txt.splitlines() if l.startswith('| Pronosticador | Media semanal'))
+    assert 'heredad' in heading,heading
+
+def test_w28_is_not_described_as_excluded_from_all_statistics():
+    d=read_source(export.SCENARIOS[0][1]);fr=next(w for w in d['weeks'] if w['week_id']=='2026-W28')['forecasters']['Q0']
+    assert fr['portfolio_net_return_open_close'] is None and fr['costs_over_invested']>0
+    txt=(ROOT/'docs/informes'/export.SCENARIOS[0][2]).read_text(encoding='utf8')
+    assert 'la semana 2026-W28 qued├│ fuera de la estad├¡stica' not in txt
