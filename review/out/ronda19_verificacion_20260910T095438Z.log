from review.out.astra_scratch.test_r18_verification import *
from twlab.sources import twse_daily as td
from twlab.store import RawStore
from datetime import datetime
from functools import lru_cache
from collections import defaultdict
from statistics import fmean

def audit():
    raw=RawStore(ROOT/'data/raw')
    recs=raw.captures();by_dataset=defaultdict(list)
    for rec in recs:by_dataset[(rec.source_id,rec.dataset)].append(rec)
    @lru_cache(None)
    def bars(market,day):
        src,ds,reader,parser=('twse',td.TWSE_DATASET,td.twse_rows,td.bars_twse) if market=='TWSE' else ('tpex',td.TPEX_DATASET,td.tpex_rows,td.bars_tpex)
        found=by_dataset.get((src,ds+'/'+day),[])
        if not found:return {}
        rec=max(found,key=lambda x:x.ingested_at)
        rows=reader(raw,rec)
        return {k:v for k,v in parser(date.fromisoformat(day),rows).items() if v.has_regular_price} if rows else {}
    def prices(sids,at,kind):
        result={}
        for sid in sids:
            market,rest=sid.split(':',1);symbol=rest.split('@')[0]
            b=bars(market,at.date().isoformat()).get(symbol)
            if b:result[sid]=getattr(b,kind)
        return result
    report={}; counts={'packets':0,'series':0,'session_references':0,'forecasts':0,'picks':0,'filled':0}
    for sid,label,informe in export.SCENARIOS:
        source=read_source(label);a=source['summary']['assumptions']
        costs=CostModel(D(a['commission_per_side']),sell_tax=D(a['sell_tax']),slippage_bps_per_side=a['slippage_bps'],min_commission_twd=D(a['min_commission_twd']))
        ledgers={f:PaperLedger(ledger_id=f,initial_cash=D(a['notional']*a['slots']),cost_model=costs,lot_size=a['lot_size']) for f in ('Q0','Q1','A1')}
        followup={f:[] for f in ledgers};week_cost_diffs=[]
        for w in source['weeks']:
            wid=w['week_id'];rec=max(by_dataset[('packet',label+'/'+wid)],key=lambda x:x.ingested_at)
            packet=json.loads(raw.read(rec));counts['packets']+=1
            docs={d['doc_id']:d for d in packet['admitted']}
            for doc in docs.values():
                if doc['kind']!='price_bar_series':continue
                counts['series']+=1
                manifest=docs[doc['payload']['captures_doc']]['payload']['session_captures']
                sessions=doc['payload']['sessions'];counts['session_references']+=len(sessions)
                assert all(row[0] in manifest for row in sessions)
                assert manifest[sessions[-1][0]]==doc['capture_id']
            entry,exit_=map(datetime.fromisoformat,(packet['entry_at'],packet['exit_at']))
            for f,lg in ledgers.items():
                fr=w['forecasters'][f]
                fc=max(by_dataset[('forecast',label+'/'+f+'/'+wid)],key=lambda x:x.ingested_at)
                archive=json.loads(raw.read(fc));counts['forecasts']+=1
                assert archive['packet_hash']==packet['packet_hash']
                assert [p['security_id'] for p in archive['forecast']['ranking']]==[p['security_id'] for p in fr['picks']]
                assert fr['notional_per_slot']==float((lg.cash/a['slots']).to_integral_value(rounding='ROUND_DOWN'))
                picks=[p['security_id'] for p in fr['picks']];counts['picks']+=len(picks)
                budget=D(str(fr['notional_per_slot']))
                slots=enter_basket(lg,picks=picks,slots=a['slots'],notional_per_slot=budget,open_prices=prices(picks,entry,'open'),at=entry,week_id=wid)
                followup[f].append(slots)
                weekly_cost=D(0)
                for slot in slots:
                    if slot.entry:
                        counts['filled']+=1
                        fill=slot.entry;weekly_cost+=fill.commission+fill.tax+fill.slippage_cost
                        assert -fill.cash_delta<=budget
                        assert oracle_cost(fill.shares+a['lot_size'],fill.price,costs)>budget
                if not w['pending_outcome']:
                    close=prices(list(lg.positions),exit_,'close')
                    for ss in followup[f]:
                        previous=[x.exit for x in ss]
                        exit_basket(lg,ss,close_prices=close,at=exit_,week_id=wid)
                        for slot,old in zip(ss,previous):
                            if slot.exit is not None and slot.exit is not old:
                                fill=slot.exit;weekly_cost+=fill.commission+fill.tax+fill.slippage_cost
                    if float(weekly_cost)!=fr['costs_twd']:week_cost_diffs.append({'week':wid,'f':f,'published':fr['costs_twd'],'ledger':str(weekly_cost)})
                    # Check exact equity on sessions with complete market closes.
                    if all(x in close for x in lg.positions):
                        assert float(lg.valuation(prices=close,at=exit_).total)==fr['equity_end']
                for slot,p in zip(slots,fr['picks']):
                    assert slot.status==p['entry_status'],(sid,wid,f,slot.status,p)
                assert sum(slot.entry is not None for slot in slots)==fr['filled']
                assert sum(slot.status=='entry_failed' for slot in slots)==fr['failed']
        bound=datetime.fromisoformat(source['summary']['forecasters']['Q0']['final_valuation']['valued_at'])
        for f,lg in ledgers.items():
            final=lg.valuation(prices=prices(list(lg.positions),bound,'close'),at=bound)
            assert float(final.total)==source['summary']['forecasters'][f]['final_equity']
            xs=[w['forecasters'][f].get('portfolio_net_return_open_close') for w in source['weeks'] if not w['pending_outcome']]
            assert fmean(x for x in xs if x is not None)==source['summary']['forecasters'][f]['mean_weekly_net_return_open_close']
        report[sid]={'final_equities':{f:str(lg.valuation(prices=prices(list(lg.positions),bound,'close'),at=bound).total) for f,lg in ledgers.items()},'weekly_cost_differences':week_cost_diffs}
    return {'counts':counts,'scenarios':report}

if __name__=='__main__':
