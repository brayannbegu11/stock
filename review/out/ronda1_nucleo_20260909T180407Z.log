"""Comparaciones emparejadas e incertidumbre por bloques de semanas."""
from __future__ import annotations

import random
from dataclasses import dataclass
from datetime import datetime
from decimal import Decimal
from typing import Sequence


class IntervalMismatch(ValueError):
    pass


@dataclass(frozen=True)
class IntervalReturn:
    label: str
    start_at: datetime
    end_at: datetime
    start_price_kind: str   # open | close
    end_price_kind: str     # open | close
    value: Decimal


def paired_excess(a: IntervalReturn, b: IntervalReturn) -> Decimal:
    """SIM-12: sólo se restan rentabilidades con los mismos extremos temporales y tipo de precio."""
    key_a = (a.start_at, a.end_at, a.start_price_kind, a.end_price_kind)
    key_b = (b.start_at, b.end_at, b.start_price_kind, b.end_price_kind)
    if key_a != key_b:
        raise IntervalMismatch(f"{a.label} {key_a} vs {b.label} {key_b}")
    return a.value - b.value


def block_bootstrap_mean(values: Sequence[float], *, block_length: int, n_boot: int, seed: int) -> tuple[float, float, float]:
    """Media y percentiles 2,5/97,5 con bootstrap por bloques móviles.

    ``block_length`` no tiene valor por defecto: es un bloqueante del protocolo
    (``statistics.bootstrap_block_length``) y debe fijarse antes de mirar la reserva.
    """
    if block_length < 1 or block_length > len(values):
        raise ValueError("block_length must be within 1..len(values)")
    rng = random.Random(seed)
    n = len(values)
    starts = n - block_length + 1
    means: list[float] = []
    for _ in range(n_boot):
        sample: list[float] = []
        while len(sample) < n:
            s = rng.randrange(starts)
            sample.extend(values[s:s + block_length])
        sample = sample[:n]
        means.append(sum(sample) / n)
    means.sort()
    lo = means[int(0.025 * (n_boot - 1))]
    hi = means[int(0.975 * (n_boot - 1))]
    return sum(values) / n, lo, hi
"""Validación de predicciones contra el contrato adjunto y contra el paquete."""
from __future__ import annotations

import json
from pathlib import Path
from typing import Any, Optional

from jsonschema import Draft202012Validator, FormatChecker

from .packet import Packet, validate_document_references

REPO_ROOT = Path(__file__).resolve().parents[2]
PREDICTION_SCHEMA_PATH = REPO_ROOT / "docs" / "spec" / "v2" / "PREDICCION.schema.json"


def load_prediction_schema() -> dict:
    return json.loads(PREDICTION_SCHEMA_PATH.read_text(encoding="utf-8"))


_validator: Optional[Draft202012Validator] = None


def prediction_validator() -> Draft202012Validator:
    global _validator
    if _validator is None:
        schema = load_prediction_schema()
        Draft202012Validator.check_schema(schema)
        _validator = Draft202012Validator(schema, format_checker=FormatChecker())
    return _validator


def validate_prediction(obj: dict[str, Any], packet: Optional[Packet] = None) -> list[str]:
    """Devuelve la lista de problemas; vacía si la predicción es válida.

    - Esquema JSON (incluye: abstained/invalid exigen motivo; probabilidad
      calibrada exige calibrador; prospectiva exige recibo temporal).
    - TXT-05: referencias documentales fuera del paquete.
    - Coherencia: ``packet_id`` debe coincidir con el paquete entregado.
    """
    problems = [
        f"schema:{'/'.join(str(p) for p in e.path) or '$'}:{e.message}"
        for e in prediction_validator().iter_errors(obj)
    ]
    if packet is not None:
        if obj.get("packet_id") != packet.packet_id:
            problems.append(f"packet_id_mismatch:{obj.get('packet_id')}!={packet.packet_id}")
        for item in obj.get("ranking", []) or []:
            missing = validate_document_references(item.get("document_ids", []) or [], packet)
            if missing:
                problems.append(f"TXT-05:rank{item.get('rank')}:unknown_documents:{missing}")
    return problems
