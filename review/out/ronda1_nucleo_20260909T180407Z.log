class PaperLedger:
    def __init__(
        self,
        *,
        ledger_id: str,
        initial_cash: Decimal,
        cost_model: CostModel,
        price_series_kind: str = "nominal",
        lot_size: int = 1000,
    ) -> None:
        if price_series_kind != "nominal":
            raise ValueError(
                "ledger requires nominal prices; adjusted series would double-count corporate actions (SIM-02)"
            )
        self.ledger_id = ledger_id
        self.cash = q_twd(D(initial_cash))
        self.initial_cash = self.cash
        self.costs = cost_model
        self.lot_size = lot_size
        self.positions: dict[str, Position] = {}
        self.closed: list[Position] = []
        self.events: list[LedgerEvent] = []
        self._applied_actions: set[str] = set()
        self._seq = 0

    # -- utilidades -------------------------------------------------------
    def _log(self, kind: str, at: datetime, security_id: Optional[str], cash_delta: Decimal,
             detail: str, event_id: str) -> None:
        self._seq += 1
        self.events.append(LedgerEvent(self._seq, kind, ensure_aware(at), security_id, cash_delta, detail, event_id))

    def _reject(self, security_id: str, side: str, reason: str, detail: str, at: datetime, event_id: str) -> Rejection:
        r = Rejection(security_id, side, reason, detail, at, event_id)
        self._log(f"{side}_rejected", at, security_id, ZERO, reason, event_id)
        return r

    def available_cash(self) -> Decimal:
        """Efectivo disponible. El dinero inmovilizado en posiciones no cuenta (SIM-05)."""
        return self.cash

    # -- operaciones ------------------------------------------------------
    def buy(self, *, security_id: str, price: Decimal, shares: int, at: datetime, event_id: str) -> Result:
        ensure_aware(at)
        price = D(price)
        if shares <= 0 or shares % self.lot_size != 0:
            return self._reject(security_id, "buy", "not_round_lot", f"shares={shares} lot={self.lot_size}", at, event_id)
        pos = self.positions.get(security_id)
        if pos is not None and pos.status != "open":
            return self._reject(security_id, "buy", f"position_{pos.status}", "cannot add to non-open position", at, event_id)
        gross = price * shares
        slip = gross * self.costs.slippage
        commission = (gross + slip) * self.costs.commission_per_side
        total = q_twd(gross + slip + commission)
        if total > self.cash:
            return self._reject(security_id, "buy", "insufficient_cash", f"need={total} cash={self.cash}", at, event_id)
        self.cash -= total
        if pos is None:
            self.positions[security_id] = Position(security_id, shares, total, at, last_price=price, lot_size=self.lot_size)
        else:
            pos.shares += shares
            pos.cost_twd += total
            pos.last_price = price
        fill = Fill(security_id, "buy", shares, price, gross, q_twd(slip), q_twd(commission), ZERO, -total, at, event_id)
        self._log("buy", at, security_id, -total, f"{shares}@{price}", event_id)
        return fill

    def sell(self, *, security_id: str, price: Decimal, shares: int, at: datetime, event_id: str) -> Result:
        ensure_aware(at)
        price = D(price)
        pos = self.positions.get(security_id)
        if pos is None:
            return self._reject(security_id, "sell", "no_position", "", at, event_id)
        if pos.status != "open":
            return self._reject(security_id, "sell", f"exit_blocked_{pos.status}", "position remains in ledger", at, event_id)
        if shares <= 0 or shares > pos.shares:
            return self._reject(security_id, "sell", "invalid_quantity", f"shares={shares} held={pos.shares}", at, event_id)
        gross = price * shares
        slip = gross * self.costs.slippage
        commission = (gross - slip) * self.costs.commission_per_side
        tax = gross * self.costs.sell_tax
        net = q_twd(gross - slip - commission - tax)
        self.cash += net
        pos.shares -= shares
        pos.last_price = price
        if pos.shares == 0:
            self.closed.append(self.positions.pop(security_id))
        fill = Fill(security_id, "sell", shares, price, gross, q_twd(slip), q_twd(commission), q_twd(tax), net, at, event_id)
        self._log("sell", at, security_id, net, f"{shares}@{price}", event_id)
        return fill

    # -- estados ----------------------------------------------------------
    def mark_suspended(self, security_id: str, *, at: datetime, detail: str = "") -> None:
        pos = self.positions[security_id]
        pos.status = "suspended"
        pos.notes.append(f"suspended@{at.isoformat()} {detail}")
        self._log("suspended", at, security_id, ZERO, detail, f"susp:{security_id}:{at.isoformat()}")

    def mark_resumed(self, security_id: str, *, at: datetime) -> None:
        pos = self.positions[security_id]
        if pos.status == "suspended":
            pos.status = "open"
            self._log("resumed", at, security_id, ZERO, "", f"res:{security_id}:{at.isoformat()}")

    def apply_corporate_action(self, action: CorporateAction) -> None:
        if action.event_id in self._applied_actions:
            raise DuplicateCorporateAction(action.event_id)
        pos = self.positions.get(action.security_id)
        self._applied_actions.add(action.event_id)
        if pos is None:
            self._log("corporate_action_ignored", action.effective_at, action.security_id, ZERO,
                      f"{action.kind}: no position", action.event_id)
            return
        if action.kind == "cash_dividend":
            if action.per_share_cash is None:
                raise ValueError("cash_dividend requires per_share_cash")
            amount = q_twd(D(action.per_share_cash) * pos.shares)
            self.cash += amount
            self._log("cash_dividend", action.effective_at, action.security_id, amount,
                      f"{pos.shares}x{action.per_share_cash}", action.event_id)
        elif action.kind == "split":
            if action.split_ratio is None:
                raise ValueError("split requires split_ratio")
            new_shares = D(pos.shares) * D(action.split_ratio)
            if new_shares != new_shares.to_integral_value():
                pos.notes.append(f"fractional_shares_after_split:{new_shares}")
            pos.shares = int(new_shares.to_integral_value(rounding=ROUND_DOWN))
            if pos.last_price is not None:
                pos.last_price = pos.last_price / D(action.split_ratio)
            self._log("split", action.effective_at, action.security_id, ZERO,
                      f"ratio={action.split_ratio} shares={pos.shares}", action.event_id)
        elif action.kind == "delisting":
            pos.terminal_price = action.terminal_price
            pos.status = "delisted_settled" if action.terminal_price is not None else "delisted_unresolved"
            self._log("delisting", action.effective_at, action.security_id, ZERO,
                      f"terminal_price={action.terminal_price}", action.event_id)
        else:
            raise ValueError(f"unknown corporate action kind {action.kind!r}")

    # -- valoración -------------------------------------------------------
    def valuation(self, *, prices: Mapping[str, Decimal], at: datetime,
                  unresolved_policy: str = "zero_flagged") -> Valuation:
        ensure_aware(at)
        if unresolved_policy not in ("zero_flagged", "raise"):
            raise ValueError(unresolved_policy)
        value = ZERO
        unresolved: list[str] = []
        flags: list[str] = []
        for sid, pos in self.positions.items():
            if pos.status == "delisted_settled":
                value += D(pos.terminal_price) * pos.shares
                flags.append(f"{sid}:terminal_price")
            elif pos.status == "delisted_unresolved":
                unresolved.append(sid)
                if unresolved_policy == "raise":
                    raise MissingPrice(f"{sid} delisted without terminal price")
                flags.append(f"{sid}:unresolved_valued_at_zero")
            elif sid in prices:
                pos.last_price = D(prices[sid])
                value += pos.last_price * pos.shares
            elif pos.status == "suspended" and pos.last_price is not None:
                value += pos.last_price * pos.shares
                flags.append(f"{sid}:suspended_stale_price")
            else:
                raise MissingPrice(f"no price for open position {sid} at {at.isoformat()}; absence is not a zero return")
        value = q_twd(value)
        return Valuation(at, self.cash, value, self.cash + value, tuple(unresolved), tuple(flags))
"""Cesta semanal de hasta cinco puestos de igual peso (PROTOCOLO.yaml weekly_experiment)."""
from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from decimal import ROUND_DOWN, Decimal
from typing import Mapping, Optional, Sequence

from .ledger import Fill, PaperLedger, Rejection

D = Decimal


@dataclass
class Slot:
    rank: int
    security_id: Optional[str]
    status: str                      # filled | entry_failed | empty | exited | exit_blocked
    reason: str = ""
    entry: Optional[Fill] = None
    exit: Optional[Fill] = None
    notes: list[str] = field(default_factory=list)

    @property
    def gross_pick_return(self) -> Optional[Decimal]:
        if self.entry and self.exit:
            return (self.exit.price - self.entry.price) / self.entry.price
        return None


def enter_basket(
    ledger: PaperLedger,
    *,
    picks: Sequence[str],
    slots: int,
    notional_per_slot: Decimal,
    open_prices: Mapping[str, Decimal],
    at: datetime,
    week_id: str,
    eligibility: Optional[Mapping[str, tuple[bool, str]]] = None,
) -> list[Slot]:
    """Entra en cada selección con importe nocional fijo por puesto.

    Un puesto fallido conserva su efectivo (SIM-09); no se redistribuye a los
    demás. Los puestos sin selección quedan en efectivo
    (``fill_unavailable_slots_with_cash``).
    """
    if len(picks) > slots:
        raise ValueError(f"{len(picks)} picks exceed {slots} slots")
    out: list[Slot] = []
    for rank in range(1, slots + 1):
        if rank > len(picks):
            out.append(Slot(rank, None, "empty", "no_selection"))
            continue
        sid = picks[rank - 1]
        if eligibility is not None:
            ok, why = eligibility.get(sid, (False, "not_in_eligibility_table"))
            if not ok:
                out.append(Slot(rank, sid, "entry_failed", f"ineligible:{why}"))
                continue
        price = open_prices.get(sid)
        if price is None:
            out.append(Slot(rank, sid, "entry_failed", "no_open_price"))
            continue
        price = D(price)
        unit_cost = price * (1 + ledger.costs.slippage) * (1 + ledger.costs.commission_per_side)
        lots = int((D(notional_per_slot) / (unit_cost * ledger.lot_size)).to_integral_value(rounding=ROUND_DOWN))
        shares = lots * ledger.lot_size
        if shares <= 0:
            out.append(Slot(rank, sid, "entry_failed", "notional_below_one_lot"))
            continue
        res = ledger.buy(security_id=sid, price=price, shares=shares, at=at, event_id=f"{week_id}:entry:{rank}:{sid}")
        if isinstance(res, Rejection):
            out.append(Slot(rank, sid, "entry_failed", res.reason))
        else:
            out.append(Slot(rank, sid, "filled", entry=res))
    return out


def exit_basket(
    ledger: PaperLedger,
    slots: Sequence[Slot],
    *,
    close_prices: Mapping[str, Decimal],
    at: datetime,
    week_id: str,
) -> list[Slot]:
    for s in slots:
        if s.status != "filled" or s.entry is None or s.security_id is None:
            continue
        price = close_prices.get(s.security_id)
        if price is None:
            s.status = "exit_blocked"
            s.reason = "no_close_price"
            continue
        res = ledger.sell(security_id=s.security_id, price=D(price), shares=s.entry.shares, at=at,
                          event_id=f"{week_id}:exit:{s.rank}:{s.security_id}")
        if isinstance(res, Rejection):
            s.status = "exit_blocked"
            s.reason = res.reason
        else:
            s.status = "exited"
            s.exit = res
    return list(slots)


@dataclass(frozen=True)
class BasketReport:
    week_id: str
    filled_slots: int
    empty_slots: int
    failed_slots: int
    exit_blocked_slots: int
    mean_gross_pick_return: Optional[Decimal]   # media de selecciones ejecutadas, bruta
    portfolio_net_return: Decimal               # (patrimonio_fin - patrimonio_ini)/patrimonio_ini


def basket_report(week_id: str, slots: Sequence[Slot], *, equity_start: Decimal, equity_end: Decimal) -> BasketReport:
    """SIM-11: la media de las selecciones no es la rentabilidad de la cartera."""
    rets = [s.gross_pick_return for s in slots if s.gross_pick_return is not None]
    mean = (sum(rets, D(0)) / len(rets)) if rets else None
    return BasketReport(
        week_id=week_id,
        filled_slots=sum(1 for s in slots if s.status in ("filled", "exited", "exit_blocked")),
        empty_slots=sum(1 for s in slots if s.status == "empty"),
        failed_slots=sum(1 for s in slots if s.status == "entry_failed"),
        exit_blocked_slots=sum(1 for s in slots if s.status == "exit_blocked"),
        mean_gross_pick_return=mean,
        portfolio_net_return=(D(equity_end) - D(equity_start)) / D(equity_start),
    )

