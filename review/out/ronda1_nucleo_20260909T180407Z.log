134:     def universe(
135:         self,
136:         *,
137:         as_of: date,
138:         known_at: Optional[datetime] = None,
139:         instrument_types: tuple[str, ...] = (ORDINARY_EQUITY,),
140:         markets: tuple[str, ...] = ("TWSE", "TPEX"),
141:     ) -> list[SecurityVersion]:
142:         best: dict[str, SecurityVersion] = {}
143:         for v in self._effective(known_at):
144:             if not v.covers(as_of):
145:                 continue
146:             cur = best.get(v.security_id)
147:             if cur is None or v.valid_from > cur.valid_from:
148:                 best[v.security_id] = v
149:         out = [v for v in best.values() if v.instrument_type in instrument_types and v.market in markets]
150:         return sorted(out, key=lambda v: (v.market, v.symbol))
