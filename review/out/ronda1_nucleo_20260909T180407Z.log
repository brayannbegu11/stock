src/twlab/schemas.py
32: def validate_prediction(obj: dict[str, Any], packet: Optional[Packet] = None) -> list[str]:
33:     """Devuelve la lista de problemas; vacía si la predicción es válida.
34: 
35:     - Esquema JSON (incluye: abstained/invalid exigen motivo; probabilidad
36:       calibrada exige calibrador; prospectiva exige recibo temporal).
37:     - TXT-05: referencias documentales fuera del paquete.
38:     - Coherencia: ``packet_id`` debe coincidir con el paquete entregado.
39:     """
40:     problems = [
41:         f"schema:{'/'.join(str(p) for p in e.path) or '$'}:{e.message}"
42:         for e in prediction_validator().iter_errors(obj)
43:     ]
44:     if packet is not None:
45:         if obj.get("packet_id") != packet.packet_id:
46:             problems.append(f"packet_id_mismatch:{obj.get('packet_id')}!={packet.packet_id}")
47:         for item in obj.get("ranking", []) or []:
48:             missing = validate_document_references(item.get("document_ids", []) or [], packet)
49:             if missing:
50:                 problems.append(f"TXT-05:rank{item.get('rank')}:unknown_documents:{missing}")
51:     return problems

