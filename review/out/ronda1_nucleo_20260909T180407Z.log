189:     def sell(self, *, security_id: str, price: Decimal, shares: int, at: datetime, event_id: str) -> Result:
190:         ensure_aware(at)
191:         price = D(price)
192:         pos = self.positions.get(security_id)
193:         if pos is None:
194:             return self._reject(security_id, "sell", "no_position", "", at, event_id)
195:         if pos.status != "open":
196:             return self._reject(security_id, "sell", f"exit_blocked_{pos.status}", "position remains in ledger", at, event_id)
197:         if shares <= 0 or shares > pos.shares:
198:             return self._reject(security_id, "sell", "invalid_quantity", f"shares={shares} held={pos.shares}", at, event_id)
199:         gross = price * shares
200:         slip = gross * self.costs.slippage
201:         commission = (gross - slip) * self.costs.commission_per_side
202:         tax = gross * self.costs.sell_tax
203:         net = q_twd(gross - slip - commission - tax)
204:         self.cash += net
205:         pos.shares -= shares
206:         pos.last_price = price
207:         if pos.shares == 0:
208:             self.closed.append(self.positions.pop(security_id))
209:         fill = Fill(security_id, "sell", shares, price, gross, q_twd(slip), q_twd(commission), q_twd(tax), net, at, event_id)
210:         self._log("sell", at, security_id, net, f"{shares}@{price}", event_id)
211:         return fill
212: 
213:     # -- estados ----------------------------------------------------------
214:     def mark_suspended(self, security_id: str, *, at: datetime, detail: str = "") -> None:
215:         pos = self.positions[security_id]
216:         pos.status = "suspended"
217:         pos.notes.append(f"suspended@{at.isoformat()} {detail}")
218:         self._log("suspended", at, security_id, ZERO, detail, f"susp:{security_id}:{at.isoformat()}")
219: 
220:     def mark_resumed(self, security_id: str, *, at: datetime) -> None:
221:         pos = self.positions[security_id]
222:         if pos.status == "suspended":
223:             pos.status = "open"
224:             self._log("resumed", at, security_id, ZERO, "", f"res:{security_id}:{at.isoformat()}")
225: 
226:     def apply_corporate_action(self, action: CorporateAction) -> None:
227:         if action.event_id in self._applied_actions:
228:             raise DuplicateCorporateAction(action.event_id)
229:         pos = self.positions.get(action.security_id)
230:         self._applied_actions.add(action.event_id)
231:         if pos is None:
232:             self._log("corporate_action_ignored", action.effective_at, action.security_id, ZERO,
233:                       f"{action.kind}: no position", action.event_id)
234:             return
235:         if action.kind == "cash_dividend":
236:             if action.per_share_cash is None:
237:                 raise ValueError("cash_dividend requires per_share_cash")
238:             amount = q_twd(D(action.per_share_cash) * pos.shares)
239:             self.cash += amount
240:             self._log("cash_dividend", action.effective_at, action.security_id, amount,
241:                       f"{pos.shares}x{action.per_share_cash}", action.event_id)
242:         elif action.kind == "split":
243:             if action.split_ratio is None:
244:                 raise ValueError("split requires split_ratio")
245:             new_shares = D(pos.shares) * D(action.split_ratio)
246:             if new_shares != new_shares.to_integral_value():
247:                 pos.notes.append(f"fractional_shares_after_split:{new_shares}")
248:             pos.shares = int(new_shares.to_integral_value(rounding=ROUND_DOWN))
249:             if pos.last_price is not None:
250:                 pos.last_price = pos.last_price / D(action.split_ratio)
251:             self._log("split", action.effective_at, action.security_id, ZERO,
252:                       f"ratio={action.split_ratio} shares={pos.shares}", action.event_id)
253:         elif action.kind == "delisting":
254:             pos.terminal_price = action.terminal_price
255:             pos.status = "delisted_settled" if action.terminal_price is not None else "delisted_unresolved"
256:             self._log("delisting", action.effective_at, action.security_id, ZERO,
257:                       f"terminal_price={action.terminal_price}", action.event_id)
258:         else:
259:             raise ValueError(f"unknown corporate action kind {action.kind!r}")
