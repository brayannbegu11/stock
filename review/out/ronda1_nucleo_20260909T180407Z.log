class InMemoryTests:
    def pytest_collection(self, session):
        session.items = [
            pytest.Function.from_parent(session, name=name, callobj=fn)
            for name, fn in list(globals().items())
            if name.startswith('test_') and callable(fn)
        ]
        session.testscollected = len(session.items)
        return True

raise SystemExit(pytest.main(['-q', '-s', '-p', 'no:cacheprovider', '-o', 'addopts=', '--tb=short'], plugins=[InMemoryTests()]))

