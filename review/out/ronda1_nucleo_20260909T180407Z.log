[project]
name = "twlab"
version = "0.1.0"
description = "Laboratorio de inteligencia y evaluación bursátil para TWSE/TPEx con control temporal estricto (carteras simuladas; sin órdenes reales)."
requires-python = ">=3.11"
dependencies = [
  "pandas>=2.2",
  "pyarrow>=15",
  "duckdb>=1.0",
  "numpy>=1.26",
