    # ---- FinMind (metadatos; histórico se pide aparte por valor) ---------
    Endpoint("finmind", "TaiwanStockInfo", FINMIND + "TaiwanStockInfo", "catálogo con tipo e industria", "date",
             date_format="iso", notes="date = última actualización de FinMind, no fecha de alta"),
    Endpoint("finmind", "TaiwanStockDelisting", FINMIND + "TaiwanStockDelisting", "retiradas (todos los tipos)", "date",
             date_format="iso"),
)


def by_source(source_id: str) -> list[Endpoint]:
    return [e for e in ENDPOINTS if e.source_id == source_id]
"""twlab — laboratorio bursátil de Taiwán con control temporal.

Reglas no negociables (ver docs/spec/v2/CONTRATOS_DATOS.md):
- Toda observación lleva `recorded_at`/`ingested_at` reales; nunca se falsifican.
- Los precios nominales y ajustados no se mezclan sin transformación explícita.
- El predictor sólo ve `information_packet`; el evaluador sólo lee predicciones selladas.
- El libro (ledger) calcula dinero; los modelos sólo puntúan o extraen.
"""
