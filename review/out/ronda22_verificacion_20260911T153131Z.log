+import copy
+import importlib.util
+import json
+import subprocess
+from dataclasses import replace
+from datetime import date, datetime, timezone
+from pathlib import Path
+
+import pytest
+from review.out.astra_scratch import test_r21 as prev
+from twlab.packet import packet_from_json, packet_to_json
+from twlab.store import RawStore
+
+
+def save_forecast(raw, d, mutate):
+    w = d['weeks'][-1]
+    x = w['forecasters']['Q0']
+    old = raw.get(x['forecast_capture_id'])
+    body = json.loads(raw.read(old))
+    mutate(body['forecast'])
+    rec = raw.put(source_id='forecast', dataset=old.dataset,
+                  payload=json.dumps(body).encode(), url='fixture')
+    x.update(forecast_sha256=rec.sha256, forecast_capture_id=rec.capture_id,
+             forecast_status=body['forecast']['status'])
+    return body
+
+
+def exported(raw, d, tmp_path, monkeypatch):
+    return prev.export_setup(monkeypatch, raw, d, tmp_path).build()['scenarios'][0]['weeks'][-1]
+
+
+@pytest.mark.parametrize('kind', ['abstained', 'selected_empty', 'invalid', 'abstained_nonempty', 'duplicate', 'rank_order', 'picks_order'])
+def test_forecast_contract(tmp_path, monkeypatch, kind):
+    raw, _, _, _, d, _ = prev.sunday_fixture(tmp_path, monkeypatch)
+    x = d['weeks'][-1]['forecasters']['Q0']
+    def mutate(fc):
+        if kind in ('abstained', 'invalid', 'selected_empty'):
+            fc.update(status='selected' if kind == 'selected_empty' else kind, ranking=[], status_reason='fixture')
+            x['picks'] = []
+        elif kind == 'abstained_nonempty':
+            fc.update(status='abstained', status_reason='fixture')
+            x['picks'] = []
+        else:
+            fc['ranking'].append(copy.deepcopy(fc['ranking'][0]))
+            fc['ranking'][1]['rank'] = 2
+            x['picks'].append(copy.deepcopy(x['picks'][0]))
+            if kind != 'duplicate':
+                fc['ranking'][1]['security_id'] = 'TWSE:B@2000-01-01'
+                x['picks'][1].update(security_id='TWSE:B@2000-01-01', symbol='B', name='B')
+            if kind == 'rank_order':
+                fc['ranking'].reverse()
+                x['picks'].reverse()
+            if kind == 'picks_order':
+                x['picks'].reverse()
+    save_forecast(raw, d, mutate)
+    w = exported(raw, d, tmp_path, monkeypatch)
+    assert w['prospective'] is (kind == 'abstained'), (kind, w)
+
+
+def test_invalid_runner_is_not_prediction(tmp_path, monkeypatch):
+    raw, market, cfg, runner, _, _ = prev.sunday_fixture(tmp_path, monkeypatch)
+    original = runner.make_forecast
+    def invalid(*args, **kwargs):
+        obj = original(*args, **kwargs)
+        obj['ranking'] = []  # contract validator, not archive tampering, makes this invalid
+        return obj
+    monkeypatch.setattr(runner, 'make_forecast', invalid)
+    runner.weeks = []
+    d = runner.run()
+    assert all(x['forecast_status'] == 'invalid' for x in d['weeks'][-1]['forecasters'].values())
+    w = exported(raw, d, tmp_path, monkeypatch)
+    assert w['prospective'] is False, w
+
+
+@pytest.mark.parametrize('kind', ['payload', 'source_hash', 'rejected', 'missing_plan'])
+def test_packet_logical_hash_is_rederived(tmp_path, monkeypatch, kind):
+    raw, _, _, _, d, _ = prev.sunday_fixture(tmp_path, monkeypatch)
+    w = d['weeks'][-1]
+    body = json.loads(raw.read(raw.get(w['packet_capture'])))
+    if kind == 'payload':
+        body['admitted'][0]['payload'] = {'fabricated': 123}
+    elif kind == 'source_hash':
+        body['admitted'][0]['source_sha256'] = '0' * 64
+    elif kind == 'rejected':
+        body['rejected'].append(['X', 'unknown_availability', 'availability could not be established'])
+    else:
+        del body['packet_id']
+    rec = raw.put(source_id='packet', dataset='other/2024-W02', payload=json.dumps(body).encode(), url='fixture')
+    with pytest.raises((ValueError, KeyError)):
+        packet_from_json(raw.read(rec))
+    w['packet_capture'] = rec.capture_id
+    out = exported(raw, d, tmp_path, monkeypatch)
+    assert out['prospective'] is False, (kind, out)
+
+
+def test_two_valid_packets_same_hash_different_datasets(tmp_path, monkeypatch):
+    raw, _, _, _, d, _ = prev.sunday_fixture(tmp_path, monkeypatch)
+    w = d['weeks'][-1]
+    original = raw.get(w['packet_capture'])
+    p = packet_from_json(raw.read(original))
+    other = replace(p, created_at=datetime(2024, 1, 7, 13, tzinfo=timezone.utc))
+    rec = raw.put(source_id='packet', dataset='other/2024-W02', payload=packet_to_json(other), url='fixture')
+    assert rec.sha256 != original.sha256
+    assert packet_from_json(raw.read(rec)).packet_hash() == w['packet_hash']
+    w['packet_capture'] = rec.capture_id
+    assert exported(raw, d, tmp_path, monkeypatch)['prospective'] is True
+
+
+def test_cutoff_must_match_archived_packet(tmp_path, monkeypatch):
+    raw, _, _, _, d, _ = prev.sunday_fixture(tmp_path, monkeypatch)
+    w = d['weeks'][-1]
+    # Complete synthetic manifest, sources arrived two hours after the true Sunday cutoff.
+    mf = raw.root / 'manifest.jsonl'
+    rows = [json.loads(line) for line in mf.read_text().splitlines()]
+    for row in rows:
+        if row['source_id'] not in ('packet', 'forecast'):
+            row['ingested_at'] = '2024-01-07T12:00:00+00:00'
+    mf.write_text('\n'.join(map(json.dumps, rows)), encoding='utf8')
+    assert exported(raw, d, tmp_path, monkeypatch)['inputs_reason'] == 'late_inputs'
+    w['cutoff_at'] = '2024-01-07T23:00:00+08:00'
+    out = exported(raw, d, tmp_path, monkeypatch)
+    assert out['prospective'] is False, out
+
+
+@pytest.mark.parametrize('kind', ['path_number', 'time_number', 'admitted_string', 'session_list'])
+def test_malformed_provenance_fails_closed(tmp_path, monkeypatch, kind):
+    raw, _, _, _, d, _ = prev.sunday_fixture(tmp_path, monkeypatch)
+    w = d['weeks'][-1]
+    if kind in ('admitted_string', 'session_list'):
+        body = json.loads(raw.read(raw.get(w['packet_capture'])))
+        if kind == 'admitted_string':
+            body['admitted'] = ['bad']
+        else:
+            body['admitted'][0].update(kind='capture_manifest', payload={'session_captures': ['bad']})
+        rec = raw.put(source_id='packet', dataset='bad', payload=json.dumps(body).encode(), url='fixture')
+        w['packet_capture'] = rec.capture_id
+    else:
+        mf = raw.root / 'manifest.jsonl'
+        rows = [json.loads(line) for line in mf.read_text().splitlines()]
+        for row in rows:
+            if row['capture_id'] == w['packet_capture']:
+                row['path' if kind == 'path_number' else 'ingested_at'] = 42
+        mf.write_text('\n'.join(map(json.dumps, rows)), encoding='utf8')
+    assert exported(raw, d, tmp_path, monkeypatch)['prospective'] is False
+
+
+@pytest.mark.parametrize('state', ['prediction', 'late', 'unknown', 'reconstruction'])
+def test_sunday_full_chain_four_states(tmp_path, monkeypatch, state):
+    now = [datetime(2024, 1, 7 if state == 'late' else 6, 12 if state == 'late' else 8, tzinfo=timezone.utc)]
+    monkeypatch.setattr(RawStore, '_now', lambda self: now[0])
+    raw, market = prev.fixture(tmp_path, end='2024-01-26', symbols=('A', 'B'))
+    now[0] = datetime(2024, 1, 8, 1, tzinfo=timezone.utc) if state == 'reconstruction' else datetime(2024, 1, 7, 12, tzinfo=timezone.utc)
+    cfg = prev.BacktestConfig(date(2023, 12, 10), date(2024, 1, 7), slots=1, notional=10000,
+                             lot_size=1, label='lab', archive_label='lab', n_boot=20)
+    q1 = prev.MomentumForecaster(); q1.name = 'Q1'
+    d = prev.Runner(raw, market, cfg, [prev.MomentumForecaster(), q1, prev.RandomForecaster(1)]).run()
+    if state == 'unknown':
+        p = packet_from_json(raw.read(raw.get(d['weeks'][-1]['packet_capture'])))
+        (raw.root / raw.get(p.admitted[0].capture_id).path).unlink()
+    ex = prev.export_setup(monkeypatch, raw, d, tmp_path)
+    out = ex.build(); w = out['scenarios'][0]['weeks'][-1]
+    assert w['pending_outcome'] and w['forecasters']['Q0']['filled'] is None
+    assert w['prospective'] is (state == 'prediction')
+    if state in ('late', 'unknown'):
+        assert w['inputs_reason'] == ('late_inputs' if state == 'late' else 'unverified_inputs')
+    asm = prev.load('assemble_backtest_reports')
+    original_spec = importlib.util.spec_from_file_location
+    def redirected(name, *args, **kwargs):
+        spec = original_spec(name, *args, **kwargs)
+        if name == 'export_site_data':
+            original_exec = spec.loader.exec_module
+            def execute(module):
+                original_exec(module); module.RAW = raw.root
+            spec.loader.exec_module = execute
+        return spec
+    monkeypatch.setattr(importlib.util, 'spec_from_file_location', redirected)
+    phrase = {'prediction': 'predicci├│n del protocolo seg├║n el reloj', 'late': 'datos del paquete recibidos despu├⌐s del corte',
+              'unknown': 'procedencia de las entradas no queda acreditada', 'reconstruction': 'es una reconstrucci├│n'}[state]
+    for sid, header in [('standard', lambda: asm.header_15(d)), ('user', lambda: asm.header_15b(d, d)), ('longhist', lambda: asm.header_15c(d, d))]:
+        path = tmp_path / (sid + '.md')
+        path.write_text(prev.markdown_report(d, title='Backtest fixture'), encoding='utf8')
+        asm._assemble(path, '# Backtest', header)
+        assert phrase in path.read_text(encoding='utf8')
+    path = tmp_path / 'site.json'; path.write_text(json.dumps(out), encoding='utf8')
+    result = subprocess.run(['node', 'review/out/astra_scratch/r22_render.cjs', 'file', str(path)],
+                            cwd=prev.ROOT, capture_output=True, text=True, encoding='utf8', check=True)
+    for lang, x in json.loads(result.stdout).items():
+        tag = x[{'prediction': 'tag_pro', 'late': 'tag_late', 'unknown': 'tag_unv', 'reconstruction': 'tag_recon'}[state]]
+        assert f'<b>{tag} ┬╖' in x['week'], (lang, state)
+
+
+@pytest.mark.parametrize('state', ['prediction', 'late', 'unknown', 'reconstruction'])
+def test_site_four_mutations_all_languages(state):
+    result = subprocess.run(['node', 'review/out/astra_scratch/r22_render.cjs', state],
+                            cwd=prev.ROOT, capture_output=True, text=True, encoding='utf8', check=True)
+    for lang, x in json.loads(result.stdout).items():
+        tag = x[{'prediction': 'tag_pro', 'late': 'tag_late', 'unknown': 'tag_unv', 'reconstruction': 'tag_recon'}[state]]
+        assert f'<b>{tag} ┬╖' in x['week'], (state, lang)

