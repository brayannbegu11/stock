def _pick(p: dict) -> dict:
    sid = p.get("security_id", "")
    market = sid.split(":", 1)[0] if ":" in sid else None
    return {
        "symbol": p.get("symbol"),
        "name": p.get("name"),
        "market": market,
        "security_id": sid,
        "gross_return": _num(p.get("gross_return")),
        "entry_status": p.get("entry_status"),
        "entry_reason": p.get("entry_reason"),
    }
