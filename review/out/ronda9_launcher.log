[31;1m    un marcador de sesión al principio combinado con un término de cierre es una contradicción[0m
[31;1m    y también ``unknown``; la comparación no distingue mayúsculas.[0m
[31;1m    """[0m
[31;1m    text = " ".join(str(description).replace("\n", " ").split())[0m
[31;1m    low = text.lower()[0m
[31;1m    if not low:[0m
[31;1m        return ROW_UNKNOWN[0m
[31;1m    if any(tok in low for tok in _EN_DOUBT_TOKENS):[0m
[31;1m        return ROW_UNKNOWN[0m
[31;1m    session_marker = any(low.startswith(p.lower()) for p in _EN_SESSION_EXACT)[0m
[31;1m    closure = any(tok.lower() in low for tok in _EN_CLOSURE_TOKENS)[0m
[31;1m    if session_marker and closure:[0m
[31;1m        return ROW_UNKNOWN[0m
[31;1m    if session_marker:[0m
[31;1m        return ROW_SESSION_MARKER[0m
[31;1m    if closure:[0m
[31;1m        return ROW_CLOSURE[0m
[31;1m    return ROW_UNKNOWN[0m
