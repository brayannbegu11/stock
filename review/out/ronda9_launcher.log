[31;1m    text = name + " " + desc[0m
[31;1m    for marker in _CLOSURE_MARKERS + _SESSION_MARKERS:[0m
[31;1m        if any(prefix + marker in text for prefix in _NEGATION_PREFIXES):[0m
[31;1m            return ROW_UNKNOWN[0m
[31;1m    if "取消" in text:[0m
[31;1m        return ROW_UNKNOWN[0m
[31;1m    is_session = any(m in text for m in _SESSION_MARKERS)[0m
[31;1m    is_closure = any(m in text for m in _CLOSURE_MARKERS)[0m
[31;1m    if is_session and is_closure:[0m
[31;1m        return ROW_UNKNOWN[0m
[31;1m    if is_session:[0m
[31;1m        return ROW_SESSION_MARKER[0m
[31;1m    if is_closure:[0m
[31;1m        return ROW_CLOSURE[0m
[31;1m    return ROW_UNKNOWN[0m
