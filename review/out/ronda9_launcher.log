[31;1m+    d = Document('d', 'news', 'news', ('SEC-1',), p.cutoff_at-timedelta(days=1), Q.VERIFIED_ORIGINAL,[0m
[31;1m+                 first_seen_at=rec.ingested_at_dt, capture_id=rec.capture_id, source_sha256=rec.sha256,[0m
[31;1m+                 derivation='extract-v1', payload={'profit':1})[0m
[31;1m+    return replace(p, admitted=(d,)), store, rec[0m
