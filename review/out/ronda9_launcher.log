[31;1m      "prueba_propuesta": "from dataclasses import replace\nfrom datetime import timedelta\nimport pytest\nfrom tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal, CAL_2030\nfrom twlab.packet import Document, packet_to_json, packet_from_json\nfrom twlab.timeutil import AvailabilityQuality as Q\nfrom twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError\n\ndef test_recovered_packet_rejects_future_document(tmp_path):\n    p = prospective_packet()\n    d = Document('future-result', 'news', 'invented', ('SEC-1',), p.cutoff_at + timedelta(days=30), Q.VERIFIED_ORIGINAL)\n    p = packet_from_json(packet_to_json(replace(p, admitted=(d,))))\n    f = prospective_forecast(p)\n    f['ranking'][0]['document_ids'] = [d.doc_id]\n    s, r = archive_and_seal(tmp_path, f, p)\n    o = WeeklyObservation(p.week_id, 'f-1', p.evidence_class, r.capture_id, True, .1)\n    with pytest.raises(ObservationError):\n        block_bootstrap_mean([o], block_length=1, n_boot=20, seed=1, store=s, packets={p.packet_hash(): p}, calendar=CAL_2030, allow_test_authorities=True)\n",[0m
