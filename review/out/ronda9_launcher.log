[31;1mdef _block_starts(mondays: Sequence[date], block_length: int) -> list[tuple[int, int]]:[0m
[31;1m    """Bloques móviles que nunca cruzan un hueco (R02-08).[0m
[31;1m[0m
[31;1m    Devuelve ``(inicio, longitud)`` dentro de cada tramo de semanas consecutivas.[0m
[31;1m    Un tramo más corto que el bloque forma un bloque propio: no se pierde la[0m
[31;1m    observación y ningún bloque une dos semanas que no fueron consecutivas.[0m
[31;1m    """[0m
[31;1m    out: list[tuple[int, int]] = [][0m
[31;1m    for s0, ln in _segments(mondays):[0m
[31;1m        if ln <= block_length:[0m
[31;1m            out.append((s0, ln))[0m
[31;1m        else:[0m
[31;1m            out.extend((s0 + k, block_length) for k in range(ln - block_length + 1))[0m
[31;1m    return out[0m
