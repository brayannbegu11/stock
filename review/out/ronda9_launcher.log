[31;1m    exposición que produce el redondeo a lotes enteros entre dos carteras del mismo[0m
[31;1m    tamaño. Es un valor del protocolo: se declara antes de mirar los datos, nunca se[0m
[31;1m    elige para que una semana «cuadre».[0m
[31;1m    """[0m
[31;1m    tol = Decimal(exposure_tolerance)[0m
[31;1m    if not tol.is_finite() or tol < 0 or tol >= 1:[0m
[31;1m        raise ValueError("exposure_tolerance must be a finite Decimal in [0, 1)")[0m
[31;1m    ka, kb = a.pairing_key(), b.pairing_key()[0m
[31;1m    same_frame = ka[:4] == kb[:4] and ka[5:] == kb[5:][0m
[31;1m    if not same_frame or abs(Decimal(a.exposure) - Decimal(b.exposure)) > tol:[0m
[31;1m        raise IntervalMismatch(f"{a.label} {ka} vs {b.label} {kb} (exposure_tolerance={tol})")[0m
[31;1m    return a.value - b.value[0m
