247:     n_invalid = len(observations) - len(valid)
248:     n = len(valid)
249:     if n == 0:
250:         raise ObservationError("no valid runs")
251:     if block_length < 1 or block_length > n:
252:         raise ObservationError("block_length must be within 1..n_valid")
253:     # Las semanas inv├ílidas o ausentes parten la serie en tramos; los bloques se muestrean dentro de cada
254:     # tramo y nunca unen dos semanas que no fueron consecutivas (R02-08). Con un solo tramo sin huecos el
255:     # muestreo es el bootstrap por bloques m├│viles cl├ísico.
256:     values = [float(o.value) for _, o in valid]  # type: ignore[arg-type]
257:     valid_mondays = [m for m, _ in valid]
258:     starts = _block_starts(valid_mondays, block_length)
259:     n_segments = len(_segments(valid_mondays))
260:     # Ponderaci├│n (R08-11, R09-12): cada extracci├│n de un tramo aporta b_s = min(bloque, longitud) observaciones,
261:     # as├¡ que el tramo se elige con probabilidad proporcional a longitud / b_s para que su fracci├│n esperada en la
262:     # muestra remuestreada sea exactamente longitud / n; el bloque se elige uniformemente dentro del tramo. Con un
263:     # solo tramo equivale al bootstrap por bloques m├│viles cl├ísico (con su efecto de borde inherente).
264:     segments = _segments(valid_mondays)
265:     blocks_by_segment = [[(s0, ln) for s0, ln in starts if seg0 <= s0 < seg0 + seg_len] for seg0, seg_len in segments]
266:     weights = [seg_len / min(block_length, seg_len) for _, seg_len in segments]
267:     cumulative: list[float] = []
268:     acc = 0.0
269:     for w in weights:
270:         acc += w
271:         cumulative.append(acc)
272:     total_weight = cumulative[-1]
273:     rng = random.Random(seed)
274:     means: list[float] = []
275:     for _ in range(n_boot):
276:         sample: list[float] = []
277:         while len(sample) < n:
278:             u = rng.random() * total_weight
279:             seg_idx = next((i for i, c in enumerate(cumulative) if u < c), len(cumulative) - 1)
280:             blocks = blocks_by_segment[seg_idx]
281:             s0, ln = blocks[rng.randrange(len(blocks))]
282:             sample.extend(values[s0:s0 + ln])
283:         # sin truncar a n: recortar el ├║ltimo bloque quita observaciones sobre todo a los tramos largos y
284:         # desplaza el peso hacia los cortos (R09-12); la media de un remuestreo de longitud ΓëÑ n es igual de v├ílida.
285:         means.append(sum(sample) / len(sample))
286:     resample_mean = sum(means) / len(means)
287:     means.sort()
288:     lo = means[int(0.025 * (n_boot - 1))]
289:     hi = means[int(0.975 * (n_boot - 1))]
290:     return BootstrapResult(sum(values) / n, lo, hi, n, n_invalid, block_length, seed, evidence_class, n_segments, resample_mean)


