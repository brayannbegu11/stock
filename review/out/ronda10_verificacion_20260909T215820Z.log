393: 
394: def _dt(v: Optional[str]) -> Optional[datetime]:
395:     return datetime.fromisoformat(v) if isinstance(v, str) else None
396: 
397: 
398: def packet_from_json(raw: bytes) -> Packet:
399:     """Reconstruye un paquete archivado y comprueba que su hash coincide con el declarado."""
400:     body = json.loads(raw.decode("utf-8"))
401:     docs = []
402:     for c in body["admitted"]:
403:         docs.append(Document(
404:             doc_id=c["doc_id"], kind=c["kind"], source_id=c["source_id"], security_ids=tuple(c["security_ids"]),
405:             available_at=_dt(c["available_at"]), availability_quality=AvailabilityQuality(c["availability_quality"]),
406:             published_at=_dt(c.get("published_at")), first_seen_at=_dt(c.get("first_seen_at")),
407:             version=c.get("version", 1), supersedes=c.get("supersedes"),
408:             period_end=date.fromisoformat(c["period_end"]) if c.get("period_end") else None,
409:             scheduled_for=_dt(c.get("scheduled_for")), capture_id=c.get("capture_id"),
410:             source_sha256=c.get("source_sha256"), derivation=c.get("derivation"), payload=c.get("payload") or {},
411:         ))
412:     packet = Packet(
413:         packet_id=body["packet_id"], cutoff_at=_dt(body["cutoff_at"]), mode=body["mode"],
414:         evidence_class=body["evidence_class"], admitted=tuple(docs),
415:         rejected=tuple(Rejection(*r) for r in body["rejected"]), created_at=_dt(body["created_at"]),
416:         week_id=body.get("week_id"), week_status=body.get("week_status"), deadline_at=_dt(body.get("deadline_at")),
417:         registration_deadline_at=_dt(body.get("registration_deadline_at")), entry_at=_dt(body.get("entry_at")),
418:         exit_at=_dt(body.get("exit_at")), calendar_version=body.get("calendar_version"),
419:     )
420:     if packet.packet_hash() != body.get("packet_hash"):
421:         raise ValueError("archived packet hash does not match its content")
422:     return packet
