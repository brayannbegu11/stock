203: class TabularForecaster:
204:     """Q1: caracter├¡sticas de precio/volumen del paquete y modelo entrenado s├│lo con etiquetas conocidas al corte."""
205:     name, model_id, version = "Q1", q1mod.MODEL_ID, "q1_v1"
206: 
207:     def __init__(self, market: MarketData, *, retrain_every_weeks: int = 4, min_weeks: int = 52, seed: int = 20260909) -> None:
208:         self.market = market
209:         self.retrain_every = retrain_every_weeks
210:         self.min_weeks = min_weeks
211:         self.seed = seed
212:         self.model: Optional[q1mod.Q1Model] = None
213:         self.trained_for: Optional[datetime] = None
214:         self.weeks_since_train = 0
215:         self.cache: dict = {}
216:         self.history: list[str] = []
217: 
218:     def maybe_train(self, cutoff_at: datetime) -> None:
219:         if self.model is not None and self.weeks_since_train < self.retrain_every:
220:             self.weeks_since_train += 1
221:             return
222:         first = min(b.session for s in self.market.securities.values() for b in s.bars[:1])
223:         cutoffs = []
224:         d = first + timedelta(days=(6 - first.weekday()) % 7)
225:         while d < cutoff_at.date():
226:             cutoffs.append(taipei(d, time(18, 0)))
227:             d += timedelta(days=7)
228:         bars = {sec_id: s.bars for sec_id, s in self.market.securities.items()}
229:         rows = q1mod.build_training_rows(bars, cutoffs, now_cutoff=cutoff_at, calendar=self.market.calendar, cache=self.cache)
230:         self.model = q1mod.fit_q1(rows, trained_at=cutoff_at, min_weeks=self.min_weeks, seed=self.seed)
231:         self.trained_for = cutoff_at
232:         self.weeks_since_train = 1
233:         self.history.append(f"{cutoff_at.date().isoformat()}: {self.model.training_manifest_id if self.model else 'insufficient_history'}")
234: 
235:     def forecast(self, view, plan, candidates, *, slots):
236:         self.maybe_train(plan.cutoff_at)
237:         meta = {"training_manifest_id": self.model.training_manifest_id if self.model else None}
238:         if self.model is None:
239:             return [], {**meta, "status_reason": "insufficient_training_history"}
240:         feats, elig = [], []
241:         for c in candidates:
242:             if not (c.scorable and c.eligible):
243:                 continue
244:             bars = [q1mod.BarLike(date.fromisoformat(s[0]), D(s[1]), D(s[2]), D(s[4]), plan.cutoff_at) for s in c.sessions]
245:             f = q1mod.features_from_bars(bars, plan.cutoff_at)
246:             if f is not None:
247:                 feats.append(f)
248:                 elig.append(c)
249:         if not feats:
250:             return [], {**meta, "status_reason": "no_eligible_securities"}
251:         scores = self.model.predict(feats)
252:         ranked = sorted(zip(elig, scores), key=lambda t: t[1], reverse=True)[:slots]
253:         return [Selection(c.security_id, float(s), [c.doc_id], list(q1mod.FEATURE_NAMES)) for c, s in ranked], meta
