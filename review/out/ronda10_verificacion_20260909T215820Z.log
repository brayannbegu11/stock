296: def readmission_problems(
297:     packet: Packet,
298:     *,
299:     store: Optional[RawStore] = None,
300:     extractors: Optional[Mapping[str, Extractor]] = None,
301:     read_bytes: Optional[Callable[[CaptureRecord], bytes]] = None,
302: ) -> list[str]:
303:     """Vuelve a aplicar el filtro de admisi├│n a un paquete recuperado de un registro (R08-01, R09-01..03).
304: 
305:     El hash acredita bytes, no admisibilidad: un paquete construido a mano puede contener documentos
306:     que ``build_packet`` habr├¡a rechazado. Por documento admitido se comprueban disponibilidad
307:     conocida, coherencia de fechas y disponibilidad no posterior al corte. En modo prospectivo el
308:     archivo es **obligatorio** (sin ├⌐l la readmisi├│n falla cerrada): captura existente, procedencia,
309:     reloj del sistema, ingesti├│n no posterior al corte, integridad de los bytes archivados y
310:     re-derivaci├│n del *payload* con el extractor registrado (sin registro, el documento no se readmite).
311:     Los rechazos recuperados deben ser ├║nicos, con motivo del cat├ílogo y sin colisi├│n con los admitidos.
312:     """
313:     problems: list[str] = []
314:     if packet.mode == MODE_PROSPECTIVE and store is None:
315:         problems.append("archive_required_for_prospective_readmission (R09-02)")
316:     seen: set[str] = set()
317:     for d in packet.admitted:
318:         if d.doc_id in seen:
319:             problems.append(f"{d.doc_id}: duplicate doc_id")
320:         seen.add(d.doc_id)
321:         if d.availability_quality == AvailabilityQuality.UNKNOWN:
322:             problems.append(f"{d.doc_id}: {R_UNKNOWN_AVAILABILITY}")
323:         if d.published_at is not None and is_after(d.published_at, d.available_at):
324:             problems.append(f"{d.doc_id}: {R_INCONSISTENT_METADATA}")
325:         if is_after(d.available_at, packet.cutoff_at):
326:             problems.append(f"{d.doc_id}: {R_AVAILABLE_AFTER_CUTOFF}")
327:         if packet.mode != MODE_PROSPECTIVE:
328:             continue
329:         if d.capture_id is None or d.source_sha256 is None or d.derivation is None:
330:             problems.append(f"{d.doc_id}: {R_NO_CAPTURE_EVIDENCE}")
331:             continue
332:         if d.first_seen_at is None or is_after(d.first_seen_at, packet.cutoff_at):
333:             problems.append(f"{d.doc_id}: {R_NOT_RECEIVED_BEFORE_CUTOFF}")
334:         if store is None:
335:             continue
336:         try:
337:             rec = store.get(d.capture_id)
338:         except KeyError:
339:             problems.append(f"{d.doc_id}: {R_NO_CAPTURE_EVIDENCE} (capture {d.capture_id} not in archive)")
340:             continue
341:         if rec.source_id != d.source_id or rec.sha256 != d.source_sha256:
342:             problems.append(f"{d.doc_id}: {R_PROVENANCE_MISMATCH}")
343:         if rec.clock_source != "system":
344:             problems.append(f"{d.doc_id}: {R_SYNTHETIC_CAPTURE}")
345:         if is_after(rec.ingested_at_dt, packet.cutoff_at) or (d.first_seen_at is not None and to_utc(d.first_seen_at) != to_utc(rec.ingested_at_dt)):
346:             problems.append(f"{d.doc_id}: {R_NOT_RECEIVED_BEFORE_CUTOFF}")
347:         try:                                                    # integridad real de los bytes archivados (R09-01)
348:             raw = (read_bytes or store.read)(rec)
349:             if hashlib.sha256(raw).hexdigest() != rec.sha256:
350:                 raise ValueError("archived bytes do not match capture sha256")
351:         except Exception as exc:
352:             problems.append(f"{d.doc_id}: archived bytes fail integrity: {exc}")
353:             continue
354:         extractor = (extractors or {}).get(d.derivation)
355:         if extractor is None:
356:             problems.append(f"{d.doc_id}: {R_DERIVATION_MISMATCH} (extractor {d.derivation!r} not registered; payload cannot be re-derived)")
357:             continue
358:         try:
359:             extraction = extractor(raw)
360:             if not isinstance(extraction, Mapping) or "payload" not in extraction or "security_ids" not in extraction:
361:                 raise ValueError("extractor must return a mapping with 'payload' and 'security_ids'")
362:             if canonical_bytes(_thaw(extraction["payload"])) != canonical_bytes(_thaw(d.payload)):
363:                 raise ValueError("payload does not equal extractor output on the archived bytes")
364:             if tuple(str(s) for s in extraction["security_ids"]) != d.security_ids:
365:                 raise ValueError("security_ids do not equal extracted identities")
366:         except Exception as exc:
367:             problems.append(f"{d.doc_id}: {R_DERIVATION_MISMATCH} ({exc})")
368:     rejected_ids: set[str] = set()
369:     for r in packet.rejected:
370:         if r.doc_id in seen:
371:             problems.append(f"{r.doc_id}: document is both admitted and rejected")
372:         if r.doc_id in rejected_ids:
373:             problems.append(f"{r.doc_id}: duplicate rejection")
374:         rejected_ids.add(r.doc_id)
375:         if r.reason not in KNOWN_REJECTION_REASONS:
376:             problems.append(f"{r.doc_id}: rejection reason {r.reason!r} is not in the admission catalog (R09-03)")
377:     return problems
