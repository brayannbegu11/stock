156: @dataclass(frozen=True)
157: class DividendRow:
158:     stock_id: str
159:     announced_date: Optional[date]        # AnnouncementDate; sin hora no es un instante (R08-03)
160:     announced_at: Optional[datetime]      # AnnouncementDate + AnnouncementTime (Taipei) s├│lo cuando la hora existe
161:     cash_per_share: Decimal               # CashEarningsDistribution + CashStatutorySurplus
162:     stock_per_share: Decimal              # StockEarningsDistribution + StockStatutorySurplus (TWD de valor nominal por acci├│n)
163:     cash_ex_date: Optional[date]
164:     cash_pay_date: Optional[date]
165:     stock_ex_date: Optional[date]
166:     period: str
167: 
168: 
169: def dividends_from_rows(div_rows: Iterable[dict], *, stock_id: str) -> list[DividendRow]:
170:     out: list[DividendRow] = []
171:     for r in div_rows:
172:         sid = str(r.get("stock_id", "")).strip()
173:         if sid != stock_id:
174:             raise SourceIdentityMismatch(f"row stock_id={sid!r} does not belong to {stock_id!r}")
175:         ann_date: Optional[date] = None
176:         ann_at: Optional[datetime] = None
177:         if r.get("AnnouncementDate"):
178:             try:
179:                 ann_date = date.fromisoformat(str(r["AnnouncementDate"]))
180:             except ValueError:
181:                 ann_date = None
182:             t = str(r.get("AnnouncementTime") or "").strip()
183:             if ann_date is not None and t:
184:                 try:
185:                     hh, mm, ss = t.split(":")
186:                     ann_at = datetime.combine(ann_date, datetime.min.time(), tzinfo=TAIPEI).replace(hour=int(hh), minute=int(mm), second=int(ss))
187:                 except ValueError:
188:                     ann_at = None          # hora ilegible: se conserva la fecha, no se inventa el instante
189: 
190:         def _d(key: str) -> Optional[date]:
191:             v = r.get(key)
192:             return date.fromisoformat(v) if v else None
193: 
194:         out.append(DividendRow(
195:             stock_id=sid, announced_date=ann_date, announced_at=ann_at,
196:             cash_per_share=Decimal(str(r.get("CashEarningsDistribution") or 0)) + Decimal(str(r.get("CashStatutorySurplus") or 0)),
197:             stock_per_share=Decimal(str(r.get("StockEarningsDistribution") or 0)) + Decimal(str(r.get("StockStatutorySurplus") or 0)),
198:             cash_ex_date=_d("CashExDividendTradingDate"), cash_pay_date=_d("CashDividendPaymentDate"),
199:             stock_ex_date=_d("StockExDividendTradingDate"), period=str(r.get("year", "")),
200:         ))
201:     return out


