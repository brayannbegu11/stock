258: def _week_costs(slots) -> D:
259:     total = D(0)
260:     for s_ in slots:
261:         for f in (s_.entry, s_.exit):
262:             if f is not None:
263:                 total += f.commission + f.tax + f.slippage_cost
264:     return total
