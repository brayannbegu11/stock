115: @dataclass(frozen=True)
116: class Bar:
117:     session: date
118:     open: Decimal
119:     high: Decimal
120:     low: Decimal
121:     close: Decimal
122:     volume_shares: int
123:     value_twd: Decimal
124:     transactions: int
125:     available_at: datetime     # pol├¡tica PRICE_AVAILABILITY_LAG sobre el cierre 13:30 Taipei
126: 
127:     @property
128:     def has_regular_price(self) -> bool:
129:         """FinMind publica OHLC a cero cuando no hubo precio de sesi├│n regular; puede haber importe y volumen
130:         (negociaci├│n de lotes menores u otras). Sin precio regular no hay ejecuci├│n ni valoraci├│n (R08-12)."""
131:         return self.open > 0 and self.close > 0
132: 
133: 
134: def bars_from_rows(price_rows: Iterable[dict], *, stock_id: str) -> list[Bar]:
135:     """Barras de una captura ``TaiwanStockPrice/<stock_id>``; toda fila debe pertenecer a ese ``stock_id``."""
136:     out: list[Bar] = []
137:     seen: set[date] = set()
138:     for r in price_rows:
139:         sid = str(r.get("stock_id", "")).strip()
140:         if sid != stock_id:
141:             raise SourceIdentityMismatch(f"row stock_id={sid!r} does not belong to {stock_id!r}")
142:         d = date.fromisoformat(r["date"])
143:         if d in seen:
144:             raise DuplicateSession(f"{stock_id}: repeated session {d.isoformat()}; revisions must be resolved upstream, not counted twice")
145:         seen.add(d)
146:         close_at = taipei(d).replace(hour=13, minute=30)
147:         out.append(Bar(
148:             session=d, open=Decimal(str(r["open"])), high=Decimal(str(r["max"])), low=Decimal(str(r["min"])),
149:             close=Decimal(str(r["close"])), volume_shares=int(r["Trading_Volume"]), value_twd=Decimal(str(r["Trading_money"])),
150:             transactions=int(r["Trading_turnover"]), available_at=close_at + PRICE_AVAILABILITY_LAG,
151:         ))
152:     out.sort(key=lambda b: b.session)
153:     return out
