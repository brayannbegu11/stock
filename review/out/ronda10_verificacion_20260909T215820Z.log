84: def classify_info(info_rows: Iterable[dict]) -> tuple[dict[str, str], dict[str, str], dict[str, str]]:
85:     """symbol ΓåÆ instrument_type, symbol ΓåÆ board, symbol ΓåÆ market (twse/tpex/emerging).
86: 
87:     FinMind repite un s├¡mbolo en varias categor├¡as (industria principal, secundarias,
88:     ``µëÇµ£ëΦ¡ëσê╕``). El resultado no depende del orden de las filas: se re├║nen todas las
89:     categor├¡as y se aplica ``_INSTRUMENT_PRECEDENCE``. Una categor├¡a vac├¡a o desconocida
90:     nunca se supone acci├│n ordinaria (R08-04).
91:     """
92:     cats: dict[str, set[str]] = {}
93:     market: dict[str, str] = {}
94:     for r in info_rows:
95:         sid = str(r["stock_id"]).strip()
96:         cats.setdefault(sid, set()).add(str(r.get("industry_category", "")).strip())
97:         market.setdefault(sid, str(r.get("type", "")).strip())
98:     instrument: dict[str, str] = {}
99:     board: dict[str, str] = {}
100:     for sid, cs in cats.items():
101:         kinds: set[str] = set()
102:         for c in cs:
103:             if c in NON_EQUITY_CATEGORIES:
104:                 kinds.add(NON_EQUITY_CATEGORIES[c])
105:             elif c in EQUITY_INDUSTRY_CATEGORIES or c in BOARD_CATEGORIES:
106:                 kinds.add("ordinary_equity")
107:             else:
108:                 kinds.add("unclassified")
109:         instrument[sid] = next(k for k in _INSTRUMENT_PRECEDENCE if k in kinds)
110:         if any(c in BOARD_CATEGORIES for c in cs):
111:             board[sid] = "innovation"
112:     return instrument, board, market
