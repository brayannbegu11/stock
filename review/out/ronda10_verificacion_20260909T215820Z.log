618: def markdown_report(result: dict, *, title: str) -> str:
619:     s = result["summary"]
620:     lines = [f"# {title}", "",
621:              f"Periodo {s['period'][0]} ΓåÆ {s['period'][1]} ┬╖ universo {s['universe_size']} valores ({s['manifest']}) ┬╖ "
622:              f"{s['weeks_operated']} semanas operadas, {s['weeks_invalid_no_sessions']} sin sesiones, "
623:              f"{len(s['weeks_pending_outcome'])} pendientes de desenlace.", "",
624:              "Costes ilustrativos (no contratados); universo del censo vigente; disponibilidad de barras por pol├¡tica de 24 h. "
625:              "Nada de esto es una estimaci├│n de rendimiento futuro.", "",
626:              "| Pronosticador | Media semanal neta aperturaΓåÆcierre | Media bruta de las selecciones | Costes/semana sobre invertido | Semanas > 0 | Patrimonio final | Exceso neto vs " + s["assumptions"]["baseline"] + " (IC 95 %) |",
627:              "|---|---|---|---|---|---|---|"]
628:     for name, e in s["forecasters"].items():
629:         pe = e.get("paired_excess_vs_baseline")
630:         pe_txt = "ΓÇö" if not pe or "error" in (pe or {}) else f"{pe['mean']*100:+.2f} % [{pe['ci_low' if 'ci_low' in pe else 'ci95'][0]*100:+.2f} %, {pe['ci95'][1]*100:+.2f} %] n={pe['n_used']}" if pe and "ci95" in pe else "ΓÇö"
631:         fmt = lambda x: "ΓÇö" if x is None else f"{x*100:+.2f} %"
632:         lines.append(f"| {name} (`{e['model_id']}`) | {fmt(e['mean_weekly_net_return_open_close'])} | {fmt(e['mean_weekly_gross_pick_return'])} | "
633:                      f"{fmt(e['mean_costs_over_invested'])} | {e['weeks_positive']}/{s['weeks_operated']} | "
634:                      f"{e['final_equity']:,.0f} TWD | {pe_txt} |")
635:     ew = s["universe_ew"]["mean_weekly_gross_open_close"]
636:     lines += ["", f"Referencia equiponderada del universo elegible (bruta, aperturaΓåÆcierre): {ew*100:+.2f} % semanal." if ew is not None else "", ""]
637:     lines += ["## Selecciones semana a semana", ""]
638:     names = list(s["forecasters"])
639:     lines.append("| Semana | " + " | ".join(names) + " |")
640:     lines.append("|---|" + "---|" * len(names))
641:     for w in result["weeks"]:
642:         if w["status"] != "valid":
643:             lines.append(f"| {w['week_id']} | " + " | ".join([w.get("note", w["status"])] + [""] * (len(names) - 1)) + " |")
644:             continue
645:         cells = []
646:         for n in names:
647:             fr = w["forecasters"].get(n, {})
648:             picks = fr.get("picks", [])
649:             if not picks:
650:                 cells.append(f"({fr.get('forecast_status', 'ΓÇö')}: {fr.get('status_reason') or ''})".strip())
651:                 continue
652:             txt = ", ".join(f"{p['symbol']} {p['name']}" + (f" {p['gross_return']*100:+.1f} %" if p.get("gross_return") is not None else "") for p in picks)
653:             net = fr.get("portfolio_net_return_open_close")
654:             cells.append(txt + (f" ΓåÆ neto {net*100:+.2f} %" if net is not None else " ΓåÆ pendiente"))
655:         lines.append(f"| {w['week_id']} | " + " | ".join(cells) + " |")
656:     return "\n".join(lines) + "\n"


