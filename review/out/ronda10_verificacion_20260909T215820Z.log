FILE src/twlab/models/q1.py
1: """Q1: modelo tabular compartido (lineal regularizado + gradient boosting) sobre barras nominales.
2: 
3: Contrato temporal (PIT):
4: - Las caracter├¡sticas de un valor en un corte T se calculan s├│lo con barras cuya ``available_at`` Γëñ T.
5: - Las etiquetas de entrenamiento son rentabilidades aperturaΓåÆcierre de semanas del protocolo cuya ├║ltima
6:   barra tiene ``available_at`` Γëñ T. Una semana cuyo viernes a├║n no est├í disponible en T no se etiqueta.
7: - El modelo se reentrena con cadencia declarada (``retrain_every_weeks``) y s├│lo con filas anteriores al corte.
8: 
9: El objetivo es el **rango** cruzado de la rentabilidad semanal (0..1 dentro de cada semana), no el nivel:
10: reduce el peso de valores extremos y es lo que la cesta de cinco puestos necesita (ordenar, no estimar).
11: Sin fundamentales ni noticias todav├¡a: es un modelo de precios/volumen, deliberadamente modesto.
12: """
13: from __future__ import annotations
14: 
15: import math
16: import statistics
17: from dataclasses import dataclass, field
18: from datetime import date, datetime, timedelta
19: from decimal import Decimal
20: from typing import Iterable, Mapping, Optional, Sequence
21: 
22: from ..calendar import TradingCalendar
23: from ..timeutil import to_utc
24: from ..weekly import plan_week
25: 
26: FEATURE_NAMES = (
27:     "ret_5", "ret_20", "ret_60", "ret_120", "vol_20", "vol_60", "log_value_20", "value_ratio_5_60",
28:     "dist_high_120", "missing_20", "ret_5_lag_20",
29: )
30: MODEL_ID = "q1:tabular_ridge_lgbm_rank_v1"
31: 
32: 
33: @dataclass(frozen=True)
34: class BarLike:
35:     """Subconjunto de una barra que Q1 necesita (compatible con ``sources.finmind.Bar``)."""
36:     session: date
37:     open: Decimal
38:     close: Decimal
39:     value_twd: Decimal
40:     available_at: datetime
41: 
42: 
43: def _log_ret(a: Decimal, b: Decimal) -> Optional[float]:
44:     if a is None or b is None or a <= 0 or b <= 0:
45:         return None
46:     return math.log(float(a) / float(b))
47: 
48: 
49: def features_from_bars(bars: Sequence[BarLike], cutoff_at: datetime, *, sessions_expected_20: int = 20) -> Optional[dict[str, float]]:
50:     """Caracter├¡sticas de un valor en el corte; ``None`` si no hay historial suficiente (121 barras)."""
51:     known = [b for b in bars if to_utc(b.available_at) <= to_utc(cutoff_at) and b.close > 0 and b.open > 0]
52:     if len(known) < 121:
53:         return None
54:     closes = [float(b.close) for b in known]
55:     values = [float(b.value_twd) for b in known]
56:     c = closes[-1]
57:     rets = [math.log(closes[i] / closes[i - 1]) for i in range(1, len(closes)) if closes[i - 1] > 0]
58:     f = {
59:         "ret_5": math.log(c / closes[-6]), "ret_20": math.log(c / closes[-21]), "ret_60": math.log(c / closes[-61]),
60:         "ret_120": math.log(c / closes[-121]),
61:         "vol_20": statistics.pstdev(rets[-20:]) if len(rets) >= 20 else 0.0,
62:         "vol_60": statistics.pstdev(rets[-60:]) if len(rets) >= 60 else 0.0,
63:         "log_value_20": math.log(max(statistics.median(values[-20:]), 1.0)),
64:         "value_ratio_5_60": (statistics.fmean(values[-5:]) / max(statistics.fmean(values[-60:]), 1.0)),
65:         "dist_high_120": c / max(closes[-120:]) - 1.0,
66:         "missing_20": float(sessions_expected_20 - min(20, sum(1 for b in known[-20:] if (cutoff_at.date() - b.session).days <= 35))),
67:         "ret_5_lag_20": math.log(closes[-21] / closes[-26]),
68:     }
69:     return f
70: 
71: 
72: @dataclass
73: class TrainingRow:
74:     cutoff_at: datetime
75:     security_id: str
76:     features: dict[str, float]
77:     label: float                 # rentabilidad aperturaΓåÆcierre de la semana siguiente al corte
78:     label_known_at: datetime     # available_at de la ├║ltima barra usada para la etiqueta
79: 
80: 
81: def weekly_label(bars_by_session: Mapping[date, BarLike], entry_s: date, exit_s: date) -> Optional[tuple[float, datetime]]:
82:     a, b = bars_by_session.get(entry_s), bars_by_session.get(exit_s)
83:     if a is None or b is None or a.open <= 0 or b.close <= 0:
84:         return None
85:     return float(b.close) / float(a.open) - 1.0, b.available_at
86: 
87: 
88: def _rank01(values: Sequence[float]) -> list[float]:
89:     order = sorted(range(len(values)), key=lambda i: values[i])
90:     out = [0.0] * len(values)
91:     n = max(len(values) - 1, 1)
92:     for r, i in enumerate(order):
93:         out[i] = r / n
94:     return out
95: 
96: 
97: class RidgeRank:
98:     """Regresi├│n ridge cerrada sobre caracter├¡sticas estandarizadas (sin dependencias)."""
99: 
100:     def __init__(self, alpha: float = 1.0) -> None:
101:         self.alpha = alpha
102:         self.mu: list[float] = []
103:         self.sd: list[float] = []
104:         self.w: list[float] = []
105:         self.b = 0.0
106: 
107:     def fit(self, X: Sequence[Sequence[float]], y: Sequence[float]) -> "RidgeRank":
108:         n, p = len(X), len(X[0])
109:         self.mu = [statistics.fmean(col) for col in zip(*X)]
110:         self.sd = [max(statistics.pstdev(col), 1e-9) for col in zip(*X)]
111:         Z = [[(row[j] - self.mu[j]) / self.sd[j] for j in range(p)] for row in X]
112:         ym = statistics.fmean(y)
113:         yc = [v - ym for v in y]
114:         # (Zß╡ÇZ + ╬▒I) w = Zß╡Çy  ΓÇö resoluci├│n por eliminaci├│n de Gauss (p es peque├▒o)
115:         A = [[sum(Z[i][j] * Z[i][k] for i in range(n)) + (self.alpha if j == k else 0.0) for k in range(p)] for j in range(p)]
116:         rhs = [sum(Z[i][j] * yc[i] for i in range(n)) for j in range(p)]
117:         for j in range(p):
118:             piv = max(range(j, p), key=lambda r: abs(A[r][j]))
119:             A[j], A[piv] = A[piv], A[j]
120:             rhs[j], rhs[piv] = rhs[piv], rhs[j]
121:             for r in range(j + 1, p):
122:                 f = A[r][j] / A[j][j]
123:                 for k in range(j, p):
124:                     A[r][k] -= f * A[j][k]
125:                 rhs[r] -= f * rhs[j]
126:         w = [0.0] * p
127:         for j in range(p - 1, -1, -1):
128:             w[j] = (rhs[j] - sum(A[j][k] * w[k] for k in range(j + 1, p))) / A[j][j]
129:         self.w, self.b = w, ym
130:         return self
131: 
132:     def predict(self, X: Sequence[Sequence[float]]) -> list[float]:
133:         return [self.b + sum(self.w[j] * (row[j] - self.mu[j]) / self.sd[j] for j in range(len(self.w))) for row in X]
134: 
135: 
136: @dataclass
137: class Q1Model:
138:     trained_at: datetime
139:     n_rows: int
140:     n_weeks: int
141:     first_label_week: str
142:     last_label_week: str
143:     ridge: RidgeRank
144:     lgbm: object = None
145:     training_manifest_id: str = ""
146: 
147:     def predict(self, feats: Sequence[dict[str, float]]) -> list[float]:
148:         X = [[f[k] for k in FEATURE_NAMES] for f in feats]
149:         r = _rank01(self.ridge.predict(X))
150:         if self.lgbm is not None:
151:             g = _rank01(list(self.lgbm.predict(X)))
152:             return [(a + b) / 2 for a, b in zip(r, g)]
153:         return r
154: 
155: 
156: def build_training_rows(
157:     bars_by_security: Mapping[str, Sequence[BarLike]],
158:     cutoffs: Iterable[datetime],
159:     *,
160:     now_cutoff: datetime,
161:     calendar: TradingCalendar,
162:     cache: Optional[dict[tuple[datetime, str], Optional[TrainingRow]]] = None,
163: ) -> list[TrainingRow]:
164:     """Filas (corte anterior, valor) con etiqueta conocida en ``now_cutoff``; nunca usa barras posteriores."""
165:     rows: list[TrainingRow] = []
166:     cache = cache if cache is not None else {}
167:     for cutoff in cutoffs:
168:         if to_utc(cutoff) >= to_utc(now_cutoff):
169:             continue
170:         plan = plan_week(cutoff, calendar)
171:         if not plan.is_valid:
172:             continue
173:         entry_s, exit_s = plan.entry_at.date(), plan.exit_at.date()
174:         for sec, bars in bars_by_security.items():
175:             key = (cutoff, sec)
176:             if key not in cache:
177:                 feats = features_from_bars(bars, cutoff)
178:                 lab = weekly_label({b.session: b for b in bars}, entry_s, exit_s) if feats else None
179:                 cache[key] = TrainingRow(cutoff, sec, feats, lab[0], lab[1]) if (feats and lab) else None
180:             row = cache[key]
181:             if row is not None and to_utc(row.label_known_at) <= to_utc(now_cutoff):
182:                 rows.append(row)
183:     return rows
184: 
185: 
186: def fit_q1(rows: Sequence[TrainingRow], *, trained_at: datetime, min_weeks: int = 52, seed: int = 20260909) -> Optional[Q1Model]:
187:     by_week: dict[datetime, list[TrainingRow]] = {}
188:     for r in rows:
189:         by_week.setdefault(r.cutoff_at, []).append(r)
190:     if len(by_week) < min_weeks:
191:         return None
192:     X: list[list[float]] = []
193:     y: list[float] = []
194:     for cutoff, wrows in sorted(by_week.items()):
195:         ranks = _rank01([r.label for r in wrows])
196:         for r, rk in zip(wrows, ranks):
197:             X.append([r.features[k] for k in FEATURE_NAMES])
198:             y.append(rk)
199:     ridge = RidgeRank(alpha=float(len(X)) * 0.01).fit(X, y)
200:     lgbm = None
201:     try:
202:         import lightgbm as lgb
203:         lgbm = lgb.LGBMRegressor(n_estimators=200, learning_rate=0.03, num_leaves=15, min_child_samples=50, subsample=0.8,
204:                                  subsample_freq=1, colsample_bytree=0.8, reg_lambda=5.0, random_state=seed, verbose=-1)
205:         lgbm.fit(X, y)
206:     except Exception:
207:         lgbm = None
208:     weeks = sorted(by_week)
209:     iso0, iso1 = weeks[0].date().isocalendar(), weeks[-1].date().isocalendar()
210:     manifest = f"{MODEL_ID}|rows={len(X)}|weeks={len(weeks)}|labels={iso0[0]}-W{iso0[1]:02d}..{iso1[0]}-W{iso1[1]:02d}|lgbm={'yes' if lgbm else 'no'}"
211:     return Q1Model(trained_at=trained_at, n_rows=len(X), n_weeks=len(weeks), first_label_week=f"{iso0[0]}-W{iso0[1]:02d}",
212:                    last_label_week=f"{iso1[0]}-W{iso1[1]:02d}", ridge=ridge, lgbm=lgbm, training_manifest_id=manifest)


