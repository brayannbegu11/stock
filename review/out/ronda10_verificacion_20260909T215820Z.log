380: def packet_to_json(packet: Packet) -> bytes:
381:     """Serializaci├│n can├│nica del paquete para archivarlo junto a su hash (registro de paquetes acreditados)."""
382:     return canonical_bytes({
383:         "packet_id": packet.packet_id, "cutoff_at": packet.cutoff_at, "mode": packet.mode,
384:         "evidence_class": packet.evidence_class, "created_at": packet.created_at, "week_id": packet.week_id,
385:         "week_status": packet.week_status, "deadline_at": packet.deadline_at,
386:         "registration_deadline_at": packet.registration_deadline_at, "entry_at": packet.entry_at,
387:         "exit_at": packet.exit_at, "calendar_version": packet.calendar_version,
388:         "admitted": [d.canonical() for d in packet.admitted],
389:         "rejected": [[r.doc_id, r.reason, r.detail] for r in packet.rejected],
390:         "packet_hash": packet.packet_hash(),
391:     })
