index 0000000000000000000000000000000000000000..ba856ad605b309abef836b195fa408c3dc1906dd
--- /dev/null
+++ b/review/out/astra_scratch/run_r10_real.py
@@ -0,0 +1,49 @@
+from r10_support import *
+from twlab.backtest import TabularForecaster, markdown_report
+from twlab.calendar import load_twse_reference_calendar
+from twlab.packet import packet_from_json
+from twlab.models import q1
+from dataclasses import fields
+
+out=ROOT/'review/out/astra_scratch/r10_real'
+out.mkdir(exist_ok=True)
+raw=RawStore(ROOT/'data/raw')
+market=load_market(raw,ROOT/'data/store/sample_universe.json',load_twse_reference_calendar())
+saved=json.loads((ROOT/'data/store/backtest_sample_2024_2025.json').read_text(encoding='utf-8'))
+ass=saved['summary']['assumptions']
+kwargs={f.name:ass[f.name] for f in fields(BacktestConfig)}
+for k in ('start','end'):kwargs[k]=date.fromisoformat(kwargs[k])
+for k in ('exposure_tolerance','commission_per_side','sell_tax','par_value'):kwargs[k]=D(kwargs[k])
+cfg=BacktestConfig(**kwargs)
+store=RawStore(out/'raw')
+class AuditedTabular(TabularForecaster):
+    def maybe_train(self,cutoff):
+        super().maybe_train(cutoff)
+        if self.model and self.model.trained_at==cutoff:
+            print(self.history[-1],flush=True)
+
+runner=Runner(store,market,cfg,[MomentumForecaster(),AuditedTabular(market),RandomForecaster(cfg.seed)])
+result=runner.run()
+(out/'result.json').write_text(json.dumps(result,ensure_ascii=False,indent=1,default=str),encoding='utf-8')
+audit={'full_json_equal':result==saved,'weeks':len(result['weeks']),'packets':0,'future_documents':0,'future_bars':0,
+       'feature_mismatches':0,'feature_checks':0}
+for rec in store.captures(source_id='packet'):
+    p=packet_from_json(store.read(rec))
+    audit['packets']+=1
+    for d in p.admitted:
+        audit['future_documents']+=d.available_at>p.cutoff_at
+        bars=market.securities[d.security_ids[0]].bars
+        by={b.session.isoformat():b for b in bars}
+        for s in d.payload['sessions']:
+            audit['future_bars']+=by[s[0]].available_at>p.cutoff_at
+        reconstructed=[q1.BarLike(date.fromisoformat(s[0]),D(s[1]),D(s[2]),D(s[4]),p.cutoff_at) for s in d.payload['sessions']]
+        a=q1.features_from_bars(bars,p.cutoff_at)
+        b=q1.features_from_bars(reconstructed,p.cutoff_at)
+        audit['feature_checks']+=1
+        audit['feature_mismatches']+=a!=b
+q0=json.loads((ROOT/'data/store/q0_demo_2024-01-01_2025-12-31.json').read_text(encoding='utf-8'))
+audit['q0_summary_equal']=q0['summary']['forecasters']['Q0']==result['summary']['forecasters']['Q0']
+audit['a1_summary_equal']=q0['summary']['forecasters']['A1']==result['summary']['forecasters']['A1']
+audit['report14_equal']=markdown_report(result,title='Backtest de la muestra 2024-2025 (Q0, Q1, A1)')==(ROOT/'docs/informes/14_backtest_muestra_2024-2025.md').read_text(encoding='utf-8')
+(out/'audit.json').write_text(json.dumps(audit,indent=2),encoding='utf-8')
+print(json.dumps(audit),flush=True)
diff --git a/review/out/astra_scratch/test_r10_attacks.py b/review/out/astra_scratch/test_r10_attacks.py
new file mode 100644
index 0000000000000000000000000000000000000000..a0fcd93b9ad6e4b0127faa37c8254443773d10e4
--- /dev/null
+++ b/review/out/astra_scratch/test_r10_attacks.py
@@ -0,0 +1,152 @@
+from review.out.astra_scratch.r10_support import *
+from dataclasses import replace
+from types import SimpleNamespace
+import math
+import pytest
+from twlab.models import q1
+from twlab.backtest import TabularForecaster
+from twlab.weekly import plan_week
+from twlab.evaluation import WeeklyObservation, block_bootstrap_mean
+
+def test_label_requires_both_endpoints(tmp_path):
+    _,market=fixture(tmp_path,end='2024-01-19')
+    bars=next(iter(market.securities.values())).bars
+    bars=[replace(b,available_at=taipei(date(2024,1,20)),open=D(50)) if b.session==date(2024,1,8) else b for b in bars]
+    rows=q1.build_training_rows({'A':bars},[taipei(date(2024,1,7),time(18))],now_cutoff=taipei(date(2024,1,14),time(18)),calendar=market.calendar)
+    assert not rows, [(r.label,r.label_known_at.isoformat()) for r in rows]
+
+def test_cache_retries_immature_missing_label(tmp_path):
+    _,market=fixture(tmp_path,end='2024-01-19')
+    bars=next(iter(market.securities.values())).bars
+    cutoffs=[taipei(date(2024,1,7),time(18))]
+    cache={}
+    q1.build_training_rows({'A':[b for b in bars if b.session<=date(2024,1,10)]},cutoffs,now_cutoff=taipei(date(2024,1,11)),calendar=market.calendar,cache=cache)
+    kw=dict(now_cutoff=taipei(date(2024,1,14),time(18)),calendar=market.calendar)
+    fresh=q1.build_training_rows({'A':bars},cutoffs,**kw)
+    cached=q1.build_training_rows({'A':bars},cutoffs,cache=cache,**kw)
+    assert cached==fresh, (len(cached),len(fresh),cache)
+
+def test_model_cannot_travel_backwards(tmp_path):
+    _,market=fixture(tmp_path,end='2024-01-19')
+    f=TabularForecaster(market,min_weeks=1)
+    f.maybe_train(taipei(date(2024,1,14),time(18)))
+    assert f.model is not None
+    old=taipei(date(2024,1,7),time(18))
+    try:
+        f.maybe_train(old)
+    except ValueError:
+        return
+    assert f.model.trained_at<=old, (f.model.trained_at,old)
+
+def test_ties_do_not_create_cross_sectional_signal():
+    ridge=q1.RidgeRank().fit([[1.]*len(q1.FEATURE_NAMES)]*3,[.5]*3)
+    model=q1.Q1Model(taipei(date(2024,1,1)),3,1,'w','w',ridge)
+    scores=model.predict([{k:1. for k in q1.FEATURE_NAMES}]*3)
+    assert len(set(scores))==1, scores
+
+def test_constant_booster_does_not_cancel_ridge_signal():
+    ridge=q1.RidgeRank(alpha=.01).fit([[v]+[0.]*(len(q1.FEATURE_NAMES)-1) for v in (1.,2.,3.)],[1.,2.,3.])
+    model=q1.Q1Model(taipei(date(2024,1,1)),3,1,'w','w',ridge,SimpleNamespace(predict=lambda X:[0.]*len(X)))
+    feats=[{k:(v if i==0 else 0.) for i,k in enumerate(q1.FEATURE_NAMES)} for v in (3.,2.,1.)]
+    scores=model.predict(feats)
+    assert scores[0]>scores[1]>scores[2],scores
+
+def test_ridge_collinear_constant_control():
+    import numpy as np
+    X=np.array([[v,2*v,7.] for v in range(10)],dtype=float)
+    y=np.arange(10,dtype=float)
+    m=q1.RidgeRank(alpha=1.).fit(X.tolist(),y.tolist())
+    Z=(X-X.mean(axis=0))/np.maximum(X.std(axis=0),1e-9)
+    expected=np.linalg.solve(Z.T@Z+np.eye(3),Z.T@(y-y.mean()))
+    assert np.allclose(m.w,expected)
+
+@pytest.mark.parametrize('variant',['declared_id','listing_conflict','dividend_source','dividend_count'])
+def test_load_market_rejects_incoherent_manifest(tmp_path,variant):
+    def mutate(m,store,capture):
+        c=m['captures']['A']
+        if variant=='declared_id': c['security_id']='TPEX:B@2020-01-01'
+        elif variant=='listing_conflict': c['listing_date']='2023-01-01'
+        elif variant=='dividend_source':
+            rec=capture('TaiwanStockDividend/A',[{'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-10','CashEarningsDistribution':2}],source='untrusted')
+            c.update(dividend=rec.capture_id,dividend_rows=1)
+        else: c['dividend_rows']=0
+    dividends=[{'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-10','CashEarningsDistribution':2}]
+    with pytest.raises(ValueError):
+        fixture(tmp_path,mutate=mutate,dividends=dividends)
+
+def test_new_issuer_cannot_inherit_prelisting_bars(tmp_path):
+    def mutate(m,*_): m['listed'][0]['listing_date']='2024-01-01'
+    r=runner(tmp_path,mutate=mutate)
+    _,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),r.market.calendar))
+    assert cs and not cs[0].scorable,(cs[0].security_id,len(cs[0].sessions),cs[0].scorable)
+
+def test_end_is_a_hard_boundary(tmp_path):
+    r=runner(tmp_path,end='2024-01-26',config_end='2024-01-10')
+    result=r.run()
+    assert all(v['final_valuation']['events_processed_through']<='2024-01-10' for v in result['summary']['forecasters'].values())
+
+def test_pending_week_preserves_actual_entry(tmp_path):
+    r=runner(tmp_path,end='2024-01-10')
+    result=r.run()
+    assert result['weeks'][0]['pending_outcome']
+    assert r.ledgers['Q0'].positions, result['summary']['forecasters']['Q0']['final_valuation']
+
+def test_random_is_unchanged_by_extra_forecaster(tmp_path):
+    a=runner(tmp_path/'a',symbols=tuple('ABCDEFG'),end='2024-01-19',slots=2).run()
+    b=runner(tmp_path/'b',symbols=tuple('ABCDEFG'),end='2024-01-19',slots=2,extra=True).run()
+    for wa,wb in zip(a['weeks'],b['weeks']):
+        assert wa['forecasters']['A1']==wb['forecasters']['A1']
+        assert wa.get('paired',{}).get('Q0')==wb.get('paired',{}).get('Q0')
+
+def test_bootstrap_exact_short_segment_weight():
+    days=[date(2024,1,1)+timedelta(weeks=i) for i in (0,2,3,4,5)]
+    obs=[WeeklyObservation(f'{d.isocalendar().year}-W{d.isocalendar().week:02}',str(i),'historical_numeric_temporally_controlled',None,True,float(i==0)) for i,d in enumerate(days)]
+    r=block_bootstrap_mean(obs,block_length=4,n_boot=100000,seed=1)
+    assert abs(r.resample_mean-.2)<.003,r
+
+def test_packet_last_session_and_features_control(tmp_path):
+    r=runner(tmp_path,end='2024-01-26')
+    plan=plan_week(taipei(date(2024,1,7),time(18)),r.market.calendar)
+    packet,_,cs=r.build_week_packet(plan)
+    c=cs[0]
+    assert c.sessions[-1][0]=='2024-01-05'
+    original=r.market.securities[c.security_id].bars
+    assert packet.admitted[0].available_at==taipei(date(2024,1,6),time(13,30))
+    reconstructed=[q1.BarLike(date.fromisoformat(s[0]),D(s[1]),D(s[2]),D(s[4]),plan.cutoff_at) for s in c.sessions]
+    assert q1.features_from_bars(original,plan.cutoff_at)==q1.features_from_bars(reconstructed,plan.cutoff_at)
+
+def test_training_manifest_identifies_actual_training_data():
+    at=taipei(date(2024,1,7),time(18))
+    known=taipei(date(2024,1,13),time(13,30))
+    rows=[q1.TrainingRow(at,str(i),{k:float(i) for k in q1.FEATURE_NAMES},float(i),known) for i in range(3)]
+    a=q1.fit_q1(rows,trained_at=taipei(date(2024,1,14),time(18)),min_weeks=1,seed=1)
+    b=q1.fit_q1([replace(r,label=-r.label) for r in rows],trained_at=taipei(date(2024,1,14),time(18)),min_weeks=1,seed=2)
+    assert a.predict([r.features for r in rows])!=b.predict([r.features for r in rows])
+    assert a.training_manifest_id!=b.training_manifest_id,(a.training_manifest_id,b.training_manifest_id)
+
+def test_q1_target_is_total_return_as_specified():
+    # Dividendo en acciones 1:1 el mi├⌐rcoles; precios nominales 100 -> 50, valor econ├│mico conservado.
+    a=q1.BarLike(date(2024,1,8),D(100),D(100),D(1),taipei(date(2024,1,9),time(13,30)))
+    b=q1.BarLike(date(2024,1,12),D(50),D(50),D(1),taipei(date(2024,1,13),time(13,30)))
+    actual,_=q1.weekly_label({a.session:a,b.session:b},a.session,b.session)
+    assert actual==0.0,actual
+
+def test_r09_03_known_reason_does_not_authorize_future_detail(tmp_path):
+    from tests.test_schema import prospective_packet
+    from twlab.packet import Rejection,readmission_problems,packet_to_json,packet_from_json,PredictorView
+    p=replace(prospective_packet(),rejected=(Rejection('ghost','available_after_cutoff','profit in 2099 = 999'),))
+    p=packet_from_json(packet_to_json(p))
+    problems=readmission_problems(p,store=RawStore(tmp_path))
+    assert problems or '2099' not in str(PredictorView(p).packet().rejected),(problems,p.rejected)
+
+def test_tail_closure_cannot_erase_monday_entry(tmp_path):
+    r=runner(tmp_path,end='2024-01-12',prices=lambda d:D(0) if d==date(2024,1,12) else D(100))
+    result=r.run()
+    assert r.store.captures(source_id='packet')
+    assert '2024-W02:1' in r.ledgers['Q0'].owners_seen,result['weeks'][0]
+
+def test_report11_counts_match_current_demo_json():
+    result=json.loads((ROOT/'data/store/q0_demo_2024-01-01_2025-12-31.json').read_text(encoding='utf-8'))
+    text=(ROOT/'docs/informes/11_demo_q0_2024-2025.md').read_text(encoding='utf-8')
+    n=result['summary']['weeks_total']
+    assert f'{n} cortes dominicales' in text,(n,result['weeks'][-1]['cutoff_at'])
