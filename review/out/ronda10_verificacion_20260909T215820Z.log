60: def fetch(store: RawStore, dataset: str, *, data_id: Optional[str] = None, start_date: Optional[str] = None,
61:           end_date: Optional[str] = None, pause_s: float = 1.0) -> CaptureRecord:
62:     params = {"dataset": dataset}
63:     if data_id:
64:         params["data_id"] = data_id
65:     if start_date:
66:         params["start_date"] = start_date
67:     if end_date:
68:         params["end_date"] = end_date
69:     r = requests.get(BASE, params=params, headers=HEADERS, timeout=90)
70:     rec = store.put(source_id="finmind", dataset=f"{dataset}/{data_id}" if data_id else dataset, payload=r.content,
71:                     url=r.url, http_status=r.status_code, content_type=r.headers.get("Content-Type"),
72:                     extra={"start_date": start_date, "end_date": end_date})
73:     time.sleep(pause_s)
74:     return rec
75: 
76: 
77: def rows(store: RawStore, rec: CaptureRecord) -> list[dict]:
78:     body = json.loads(store.read(rec).decode("utf-8"))
79:     if body.get("status") != 200 or body.get("msg") != "success":
80:         raise ValueError(f"FinMind capture {rec.capture_id} is not a success payload: {body.get('msg')}")
81:     return body.get("data", [])
