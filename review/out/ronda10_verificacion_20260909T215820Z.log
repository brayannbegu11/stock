89: def load_market(store: RawStore, manifest_path: Path, calendar: TradingCalendar, *, default_market: str = "TWSE") -> MarketData:
90:     """Carga barras y dividendos desde las capturas listadas en un manifiesto (muestra o universo), comprobando identidad."""
91:     manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
92:     listing: dict[str, date] = {}
93:     delisting: dict[str, date] = {}
94:     names: dict[str, str] = {}
95:     markets: dict[str, str] = {}
96:     for row in manifest.get("listed", []):
97:         listing[row["symbol"]] = date.fromisoformat(row["listing_date"])
98:         names[row["symbol"]] = row.get("name", "")
99:     for row in manifest.get("delisted", []):
100:         delisting[row["symbol"]] = date.fromisoformat(row["delisting_date"])
101:         names[row["symbol"]] = row.get("name", "")
102:     now = datetime.now(TAIPEI)
103:     master = SecurityMaster()
104:     securities: dict[str, Security] = {}
105:     by_symbol: dict[str, str] = {}
106:     by_session: dict[str, dict[date, finmind.Bar]] = {}
107:     dropped = 0
108:     for sid, caps in manifest["captures"].items():
109:         if caps.get("price_rows", 0) <= 0:
110:             continue
111:         rec = store.get(caps["price"])
112:         if rec.source_id != "finmind" or rec.dataset != f"TaiwanStockPrice/{sid}":
113:             raise SourceIdentityMismatch(f"{sid}: manifest points to capture {rec.capture_id} ({rec.dataset})")
114:         raw_bars = finmind.bars_from_rows(finmind.rows(store, rec), stock_id=sid)
115:         bars = [b for b in raw_bars if b.has_regular_price]
116:         dropped += len(raw_bars) - len(bars)
117:         if not bars:
118:             continue
119:         divs: list[finmind.DividendRow] = []
120:         if caps.get("dividend_rows", 0) > 0:
121:             drec = store.get(caps["dividend"])
122:             if drec.dataset != f"TaiwanStockDividend/{sid}":
123:                 raise SourceIdentityMismatch(f"{sid}: manifest points to dividend capture {drec.capture_id} ({drec.dataset})")
124:             divs = finmind.dividends_from_rows(finmind.rows(store, drec), stock_id=sid)
125:         market = caps.get("market", markets.get(sid, default_market))
126:         vf = date.fromisoformat(caps["listing_date"]) if caps.get("listing_date") else listing.get(sid, bars[0].session)
127:         name = caps.get("name", names.get(sid, ""))
128:         sec_id = security_id_for(market, sid, vf)
129:         sv = SecurityVersion(security_id=sec_id, issuer_id=sec_id, symbol=sid, name_zh=name, market=market, board="main",
130:                              instrument_type="ordinary_equity", valid_from=vf, valid_to=None, recorded_at=now, source_id=manifest_path.name)
131:         master.add(sv)
132:         dl = delisting.get(sid)
133:         if dl:
134:             later = now + timedelta(seconds=1)
135:             master.close_version(sec_id, valid_to=dl, recorded_at=later, source_id="twse:suspendListing",
136:                                  terminal=TerminalEvent(sec_id, "delisting", dl, later, "twse:suspendListing"))
137:         securities[sec_id] = Security(sid, sec_id, market, name, vf, dl, bars, divs, rec)
138:         by_symbol[sid] = sec_id
139:         by_session[sec_id] = {b.session: b for b in bars}
140:     traded: set[date] = set().union(*[set(m) for m in by_session.values()]) if by_session else set()
141:     return MarketData(securities, by_symbol, master, calendar, by_session, traded, dropped, manifest_path.name)
142: 
143: 
144: # ---------------------------------------------------------------------------------------------------
145: # Pronosticadores: s├│lo ven el paquete (PredictorView) y la lista de candidatos derivada de ├⌐l.
146: # ---------------------------------------------------------------------------------------------------
147: 
148: @dataclass
149: class Candidate:
150:     security_id: str
151:     symbol: str
152:     doc_id: str
153:     sessions: list                 # [[fecha, apertura, cierre, volumen, importe], ...] del documento
154:     scorable: bool
155:     eligible: bool
156:     reasons: tuple[str, ...]
157: 
158: 
159: @dataclass
160: class Selection:
161:     security_id: str
162:     score: float
163:     doc_ids: list[str]
164:     feature_ids: list[str] = field(default_factory=list)
165: 
166: 
167: class Forecaster(Protocol):
168:     name: str
169:     model_id: str
170:     version: str
171: 
172:     def forecast(self, view: PredictorView, plan: WeekPlan, candidates: Sequence[Candidate], *, slots: int) -> tuple[list[Selection], dict]:
173:         """Devuelve selecciones ordenadas (como m├íximo ``slots``) y metadatos (training_manifest_id, limitaciones)."""
174: 
175: 
176: class MomentumForecaster:
177:     """Q0: rentabilidad de 20 sesiones sobre las barras nominales del paquete. Control transparente."""
178:     name, model_id, version = "Q0", "rule:momentum_20_sessions_v1", "q0_v1"
179: 
180:     def forecast(self, view, plan, candidates, *, slots):
181:         scored = []
182:         for c in candidates:
183:             if not (c.scorable and c.eligible) or len(c.sessions) < 21:
184:                 continue
185:             closes = [D(s[2]) for s in c.sessions]
186:             scored.append(Selection(c.security_id, float(closes[-1] / closes[-21] - 1), [c.doc_id], ["ret_20s", "median_value_20s"]))
187:         return sorted(scored, key=lambda s: s.score, reverse=True)[:slots], {"training_manifest_id": None}
188: 
189: 
190: class RandomForecaster:
191:     """A1: cinco valores al azar entre los elegibles de la semana, con semilla declarada."""
192:     name, model_id, version = "A1", "rule:random_eligible_v1", "a1_v1"
193: 
194:     def __init__(self, seed: int) -> None:
195:         self.rng = random.Random(seed)
196: 
197:     def forecast(self, view, plan, candidates, *, slots):
198:         eligible = [c for c in candidates if c.eligible]
199:         picks = self.rng.sample(eligible, min(slots, len(eligible))) if eligible else []
200:         return [Selection(c.security_id, 0.0, [c.doc_id], []) for c in picks], {"training_manifest_id": None}
201: 
202: 
203: class TabularForecaster:
204:     """Q1: caracter├¡sticas de precio/volumen del paquete y modelo entrenado s├│lo con etiquetas conocidas al corte."""
205:     name, model_id, version = "Q1", q1mod.MODEL_ID, "q1_v1"
206: 
207:     def __init__(self, market: MarketData, *, retrain_every_weeks: int = 4, min_weeks: int = 52, seed: int = 20260909) -> None:
208:         self.market = market
209:         self.retrain_every = retrain_every_weeks
210:         self.min_weeks = min_weeks
211:         self.seed = seed
212:         self.model: Optional[q1mod.Q1Model] = None
213:         self.trained_for: Optional[datetime] = None
214:         self.weeks_since_train = 0
215:         self.cache: dict = {}
216:         self.history: list[str] = []
217: 
218:     def maybe_train(self, cutoff_at: datetime) -> None:
219:         if self.model is not None and self.weeks_since_train < self.retrain_every:
220:             self.weeks_since_train += 1
221:             return
222:         first = min(b.session for s in self.market.securities.values() for b in s.bars[:1])
223:         cutoffs = []
224:         d = first + timedelta(days=(6 - first.weekday()) % 7)
225:         while d < cutoff_at.date():
226:             cutoffs.append(taipei(d, time(18, 0)))
227:             d += timedelta(days=7)
228:         bars = {sec_id: s.bars for sec_id, s in self.market.securities.items()}
229:         rows = q1mod.build_training_rows(bars, cutoffs, now_cutoff=cutoff_at, calendar=self.market.calendar, cache=self.cache)
230:         self.model = q1mod.fit_q1(rows, trained_at=cutoff_at, min_weeks=self.min_weeks, seed=self.seed)
231:         self.trained_for = cutoff_at
232:         self.weeks_since_train = 1
233:         self.history.append(f"{cutoff_at.date().isoformat()}: {self.model.training_manifest_id if self.model else 'insufficient_history'}")
234: 
235:     def forecast(self, view, plan, candidates, *, slots):
236:         self.maybe_train(plan.cutoff_at)
237:         meta = {"training_manifest_id": self.model.training_manifest_id if self.model else None}
238:         if self.model is None:
239:             return [], {**meta, "status_reason": "insufficient_training_history"}
240:         feats, elig = [], []
241:         for c in candidates:
242:             if not (c.scorable and c.eligible):
243:                 continue
244:             bars = [q1mod.BarLike(date.fromisoformat(s[0]), D(s[1]), D(s[2]), D(s[4]), plan.cutoff_at) for s in c.sessions]
245:             f = q1mod.features_from_bars(bars, plan.cutoff_at)
246:             if f is not None:
247:                 feats.append(f)
248:                 elig.append(c)
249:         if not feats:
250:             return [], {**meta, "status_reason": "no_eligible_securities"}
251:         scores = self.model.predict(feats)
252:         ranked = sorted(zip(elig, scores), key=lambda t: t[1], reverse=True)[:slots]
253:         return [Selection(c.security_id, float(s), [c.doc_id], list(q1mod.FEATURE_NAMES)) for c, s in ranked], meta
254: 
255: 
256: # ---------------------------------------------------------------------------------------------------
257: 
258: def _week_costs(slots) -> D:
259:     total = D(0)
260:     for s_ in slots:
261:         for f in (s_.entry, s_.exit):
262:             if f is not None:
263:                 total += f.commission + f.tax + f.slippage_cost
264:     return total
265: 
266: 
267: def _sundays(start: date, end: date):
268:     d = start + timedelta(days=(6 - start.weekday()) % 7)
269:     while d <= end:
270:         yield d
271:         d += timedelta(days=7)
272: 
273: 
274: class Runner:
275:     def __init__(self, store: RawStore, market: MarketData, cfg: BacktestConfig, forecasters: Sequence[Forecaster]) -> None:
276:         self.store, self.market, self.cfg = store, market, cfg
277:         self.forecasters = {f.name: f for f in forecasters}
278:         if cfg.baseline not in self.forecasters:
279:             raise ValueError(f"baseline {cfg.baseline!r} is not among the forecasters")
280:         costs = CostModel(commission_per_side=cfg.commission_per_side, sell_tax=cfg.sell_tax, slippage_bps_per_side=cfg.slippage_bps)
281:         self.costs = costs
282:         self.initial = D(cfg.notional * cfg.slots)
283:         self.ledgers = {n: PaperLedger(ledger_id=n, initial_cash=self.initial, cost_model=costs) for n in self.forecasters}
284:         self.open_slots: dict[str, list] = {n: [] for n in self.forecasters}
285:         self.prev_equity = {n: self.initial for n in self.forecasters}
286:         self.cursor = {n: cfg.start - timedelta(days=1) for n in self.forecasters}
287:         self.weeks: list[dict] = []
288:         self.last_data_day = max(market.traded_days) if market.traded_days else cfg.start
289: 
290:     # -- precios y eventos --------------------------------------------------------------------------
291:     def marks(self, session: date, ledger: PaperLedger, kind: str) -> tuple[dict[str, D], list[str]]:
292:         out, stale = {}, []
293:         for sec, pos in ledger.positions.items():
294:             if pos.status.startswith("delisted"):
295:                 continue
296:             b = self.market.by_session.get(sec, {}).get(session)
297:             if b is None:
298:                 prev = [x for x in self.market.securities[sec].bars if x.session <= session]
299:                 if prev:
300:                     out[sec] = prev[-1].close
301:                     stale.append(f"stale_price:{sec}:{prev[-1].session.isoformat()}")
302:             else:
303:                 out[sec] = b.open if kind == "open" else b.close
304:         return out, stale
305: 
306:     def apply_actions(self, name: str, upto: date) -> int:
307:         ledger = self.ledgers[name]
308:         since = self.cursor[name]
309:         if upto <= since:
310:             return 0
311:         events = []
312:         for sec in list(ledger.positions):
313:             s = self.market.securities[sec]
314:             for dv in s.dividends:
315:                 for kind, exd in (("cash", dv.cash_ex_date), ("stock", dv.stock_ex_date)):
316:                     if exd is not None and since < exd <= upto:
317:                         events.append((exd, kind, sec, dv))
318:             if s.delisting_date and since < s.delisting_date <= upto:
319:                 events.append((s.delisting_date, "delisting", sec, None))
320:         n = 0
321:         for exd, kind, sec, dv in sorted(events, key=lambda e: (e[0], e[1])):
322:             at = taipei(exd, PRE_OPEN)
323:             try:
324:                 if kind == "cash" and dv.cash_per_share > 0:
325:                     pay = taipei(dv.cash_pay_date, time(9, 0)) if dv.cash_pay_date else None
326:                     ledger.apply_corporate_action(CorporateAction(f"{sec}:cash:{exd}:{dv.period}", sec, "cash_dividend", at,
327:                                                                   per_share_cash=dv.cash_per_share, pay_at=pay))
328:                 elif kind == "stock" and dv.stock_per_share > 0:
329:                     ledger.apply_corporate_action(CorporateAction(f"{sec}:stock:{exd}:{dv.period}", sec, "stock_dividend", at,
330:                                                                   stock_ratio=dv.stock_per_share / self.cfg.par_value))
331:                 elif kind == "delisting":
332:                     ledger.apply_corporate_action(CorporateAction(f"{sec}:delisting:{exd}", sec, "delisting", at, terminal_price=None))
333:                 else:
334:                     continue
335:                 n += 1
336:             except LedgerError as exc:
337:                 self.weeks[-1].setdefault("action_errors", []).append(f"{name}:{sec}:{kind}:{exd}:{exc}")
338:         self.cursor[name] = upto
339:         return n
340: 
341:     # -- paquete y candidatos ------------------------------------------------------------------------
342:     def build_week_packet(self, plan: WeekPlan) -> tuple[Packet, object, list[Candidate]]:
343:         cutoff = plan.cutoff_at
344:         docs = []
345:         for sec_id, s in self.market.securities.items():
346:             known = [b for b in s.bars if b.available_at <= cutoff]
347:             if not known:
348:                 continue
349:             docs.append(Document(
350:                 doc_id=f"{s.symbol}:bars:{plan.week_id}", kind="price_bar_series", source_id="finmind", security_ids=(sec_id,),
351:                 available_at=known[-1].available_at, availability_quality=AvailabilityQuality.CONSERVATIVE_INFERENCE,
352:                 capture_id=s.price_capture.capture_id, source_sha256=s.price_capture.sha256, derivation="finmind_price_bars_v1",
353:                 payload={"history_sessions": len(known), "last_session": known[-1].session.isoformat(),
354:                          "sessions": [[b.session.isoformat(), str(b.open), str(b.close), b.volume_shares, str(b.value_twd)] for b in known[-130:]]},
355:             ))
356:         packet = build_packet(packet_id=f"pkt-{self.cfg.label}-{plan.week_id}", cutoff_at=cutoff, documents=docs, mode="historical",
357:                               evidence_class=EVIDENCE, calendar=self.market.calendar)
358:         rec = self.store.put(source_id="packet", dataset=f"{self.cfg.label}/{plan.week_id}", payload=packet_to_json(packet),
359:                              url="local://backtest", content_type="application/json",
360:                              extra={"packet_hash": packet.packet_hash(), "evidence_class": EVIDENCE})
361:         last_session = self.market.calendar.prev_session(before=cutoff.date())
362:         candidates: list[Candidate] = []
363:         for doc in packet.admitted:
364:             sec_id = doc.security_ids[0]
365:             s = self.market.securities[sec_id]
366:             sessions = list(doc.payload["sessions"])
367:             values = [D(x[4]) for x in sessions[-20:]]
368:             try:
369:                 sv = self.market.master.resolve_symbol(s.symbol, as_of=last_session)
370:             except UnknownSymbol:
371:                 candidates.append(Candidate(sec_id, s.symbol, doc.doc_id, sessions, False, False, ("not_in_catalog_as_of_last_session",)))
372:                 continue
373:             median_value = statistics.median(values) if values else D(0)
374:             status_ok = doc.payload["last_session"] == last_session.isoformat()
375:             cov = classify_coverage(sv, price_history_sessions=int(doc.payload["history_sessions"]),
376:                                     min_history_sessions=self.cfg.min_history_sessions,
377:                                     trading_status="normal" if status_ok else "no_bar_on_last_session",
378:                                     liquidity_ok=median_value >= D(self.cfg.liquidity_multiple * self.cfg.notional))
379:             candidates.append(Candidate(sv.security_id, s.symbol, doc.doc_id, sessions, cov.numerically_scorable, cov.simulation_eligible, cov.reasons))
380:         return packet, rec, candidates
381: 
382:     def make_forecast(self, f: Forecaster, plan: WeekPlan, packet: Packet, selections: list[Selection], meta: dict, candidates) -> dict:
383:         eligible = [c for c in candidates if c.eligible]
384:         scorable = [c for c in candidates if c.scorable]
385:         obj = {
386:             "schema_version": "2.0", "forecast_id": f"{f.name}-{plan.week_id}", "experiment_id": f.name, "protocol_version": "2.0-draft-backtest",
387:             "packet_id": packet.packet_id, "cutoff_at": plan.cutoff_at.isoformat(), "issued_at": (plan.cutoff_at + timedelta(minutes=5)).isoformat(),
388:             "deadline_at": plan.deadline_at.isoformat(), "timezone": "Asia/Taipei", "evidence_class": EVIDENCE,
389:             "model": {"requested_id": f.model_id, "returned_id": f.model_id, "revision_id": None,
390:                       "prompt_or_feature_version": f.version, "training_manifest_id": meta.get("training_manifest_id")},
391:             "coverage": {"catalog_count": len(self.market.securities), "scored_count": len(scorable), "deep_review_count": 0,
392:                          "eligible_count": len(eligible), "missing_critical_sources": []},
393:             "status": "selected" if selections else "abstained",
394:             "ranking": [{"security_id": s.security_id, "ticker_as_of": self.market.securities[s.security_id].symbol, "market": self.market.securities[s.security_id].market,
395:                          "rank": i + 1, "score": s.score, "score_definition": f"{f.model_id} sobre barras nominales del paquete",
396:                          "document_ids": s.doc_ids, "feature_ids": s.feature_ids, "impact_hypothesis": None, "counterargument": None,
397:                          "calibrated_probability": None, "calibration_model_id": None} for i, s in enumerate(selections)],
398:             "limitations": ["universo del censo vigente (sesgo de supervivencia)", "disponibilidad de barras por pol├¡tica de 24 h, no verificada",
399:                             "costes ilustrativos; deslizamiento central no congelado", "regla de liquidez provisional, no del protocolo"],
400:         }
401:         if not selections:
402:             obj["status_reason"] = meta.get("status_reason", "no_eligible_securities")
403:         return obj
404: 
405:     # -- una semana ------------------------------------------------------------------------------------
406:     def run_week(self, sunday: date) -> None:
407:         cfg = self.cfg
408:         cutoff = taipei(sunday, time(18, 0))
409:         plan = plan_week(cutoff, self.market.calendar)
410:         record: dict = {"week_id": plan.week_id, "cutoff_at": cutoff.isoformat(), "status": plan.status, "forecasters": {}}
411:         self.weeks.append(record)
412:         if not plan.is_valid:
413:             week_end = plan.target_monday + timedelta(days=6)
414:             last_close = self.market.calendar.prev_session(before=week_end + timedelta(days=1))
415:             for name, lg in self.ledgers.items():
416:                 self.apply_actions(name, week_end)
417:                 lg.advance_to(taipei(week_end, time(23, 59)))
418:                 prices, stale = self.marks(last_close, lg, "close")
419:                 try:
420:                     v = lg.valuation(prices=prices, at=taipei(week_end, time(23, 59)))
421:                     record["forecasters"][name] = {"equity_end": float(v.total), "flags": list(v.flags)[:6] + stale}
422:                     self.prev_equity[name] = v.total
423:                 except MissingPrice as exc:
424:                     record["forecasters"][name] = {"equity_end": None, "flags": [f"missing_price:{exc}"] + stale}
425:             record["note"] = "invalid:no_sessions (registrado, sin operaciones; eventos procesados)"
426:             return
427:         packet, pkt_rec, candidates = self.build_week_packet(plan)
428:         view = PredictorView(packet)
429:         entry_s, exit_s = plan.entry_at.date(), plan.exit_at.date()
430:         pending = exit_s > self.last_data_day
431:         record.update(eligible=sum(1 for c in candidates if c.eligible), scored=sum(1 for c in candidates if c.scorable),
432:                       coverage_reasons=dict(collections.Counter(r.split(":")[0] for c in candidates for r in c.reasons)),
433:                       pending_outcome=pending)
434:         picks: dict[str, list[str]] = {}
435:         for name, f in self.forecasters.items():
436:             selections, meta = f.forecast(view, plan, candidates, slots=cfg.slots)
437:             obj = self.make_forecast(f, plan, packet, selections, meta, candidates)
438:             problems = validate_prediction(obj, packet, calendar=self.market.calendar, experiment_ids=list(self.forecasters))
439:             if problems:
440:                 obj["status"], obj["ranking"], obj["status_reason"] = "invalid", [], "; ".join(problems[:3])
441:             self.store.put(source_id="forecast", dataset=f"{cfg.label}/{name}/{plan.week_id}",
442:                            payload=canonical_bytes({"forecast": obj, "packet_hash": packet.packet_hash()}), url="local://backtest",
443:                            content_type="application/json", extra={"packet_hash": packet.packet_hash(), "packet_capture": pkt_rec.capture_id})
444:             picks[name] = [s.security_id for s in selections] if obj["status"] == "selected" else []
445:             record["forecasters"][name] = {"picks": [{"security_id": p, "symbol": self.market.securities[p].symbol,
446:                                                       "name": self.market.securities[p].name} for p in picks[name]],
447:                                            "forecast_status": obj["status"], "status_reason": obj.get("status_reason"),
448:                                            "training_manifest_id": meta.get("training_manifest_id"), "validation_problems": problems}
449:         if pending:
450:             record["note"] = f"pending_outcome: salida prevista {exit_s.isoformat()} posterior al ├║ltimo dato {self.last_data_day.isoformat()}"
451:             return
452:         open_prices = {sec: m[entry_s].open for sec, m in self.market.by_session.items() if entry_s in m}
453:         close_prices = {sec: m[exit_s].close for sec, m in self.market.by_session.items() if exit_s in m}
454:         intervals: dict[str, IntervalReturn] = {}
455:         for name, lg in self.ledgers.items():
456:             self.apply_actions(name, entry_s)
457:             lg.advance_to(plan.entry_at)
458:             open_marks, stale0 = self.marks(entry_s, lg, "open")
459:             try:
460:                 equity_start = lg.valuation(prices=open_marks, at=plan.entry_at).total
461:             except MissingPrice as exc:
462:                 equity_start = None
463:                 stale0.append(f"missing_open_price:{exc}")
464:             notional = (lg.cash / cfg.slots).to_integral_value(rounding="ROUND_DOWN") if cfg.sizing == "proportional" else D(cfg.notional)
465:             slots = enter_basket(lg, picks=picks[name], slots=cfg.slots, notional_per_slot=notional, open_prices=open_prices,
466:                                  at=plan.entry_at, week_id=plan.week_id)
467:             self.open_slots[name].append((plan.week_id, slots))
468:             open_marks_after, _ = self.marks(entry_s, lg, "open")
469:             try:
470:                 positions_value_open = lg.valuation(prices=open_marks_after, at=plan.entry_at).positions_value
471:             except MissingPrice:
472:                 positions_value_open = None
473:             exposure = (positions_value_open / equity_start) if (equity_start and positions_value_open is not None) else D(0)
474:             self.apply_actions(name, exit_s)
475:             for wid, ss in self.open_slots[name]:
476:                 exit_basket(lg, ss, close_prices=close_prices, at=plan.exit_at, week_id=wid)
477:             self.open_slots[name] = [(wid, ss) for wid, ss in self.open_slots[name]
478:                                      if any(s.status == "exit_blocked" or (s.status == "exited" and not s.liquidated) for s in ss)]
479:             close_marks, stale1 = self.marks(exit_s, lg, "close")
480:             try:
481:                 val = lg.valuation(prices=close_marks, at=plan.exit_at)
482:                 equity_end, flags = val.total, list(val.flags) + stale0 + stale1
483:             except MissingPrice as exc:
484:                 equity_end, flags = None, [f"missing_price:{exc}"] + stale0 + stale1
485:             measurable = (equity_start is not None and equity_end is not None and equity_start > 0
486:                           and positions_value_open is not None and not stale0 and not stale1)
487:             rep = basket_report(plan.week_id, slots, equity_start=equity_start if measurable else self.prev_equity[name],
488:                                 equity_end=equity_end if measurable else self.prev_equity[name])
489:             interval_return = (equity_end / equity_start - 1) if measurable else None
490:             chain_return = (equity_end / self.prev_equity[name] - 1) if equity_end is not None and self.prev_equity[name] else None
491:             invested = sum((s.entry.gross for s in slots if s.entry is not None), D(0))
492:             costs_twd = _week_costs(slots)
493:             pick_returns = {s.security_id: (float(s.gross_pick_return) if s.gross_pick_return is not None else None) for s in slots if s.security_id}
494:             fr = record["forecasters"][name]
495:             for p in fr["picks"]:
496:                 p["gross_return"] = pick_returns.get(p["security_id"])
497:             fr.update({"notional_per_slot": float(notional), "filled": rep.filled_slots, "failed": rep.failed_slots,
498:                        "exit_blocked": rep.exit_blocked_slots, "fail_reasons": [s.reason for s in slots if s.status == "entry_failed"],
499:                        "mean_gross_pick_return": float(rep.mean_gross_pick_return) if rep.mean_gross_pick_return is not None else None,
500:                        "portfolio_net_return_open_close": float(interval_return) if interval_return is not None else None,
501:                        "portfolio_net_return_week_over_week": float(chain_return) if chain_return is not None else None,
502:                        "exposure_at_open": float(exposure), "costs_twd": float(costs_twd),
503:                        "costs_over_invested": float(costs_twd / invested) if invested else None,
504:                        "equity_open": float(equity_start) if equity_start is not None else None,
505:                        "equity_end": float(equity_end) if equity_end is not None else None, "flags": flags[:6],
506:                        "stale_prices": stale0 + stale1, "baskets_in_follow_up": len(self.open_slots[name])})
507:             if measurable and rep.filled_slots > 0:
508:                 intervals[name] = IntervalReturn(label=name, start_at=plan.entry_at, end_at=plan.exit_at, start_price_kind="open",
509:                                                  end_price_kind="close", value=interval_return.quantize(D("0.0000001")),
510:                                                  exposure=exposure.quantize(D("0.0001")), week_id=plan.week_id)
511:             if equity_end is not None:
512:                 self.prev_equity[name] = equity_end
513:         eligible_ids = [c.security_id for c in candidates if c.eligible]
514:         ew = [float(self.market.by_session[s][exit_s].close / self.market.by_session[s][entry_s].open - 1) for s in eligible_ids
515:               if entry_s in self.market.by_session[s] and exit_s in self.market.by_session[s]]
516:         record["universe_ew_gross_open_close"] = statistics.fmean(ew) if ew else None
517:         closure = entry_s not in self.market.traded_days or exit_s not in self.market.traded_days
518:         if closure:
519:             closed = entry_s if entry_s not in self.market.traded_days else exit_s
520:             record["note"] = f"extraordinary_closure_unhandled:{closed.isoformat()}"
521:         base = cfg.baseline
522:         record["paired"] = {}
523:         for name in self.forecasters:
524:             if name == base:
525:                 continue
526:             entry = {"paired": False, "excess_net_vs_baseline": None, "unpaired_reason": None}
527:             if closure:
528:                 entry["unpaired_reason"] = "extraordinary_closure_unhandled"
529:             elif record["forecasters"][name]["stale_prices"] or record["forecasters"][base]["stale_prices"]:
530:                 entry["unpaired_reason"] = "stale_price_in_interval"
531:             elif name in intervals and base in intervals:
532:                 try:
533:                     entry["excess_net_vs_baseline"] = float(paired_excess(intervals[name], intervals[base], exposure_tolerance=cfg.exposure_tolerance))
534:                     entry["paired"] = True
535:                 except IntervalMismatch as exc:
536:                     entry["unpaired_reason"] = f"interval_mismatch:{exc}"
537:             else:
538:                 entry["unpaired_reason"] = "missing_interval:" + ",".join(n for n in (name, base) if n not in intervals)
539:             record["paired"][name] = entry
540: 
541:     # -- todo el periodo -------------------------------------------------------------------------------
542:     def run(self) -> dict:
543:         cfg = self.cfg
544:         for sunday in _sundays(cfg.start, cfg.end):
545:             self.run_week(sunday)
546:         end_at = taipei(cfg.end, time(23, 59))
547:         last_close = self.market.calendar.prev_session(before=min(cfg.end, self.last_data_day) + timedelta(days=1))
548:         final: dict[str, dict] = {}
549:         for name, lg in self.ledgers.items():
550:             self.apply_actions(name, cfg.end)
551:             lg.advance_to(end_at)
552:             prices, stale = self.marks(last_close, lg, "close")
553:             try:
554:                 v = lg.valuation(prices=prices, at=end_at)
555:                 final[name] = {"equity": float(v.total), "cash": float(v.cash), "receivables": float(v.receivables),
556:                                "positions_value": float(v.positions_value), "unresolved": list(v.unresolved), "flags": list(v.flags) + stale,
557:                                "valued_at": end_at.isoformat(), "prices_session": last_close.isoformat(),
558:                                "events_processed_through": self.cursor[name].isoformat()}
559:             except MissingPrice as exc:
560:                 final[name] = {"equity": None, "error": str(exc), "flags": stale, "valued_at": end_at.isoformat()}
561:         operated = [w for w in self.weeks if w["status"] == "valid" and not w.get("pending_outcome")]
562:         summary: dict = {
563:             "label": cfg.label, "period": [cfg.start.isoformat(), cfg.end.isoformat()], "manifest": self.market.source_manifest,
564:             "universe_size": len(self.market.securities), "weeks_total": len(self.weeks), "weeks_operated": len(operated),
565:             "weeks_invalid_no_sessions": sum(1 for w in self.weeks if w["status"] == "invalid:no_sessions"),
566:             "weeks_pending_outcome": [w["week_id"] for w in self.weeks if w.get("pending_outcome")],
567:             "weeks_extraordinary_closure_unhandled": [w["week_id"] for w in self.weeks if str(w.get("note", "")).startswith("extraordinary")],
568:             "bars_without_regular_price_dropped": self.market.dropped_no_regular_price,
569:             "universe_ew": {"mean_weekly_gross_open_close": self._mean(operated, lambda w: w["universe_ew_gross_open_close"])},
570:             "assumptions": {**{k: (str(v) if isinstance(v, D) else (v.isoformat() if isinstance(v, date) else v)) for k, v in asdict(cfg).items()},
571:                             "costs": asdict(self.costs), "price_availability_lag_hours": 24,
572:                             "liquidity_rule": f"mediana(importe 20 sesiones) >= {cfg.liquidity_multiple} x nocional",
573:                             "planning_calendar": f"{self.market.calendar.source_id}@{self.market.calendar.version}"},
574:             "forecasters": {},
575:         }
576:         for name, f in self.forecasters.items():
577:             fw = [w["forecasters"][name] for w in operated]
578:             entry = {
579:                 "model_id": f.model_id, "mean_weekly_net_return_open_close": self._mean(fw, lambda r: r.get("portfolio_net_return_open_close")),
580:                 "mean_weekly_net_return_week_over_week": self._mean(fw, lambda r: r.get("portfolio_net_return_week_over_week")),
581:                 "mean_weekly_gross_pick_return": self._mean(fw, lambda r: r.get("mean_gross_pick_return")),
582:                 "mean_costs_over_invested": self._mean(fw, lambda r: r.get("costs_over_invested")),
583:                 "weeks_positive": sum(1 for r in fw if (r.get("portfolio_net_return_open_close") or 0) > 0),
584:                 "weeks_selected": sum(1 for r in fw if r.get("forecast_status") == "selected"),
585:                 "entry_failures": sum(r.get("failed", 0) for r in fw), "exit_blocked": sum(r.get("exit_blocked", 0) for r in fw),
586:                 "final_equity": final[name]["equity"],
587:                 "total_net_return": (final[name]["equity"] / float(self.initial) - 1) if final[name]["equity"] is not None else None,
588:                 "final_valuation": final[name],
589:                 "open_positions_at_end": [{"security_id": sec, "status": pos.status, "quantity": str(pos.total_quantity),
590:                                            "unresolved_fraction": str(pos.unresolved_fraction)} for sec, pos in sorted(self.ledgers[name].positions.items())],
591:                 "baskets_in_follow_up_at_end": [wid for wid, _ in self.open_slots[name]],
592:             }
593:             if hasattr(f, "history"):
594:                 entry["training_history"] = list(getattr(f, "history"))
595:             if name != cfg.baseline:
596:                 obs = [WeeklyObservation(w["week_id"], f"{name}-{w['week_id']}", EVIDENCE, None, bool(w["paired"][name]["paired"]),
597:                                          w["paired"][name]["excess_net_vs_baseline"]) for w in self.weeks if w["status"] == "valid" and not w.get("pending_outcome")]
598:                 try:
599:                     boot = block_bootstrap_mean(obs, block_length=cfg.block_length, n_boot=cfg.n_boot, seed=cfg.seed)
600:                     entry["paired_excess_vs_baseline"] = {"baseline": cfg.baseline, "mean": boot.mean, "ci95": [boot.ci_low, boot.ci_high],
601:                                                           "n_used": boot.n_used, "n_excluded": boot.n_invalid_excluded,
602:                                                           "block_length": boot.block_length, "n_segments": boot.n_segments,
603:                                                           "resample_mean": boot.resample_mean}
604:                 except Exception as exc:
605:                     entry["paired_excess_vs_baseline"] = {"baseline": cfg.baseline, "error": str(exc)}
606:                 entry["unpaired_reasons"] = dict(collections.Counter((w["paired"][name]["unpaired_reason"] or "").split(":")[0]
607:                                                                      for w in operated if not w["paired"][name]["paired"]))
608:             summary["forecasters"][name] = entry
609:         return {"summary": summary, "weeks": self.weeks}
610: 
611:     @staticmethod
612:     def _mean(rows, getter) -> Optional[float]:
613:         xs = [getter(r) for r in rows]
614:         xs = [x for x in xs if x is not None]
615:         return statistics.fmean(xs) if xs else None
