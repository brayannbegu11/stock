274: class Runner:
275:     def __init__(self, store: RawStore, market: MarketData, cfg: BacktestConfig, forecasters: Sequence[Forecaster]) -> None:
276:         self.store, self.market, self.cfg = store, market, cfg
277:         self.forecasters = {f.name: f for f in forecasters}
278:         if cfg.baseline not in self.forecasters:
279:             raise ValueError(f"baseline {cfg.baseline!r} is not among the forecasters")
280:         costs = CostModel(commission_per_side=cfg.commission_per_side, sell_tax=cfg.sell_tax, slippage_bps_per_side=cfg.slippage_bps)
281:         self.costs = costs
282:         self.initial = D(cfg.notional * cfg.slots)
283:         self.ledgers = {n: PaperLedger(ledger_id=n, initial_cash=self.initial, cost_model=costs) for n in self.forecasters}
284:         self.open_slots: dict[str, list] = {n: [] for n in self.forecasters}
285:         self.prev_equity = {n: self.initial for n in self.forecasters}
286:         self.cursor = {n: cfg.start - timedelta(days=1) for n in self.forecasters}
287:         self.weeks: list[dict] = []
288:         self.last_data_day = max(market.traded_days) if market.traded_days else cfg.start
289: 
290:     # -- precios y eventos --------------------------------------------------------------------------
291:     def marks(self, session: date, ledger: PaperLedger, kind: str) -> tuple[dict[str, D], list[str]]:
292:         out, stale = {}, []
293:         for sec, pos in ledger.positions.items():
294:             if pos.status.startswith("delisted"):
295:                 continue
296:             b = self.market.by_session.get(sec, {}).get(session)
297:             if b is None:
298:                 prev = [x for x in self.market.securities[sec].bars if x.session <= session]
299:                 if prev:
300:                     out[sec] = prev[-1].close
301:                     stale.append(f"stale_price:{sec}:{prev[-1].session.isoformat()}")
302:             else:
303:                 out[sec] = b.open if kind == "open" else b.close
304:         return out, stale
305: 
306:     def apply_actions(self, name: str, upto: date) -> int:
307:         ledger = self.ledgers[name]
308:         since = self.cursor[name]
309:         if upto <= since:
310:             return 0
311:         events = []
312:         for sec in list(ledger.positions):
313:             s = self.market.securities[sec]
314:             for dv in s.dividends:
315:                 for kind, exd in (("cash", dv.cash_ex_date), ("stock", dv.stock_ex_date)):
316:                     if exd is not None and since < exd <= upto:
317:                         events.append((exd, kind, sec, dv))
318:             if s.delisting_date and since < s.delisting_date <= upto:
319:                 events.append((s.delisting_date, "delisting", sec, None))
320:         n = 0
321:         for exd, kind, sec, dv in sorted(events, key=lambda e: (e[0], e[1])):
322:             at = taipei(exd, PRE_OPEN)
323:             try:
324:                 if kind == "cash" and dv.cash_per_share > 0:
325:                     pay = taipei(dv.cash_pay_date, time(9, 0)) if dv.cash_pay_date else None
326:                     ledger.apply_corporate_action(CorporateAction(f"{sec}:cash:{exd}:{dv.period}", sec, "cash_dividend", at,
327:                                                                   per_share_cash=dv.cash_per_share, pay_at=pay))
328:                 elif kind == "stock" and dv.stock_per_share > 0:
329:                     ledger.apply_corporate_action(CorporateAction(f"{sec}:stock:{exd}:{dv.period}", sec, "stock_dividend", at,
330:                                                                   stock_ratio=dv.stock_per_share / self.cfg.par_value))
331:                 elif kind == "delisting":
332:                     ledger.apply_corporate_action(CorporateAction(f"{sec}:delisting:{exd}", sec, "delisting", at, terminal_price=None))
333:                 else:
334:                     continue
335:                 n += 1
336:             except LedgerError as exc:
337:                 self.weeks[-1].setdefault("action_errors", []).append(f"{name}:{sec}:{kind}:{exd}:{exc}")
338:         self.cursor[name] = upto
339:         return n
340: 
341:     # -- paquete y candidatos ------------------------------------------------------------------------
342:     def build_week_packet(self, plan: WeekPlan) -> tuple[Packet, object, list[Candidate]]:
343:         cutoff = plan.cutoff_at
344:         docs = []
345:         for sec_id, s in self.market.securities.items():
346:             known = [b for b in s.bars if b.available_at <= cutoff]
347:             if not known:
348:                 continue
349:             docs.append(Document(
350:                 doc_id=f"{s.symbol}:bars:{plan.week_id}", kind="price_bar_series", source_id="finmind", security_ids=(sec_id,),
351:                 available_at=known[-1].available_at, availability_quality=AvailabilityQuality.CONSERVATIVE_INFERENCE,
352:                 capture_id=s.price_capture.capture_id, source_sha256=s.price_capture.sha256, derivation="finmind_price_bars_v1",
353:                 payload={"history_sessions": len(known), "last_session": known[-1].session.isoformat(),
354:                          "sessions": [[b.session.isoformat(), str(b.open), str(b.close), b.volume_shares, str(b.value_twd)] for b in known[-130:]]},
355:             ))
356:         packet = build_packet(packet_id=f"pkt-{self.cfg.label}-{plan.week_id}", cutoff_at=cutoff, documents=docs, mode="historical",
357:                               evidence_class=EVIDENCE, calendar=self.market.calendar)
358:         rec = self.store.put(source_id="packet", dataset=f"{self.cfg.label}/{plan.week_id}", payload=packet_to_json(packet),
359:                              url="local://backtest", content_type="application/json",
