"""Comparaciones emparejadas e incertidumbre por bloques de semanas.

Corrección ronda 1 (R01-21): una comparación sólo es emparejada si comparte
extremos temporales, tipo de precio, exposición, moneda y tratamiento de
costes. La unidad estadística es la semana (STA-01): el bootstrap recibe
observaciones semanales identificadas, únicas, ordenadas y de una sola
clase de evidencia; las corridas inválidas se cuentan, no se ocultan (STA-04).
"""
from __future__ import annotations

import random
from dataclasses import dataclass
from datetime import datetime
from decimal import Decimal
from typing import Optional, Sequence

from .timeutil import to_utc


class IntervalMismatch(ValueError):
    pass


class ObservationError(ValueError):
    pass


@dataclass(frozen=True)
class IntervalReturn:
    label: str
    start_at: datetime
    end_at: datetime
    start_price_kind: str   # open | close
    end_price_kind: str     # open | close
    value: Decimal
    exposure: Decimal       # fracción del patrimonio invertida en el intervalo (0..1)
    currency: str = "TWD"
    net_of_costs: bool = True
    week_id: Optional[str] = None

    def pairing_key(self) -> tuple:
        return (to_utc(self.start_at), to_utc(self.end_at), self.start_price_kind, self.end_price_kind,
                self.exposure, self.currency, self.net_of_costs, self.week_id)


def paired_excess(a: IntervalReturn, b: IntervalReturn) -> Decimal:
    """SIM-12 / R01-21: sólo se restan rentabilidades estrictamente comparables."""
    if a.pairing_key() != b.pairing_key():
        raise IntervalMismatch(f"{a.label} {a.pairing_key()} vs {b.label} {b.pairing_key()}")
    return a.value - b.value


@dataclass(frozen=True)
class WeeklyObservation:
    week_id: str            # p. ej. 2026-W37 (semana ISO del lunes de entrada)
    forecast_id: str
    evidence_class: str
    sealed: bool            # predicción con recibo temporal verificado
    valid_run: bool         # False → corrida inválida/tardía; se cuenta pero no se usa
    value: Optional[float]  # exceso neto emparejado; None si la corrida no es válida


@dataclass(frozen=True)
class BootstrapResult:
    mean: float
    ci_low: float
    ci_high: float
    n_used: int
    n_invalid_excluded: int
    block_length: int
    seed: int
    evidence_class: str


def block_bootstrap_mean(
    observations: Sequence[WeeklyObservation],
    *,
    block_length: int,
    n_boot: int,
    seed: int,
    require_sealed: bool = False,
) -> BootstrapResult:
    """Media y percentiles 2,5/97,5 con bootstrap por bloques móviles sobre semanas.

    ``block_length`` no tiene valor por defecto: es un bloqueante del protocolo
    (``statistics.bootstrap_block_length``) y debe fijarse antes de mirar la reserva.
    """
    if not observations:
        raise ObservationError("no observations")
    ids = [o.week_id for o in observations]
    if len(set(ids)) != len(ids):
        raise ObservationError("duplicate week_id: the statistical unit is the week (STA-01)")
    if ids != sorted(ids):
        raise ObservationError("observations must be in chronological order for block bootstrap")
    classes = {o.evidence_class for o in observations}
    if len(classes) != 1:
        raise ObservationError(f"mixed evidence classes are not one sample: {sorted(classes)}")
    if require_sealed and not all(o.sealed for o in observations):
        raise ObservationError("unsealed forecasts cannot enter a prospective evaluation")
    valid = [o for o in observations if o.valid_run and o.value is not None]
    n_invalid = len(observations) - len(valid)
    values = [float(o.value) for o in valid]  # type: ignore[arg-type]
    n = len(values)
    if n == 0:
        raise ObservationError("no valid runs")
    if block_length < 1 or block_length > n:
        raise ObservationError("block_length must be within 1..n_valid")
    rng = random.Random(seed)
    starts = n - block_length + 1
    means: list[float] = []
    for _ in range(n_boot):
        sample: list[float] = []
        while len(sample) < n:
            s = rng.randrange(starts)
            sample.extend(values[s:s + block_length])
        sample = sample[:n]
        means.append(sum(sample) / n)
    means.sort()
    lo = means[int(0.025 * (n_boot - 1))]
    hi = means[int(0.975 * (n_boot - 1))]
    return BootstrapResult(sum(values) / n, lo, hi, n, n_invalid, block_length, seed, classes.pop())
"""Cesta semanal de hasta cinco puestos de igual peso (PROTOCOLO.yaml weekly_experiment).

Correcciones ronda 1 (Astra): la salida vende la posición vigente en el
libro, no las acciones de entrada, para respetar acciones corporativas
(R01-09); un puesto con salida bloqueada puede reintentarse tras la
reanudación (R01-10); las selecciones repetidas se rechazan (R01-19).
"""
from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from decimal import ROUND_DOWN, Decimal
from typing import Mapping, Optional, Sequence

from .ledger import Fill, PaperLedger, Rejection

D = Decimal


@dataclass
class Slot:
    rank: int
    security_id: Optional[str]
    status: str                      # filled | entry_failed | empty | exited | exit_blocked
    reason: str = ""
    entry: Optional[Fill] = None
    exit: Optional[Fill] = None
    notes: list[str] = field(default_factory=list)

    @property
    def gross_pick_return(self) -> Optional[Decimal]:
        """Rentabilidad bruta de la selección sobre importes de referencia (respeta splits)."""
        if self.entry and self.exit and self.entry.gross:
            return self.exit.gross / self.entry.gross - 1
        return None


def enter_basket(
    ledger: PaperLedger,
    *,
    picks: Sequence[str],
    slots: int,
    notional_per_slot: Decimal,
    open_prices: Mapping[str, Decimal],
    at: datetime,
    week_id: str,
    eligibility: Optional[Mapping[str, tuple[bool, str]]] = None,
) -> list[Slot]:
    """Entra en cada selección con importe nocional fijo por puesto.

    Un puesto fallido conserva su efectivo (SIM-09); no se redistribuye a los
    demás. Los puestos sin selección quedan en efectivo
    (``fill_unavailable_slots_with_cash``).
    """
    if len(picks) > slots:
        raise ValueError(f"{len(picks)} picks exceed {slots} slots")
    if len(set(picks)) != len(picks):
        raise ValueError(f"duplicate selections are not allowed: {list(picks)}")
    out: list[Slot] = []
    for rank in range(1, slots + 1):
        if rank > len(picks):
            out.append(Slot(rank, None, "empty", "no_selection"))
            continue
        sid = picks[rank - 1]
        if eligibility is not None:
            ok, why = eligibility.get(sid, (False, "not_in_eligibility_table"))
            if not ok:
                out.append(Slot(rank, sid, "entry_failed", f"ineligible:{why}"))
                continue
        price = open_prices.get(sid)
        if price is None:
            out.append(Slot(rank, sid, "entry_failed", "no_open_price"))
            continue
        price = D(price)
        unit_cost = price * (1 + ledger.costs.slippage) * (1 + ledger.costs.commission_per_side)
        lots = int((D(notional_per_slot) / (unit_cost * ledger.lot_size)).to_integral_value(rounding=ROUND_DOWN))
        shares = lots * ledger.lot_size
        if shares <= 0:
            out.append(Slot(rank, sid, "entry_failed", "notional_below_one_lot"))
            continue
        res = ledger.buy(security_id=sid, price=price, shares=shares, at=at, event_id=f"{week_id}:entry:{rank}:{sid}")
        if isinstance(res, Rejection):
            out.append(Slot(rank, sid, "entry_failed", res.reason))
        else:
            out.append(Slot(rank, sid, "filled", entry=res))
    return out


def exit_basket(
    ledger: PaperLedger,
    slots: Sequence[Slot],
    *,
    close_prices: Mapping[str, Decimal],
    at: datetime,
    week_id: str,
) -> list[Slot]:
    for s in slots:
        if s.status not in ("filled", "exit_blocked") or s.entry is None or s.security_id is None:
            continue
        pos = ledger.positions.get(s.security_id)
        if pos is None:
            s.status = "exit_blocked"
            s.reason = "position_not_in_ledger"
            continue
        price = close_prices.get(s.security_id)
        if price is None:
            s.status = "exit_blocked"
            s.reason = "no_close_price"
            continue
        sellable = (pos.shares // ledger.lot_size) * ledger.lot_size
        if sellable <= 0:
            s.status = "exit_blocked"
            s.reason = "odd_lot_remainder_only"
            continue
        attempt = sum(1 for n in s.notes if n.startswith("exit_attempt_blocked"))
        res = ledger.sell(security_id=s.security_id, price=D(price), shares=sellable, at=at,
                          event_id=f"{week_id}:exit:{s.rank}:{s.security_id}:attempt{attempt}")
        if isinstance(res, Rejection):
            s.status = "exit_blocked"
            s.reason = res.reason
            s.notes.append(f"exit_attempt_blocked:{res.reason}@{at.isoformat()}")
        else:
            s.status = "exited"
            s.exit = res
            if pos.shares:
                s.notes.append(f"odd_lot_remainder:{pos.shares}")
    return list(slots)


@dataclass(frozen=True)
class BasketReport:
    week_id: str
    filled_slots: int
    empty_slots: int
    failed_slots: int
    exit_blocked_slots: int
    mean_gross_pick_return: Optional[Decimal]   # media de selecciones ejecutadas, bruta
    portfolio_net_return: Decimal               # (patrimonio_fin - patrimonio_ini)/patrimonio_ini


def basket_report(week_id: str, slots: Sequence[Slot], *, equity_start: Decimal, equity_end: Decimal) -> BasketReport:
    """SIM-11: la media de las selecciones no es la rentabilidad de la cartera."""
    rets = [s.gross_pick_return for s in slots if s.gross_pick_return is not None]
    mean = (sum(rets, D(0)) / len(rets)) if rets else None
    return BasketReport(
        week_id=week_id,
        filled_slots=sum(1 for s in slots if s.status in ("filled", "exited", "exit_blocked")),
        empty_slots=sum(1 for s in slots if s.status == "empty"),
        failed_slots=sum(1 for s in slots if s.status == "entry_failed"),
        exit_blocked_slots=sum(1 for s in slots if s.status == "exit_blocked"),
        mean_gross_pick_return=mean,
        portfolio_net_return=(D(equity_end) - D(equity_start)) / D(equity_start),
    )
