    assert p.admitted_ids() == {"us-thu"}
    assert rejected_reasons(p)["us-fri"] == R_AVAILABLE_AFTER_CUTOFF


def test_pit09_scheduled_event_admitted_outcome_rejected(sunday_cutoff):
