diff --git a/review/out/astra_scratch/test_ronda2.py b/review/out/astra_scratch/test_ronda2.py
new file mode 100644
index 0000000000000000000000000000000000000000..898df719564b3e4fe05a040db71a8871861f4bc3
--- /dev/null
+++ b/review/out/astra_scratch/test_ronda2.py
@@ -0,0 +1,204 @@
+import sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
+
+from dataclasses import replace
+from datetime import date, datetime, time, timedelta
+from decimal import Decimal as D
+import pytest
+from tests.test_ledger import MON, FRI, FREE, ledger
+from tests.test_master import R, sv
+from tests.test_packet import doc, build
+from tests.test_schema import base, packet
+from twlab.packet import build_packet
+from twlab.store import RawStore, CaptureRecord
+from twlab.ledger import CorporateAction, LedgerError
+from twlab.master import SecurityMaster
+from twlab.calendar import TradingCalendar, CalendarStore, classify_holiday_row, ROW_SESSION_MARKER, ROW_UNKNOWN
+from twlab.schemas import validate_prediction
+from twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError
+
+
+def test_packet_duplicate_ids_cannot_hide_delivered_content():
+    a = doc('same', MON, payload={'value': 1})
+    b = doc('same', MON, payload={'value': 999})
+    p = build([a, b], FRI)
+    q = build([b], FRI)
+    assert p.packet_hash() != q.packet_hash(), (len(p.admitted), len(q.admitted))
+
+
+def test_prospective_nested_payload_survives_capture_binding(tmp_path):
+    rec = RawStore(tmp_path).put(source_id='test', dataset='d', payload=b'{"nested":{"value":1}}', url='u')
+    d = doc('d', rec.ingested_at_dt, capture_id=rec.capture_id, payload={'nested': {'value': 1}})
+    p = build_packet(packet_id='p', cutoff_at=rec.ingested_at_dt, documents=[d], mode='prospective',
+                     evidence_class='prospective_registered', captures={rec.capture_id: rec})
+    assert p.admitted_ids() == {'d'}
+
+
+def test_capture_from_other_source_cannot_attest_document(tmp_path):
+    rec = RawStore(tmp_path).put(source_id='weather', dataset='rain', payload=b'{"rain":0}', url='u')
+    d = doc('revenue', rec.ingested_at_dt, capture_id=rec.capture_id, payload={'revenue': 999})
+    p = build_packet(packet_id='p', cutoff_at=rec.ingested_at_dt, documents=[d], mode='prospective',
+                     evidence_class='prospective_registered', captures={rec.capture_id: rec})
+    assert not p.admitted, (p.admitted[0].source_id, rec.source_id)
+
+
+def test_registered_prediction_requires_verified_receipt_and_matching_evidence():
+    o = base(evidence_class='prospective_registered', independent_timestamp_receipt_id='inventado')
+    assert validate_prediction(o, packet()), 'historical packet + imaginary seal accepted'
+
+
+def test_selected_cannot_extend_its_own_deadline():
+    o = base(issued_at='2026-09-12T10:00:00+08:00', deadline_at='2026-09-13T08:30:00+08:00')
+    assert validate_prediction(o, packet()), 'forecast after weekly close accepted'
+
+
+def test_known_calibrator_requires_temporal_evidence():
+    o = base()
+    o['ranking'][0].update(calibrated_probability=0.9, calibration_model_id='trained-2027')
+    assert validate_prediction(o, packet(), known_calibrators=frozenset({'trained-2027'}))
+
+
+def test_real_archive_is_readable_by_current_store():
+    store = RawStore(Path(__file__).resolve().parents[3] / 'data' / 'raw')
+    assert store.captures()
+    assert store.verify() == []
+
+
+def test_verified_receipt_state_cannot_be_forged_on_record(tmp_path):
+    rec = RawStore(tmp_path).put(source_id='s', dataset='d', payload=b'x', url='u')
+    fake = replace(rec, receipt={'receipt_id': 'inventado', 'authority': 'yo', 'digest': rec.sha256,
+        'status': 'verified', 'attested_at': 'not-a-date'})
+    assert not fake.prospectively_sealed
+
+
+def test_master_change_segment_is_atomic():
+    m = SecurityMaster()
+    m.add(sv(security_id='A', symbol='1111', valid_from=date(2020, 1, 1)))
+    before = m.versions_of('A')
+    new = sv(security_id='A', symbol='2222', valid_from=date(2022, 1, 1), valid_to=date(2021, 1, 1))
+    with pytest.raises(ValueError):
+        m.change_segment('A', new=new, recorded_at=R(2022, 1, 1), source_id='s')
+    assert m.versions_of('A') == before
+
+
+def test_master_no_historical_overlap_when_new_row_predates_closure():
+    m = SecurityMaster()
+    m.add(sv(security_id='A', symbol='1111', valid_from=date(2020, 1, 1)))
+    m.close_version('A', valid_to=date(2022, 1, 1), recorded_at=R(2022, 1, 1), source_id='s')
+    m.add(sv(security_id='A', symbol='2222', valid_from=date(2022, 1, 1), recorded_at=R(2021, 1, 1)))
+    segs = m._effective(R(2021, 6, 1))
+    assert sum(v.covers(date(2023, 1, 1)) for v in segs) <= 1
+
+
+def bought():
+    lg = ledger(costs=FREE)
+    lg.buy(security_id='A', price=D(100), shares=1000, at=MON, event_id='b')
+    return lg
+
+
+def test_reverse_split_preserves_fraction_without_inventing_shares():
+    lg = bought()
+    lg.apply_corporate_action(CorporateAction('rs', 'A', 'split', FRI, split_ratio=D('0.0005')))
+    p = lg.positions['A']
+    assert D(p.shares) + p.unresolved_fraction == D('0.5'), p
+
+
+def test_fraction_remains_pending_after_sale_of_all_whole_shares():
+    lg = bought()
+    lg.apply_corporate_action(CorporateAction('sd', 'A', 'stock_dividend', FRI, stock_ratio=D('0.0005')))
+    lg.sell(security_id='A', price=D(100), shares=1000, at=FRI, event_id='s')
+    v = lg.valuation(prices={}, at=FRI)
+    assert v.flags or v.unresolved, (v, lg.closed)
+
+
+def test_missing_payment_date_never_creates_spendable_cash():
+    lg = bought()
+    before = lg.cash
+    lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', FRI, per_share_cash=D('2.5')))
+    assert lg.available_cash() == before
+
+
+def test_future_valuation_cannot_rewrite_past_stale_price():
+    lg = bought()
+    lg.valuation(prices={'A': D(999)}, at=FRI)
+    try:
+        lg.mark_suspended('A', at=MON + timedelta(days=1))
+    except LedgerError:
+        return
+    v = lg.valuation(prices={}, at=MON + timedelta(days=1))
+    assert v.positions_value == D(100000), v
+
+
+def test_receivable_payments_are_logged_chronologically():
+    lg = bought()
+    for event_id, effective, payment in [('d1', MON, MON + timedelta(days=4)),
+                                         ('d2', MON + timedelta(days=1), MON + timedelta(days=3))]:
