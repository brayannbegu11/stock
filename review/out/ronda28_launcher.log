[31;1mdef project_status(scenarios: list[dict]) -> dict:[0m
[31;1m    """Fase del proyecto derivada de los artefactos: 1 construir, 2 probar con el pasado, 3 predecir cada semana, 4 decidir.[0m
[31;1m[0m
[31;1m    La fase 3 empieza cuando existe al menos una semana cuya lista se archivó antes del plazo (reloj del sistema);[0m
[31;1m    hasta entonces la primera lista prospectiva posible es la del siguiente corte dominical posterior a la última[0m
[31;1m    semana pendiente."""[0m
[31;1m    prospective = sorted({w for sc in scenarios for w in sc.get("prospective_weeks", [])})[0m
[31;1m    pending = sorted({w["week_id"] for sc in scenarios for w in sc["weeks"] if w["pending_outcome"]})[0m
[31;1m    backtested = max((sc["weeks_operated"] for sc in scenarios), default=0)[0m
[31;1m    next_cutoff = None[0m
[31;1m    if scenarios:[0m
[31;1m        last = max(datetime.fromisoformat(w["cutoff_at"]) for sc in scenarios for w in sc["weeks"])[0m
[31;1m        nxt = last + timedelta(days=7)[0m
[31;1m        now = datetime.now(timezone.utc)[0m
[31;1m        while nxt <= now:                       # instante completo del corte (18:00 Taipei), no la fecha UTC (R20-07)[0m
[31;1m            nxt += timedelta(days=7)[0m
[31;1m        next_cutoff = nxt.date().isoformat()[0m
[31;1m    phase = 3 if prospective else (2 if backtested else 1)[0m
[31;1m    return {"phase": phase, "phases_total": 4, "prospective_weeks": prospective, "prospective_count": len(prospective),[0m
[31;1m            "pending_weeks": pending, "backtested_weeks": backtested, "next_cutoff": next_cutoff,[0m
[31;1m            "weekly_pipeline": "scripts/weekly_prospective.ps1", "external_timestamp": False,[0m
[31;1m            "prospective_mode_admission": False}[0m
[31;1m[0m
[31;1m[0m
[31;1mdef inline_into_index(payload: str) -> bool:[0m
[31;1m    if not INDEX.exists():[0m
[31;1m        return False[0m
[31;1m    html = INDEX.read_text(encoding="utf-8")[0m
[31;1m    pat = re.compile(r'(<script type="application/json" id="site-data">)(.*?)(</script>)', re.S)[0m
[31;1m    if not pat.search(html):[0m
