[31;1m  -o $last `[0m
[31;1m  - 2>&1 | Tee-Object -FilePath $log[0m
[31;1m[0m
[31;1m$after = Get-TreeHashes[0m
[31;1m$diff = Compare-Object -ReferenceObject $before -DifferenceObject $after[0m
[31;1mif ($diff) {[0m
