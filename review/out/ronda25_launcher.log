      "prueba_propuesta": "import pytest\nfrom review.out.astra_scratch.test_r23 import setup\nfrom twlab.packet import packet_from_json\n\n@pytest.mark.parametrize('target', ['packet', 'source'])\ndef test_integridad_no_se_hereda_de_la_cache(tmp_path, monkeypatch, target):\n    raw, market, data, ex, week = setup(tmp_path, monkeypatch)\n    rec = raw.get(week['packet_capture'])\n    if target == 'source':\n        packet = packet_from_json(raw.read(rec))\n        rec = raw.get(packet.admitted[0].capture_id)\n    (raw.root / rec.path).write_bytes(b'corrupt')\n    cached = ex.classify_week('lab', week)\n    ex._INPUTS_CACHE.clear()\n    assert ex.classify_week('lab', week)['prospective'] is False\n    assert cached['prospective'] is False\n",
