      "prueba_propuesta": "from dataclasses import replace\nfrom review.out.astra_scratch.test_r23 import setup, classify, rearchive_packet\nfrom twlab.packet import packet_from_json\n\ndef test_serie_no_declara_identidades_desconocidas(tmp_path, monkeypatch):\n    raw, market, data, ex, week = setup(tmp_path, monkeypatch)\n    packet = packet_from_json(raw.read(raw.get(week['packet_capture'])))\n    ghost = 'TWSE:GHOST@2000-01-01'\n    docs = tuple(replace(d, security_ids=d.security_ids + (ghost,)) if d.kind == 'price_bar_series' else d for d in packet.admitted)\n    rearchive_packet(raw, data, replace(packet, admitted=docs))\n    assert classify(ex, week)['prospective'] is False\n",
