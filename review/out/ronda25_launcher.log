      "prueba_propuesta": "from review.out.astra_scratch.test_r23 import setup, classify\nfrom review.out.astra_scratch.test_r24 import rows_of\nfrom review.out.astra_scratch.test_r25 import change_master\n\ndef test_kind_malformado_invalida_la_instantanea(tmp_path, monkeypatch):\n    raw, market, data, ex, week = setup(tmp_path, monkeypatch)\n    rows = rows_of(raw, week)\n    rows.append({'kind': [], 'security_id': 'TWSE:GHOST@2000-01-01', 'valid_to': '2024-01-07'})\n    change_master(raw, week, rows)\n    result = classify(ex, week)\n    assert result['prospective'] is False\n    assert any(r.startswith('master_contract:') for r in result['reasons'])\n",
