[31;1m    slippage_bps_per_side: int = 0[0m
[31;1m    rounding: str = "floor"               # floor | half_up; política declarada, a confirmar con el bróker[0m
[31;1m    label: str = "illustrative_not_contracted"[0m
[31;1m    min_commission_twd: Decimal = D(0)    # comisión mínima por orden (habitual: 20 TWD); pesa en órdenes pequeñas (lotes sueltos)[0m
[31;1m[0m
[31;1m    def commission(self, executed: Decimal) -> Decimal:[0m
[31;1m        if executed <= 0:[0m
