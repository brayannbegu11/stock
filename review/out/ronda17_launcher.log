[31;1m[0m
[31;1m[0m
[31;1mdef is_weekly_cutoff(cutoff_at: datetime) -> bool:[0m
[31;1m    local = to_utc(cutoff_at).astimezone(TAIPEI)[0m
[31;1m    return local.weekday() == 6 and local.time() == WEEKLY_CUTOFF_TIME[0m
[31;1m[0m
[31;1m[0m
[31;1mdef target_monday_for(cutoff_at: datetime) -> date:[0m
[31;1m    """Lunes de la semana natural que empieza después del corte (en hora de Taipei)."""[0m
[31;1m    local = to_utc(cutoff_at).astimezone(TAIPEI)[0m
[31;1m    d = local.date() + timedelta(days=1)[0m
[31;1m    return d - timedelta(days=d.weekday())[0m
[31;1m[0m
[31;1m[0m
[31;1mdef plan_week(cutoff_at: datetime, calendar: TradingCalendar) -> WeekPlan:[0m
