[31;1m    deadline = taipei(sessions[0], WEEKLY_DEADLINE_TIME)[0m
[31;1m    entry_sessions = [s for s in sessions if to_utc(calendar.session_open(s)) > to_utc(deadline)][0m
[31;1m    if not entry_sessions:[0m
[31;1m        return WeekPlan(week_id, monday, cutoff_at, STATUS_NO_SESSIONS, sessions, deadline, None, None)[0m
[31;1m    return WeekPlan([0m
[31;1m        week_id, monday, cutoff_at, STATUS_VALID, sessions,[0m
[31;1m        deadline_at=deadline,[0m
[31;1m        entry_at=calendar.session_open(entry_sessions[0]),[0m
[31;1m        exit_at=calendar.session_close(sessions[-1]),[0m
[31;1m    )[0m
[31;1m[0m
[31;1m[0m
[31;1mdef weekly_deadline(cutoff_at: datetime, calendar: TradingCalendar) -> datetime:[0m
