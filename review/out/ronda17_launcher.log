[31;1m@dataclass(frozen=True)[0m
[31;1mclass WeekPlan:[0m
[31;1m    week_id: str                   # semana ISO objetivo, p. ej. 2026-W37[0m
[31;1m    target_monday: date[0m
[31;1m    cutoff_at: datetime[0m
