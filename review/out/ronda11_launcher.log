      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner, stock_div, date, timedelta\n\ndef test_invalid_week_obeys_requested_end(tmp_path):\n    closures = [date(2024,1,15) + timedelta(days=i) for i in range(5)]\n    dividends = [stock_div('2024-01-10', 5), {'stock_id':'A', 'year':'2024', 'CashExDividendTradingDate':'2024-01-18', 'CashEarningsDistribution':2}]\n    r = runner(tmp_path, end='2024-01-26', config_end='2024-01-16', closures=closures, dividends=dividends)\n    r.run()\n    assert r.cursor['Q0'] <= date(2024,1,16)\n    assert all(e.at.date() <= date(2024,1,16) for e in r.ledgers['Q0'].events)\n\n# Calcular el límite antes de bifurcar por validez del plan; diferir la consulta del cierre hasta comprobarlo.",
