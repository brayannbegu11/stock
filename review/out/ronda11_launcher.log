[31;1mdef test_r09_12_segment_weights_are_preserved_when_segments_are_shorter_than_the_block():[0m
[31;1m    # tramos de 1 y 8 (valores 1 y 0): media 1/9; con bloque 4 una extracciÃ³n del tramo corto aporta 1 observaciÃ³n y[0m
[31;1m    # una del largo 4, asÃ­ que el tramo corto debe elegirse con probabilidad âˆ 1/1 frente a 8/4.[0m
[31;1m    # Remuestreo estratificado (ronda 10): cada tramo aporta exactamente su longitud â†’ el peso es exacto, no aproximado.[0m
[31;1m    rows = [obs("2026-W20", 1.0)] + [obs(f"2026-W{w}", 0.0) for w in range(22, 30)][0m
