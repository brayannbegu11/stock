      "prueba_propuesta": "from dataclasses import replace\nfrom review.out.astra_scratch.r10_support import fixture, date, time, taipei, D, TradingCalendar\nfrom twlab.models import q1\n\ndef test_calendar_change_invalidates_rows(tmp_path):\n    _, m = fixture(tmp_path, end='2024-01-19')\n    cal = TradingCalendar(start=date(2021,1,1), end=date(2026,12,31), closures=[date(2024,1,12)], source_id='revised', recorded_at=taipei(date(2021,1,1)))\n    revised = replace(m, calendar=cal)\n    bars = {s.security_id: [replace(b, close=D(110)) if b.session == date(2024,1,12) else b for b in s.bars] for s in m.securities.values()}\n    cuts = [taipei(date(2024,1,7), time(18))]\n    now = taipei(date(2024,1,14), time(18))\n    cache = {}\n    q1.build_training_rows(bars, cuts, now_cutoff=now, calendar=m.calendar, cache=cache, data_version=m.data_version)\n    cached = q1.build_training_rows(bars, cuts, now_cutoff=now, calendar=cal, cache=cache, data_version=revised.data_version)\n    fresh = q1.build_training_rows(bars, cuts, now_cutoff=now, calendar=cal, data_version=revised.data_version)\n    assert cached == fresh",
