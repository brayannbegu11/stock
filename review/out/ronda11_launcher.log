      "prueba_propuesta": "import pytest\nfrom review.out.astra_scratch.r10_support import fixture, date, time, taipei\nfrom twlab.backtest import TabularForecaster\n\ndef test_strictly_increasing_cutoffs(tmp_path):\n    _, market = fixture(tmp_path)\n    f = TabularForecaster(market, min_weeks=1)\n    cutoff = taipei(date(2024,1,7), time(18))\n    f.maybe_train(cutoff)\n    with pytest.raises(ValueError):\n        f.maybe_train(cutoff)\n\n# Alternativa: documentar y probar una operación idempotente para cortes iguales.",
