[31;1m                      coverage_reasons=dict(collections.Counter(r.split(":")[0] for c in candidates for r in c.reasons)),[0m
[31;1m                      pending_outcome=pending_exit)[0m
[31;1m        picks: dict[str, list[str]] = {}[0m
[31;1m        for name, f in self.forecasters.items():[0m
