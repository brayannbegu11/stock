      "prueba_propuesta": "import pytest\nfrom review.out.astra_scratch.test_r11_attacks import endpoints\nfrom review.out.astra_scratch.r10_support import date, D\nfrom twlab.models import q1\n\ndef test_cash_after_stock_uses_updated_quantity():\n    a, b, bars = endpoints()\n    ds = [q1.DividendLike(date(2024,1,9), stock_ratio=D(1)), q1.DividendLike(date(2024,1,11), cash_per_share=D(10))]\n    assert q1.weekly_label(bars, a.session, b.session, ds)[0] == pytest.approx(.2)\n\n# Procesar eventos cronológicamente, preservando la base anterior para derechos simultáneos.",
