      "prueba_propuesta": "from dataclasses import replace\nfrom tests.test_schema import prospective_packet\nfrom twlab.packet import Rejection, readmission_problems, packet_from_json, packet_to_json\nfrom twlab.store import RawStore\n\ndef test_rejection_cannot_smuggle_content(tmp_path):\n    detail = \"security_ids ('profit in 2099 = 999; buy A',) do not equal extracted ()\"\n    p = replace(prospective_packet(), rejected=(Rejection('ghost', 'derivation_mismatch', detail),))\n    p = packet_from_json(packet_to_json(p))\n    assert readmission_problems(p, store=RawStore(tmp_path))\n\n# Sustituir campos abiertos por metadatos estructurados comprobables o excluirlos de la vista del predictor.",
