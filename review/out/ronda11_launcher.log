[31;1m_ISO = r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.+\-]+"[0m
[31;1m_ID = r"[A-Za-z0-9_:.@/\-]+"[0m
[31;1m_REJECTION_DETAIL_TEMPLATES: dict[str, tuple[str, ...]] = {[0m
[31;1m    R_UNKNOWN_AVAILABILITY: (r"availability could not be established",),[0m
[31;1m    R_INCONSISTENT_METADATA: (rf"published_at={_ISO} later than available_at={_ISO}", rf"first_seen_at={_ISO} != capture ingested_at={_ISO}"),[0m
[31;1m    R_AVAILABLE_AFTER_CUTOFF: (rf"available_at={_ISO} > cutoff={_ISO}",),[0m
[31;1m    R_NO_CAPTURE_EVIDENCE: (r"document is not linked to a RawStore capture",),[0m
[31;1m    R_SYNTHETIC_CAPTURE: (rf"capture clock_source={_ID}",),[0m
[31;1m    R_PROVENANCE_MISMATCH: (rf"document source={_ID} sha=[0-9a-fA-F]{{0,12}}(None)? vs capture source={_ID} sha=[0-9a-f]{{12}}",),[0m
[31;1m    R_DERIVATION_MISMATCH: (rf"derivation='?{_ID}'? is not a registered extractor", r"derivation=None is not a registered extractor",[0m
[31;1m                            rf"extractor {_ID} failed: [A-Za-z_][A-Za-z0-9_]*",[0m
[31;1m                            rf"payload does not equal extractor\({_ID}\) applied to the archived bytes",[0m
[31;1m                            r"security_ids \([^)]*\) do not equal extracted \([^)]*\)"),[0m
[31;1m    R_NOT_RECEIVED_BEFORE_CUTOFF: (rf"ingested_at={_ISO} > cutoff={_ISO}",),[0m
[31;1m}[0m
