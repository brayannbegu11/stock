      "prueba_propuesta": "from review.out.astra_scratch.r10_support import fixture, date, time, taipei\nfrom twlab.backtest import TabularForecaster\nfrom twlab.models import q1\n\ndef test_late_dividend_prevents_mature_label(tmp_path):\n    ds = [{'stock_id':'A', 'year':'2024', 'AnnouncementDate':'2024-02-01', 'AnnouncementTime':'08:00:00', 'CashExDividendTradingDate':'2024-01-10', 'CashEarningsDistribution':100}]\n    _, m = fixture(tmp_path, end='2024-01-19', dividends=ds)\n    f = TabularForecaster(m, min_weeks=1)\n    sec = next(iter(m.securities))\n    rows = q1.build_training_rows({sec:m.securities[sec].bars}, [taipei(date(2024,1,7),time(18))], now_cutoff=taipei(date(2024,1,14),time(18)), calendar=m.calendar, dividends_by_security=f.dividends)\n    assert not rows\n\n# Preservar disponibilidad y versión de cada evento; extender label_known_at a todas sus dependencias.",
