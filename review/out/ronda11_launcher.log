[31;1m                           content_type="application/json", extra={"packet_hash": packet.packet_hash(), "packet_capture": pkt_rec.capture_id})[0m
[31;1m            picks[name] = [s.security_id for s in selections] if obj["status"] == "selected" else [][0m
