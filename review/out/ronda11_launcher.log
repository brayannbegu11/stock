      "prueba_propuesta": "from dataclasses import replace\nfrom review.out.astra_scratch.r10_support import date, time, taipei\nfrom twlab.models import q1\n\ndef test_hash_covers_actual_training_values():\n    cutoff = taipei(date(2024,1,7), time(18))\n    known = taipei(date(2024,1,13), time(13,30))\n    rows = [q1.TrainingRow(cutoff, str(i), {k:float(i) for k in q1.FEATURE_NAMES}, (i+1)*1e-12, known) for i in range(3)]\n    now = taipei(date(2024,1,14), time(18))\n    a = q1.fit_q1(rows, trained_at=now, min_weeks=1, seed=1)\n    b = q1.fit_q1([replace(r, label=(3-i)*1e-12) for i,r in enumerate(rows)], trained_at=now, min_weeks=1, seed=1)\n    assert a.training_manifest_id != b.training_manifest_id\n\n# Hashear la representación exacta utilizada para ajustar el modelo.",
