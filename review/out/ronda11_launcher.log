[31;1mdef rejection_detail_is_canonical(reason: str, detail: str) -> bool:[0m
[31;1m    """El detalle de un rechazo sÃ³lo puede ser una de las plantillas de ``build_packet``: sin texto libre que el[0m
[31;1m    predictor pueda leer (R09-03). Las excepciones de extractores se reducen a su clase, nunca a su mensaje."""[0m
[31;1m    import re[0m
[31;1m    return any(re.fullmatch(p, str(detail)) is not None for p in _REJECTION_DETAIL_TEMPLATES.get(reason, ()))[0m
