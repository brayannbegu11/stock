[31;1m    assert abs(r.mean - 1 / 9) < 1e-9 and abs(r.resample_mean - 1 / 9) < 1e-12 and r.ci_low == r.ci_high == r.mean[0m
[31;1m    rows2 = [obs("2026-W20", 1.0), obs("2026-W21", 1.0)] + [obs(f"2026-W{w}", 0.0) for w in range(23, 31)][0m
