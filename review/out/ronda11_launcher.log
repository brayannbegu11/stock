[31;1m        # La entrada se ejecuta si su sesiÃ³n estÃ¡ dentro del lÃ­mite; la salida sÃ³lo si tambiÃ©n lo estÃ¡. Lo que[0m
[31;1m        # queda fuera no se intenta (ni se marca bloqueado): queda pendiente para una corrida posterior.[0m
[31;1m        bound = min(cfg.end, self.last_data_day)[0m
