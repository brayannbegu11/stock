estamp":"20260909T230327Z","verdict":"rechazado","verifications":[{"claim":"Corregida la vía concreta de doc_id rechazado; quedan otras vías en R13-01.","id":"R09-03","severity":"alta","state":"reproducido"},{"claim":"Corregido: captures.delisting_date se incorpora y las declaraciones contradictorias se rechazan.","id":"R10-05","severity":"alta","state":"reproducido"},{"claim":"Corregido: el informe 16 distingue cortes decrecientes de cortes iguales.","id":"R10-10","severity":"baja","state":"reproducido"},{"claim":"Corregida la política de fechas sin hora: se utiliza derive_available_at y se declara conservative_inference.","id":"R11-01","severity":"media","state":"reproducido"},{"claim":"Parcial: existe la lista compartida y pasan los contraejemplos anteriores, pero su validación y sus descartes siguen siendo incorrectos.","id":"R12-01","severity":"alta","state":"reproducido"},{"claim":"Parcial: el caso original y la frontera de la sesión quedan cubiertos; las retiradas conservan un intervalo indebidamente medible en R13-06.","id":"R12-02","severity":"alta","state":"reproducido"},{"claim":"Corregido: el bootstrap degenerado publica ci95=null y admite serialización JSON estricta.","id":"R12-03","severity":"media","state":"reproducido"},{"claim":"Corregido: el informe 11 declara la observación fija y la variabilidad limitada.","id":"R12-04","severity":"media","state":"reproducido"}]},{"file":"review/out/ronda14_verificacion_20260909T232124Z.json","findings_new":8,"findings_total":19,"new_findings":[{"category":"seguridad","claim":"Document.__post_init__ deja campos de texto libre fuera del payload; contradice el informe 19, línea 11.","file":"src/twlab/packet.py","id":"R14-01","severity":"alta"},{"category":"tiempo","claim":"El modo histórico admite payloads sin correspondencia con sus bytes fuente, incluso cuando se proporciona un extractor que demuestra la discrepancia.","file":"src/twlab/packet.py","id":"R14-02","severity":"alta"},{"category":"contabilidad","claim