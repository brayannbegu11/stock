[31;1m        entry_s, exit_s = plan.entry_at.date(), plan.exit_at.date()[0m
[31;1m        if entry_s > bound:[0m
[31;1m            record["pending_outcome"] = True[0m
[31;1m            return[0m
[31;1m        pending_exit = exit_s > bound[0m
[31;1m        record["pending_outcome"] = pending_exit[0m
[31;1m        close_prices = {} if pending_exit else {sec: m[exit_s].close for sec, m in self.market.by_session.items() if exit_s in m}[0m
[31;1m        for name, lg in self.ledgers.items():[0m
[31;1m            self.apply_actions(name, entry_s)[0m
[31;1m            lg.advance_to(plan.entry_at)[0m
[31;1m            fr = record["forecasters"].setdefault(name, {})[0m
[31;1m            if pending_exit:[0m
[31;1m                fr["note"] = "semana no emitida; salida heredada pendiente"[0m
[31;1m                continue[0m
[31;1m            self.apply_actions(name, exit_s)[0m
[31;1m            for wid, ss in self.open_slots[name]:[0m
[31;1m                exit_basket(lg, ss, close_prices=close_prices, at=plan.exit_at, week_id=wid)[0m
[31;1m            self.open_slots[name] = [(wid, ss) for wid, ss in self.open_slots[name][0m
[31;1m                                     if any(s.status in ("filled", "exit_blocked") or (s.status == "exited" and not s.liquidated) for s in ss)][0m
[31;1m            close_marks, stale = self.marks(exit_s, lg, "close")[0m
[31;1m            try:[0m
[31;1m                v = lg.valuation(prices=close_marks, at=plan.exit_at)[0m
[31;1m                fr.update({"equity_end": float(v.total), "flags": list(v.flags)[:6] + stale, "baskets_in_follow_up": len(self.open_slots[name]),[0m
[31;1m                           "note": "semana no emitida; cestas heredadas gestionadas"})[0m
[31;1m                self.prev_equity[name] = v.total[0m
[31;1m            except MissingPrice as exc:[0m
[31;1m                fr.update({"equity_end": None, "flags": [f"missing_price:{exc}"] + stale, "note": "semana no emitida; cestas heredadas gestionadas"})[0m
