[31;1m      "prueba_propuesta": "from datetime import date\nfrom decimal import Decimal as D\nfrom review.out.astra_scratch.r10_support import fixture, Runner, BacktestConfig, MomentumForecaster, RandomForecaster\n\ndef test_fallo_de_emision_no_aplaza_venta_heredada(tmp_path, monkeypatch):\n    def prices(d):\n        return D(80) if d >= date(2024, 1, 22) else D(110) if d == date(2024, 1, 19) else D(100)\n    raw, market = fixture(tmp_path, prices=prices)\n    sid = market.by_symbol['A']\n    market.securities[sid].bars = [b for b in market.securities[sid].bars if b.session != date(2024, 1, 12)]\n    del market.by_session[sid][date(2024, 1, 12)]\n    cfg = BacktestConfig(date(2024, 1, 1), date(2024, 1, 26), slots=1, notional=10000, lot_size=1, commission_per_side=D(0), sell_tax=D(0), slippage_bps=0, label='lab', n_boot=20)\n    runner = Runner(raw, market, cfg, [MomentumForecaster(), RandomForecaster(1)])\n    runner.run_week(date(2024, 1, 7))\n    slot = runner.open_slots['Q0'][0][1][0]\n    assert slot.status == 'exit_blocked'\n    original = raw.find\n    def fail(**kwargs):\n        if kwargs['source_id'] == 'packet' and kwargs['dataset'].endswith('2024-W03'):\n            raise OSError('disk failed for W03')\n        return original(**kwargs)\n    monkeypatch.setattr(raw, 'find', fail)\n    runner.run_week(date(2024, 1, 14))\n    assert runner.weeks[-1]['status'] == 'invalid:archive'\n    monkeypatch.setattr(raw, 'find', original)\n    runner.run_week(date(2024, 1, 21))\n    assert slot.exit.at.date() == date(2024, 1, 19)\n    assert slot.exit.gross == D(11000)\n",[0m
