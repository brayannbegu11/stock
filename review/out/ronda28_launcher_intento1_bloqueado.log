[31;1m+@pytest.mark.parametrize('reset', [False, True])[0m
[31;1m+def test_nested_pin_preserves_outer_generation(tmp_path, monkeypatch, reset):[0m
[31;1m+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)[0m
[31;1m+    src = source_id(raw, w)[0m
[31;1m+    fid = w['forecasters']['Q0']['forecast_capture_id'][0m
[31;1m+    rewrite_manifest(raw, lambda rows: [r.update(clock_source='injected') for r in rows if r['capture_id'] == src])[0m
[31;1m+    assert not ex.classify_week('lab', w)['prospective'][0m
[31;1m+    original = ex.forecast_archive[0m
[31;1m+    def interleave(*args, **kwargs):[0m
[31;1m+        result = original(*args, **kwargs)[0m
[31;1m+        # A nested classification must restore, not release, the caller's pin.[0m
[31;1m+        ex.classify_week('lab', {'status': 'invalid:archive'})[0m
[31;1m+        def mutate(rows):[0m
[31;1m+            for r in rows:[0m
[31;1m+                if r['capture_id'] == src: r['clock_source'] = 'system'[0m
[31;1m+                if r['capture_id'] == fid: r['clock_source'] = 'injected'[0m
[31;1m+        rewrite_manifest(raw, mutate)[0m
[31;1m+        if reset: ex._MANIFEST = None[0m
[31;1m+        return result[0m
[31;1m+    monkeypatch.setattr(ex, 'forecast_archive', interleave)[0m
[31;1m+    mixed = ex.classify_week('lab', w)[0m
[31;1m+    monkeypatch.setattr(ex, 'forecast_archive', original)[0m
[31;1m+    assert not ex.classify_week('lab', w)['prospective'][0m
[31;1m+    assert not mixed['prospective'], mixed['reasons'][0m
