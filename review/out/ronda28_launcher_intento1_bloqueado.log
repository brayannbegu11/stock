[31;1m            if plan.target_monday > bound:                  # semana sin sesiones más allá del límite: sólo se registra (R10-07)[0m
[31;1m                record["note"] = "invalid:no_sessions (registrado; fuera del límite de simulación)"[0m
[31;1m                record["pending_outcome"] = True[0m
[31;1m                return[0m
[31;1m            upto = min(week_end, bound)                     # nunca se procesa ni se valora más allá del límite[0m
[31;1m            last_close = self.market.calendar.prev_session(before=upto + timedelta(days=1))[0m
[31;1m            for name, lg in self.ledgers.items():[0m
[31;1m                self.apply_actions(name, upto)[0m
[31;1m                lg.advance_to(taipei(upto, time(23, 59)))[0m
[31;1m                prices, stale = self.marks(last_close, lg, "close", valued_at=upto)[0m
[31;1m                try:[0m
[31;1m                    v = lg.valuation(prices=prices, at=taipei(upto, time(23, 59)))[0m
[31;1m                    record["forecasters"][name] = {"equity_end": float(v.total), "flags": list(v.flags)[:6] + stale}[0m
[31;1m                    self.prev_equity[name] = v.total[0m
[31;1m                except MissingPrice as exc:[0m
[31;1m                    record["forecasters"][name] = {"equity_end": None, "flags": [f"missing_price:{exc}"] + stale}[0m
[31;1m            record["note"] = "invalid:no_sessions (registrado, sin operaciones; eventos procesados hasta el límite)"[0m
[31;1m            return[0m
[31;1m        try:[0m
[31;1m            self._emit_week(plan, record, bound)[0m
[31;1m        except ARCHIVE_ERRORS as exc:[0m
[31;1m            # el archivo no permite emitir con garantías: la semana queda registrada como fallida (con la traza de lo[0m
[31;1m            # que llegó a archivarse antes del fallo), sin evaluación, y la corrida continúa con la siguiente (R26-03);[0m
[31;1m            # el libro sigue vivo: derechos, reintento de salidas heredadas y valoración (R27-05)[0m
[31;1m            record["status"] = "invalid:archive"[0m
