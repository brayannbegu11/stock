+def test_census_report_innovation_exclusion_matches_default_universe():
+    from twlab.master import SecurityMaster, SecurityVersion
+    master = SecurityMaster()
+    path = ROOT / 'data/store/master_2026-09-09.jsonl'
+    for line in path.read_text(encoding='utf-8').splitlines():
+        row = json.loads(line)
+        if row.pop('kind') != 'segment':
+            continue
+        for field in ('valid_from','valid_to'):
+            if row[field]:
+                row[field] = date.fromisoformat(row[field])
+        row['recorded_at'] = datetime.fromisoformat(row['recorded_at'])
+        master.add(SecurityVersion(**row))
+    universe = master.universe(as_of=date(2026,9,9))
+    assert len(universe) == 1973
+    assert not [v for v in universe if v.board == 'innovation']
