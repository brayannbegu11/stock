+from pathlib import Path
+
+HERE = Path(__file__).parent
+for name in ('ataques', 'verificacion'):
+    text = (HERE / f'test_ronda7_{name}.py').read_text(encoding='utf-8')
+    text = text.replace('from twlab.schemas import validate_prediction', 'from twlab.schemas import validate_prediction\nfrom twlab.packet import packet_to_json, packet_from_json\nfrom tests.test_schema import CAL_2030, calendar_for')
+    marker = '\n\ndef enter(' if name == 'verificacion' else '\n\ndef evaluate('
+    wrapper = '''
+
+_archive_and_seal = archive_and_seal
+def archive_and_seal(path, obj, pkt, **kw):
+    store, rec = _archive_and_seal(path, obj, pkt, **kw)
+    restored = packet_from_json(packet_to_json(pkt))
+    store.r8_packets = {restored.packet_hash(): restored}
+    return store, rec
+'''
+    text = text.replace(marker, wrapper + marker, 1)
+    if name == 'ataques':
+        text = text.replace('store=s, allow_test_authorities=True)', 'store=s, packets=getattr(s, "r8_packets", {}), calendar=CAL_2030, allow_test_authorities=True)', 1)
+        text = text.replace('validate_prediction(o, p, store=s, allow_test_authorities=True)', 'validate_prediction(o, p, calendar=CAL_2030, store=s, allow_test_authorities=True)')
+    else:
+        text = text.replace('seed=1, store=s, **kw)', 'seed=1, store=s, packets=getattr(s, "r8_packets", {}), calendar=CAL_2030, **kw)')
+        text = text.replace('validate_prediction(o, p, store=s', 'validate_prediction(o, p, calendar=calendar_for(p), store=s')
+    (HERE / f'test_ronda8_r7_{name}.py').write_text(text, encoding='utf-8')
