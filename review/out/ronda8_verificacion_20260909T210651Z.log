+import sys
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / 'src'))
+import ast
+import importlib.util
+import json
+from dataclasses import replace
+from datetime import date, datetime, time, timedelta
+from decimal import Decimal as D
+import pytest
+from twlab.calendar import TradingCalendar, CalendarRangeError, UnclassifiedCalendarRow, classify_holiday_row_en
+from twlab.packet import Document, packet_from_json, packet_to_json, build_packet
+from twlab.schemas import validate_prediction
+from twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError
+from twlab.sources import finmind
+from twlab.sources.twse import CensusRow, security_versions_from_census, census_rows_twse, delisting_rows_twse
+from twlab.store import RawStore
+from twlab.timeutil import taipei, AvailabilityQuality as Q
+from twlab.ledger import PaperLedger
+from tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal, CAL_2030
+from tests.test_ledger import FREE
+
+
+@pytest.mark.parametrize('variant', ['future', 'no_capture', 'unknown'])
+def test_evaluator_revalidates_document_admission(tmp_path, variant):
+    p = prospective_packet()
+    d = Document(doc_id='future-result', kind='news', source_id='invented', security_ids=('SEC-1',),
+                 available_at=p.cutoff_at + timedelta(days=30) if variant == 'future' else p.cutoff_at,
+                 availability_quality=Q.UNKNOWN if variant == 'unknown' else Q.VERIFIED_ORIGINAL,
+                 payload={'future_profit': 999})
+    rejected = build_packet(packet_id=p.packet_id, cutoff_at=p.cutoff_at, documents=[d], mode='prospective',
+                            evidence_class=p.evidence_class, calendar=CAL_2030, captures={}, read_bytes=lambda r: b'', extractors={})
+    assert not rejected.admitted
+    p = packet_from_json(packet_to_json(replace(p, admitted=(d,))))
+    f = prospective_forecast(p)
+    f['ranking'][0]['document_ids'] = [d.doc_id]
+    store, rec = archive_and_seal(tmp_path, f, p)
+    row = WeeklyObservation(p.week_id, 'f-1', p.evidence_class, rec.capture_id, True, .1)
+    with pytest.raises(ObservationError):
+        block_bootstrap_mean([row], block_length=1, n_boot=20, seed=1, store=store,
+                             packets={p.packet_hash(): p}, calendar=CAL_2030, allow_test_authorities=True)
+
+
+@pytest.mark.parametrize('description', ['Typhoon closure cancelled; normal trading',
+                                        'Market Open: No trading due to typhoon',
+                                        'Holiday schedule to be confirmed'])
+def test_english_ambiguous_calendar_rows_fail_closed(description):
+    with pytest.raises(UnclassifiedCalendarRow):
+        TradingCalendar.from_twse_legacy_rows({2024: [['2024-10-04', description]]},
+                                             source_id='test', recorded_at=taipei(date(2024,1,1)))
+
+
+def test_calendar_controls():
+    for rows in ({2021: [], 2023: []}, {2024: [['2023-01-02','Market Open']]}):
+        with pytest.raises(CalendarRangeError):
+            TradingCalendar.from_twse_legacy_rows(rows, source_id='test', recorded_at=taipei(date(2024,1,1)))
+    with pytest.raises(UnclassifiedCalendarRow):
+        TradingCalendar.from_twse_legacy_rows({2024: [['2024-01-02','unrecognised']]}, source_id='test', recorded_at=taipei(date(2024,1,1)))
+
+
+def test_dividend_without_time_does_not_invent_midnight():
+    dv = finmind.dividends_from_rows([{'stock_id': 'A', 'AnnouncementDate': '2024-01-05'}])[0]
+    assert dv.announced_at is None, dv.announced_at
+
+
+@pytest.mark.parametrize('category', ['', 'NEW_STRUCTURED_PRODUCT'])
+def test_unknown_instrument_is_not_ordinary_equity(category):
+    instruments, boards, _ = finmind.classify_info([{'stock_id':'9999', 'industry_category':category, 'type':'twse'}])
+    rows = [CensusRow('9999','X','99',date(2020,1,1),'',1000,date(2026,9,9))]
+    v = security_versions_from_census(rows, market='TWSE', instrument_types=instruments, boards=boards,
+                                    recorded_at=taipei(date(2026,9,9)), source_id='fixture')[0]
+    assert v.instrument_type == 'unclassified'
+
+
+def test_reused_symbol_has_distinct_identity():
+    kwargs = dict(market='TWSE', instrument_types={'2432':'ordinary_equity'}, boards={},
+                  recorded_at=taipei(date(2026,9,9)), source_id='fixture')
+    old = security_versions_from_census([CensusRow('2432','OLD','1',date(2000,1,1),'',1000,date(2007,1,1))], **kwargs)[0]
+    new = security_versions_from_census([CensusRow('2432','NEW','2',date(2023,5,31),'',1000,date(2026,9,9))], **kwargs)[0]
+    assert old.security_id != new.security_id
+
+
+def test_roc_control():
+    assert delisting_rows_twse([{'Code':'2432','Company':'OLD','DelistingDate':'97/09/01'}])[0].delisting_date == date(2008,9,1)
+    r = census_rows_twse([{'σà¼σÅ╕Σ╗úΦÖƒ':'2432','Σ╕èσ╕éµùÑµ£ƒ':'1120531','σç║Φí¿µùÑµ£ƒ':'1150909'}])[0]
+    assert r.listing_date == date(2023,5,31) and r.report_date == date(2026,9,9)
+
+
+def price_row(sid='A', session='2024-01-05'):
+    return {'stock_id':sid,'date':session,'open':100,'max':100,'min':100,'close':100,
+            'Trading_Volume':1000,'Trading_money':100000,'Trading_turnover':10}
+
+
+def test_bar_adapter_does_not_erase_security_identity():
+    # Identical prices are possible for distinct securities; identity must survive decoding.
+    assert finmind.bars_from_rows([price_row('A')]) != finmind.bars_from_rows([price_row('B')])
+
+
+def test_bar_adapter_does_not_count_duplicate_dates_as_sessions():
+    try:
+        bars = finmind.bars_from_rows([price_row()] * 120)
+    except ValueError:
+        return  # rejecting ambiguous input is also valid
+    assert len(bars) == 1, len(bars)
+
+
+def test_segmented_bootstrap_preserves_week_weights(monkeypatch):
+    import random
+    from twlab import evaluation
+    chosen = []
+    original = random.Random
+    class TrackedRandom:
+        def __init__(self, seed):
+            self.rng = original(seed)
+        def randrange(self, n):
+            x = self.rng.randrange(n)
+            chosen.append(x)
+            return x
+    monkeypatch.setattr(evaluation.random,'Random',TrackedRandom)
+    # Two constant segments, lengths 4 and 8; one absent week in between.
+    dates = [date(2024,1,1)+timedelta(weeks=i) for i in list(range(4))+list(range(5,13))]
+    vals = [1.] * 4 + [0.] * 8
+    obs = [WeeklyObservation(f'{d.isocalendar().year}-W{d.isocalendar().week:02}',str(i),'historical_numeric_temporally_controlled',None,True,v)
+           for i,(d,v) in enumerate(zip(dates,vals))]
+    result = block_bootstrap_mean(obs,block_length=4,n_boot=10000,seed=1)
+    starts = evaluation._block_starts(dates,4)
+    # Every draw has length 4, exactly 3 draws per replicate. Observe actual resampling weights.
+    boot_mean = sum(sum(vals[s:s+n]) for s,n in (starts[i] for i in chosen)) / (10000*12)
+    assert abs(boot_mean-result.mean) < .02, (result.mean,boot_mean,starts)
+
+
+def test_real_zero_price_rows_are_not_all_zero_trading():
+    # Archived real row TWSE:1203, 2022-11-17: no OHLC, but 48 shares / 1,606 TWD / 18 trades.
+    r = {'date':'2022-11-17','stock_id':'1203','Trading_Volume':48,'Trading_money':1606,
+         'open':0.,'max':0.,'min':0.,'close':0.,'Trading_turnover':18}
+    b = finmind.bars_from_rows([r])[0]
+    discarded_as_no_trading = not (b.close > 0 and b.open > 0)
+    assert not discarded_as_no_trading or (b.volume_shares == 0 and b.value_twd == 0 and b.transactions == 0)
+
