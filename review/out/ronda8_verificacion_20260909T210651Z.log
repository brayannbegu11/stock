index 0000000000000000000000000000000000000000..fc59f9947f14023ec4a209e5e2b26afa33a6d559
--- /dev/null
+++ b/review/out/astra_scratch/prepare_r8.py
@@ -0,0 +1,24 @@
+from pathlib import Path
+
+HERE = Path(__file__).parent
+for name in ('ataques', 'verificacion'):
+    text = (HERE / f'test_ronda7_{name}.py').read_text(encoding='utf-8')
+    text = text.replace('from twlab.schemas import validate_prediction', 'from twlab.schemas import validate_prediction\nfrom twlab.packet import packet_to_json, packet_from_json\nfrom tests.test_schema import CAL_2030, calendar_for')
+    marker = '\n\ndef enter(' if name == 'verificacion' else '\n\ndef evaluate('
+    wrapper = '''
+
+_archive_and_seal = archive_and_seal
+def archive_and_seal(path, obj, pkt, **kw):
+    store, rec = _archive_and_seal(path, obj, pkt, **kw)
+    restored = packet_from_json(packet_to_json(pkt))
+    store.r8_packets = {restored.packet_hash(): restored}
+    return store, rec
+'''
+    text = text.replace(marker, wrapper + marker, 1)
+    if name == 'ataques':
+        text = text.replace('store=s, allow_test_authorities=True)', 'store=s, packets=getattr(s, "r8_packets", {}), calendar=CAL_2030, allow_test_authorities=True)', 1)
+        text = text.replace('validate_prediction(o, p, store=s, allow_test_authorities=True)', 'validate_prediction(o, p, calendar=CAL_2030, store=s, allow_test_authorities=True)')
+    else:
+        text = text.replace('seed=1, store=s, **kw)', 'seed=1, store=s, packets=getattr(s, "r8_packets", {}), calendar=CAL_2030, **kw)')
+        text = text.replace('validate_prediction(o, p, store=s', 'validate_prediction(o, p, calendar=calendar_for(p), store=s')
+    (HERE / f'test_ronda8_r7_{name}.py').write_text(text, encoding='utf-8')
diff --git a/review/out/astra_scratch/run_r8_real.py b/review/out/astra_scratch/run_r8_real.py
new file mode 100644
index 0000000000000000000000000000000000000000..c7810661c9e8e9c765c065eaf6d690181c666018
--- /dev/null
+++ b/review/out/astra_scratch/run_r8_real.py
@@ -0,0 +1,49 @@
+import sys, json, importlib.util
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / 'src'))
+from twlab.store import RawStore
+from twlab.packet import packet_from_json
+
+def module(name):
+    spec = importlib.util.spec_from_file_location(name, ROOT / 'scripts' / f'{name}.py')
+    obj = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(obj)
+    return obj
+
+def run():
+    target = ROOT / 'review/out/astra_scratch/r8_real'
+    (target / 'data/store').mkdir(parents=True, exist_ok=True)
+    (target / 'docs/informes').mkdir(parents=True, exist_ok=True)
+    (target / 'data/store/sample_universe.json').write_bytes((ROOT / 'data/store/sample_universe.json').read_bytes())
+    source = RawStore(ROOT / 'data/raw')
+    sink = RawStore(target / 'archive')
+    stats = {'packets': 0, 'future_documents': 0, 'future_rows': 0, 'roundtrips': 0}
+    class Proxy:
+        def __getattr__(self, key):
+            return getattr(source, key)
+        def put(self, **kwargs):
+            if kwargs['source_id'] == 'packet':
+                p = packet_from_json(kwargs['payload'])
+                stats['packets'] += 1
+                stats['roundtrips'] += 1
+                for doc in p.admitted:
+                    stats['future_documents'] += doc.available_at > p.cutoff_at
+                    from datetime import date, timedelta
+                    from twlab.timeutil import taipei
+                    stats['future_rows'] += sum(taipei(date.fromisoformat(row[0])).replace(hour=13,minute=30) + timedelta(hours=24) > p.cutoff_at for row in doc.payload['sessions'])
+            return sink.put(**kwargs)
+    m = module('build_master')
+    m.ROOT = target
+    m.RawStore = lambda path: source
+    m.main()
+    m = module('run_q0_demo')
+    m.ROOT = target
+    m.RawStore = lambda path: Proxy()
+    sys.argv = ['run_q0_demo']
+    m.main()
+    (target / 'packet_audit.json').write_text(json.dumps(stats), encoding='utf-8')
+    print(stats)
+
+if __name__ == '__main__':
+    run()
