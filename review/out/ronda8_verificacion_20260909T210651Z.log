+         'open':0.,'max':0.,'min':0.,'close':0.,'Trading_turnover':18}
+    b = finmind.bars_from_rows([r])[0]
+    discarded_as_no_trading = not (b.close > 0 and b.open > 0)
+    assert not discarded_as_no_trading or (b.volume_shares == 0 and b.value_twd == 0 and b.transactions == 0)
