+def test_roc_control():
+    assert delisting_rows_twse([{'Code':'2432','Company':'OLD','DelistingDate':'97/09/01'}])[0].delisting_date == date(2008,9,1)
+    r = census_rows_twse([{'σà¼σÅ╕Σ╗úΦÖƒ':'2432','Σ╕èσ╕éµùÑµ£ƒ':'1120531','σç║Φí¿µùÑµ£ƒ':'1150909'}])[0]
+    assert r.listing_date == date(2023,5,31) and r.report_date == date(2026,9,9)
