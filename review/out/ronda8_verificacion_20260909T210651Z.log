+    old = security_versions_from_census([CensusRow('2432','OLD','1',date(2000,1,1),'',1000,date(2007,1,1))], **kwargs)[0]
+    new = security_versions_from_census([CensusRow('2432','NEW','2',date(2023,5,31),'',1000,date(2026,9,9))], **kwargs)[0]
+    assert old.security_id != new.security_id
+
