+import sys
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / 'src'))
+import ast
+import importlib.util
+import json
+from dataclasses import replace
+from datetime import date, datetime, time, timedelta
+from decimal import Decimal as D
+import pytest
+from twlab.calendar import TradingCalendar, CalendarRangeError, UnclassifiedCalendarRow, classify_holiday_row_en
+from twlab.packet import Document, packet_from_json, packet_to_json, build_packet
+from twlab.schemas import validate_prediction
+from twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError
+from twlab.sources import finmind
+from twlab.sources.twse import CensusRow, security_versions_from_census, census_rows_twse, delisting_rows_twse
+from twlab.store import RawStore
+from twlab.timeutil import taipei, AvailabilityQuality as Q
+from twlab.ledger import PaperLedger
+from tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal, CAL_2030
+from tests.test_ledger import FREE
+
+
+@pytest.mark.parametrize('variant', ['future', 'no_capture', 'unknown'])
+def test_evaluator_revalidates_document_admission(tmp_path, variant):
+    p = prospective_packet()
+    d = Document(doc_id='future-result', kind='news', source_id='invented', security_ids=('SEC-1',),
+                 available_at=p.cutoff_at + timedelta(days=30) if variant == 'future' else p.cutoff_at,
+                 availability_quality=Q.UNKNOWN if variant == 'unknown' else Q.VERIFIED_ORIGINAL,
+                 payload={'future_profit': 999})
+    rejected = build_packet(packet_id=p.packet_id, cutoff_at=p.cutoff_at, documents=[d], mode='prospective',
+                            evidence_class=p.evidence_class, calendar=CAL_2030, captures={}, read_bytes=lambda r: b'', extractors={})
+    assert not rejected.admitted
+    p = packet_from_json(packet_to_json(replace(p, admitted=(d,))))
+    f = prospective_forecast(p)
+    f['ranking'][0]['document_ids'] = [d.doc_id]
+    store, rec = archive_and_seal(tmp_path, f, p)
+    row = WeeklyObservation(p.week_id, 'f-1', p.evidence_class, rec.capture_id, True, .1)
+    with pytest.raises(ObservationError):
+        block_bootstrap_mean([row], block_length=1, n_boot=20, seed=1, store=store,
+                             packets={p.packet_hash(): p}, calendar=CAL_2030, allow_test_authorities=True)
+
+
+@pytest.mark.parametrize('description', ['Typhoon closure cancelled; normal trading',
+                                        'Market Open: No trading due to typhoon',
+                                        'Holiday schedule to be confirmed'])
+def test_english_ambiguous_calendar_rows_fail_closed(description):
+    with pytest.raises(UnclassifiedCalendarRow):
+        TradingCalendar.from_twse_legacy_rows({2024: [['2024-10-04', description]]},
+                                             source_id='test', recorded_at=taipei(date(2024,1,1)))
+
+
+def test_calendar_controls():
+    for rows in ({2021: [], 2023: []}, {2024: [['2023-01-02','Market Open']]}):
+        with pytest.raises(CalendarRangeError):
+            TradingCalendar.from_twse_legacy_rows(rows, source_id='test', recorded_at=taipei(date(2024,1,1)))
+    with pytest.raises(UnclassifiedCalendarRow):
+        TradingCalendar.from_twse_legacy_rows({2024: [['2024-01-02','unrecognised']]}, source_id='test', recorded_at=taipei(date(2024,1,1)))
+
+
+def test_dividend_without_time_does_not_invent_midnight():
+    dv = finmind.dividends_from_rows([{'stock_id': 'A', 'AnnouncementDate': '2024-01-05'}])[0]
+    assert dv.announced_at is None, dv.announced_at
+
+
+@pytest.mark.parametrize('category', ['', 'NEW_STRUCTURED_PRODUCT'])
+def test_unknown_instrument_is_not_ordinary_equity(category):
+    instruments, boards, _ = finmind.classify_info([{'stock_id':'9999', 'industry_category':category, 'type':'twse'}])
+    rows = [CensusRow('9999','X','99',date(2020,1,1),'',1000,date(2026,9,9))]
+    v = security_versions_from_census(rows, market='TWSE', instrument_types=instruments, boards=boards,
+                                    recorded_at=taipei(date(2026,9,9)), source_id='fixture')[0]
+    assert v.instrument_type == 'unclassified'
+
+
+def test_reused_symbol_has_distinct_identity():
+    kwargs = dict(market='TWSE', instrument_types={'2432':'ordinary_equity'}, boards={},
+                  recorded_at=taipei(date(2026,9,9)), source_id='fixture')
+    old = security_versions_from_census([CensusRow('2432','OLD','1',date(2000,1,1),'',1000,date(2007,1,1))], **kwargs)[0]
+    new = security_versions_from_census([CensusRow('2432','NEW','2',date(2023,5,31),'',1000,date(2026,9,9))], **kwargs)[0]
+    assert old.security_id != new.security_id
+
+
+def test_roc_control():
+    assert delisting_rows_twse([{'Code':'2432','Company':'OLD','DelistingDate':'97/09/01'}])[0].delisting_date == date(2008,9,1)
+    r = census_rows_twse([{'σà¼σÅ╕Σ╗úΦÖƒ':'2432','Σ╕èσ╕éµùÑµ£ƒ':'1120531','σç║Φí¿µùÑµ£ƒ':'1150909'}])[0]
+    assert r.listing_date == date(2023,5,31) and r.report_date == date(2026,9,9)
+
+
+def load_demo():
+    spec = importlib.util.spec_from_file_location('r8_demo', ROOT / 'scripts/run_q0_demo.py')
+    m = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(m)
+    return m
+
+
+def run_demo(tmp_path, monkeypatch, *, dividends=(), prices=None, closures=(), end='2024-01-26', delisted=None):
+    m = load_demo()
+    folder = tmp_path / 'data/store'
+    folder.mkdir(parents=True)
+    store = RawStore(tmp_path / 'raw')
+    price_rows = []
+    day = date(2021,1,1)
+    while day <= date.fromisoformat(end):
+        if day.weekday() < 5 and day not in closures:
+            price = prices(day) if prices else D(100)
+            price_rows.append({'stock_id':'A','date':day.isoformat(),'open':str(price), 'max':str(price),'min':str(price),
+                               'close':str(price),'Trading_Volume':10000000,'Trading_money':1000000000,'Trading_turnover':1000})
+        day += timedelta(days=1)
+    def capture(dataset, data):
+        return store.put(source_id='finmind',dataset=dataset,payload=json.dumps({'status':200,'msg':'success','data':data}).encode(),url='fixture')
+    bp = capture('TaiwanStockPrice/A',price_rows)
+    bd = capture('TaiwanStockDividend/A',list(dividends))
+    manifest = {'listed':[{'symbol':'A','name':'A','listing_date':'2000-01-01'}],
+                'delisted':[] if not delisted else [{'symbol':'A','name':'A','delisting_date':delisted}],
+                'captures':{'A':{'price':bp.capture_id,'price_rows':len(price_rows),'dividend':bd.capture_id,'dividend_rows':len(dividends)}}}
+    (folder/'sample_universe.json').write_text(json.dumps(manifest),encoding='utf-8')
+    cal = TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=closures,source_id='synthetic',recorded_at=taipei(date(2021,1,1)))
+    monkeypatch.setattr(m,'ROOT',tmp_path)
+    monkeypatch.setattr(m,'RawStore',lambda path:store)
+    monkeypatch.setattr(m,'load_twse_reference_calendar',lambda:cal)
+    monkeypatch.setattr(m,'CostModel',lambda **kw:FREE)
+    ledgers = []
+    def ledger(**kw):
+        obj = PaperLedger(**kw)
+        ledgers.append(obj)
+        return obj
+    monkeypatch.setattr(m,'PaperLedger',ledger)
+    monkeypatch.setattr(sys,'argv',['demo','--start','2024-01-01','--end',end,'--slots','1','--notional','100000','--block-length','1'])
+    assert m.main() == 0
+    result = json.loads((folder/f'q0_demo_2024-01-01_{end}.json').read_text(encoding='utf-8'))
+    return result, ledgers, store
+
+
+def stock_div(ex, amount):
+    return {'stock_id':'A','year':'2024','StockExDividendTradingDate':ex,'StockEarningsDistribution':amount}
+
+
+def test_demo_retries_residue_after_it_becomes_sellable(tmp_path, monkeypatch):
+    result, ledgers, _ = run_demo(tmp_path,monkeypatch, dividends=[stock_div('2024-01-10',5),stock_div('2024-01-17',10)],
+                                 prices=lambda d: D(100) if d < date(2024,1,10) else D(60) if d < date(2024,1,17) else D(30),end='2024-01-19')
+    assert not ledgers[0].positions, result['summary']['open_positions_at_end']
+
+
+@pytest.mark.parametrize('kind', ['cash', 'delisting'])
+def test_demo_processes_events_in_no_session_week(tmp_path, monkeypatch, kind):
+    holidays = [date(2024,1,d) for d in range(15,20)]
+    dvs = [stock_div('2024-01-10',5)]
+    if kind == 'cash':
+        dvs.append({'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-17','CashEarningsDistribution':2})
+    result, ledgers, _ = run_demo(tmp_path,monkeypatch, dividends=dvs,closures=holidays,
+                                 delisted='2024-01-17' if kind == 'delisting' else None)
+    lg = ledgers[0]
+    if kind == 'cash':
+        assert sum((r.amount for r in lg.receivables),D(0)) == D(1000)
+    else:
+        assert lg.positions['TWSE:A'].status == 'delisted_unresolved'
+
+
+def test_demo_excludes_pre_entry_return_from_open_close_interval(tmp_path, monkeypatch):
+    result, ledgers, _ = run_demo(tmp_path,monkeypatch,dividends=[stock_div('2024-01-10',5)],
+                                 prices=lambda d: D(100) if d < date(2024,1,15) else D(200),end='2024-01-19')
+    w = result['weeks'][1]['Q0']
+    # 500 carried shares rise 100 -> 200 over weekend. Monday open and Friday close are both 200.
+    # Free costs, no weekly action: true Monday-open -> Friday-close total-equity return is zero.
+    assert w['portfolio_net_return'] == 0, w
+
+
+def test_demo_exposure_includes_carried_positions(tmp_path, monkeypatch):
+    result, ledgers, _ = run_demo(tmp_path,monkeypatch,dividends=[stock_div('2024-01-10',5)],end='2024-01-19')
+    w = result['weeks'][1]['Q0']
+    # New 1,000 shares + carried 500 at 100, equity 150,000: fully invested.
+    assert w['exposure'] == 1, w
+
+
+def test_demo_entry_day_dividend_is_not_given_to_new_buyer(tmp_path, monkeypatch):
+    result, ledgers, _ = run_demo(tmp_path,monkeypatch,dividends=[{'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-08','CashEarningsDistribution':10}],end='2024-01-12')
+    assert ledgers[0].cash == D(100000) and not ledgers[0].receivables
+
+
+def test_demo_marks_stale_prices_explicitly(tmp_path, monkeypatch):
+    # Test the actual nested marking function without rewriting its logic.
+    m = load_demo()
+    tree = ast.parse((ROOT/'scripts/run_q0_demo.py').read_text(encoding='utf-8'))
+    main = next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='main')
+    fn = next(n for n in main.body if isinstance(n,ast.FunctionDef) and n.name=='mark_prices')
+    row = finmind.Bar(date(2024,1,11),D(100),D(100),D(100),D(100),1000,D(100000),1,taipei(date(2024,1,12)))
+    scope = dict(vars(m), by_session={'A':{row.session:row}},bars={'A':[row]})
+    exec(compile(ast.Module(body=[fn],type_ignores=[]),'scripts/run_q0_demo.py','exec'),scope)
+    lg = PaperLedger(ledger_id='t',initial_cash=D(100000),cost_model=FREE)
+    lg.buy(security_id='TWSE:A',price=D(100),shares=1000,at=taipei(date(2024,1,8),time(9)),event_id='b')
+    prices,flags = scope['mark_prices'](date(2024,1,12),lg)
+    assert prices == {'TWSE:A':D(100)} and flags == ['stale_price:TWSE:A:2024-01-11']

