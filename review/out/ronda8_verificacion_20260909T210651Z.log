            industry_code=str(r.get("τöóµÑ¡σêÑ", "")).strip(), listing_date=listing,
            registration=str(r.get("σñûσ£ïΣ╝üµÑ¡Φ¿╗σåèσ£░σ£ï", "")).strip(),
            issued_shares=_int_or_none(r.get("σ╖▓τÖ╝ΦíîµÖ«ΘÇÜΦéíµò╕µêûTDRσÄƒΦéíτÖ╝ΦíîΦéíµò╕", "")),
