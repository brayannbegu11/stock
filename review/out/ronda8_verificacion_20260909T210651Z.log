+def test_bar_adapter_does_not_count_duplicate_dates_as_sessions():
+    try:
+        bars = finmind.bars_from_rows([price_row()] * 120)
+    except ValueError:
+        return  # rejecting ambiguous input is also valid
+    assert len(bars) == 1, len(bars)
