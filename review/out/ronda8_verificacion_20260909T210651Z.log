+@pytest.mark.parametrize('category', ['', 'NEW_STRUCTURED_PRODUCT'])
+def test_unknown_instrument_is_not_ordinary_equity(category):
+    instruments, boards, _ = finmind.classify_info([{'stock_id':'9999', 'industry_category':category, 'type':'twse'}])
+    rows = [CensusRow('9999','X','99',date(2020,1,1),'',1000,date(2026,9,9))]
