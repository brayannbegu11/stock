+++ b/review/out/astra_scratch/run_r8_real.py
@@ -0,0 +1,49 @@
+import sys, json, importlib.util
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / 'src'))
+from twlab.store import RawStore
+from twlab.packet import packet_from_json
+
+def module(name):
+    spec = importlib.util.spec_from_file_location(name, ROOT / 'scripts' / f'{name}.py')
+    obj = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(obj)
+    return obj
+
+def run():
+    target = ROOT / 'review/out/astra_scratch/r8_real'
+    (target / 'data/store').mkdir(parents=True, exist_ok=True)
+    (target / 'docs/informes').mkdir(parents=True, exist_ok=True)
+    (target / 'data/store/sample_universe.json').write_bytes((ROOT / 'data/store/sample_universe.json').read_bytes())
+    source = RawStore(ROOT / 'data/raw')
+    sink = RawStore(target / 'archive')
+    stats = {'packets': 0, 'future_documents': 0, 'future_rows': 0, 'roundtrips': 0}
+    class Proxy:
+        def __getattr__(self, key):
+            return getattr(source, key)
+        def put(self, **kwargs):
+            if kwargs['source_id'] == 'packet':
+                p = packet_from_json(kwargs['payload'])
+                stats['packets'] += 1
+                stats['roundtrips'] += 1
+                for doc in p.admitted:
+                    stats['future_documents'] += doc.available_at > p.cutoff_at
+                    from datetime import date, timedelta
+                    from twlab.timeutil import taipei
+                    stats['future_rows'] += sum(taipei(date.fromisoformat(row[0])).replace(hour=13,minute=30) + timedelta(hours=24) > p.cutoff_at for row in doc.payload['sessions'])
+            return sink.put(**kwargs)
+    m = module('build_master')
+    m.ROOT = target
+    m.RawStore = lambda path: source
+    m.main()
+    m = module('run_q0_demo')
+    m.ROOT = target
+    m.RawStore = lambda path: Proxy()
+    sys.argv = ['run_q0_demo']
+    m.main()
+    (target / 'packet_audit.json').write_text(json.dumps(stats), encoding='utf-8')
+    print(stats)
+
+if __name__ == '__main__':
+    run()
