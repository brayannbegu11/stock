+def run_demo(tmp_path, monkeypatch, *, dividends=(), prices=None, closures=(), end='2024-01-26', delisted=None):
+    m = load_demo()
+    folder = tmp_path / 'data/store'
+    folder.mkdir(parents=True)
+    store = RawStore(tmp_path / 'raw')
+    price_rows = []
+    day = date(2021,1,1)
+    while day <= date.fromisoformat(end):
+        if day.weekday() < 5 and day not in closures:
+            price = prices(day) if prices else D(100)
+            price_rows.append({'stock_id':'A','date':day.isoformat(),'open':str(price), 'max':str(price),'min':str(price),
+                               'close':str(price),'Trading_Volume':10000000,'Trading_money':1000000000,'Trading_turnover':1000})
+        day += timedelta(days=1)
+    def capture(dataset, data):
+        return store.put(source_id='finmind',dataset=dataset,payload=json.dumps({'status':200,'msg':'success','data':data}).encode(),url='fixture')
+    bp = capture('TaiwanStockPrice/A',price_rows)
+    bd = capture('TaiwanStockDividend/A',list(dividends))
+    manifest = {'listed':[{'symbol':'A','name':'A','listing_date':'2000-01-01'}],
+                'delisted':[] if not delisted else [{'symbol':'A','name':'A','delisting_date':delisted}],
+                'captures':{'A':{'price':bp.capture_id,'price_rows':len(price_rows),'dividend':bd.capture_id,'dividend_rows':len(dividends)}}}
+    (folder/'sample_universe.json').write_text(json.dumps(manifest),encoding='utf-8')
+    cal = TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=closures,source_id='synthetic',recorded_at=taipei(date(2021,1,1)))
+    monkeypatch.setattr(m,'ROOT',tmp_path)
+    monkeypatch.setattr(m,'RawStore',lambda path:store)
+    monkeypatch.setattr(m,'load_twse_reference_calendar',lambda:cal)
+    monkeypatch.setattr(m,'CostModel',lambda **kw:FREE)
+    ledgers = []
+    def ledger(**kw):
+        obj = PaperLedger(**kw)
+        ledgers.append(obj)
+        return obj
+    monkeypatch.setattr(m,'PaperLedger',ledger)
+    monkeypatch.setattr(sys,'argv',['demo','--start','2024-01-01','--end',end,'--slots','1','--notional','100000','--block-length','1'])
+    assert m.main() == 0
+    result = json.loads((folder/f'q0_demo_2024-01-01_{end}.json').read_text(encoding='utf-8'))
+    return result, ledgers, store
