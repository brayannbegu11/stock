+def test_english_ambiguous_calendar_rows_fail_closed(description):
+    with pytest.raises(UnclassifiedCalendarRow):
+        TradingCalendar.from_twse_legacy_rows({2024: [['2024-10-04', description]]},
+                                             source_id='test', recorded_at=taipei(date(2024,1,1)))
+
+
+def test_calendar_controls():
+    for rows in ({2021: [], 2023: []}, {2024: [['2023-01-02','Market Open']]}):
+        with pytest.raises(CalendarRangeError):
+            TradingCalendar.from_twse_legacy_rows(rows, source_id='test', recorded_at=taipei(date(2024,1,1)))
+    with pytest.raises(UnclassifiedCalendarRow):
+        TradingCalendar.from_twse_legacy_rows({2024: [['2024-01-02','unrecognised']]}, source_id='test', recorded_at=taipei(date(2024,1,1)))
+
