+def test_validator_checks_weekly_cutoff_of_received_packet():
+    midweek = datetime.fromisoformat('2026-09-10T02:00:00+08:00')
+    with pytest.raises(ProtocolViolation):
+        plan_week(midweek, CAL_2030)
+    p = replace(packet(), cutoff_at=midweek,
+                deadline_at=datetime.fromisoformat('2026-09-10T08:30:00+08:00'),
+                entry_at=datetime.fromisoformat('2026-09-10T09:00:00+08:00'))
+    o = base(cutoff_at=midweek.isoformat(), issued_at='2026-09-10T07:00:00+08:00',
+             deadline_at=p.deadline_at.isoformat())
+    assert validate_prediction(o, p), 'Midweek replacement packet accepted as weekly'
