+        lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', MON,
+                                                per_share_cash=D('1.2345'), pay_at=FRI))
+        lg.advance_to(FRI)
+        return lg.cash
+    assert paid([1000, 1000]) == paid([2000])
+
+
+def test_invalid_prospective_week_can_be_registered_after_cutoff(tmp_path):
+    # Pick a past Sunday so the archive uses its real system clock after cutoff.
+    now = datetime.now(CUTOFF.tzinfo)
+    sunday = now.date() - timedelta(days=(now.weekday()+1) % 7 + 7)
+    cutoff = datetime.combine(sunday, time(18), tzinfo=CUTOFF.tzinfo)
+    monday = sunday + timedelta(days=1)
+    cal = TradingCalendar(start=sunday, end=sunday+timedelta(days=14),
+                          closures=[monday+timedelta(days=i) for i in range(5)],
+                          source_id='no-sessions', recorded_at=cutoff-timedelta(days=1))
+    p = prospective_packet(cutoff=cutoff, calendar=cal)
+    o = base(packet_id=p.packet_id, cutoff_at=cutoff.isoformat(), issued_at=now.isoformat(),
+             deadline_at=cutoff.isoformat(), evidence_class='prospective_registered',
+             status='invalid', ranking=[], status_reason='no_sessions')
+    store, rec = archive_and_seal(tmp_path, o, p)
+    assert rec.ingested_at_dt > cutoff
+    assert validate_prediction(o, p, store=store) == []
+
+
+def test_validator_checks_weekly_cutoff_of_received_packet():
+    midweek = datetime.fromisoformat('2026-09-10T02:00:00+08:00')
+    with pytest.raises(ProtocolViolation):
+        plan_week(midweek, CAL_2030)
+    p = replace(packet(), cutoff_at=midweek,
+                deadline_at=datetime.fromisoformat('2026-09-10T08:30:00+08:00'),
+                entry_at=datetime.fromisoformat('2026-09-10T09:00:00+08:00'))
+    o = base(cutoff_at=midweek.isoformat(), issued_at='2026-09-10T07:00:00+08:00',
+             deadline_at=p.deadline_at.isoformat())
+    assert validate_prediction(o, p), 'Midweek replacement packet accepted as weekly'
+
+
+def test_invalid_week_status_must_be_recognized():
+    p = replace(packet(), week_status='valid_typo')
+    o = base(status='invalid', ranking=[], status_reason='fake-no-sessions', deadline_at=CUTOFF.isoformat())
+    assert validate_prediction(o, p), 'Any unknown week_status authorizes a null deadline'
+
+
+def test_control_fifo_partial_sales_corporate_actions_and_collections():
+    lg = ledger('1000000', FREE)
+    for event, owner, price in [('a1', 'A', 100), ('b1', 'B', 200), ('a2', 'A', 120)]:
+        lg.buy(security_id='S', price=D(price), shares=1000, at=MON, event_id=event, owner=owner)
+    lg.apply_corporate_action(CorporateAction('split', 'S', 'split', MON, split_ratio=D('1.1')))
+    lg.apply_corporate_action(CorporateAction('stock', 'S', 'stock_dividend', MON, stock_ratio=D('0.1')))
+    pos = lg.positions['S']
+    assert pos.owner_quantity('A') == D(2420)
+    assert pos.owner_quantity('B') == D(1210)
+    before_b = [(lot.quantity, lot.cost_twd) for lot in pos.lots if lot.owner == 'B']
+    fill = lg.sell(security_id='S', price=D(100), shares=2000, at=MON, event_id='sale', owner='A')
+    assert isinstance(fill, Fill)
+    assert pos.owner_quantity('A') == D(420)
+    assert [(lot.quantity, lot.cost_twd) for lot in pos.lots if lot.owner == 'B'] == before_b
+    assert sum(l.cost_twd for l in pos.lots if l.owner == 'A') + (fill.gross-fill.realized_pnl) == D(220000)
+    action = CorporateAction('div', 'S', 'cash_dividend', MON, per_share_cash=D(2))
+    lg.apply_corporate_action(action)
+    assert lg.declared_dividends('S', 'A') == D(840)
+    assert lg.declared_dividends('S', 'B') == D(2420)
+    with pytest.raises(DuplicateCorporateAction):
+        lg.apply_corporate_action(action)
+    cash = lg.cash
+    lg.advance_to(FRI)
+    lg.set_payment_date('div', pay_at=MON+timedelta(days=1), at=FRI)
+    assert lg.cash == cash + D(3260)
+    assert not lg.receivables
+    assert [e.at for e in lg.events] == sorted(e.at for e in lg.events)
+    lg.advance_to(FRI+timedelta(days=7))
+    assert lg.cash == cash + D(3260)
+
+
+def test_control_canonical_forecast_all_fields_except_receipt_are_bound():
+    p = prospective_packet()
+    o = prospective_forecast(p, raw_response_hash='0'*64, independent_timestamp_receipt_id='a')
+    digest = sealed_forecast_digest(o, p)
+    for key in o:
+        changed = deepcopy(o)
+        changed[key] = {'changed': True}
+        if key == 'independent_timestamp_receipt_id':
+            assert sealed_forecast_digest(changed, p) == digest
+        else:
+            assert sealed_forecast_digest(changed, p) != digest, key
+    assert json.loads(sealed_forecast_bytes(o, p))['packet_hash'] == p.packet_hash()
+
+
+@pytest.mark.parametrize('offset', [-1, 1, 60, 86400])
+def test_control_week_plan_rejects_off_cutoff(offset):
+    with pytest.raises(ProtocolViolation):
+        plan_week(CUTOFF_2030+timedelta(seconds=offset), CAL_2030)
+
+
+@pytest.mark.parametrize('opening', [time(8), time(8, 30), time(8, 31)])
+def test_control_only_one_session_open_must_follow_deadline(opening):
+    monday = date(2030, 1, 7)
+    cal = TradingCalendar(start=date(2030,1,1), end=date(2030,1,31),
+        closures=[monday+timedelta(days=i) for i in range(1,5)],
+        session_overrides={monday: (opening,time(13,30))}, source_id='one', recorded_at=CUTOFF_2030)
+    plan = plan_week(CUTOFF_2030, cal)
+    assert plan.is_valid == (opening > time(8,30))
+    if plan.is_valid:
+        assert plan.deadline_at < plan.entry_at < plan.exit_at
+    else:
+        assert plan.entry_at is None and plan.exit_at is None
+

