    assert validate_prediction(base(status="abstained", ranking=[], status_reason="insufficient evidence")) == []


# ---- cadena prospectiva: sello ↔ predicción ↔ paquete ---------------------------
def test_r02_07_r03_04_r04_02_r04_03_seal_covers_forecast_and_packet(tmp_path):
    pkt = prospective_packet()
    obj = prospective_forecast(pkt)
    assert any("independent_timestamp_receipt_id" in p for p in validate_prediction(obj))
    obj["independent_timestamp_receipt_id"] = "inventado"
    assert any(p.startswith("prospective_requires_raw_store") for p in validate_prediction(obj, pkt))
    assert any(p.startswith("evidence_class_incompatible") for p in validate_prediction(obj, packet()))
    store, rec = archive_and_seal(tmp_path, obj, pkt)
    assert validate_prediction(obj, pkt, store=store) == []
    assert rec.sha256 == sealed_forecast_digest(obj, pkt)
    # R04-02: cambiar el ranking o el identificador tras sellar invalida el sello
    tampered = deepcopy(obj)
    tampered["ranking"][0]["security_id"] = "FUTURE-WINNER"
    assert "prospective_seal_digest_does_not_cover_this_forecast_and_packet" in validate_prediction(tampered, pkt, store=store)
    tampered2 = deepcopy(obj)
    tampered2["forecast_id"] = "retroactive-replacement"
    assert "prospective_seal_digest_does_not_cover_this_forecast_and_packet" in validate_prediction(tampered2, pkt, store=store)
    # R04-03: el mismo sello no sirve para otro paquete (el hash del paquete está dentro del digest)
    other = prospective_packet(cutoff=CUTOFF_2030 + timedelta(days=7))
    moved = prospective_forecast(other, independent_timestamp_receipt_id=obj["independent_timestamp_receipt_id"],
                                 raw_response_hash=obj["raw_response_hash"])
    assert "prospective_seal_digest_does_not_cover_this_forecast_and_packet" in validate_prediction(moved, other, store=store)
    # un recibo ajeno (otros bytes) tampoco
    foreign = store.put(source_id="weather", dataset="rain", payload=b"weather:rain=0", url="u")
    store.attach_receipt(foreign.capture_id, receipt_id="opentimestamps:w", authority="opentimestamps", digest=foreign.sha256, attested_at=foreign.ingested_at)
    obj2 = deepcopy(obj)
    obj2["independent_timestamp_receipt_id"] = "opentimestamps:w"
    assert "prospective_seal_digest_does_not_cover_this_forecast_and_packet" in validate_prediction(obj2, pkt, store=store)


def test_r04_01_seals_cannot_be_supplied_by_the_caller(tmp_path):
    pkt = prospective_packet()
    obj = prospective_forecast(pkt, independent_timestamp_receipt_id="fake", raw_response_hash="0" * 64)
    fake = SealInfo("fake", "fixture", "nonexistent", "0" * 64, CUTOFF_2030, CUTOFF_2030, True, {"packet_hash": pkt.packet_hash()})
    with pytest.raises(TypeError):
        validate_prediction(obj, pkt, seals={"fake": fake})   # type: ignore[call-arg]
    assert any(p.startswith("prospective_requires_raw_store") for p in validate_prediction(obj, pkt, store={"fake": fake}))  # type: ignore[arg-type]
    empty = RawStore(tmp_path)
    assert any(p.startswith("prospective_receipt_not_sealed") for p in validate_prediction(obj, pkt, store=empty))


def test_r04_04_attestation_after_deadline_is_rejected(tmp_path):
    pkt = prospective_packet()
    obj = prospective_forecast(pkt)
    late = (pkt.deadline_at + timedelta(days=7)).isoformat()
    store, _ = archive_and_seal(tmp_path, obj, pkt, attested_at=late, verifier=lambda rec, rc: rc.digest == rec.sha256)
    assert store.seals() and store.seals(not_after=pkt.deadline_at) == {}
    assert any(p.startswith("prospective_receipt_not_sealed") for p in validate_prediction(obj, pkt, store=store))


def test_p2_test_authority_seals_are_not_accepted_by_the_protocol(tmp_path):
    pkt = prospective_packet()
    obj = prospective_forecast(pkt)
    store, _ = archive_and_seal(tmp_path, obj, pkt, authority="fixture")
    assert store.seals(allow_test_authorities=True) and store.seals() == {}
    assert any(p.startswith("prospective_receipt_not_sealed") for p in validate_prediction(obj, pkt, store=store))


