def test_r04_01_prospective_evaluation_recomputes_seals_from_the_archive(tmp_path):
    from twlab.store import RawStore
    pro = [obs("2026-W30", 0.1, cls="prospective_registered", seal="cap-1")]
    with pytest.raises(ObservationError):
        block_bootstrap_mean(pro, block_length=1, n_boot=10, seed=1)                    # sin archivo: no hay sello
    store = RawStore(tmp_path, verifiers={"opentimestamps": lambda r, rc: rc.digest == r.sha256})
    rec = store.put(source_id="forecast", dataset="w30", payload=b"forecast bytes", url="u")
    unsealed = [obs("2026-W30", 0.1, cls="prospective_registered", seal=rec.capture_id)]
    with pytest.raises(ObservationError):
        block_bootstrap_mean(unsealed, block_length=1, n_boot=10, seed=1, store=store)   # captura sin recibo
    store.attach_receipt(rec.capture_id, receipt_id="ots:1", authority="opentimestamps", digest=rec.sha256, attested_at=rec.ingested_at)
    r = block_bootstrap_mean(unsealed, block_length=1, n_boot=10, seed=1, store=store)
    assert r.n_used == 1
    with pytest.raises(ObservationError):
        block_bootstrap_mean(unsealed, block_length=1, n_boot=10, seed=1, store={"cap-1": True})   # type: ignore[arg-type]


def test_r02_08_daily_rows_are_not_weeks_and_blocks_do_not_bridge_gaps():
    rows = [WeeklyObservation(f"2026-09-{d:02d}", f"f-{d}", CLEAN, None, True, 0.1) for d in range(7, 12)]
    with pytest.raises(ObservationError):
        block_bootstrap_mean(rows, block_length=1, n_boot=10, seed=1)
    gap = [obs("2026-W30", 0.1), obs("2026-W31", None, valid=False), obs("2026-W32", -0.1)]
    with pytest.raises(ObservationError):
        block_bootstrap_mean(gap, block_length=2, n_boot=10, seed=1)
    r = block_bootstrap_mean(gap, block_length=1, n_boot=50, seed=1)       # con bloque 1 se cuenta la inválida
    assert r.n_used == 2 and r.n_invalid_excluded == 1
    missing = [obs("2026-W30", 0.1), obs("2026-W32", -0.1)]
    with pytest.raises(ObservationError):
        block_bootstrap_mean(missing, block_length=2, n_boot=10, seed=1)


