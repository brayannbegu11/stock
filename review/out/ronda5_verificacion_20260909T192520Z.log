import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))

import json
from copy import deepcopy
from dataclasses import replace
from datetime import date, datetime, time, timedelta
from decimal import Decimal as D
import pytest
from tests.test_schema import base, packet, CAL, CUTOFF, DEADLINE
from tests.test_ledger import MON, FRI, FREE, ledger
from tests.test_master import R, sv
from tests.test_packet import doc
from twlab.calendar import TradingCalendar, CalendarRangeError
from twlab.weekly import plan_week
from twlab.packet import build_packet
from twlab.schemas import validate_prediction
from twlab.store import RawStore, SealInfo
from twlab.timeutil import TAIPEI, AvailabilityQuality as Q
from twlab.ledger import CorporateAction
from twlab.master import SecurityMaster
from twlab.simulation import enter_basket, exit_basket
from twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError


def live_packet(cutoff=None):
    return packet(documents=[], mode='prospective', evidence_class='prospective_registered',
                  captures={}, read_bytes=lambda r: b'', extractors={},
                  cutoff_at=cutoff or datetime.now(TAIPEI) - timedelta(hours=1))


def forecast(p, **kw):
    o = base(cutoff_at=p.cutoff_at.isoformat(), deadline_at=p.deadline_at.isoformat(),
             issued_at=(p.cutoff_at + timedelta(seconds=1)).isoformat(),
             evidence_class='prospective_registered', **kw)
    o['ranking'][0]['document_ids'] = []
    return o


def signed(tmp_path, p, payload=b'{"ranking":["SEC-1"]}', stamp=None):
    # Fixture only: deliberately not a cryptographic verifier.
    s = RawStore(tmp_path, verifiers={'opentimestamps': lambda r, rc: rc.digest == r.sha256})
    r = s.put(source_id='forecast', dataset='L1', payload=payload, url='fixture',
              extra={'packet_hash': p.packet_hash()})
    s.attach_receipt(r.capture_id, receipt_id='ots:test', authority='opentimestamps',
                     digest=r.sha256, attested_at=(stamp or r.ingested_at))
    o = forecast(p, independent_timestamp_receipt_id='ots:test', raw_response_hash=r.sha256)
    return s, r, o


def test_p2_fabricated_seal_without_any_archive():
    p = live_packet(CUTOFF)
    o = forecast(p, independent_timestamp_receipt_id='fake', raw_response_hash='0'*64)
    forged = SealInfo('fake', 'fixture', 'nonexistent', '0'*64, CUTOFF, CUTOFF,
                      True, {'packet_hash': p.packet_hash()})
    problems = validate_prediction(o, p, seals={'fake': forged})
    assert problems, 'No archive, no verifier, fixture authority, production=True: accepted'


def test_seal_does_not_authenticate_validated_ranking(tmp_path):
    p = live_packet()
    s, r, o = signed(tmp_path, p)
    assert validate_prediction(o, p, seals=s.seals()) == []
    o['ranking'][0]['security_id'] = 'FUTURE-WINNER'
    o['forecast_id'] = 'retroactive-replacement'
    assert validate_prediction(o, p, seals=s.seals()), 'Archived SEC-1 authenticates FUTURE-WINNER'


def test_unsigned_packet_binding_can_be_reassigned(tmp_path):
    p = live_packet()
    s, r, o = signed(tmp_path, p)
    seals = s.seals()
    p2 = live_packet(p.cutoff_at - timedelta(minutes=5))
    o['cutoff_at'] = p2.cutoff_at.isoformat()
    assert validate_prediction(o, p2, seals=seals)
    seals['ots:test'].capture_extra['packet_hash'] = p2.packet_hash()
    assert validate_prediction(o, p2, seals=seals), 'Unsigned mutable metadata rebinds unchanged receipt'


def test_attestation_after_deadline_is_rejected_by_validator(tmp_path):
    p = live_packet()
    s, r, o = signed(tmp_path, p, stamp=(p.deadline_at + timedelta(days=7)).isoformat())
    assert s.seals(not_after=p.deadline_at) == {}
    assert validate_prediction(o, p, seals=s.seals()), 'Attestation one week late accepted through seals()'


def test_midweek_cutoff_cannot_reissue_weekly_selection():
    cutoff = datetime.fromisoformat('2026-09-10T02:00:00+08:00')
    try:
        p = packet(cutoff_at=cutoff)
    except ValueError:
        return
    o = base(cutoff_at=cutoff.isoformat(), issued_at='2026-09-10T07:00:00+08:00',
             deadline_at=p.deadline_at.isoformat())
    assert validate_prediction(o, p), (p.week_id, p.entry_at, p.exit_at)


def test_week_plan_never_enters_before_forecast_deadline():
    cal = TradingCalendar(start=date(2026,1,1), end=date(2026,12,31), closures=[],
                          source_id='synthetic', recorded_at=R(2026,1,1),
                          session_overrides={date(2026,9,7): (time(8), time(13,30))})
    p = plan_week(CUTOFF, cal)
    assert p.entry_at > p.deadline_at, (p.entry_at, p.deadline_at)


def test_packet_payload_identity_includes_json_types(tmp_path):
    s = RawStore(tmp_path)
    r = s.put(source_id='test', dataset='x', payload=b'{"revenue":true}', url='fixture')
    d = doc('d', r.ingested_at_dt, capture=r, payload={'revenue': 1}, derivation='json')
    p = build_packet(packet_id='p', cutoff_at=r.ingested_at_dt, documents=[d],
                     mode='prospective', evidence_class='prospective_registered', calendar=CAL,
                     captures={r.capture_id:r}, read_bytes=s.read, extractors={'json':json.loads})
    assert not p.admitted, 'Boolean true became numerical revenue=1'


def test_late_known_payment_does_not_backdate_cash_event():
    lg = ledger(costs=FREE)
    lg.buy(security_id='A', price=D(100), shares=1000, at=MON, event_id='buy')
    lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', MON, per_share_cash=D(1)))
    lg.advance_to(FRI)
    lg.set_payment_date('div', pay_at=MON+timedelta(days=1), at=FRI)
    ats = [e.at for e in lg.events]
    assert ats == sorted(ats), [(e.kind,e.at,e.cash_delta) for e in lg.events]


def test_previous_blocked_basket_does_not_own_later_purchase():
    lg = ledger('300000',FREE)
    args = dict(picks=['A'], slots=1, notional_per_slot=D(100000), open_prices={'A':D(100)})
    w1 = enter_basket(lg, **args, at=MON, week_id='w1')
    exit_basket(lg,w1,close_prices={},at=FRI,week_id='w1')
    w2 = enter_basket(lg, **args, at=MON+timedelta(days=7),week_id='w2')
    exit_basket(lg,w1,close_prices={'A':D(100)},at=FRI+timedelta(days=7),week_id='w1')
    assert w1[0].gross_pick_return == D(0), w1[0]
    assert lg.positions['A'].total_quantity >= D(w2[0].entry.shares)


def test_exit_residual_uses_same_proportion_as_attributed_quantity():
    lg = ledger('400000',FREE)
    lg.buy(security_id='A',price=D(100),shares=1000,at=MON,event_id='old')
    w = enter_basket(lg,picks=['A'],slots=1,notional_per_slot=D(100000),open_prices={'A':D(100)},at=MON,week_id='w')
    lg.apply_corporate_action(CorporateAction('sp','A','split',MON,split_ratio=D('1.1')))
    exit_basket(lg,w,close_prices={'A':D(100)/D('1.1')},at=FRI,week_id='w')
    assert lg.positions['A'].total_quantity == D(200)
    assert w[0].exit_residual_quantity == D(100), w[0]


def test_cash_dividend_is_in_gross_total_pick_return():
    lg = ledger('100000',FREE)
    w = enter_basket(lg,picks=['A'],slots=1,notional_per_slot=D(100000),open_prices={'A':D(100)},at=MON,week_id='w')
    lg.apply_corporate_action(CorporateAction('div','A','cash_dividend',MON+timedelta(days=1),per_share_cash=D(1),pay_at=FRI))
    exit_basket(lg,w,close_prices={'A':D(99)},at=FRI,week_id='w')
    assert lg.cash == D(100000)
    assert w[0].gross_pick_return == D(0), w[0].gross_pick_return


def test_same_master_key_cannot_rewrite_known_history():
    m = SecurityMaster()
    a = sv(security_id='A',symbol='1111',valid_from=date(2020,1,1),recorded_at=R(2020,1,1))
    m.add(a)
    before = m.universe(as_of=date(2020,6,1),known_at=R(2020,6,1))
    try:
        m.add(sv(security_id='A',symbol='2222',valid_from=a.valid_from,recorded_at=a.recorded_at))
    except ValueError:
        return
    assert m.universe(as_of=date(2020,6,1),known_at=R(2020,6,1)) == before


def test_empty_week_invalid_record_needs_no_fictitious_deadline():
    cutoff = datetime.fromisoformat('2026-02-15T18:00:00+08:00')
    p = packet(cutoff_at=cutoff)
    assert p.deadline_at is None
    o = base(cutoff_at=cutoff.isoformat(),issued_at=(cutoff+timedelta(hours=1)).isoformat(),
             deadline_at=None,status='invalid',ranking=[],status_reason='no_sessions')
    assert validate_prediction(o,p) == []


def test_control_incomplete_calendar_coverage_fails_closed():
    cutoff = datetime.fromisoformat('2026-12-27T18:00:00+08:00')
    with pytest.raises(CalendarRangeError):
        plan_week(cutoff,CAL)


def test_document_security_identity_must_come_from_extraction(tmp_path):
    s = RawStore(tmp_path)
    raw = b'{"security_id":"SEC-1","revenue":100}'
    r = s.put(source_id='test',dataset='revenue',payload=raw,url='fixture')
    d = replace(doc('d',r.ingested_at_dt,capture=r,payload=json.loads(raw)),security_ids=('SEC-2',))
    p = build_packet(packet_id='p',cutoff_at=r.ingested_at_dt,documents=[d],
                     mode='prospective',evidence_class='prospective_registered',calendar=CAL,
                     captures={r.capture_id:r},read_bytes=s.read,extractors={'json':json.loads})
    assert not p.admitted, 'SEC-1 archived revenue admitted as SEC-2 document'


def test_prospective_evaluation_cannot_be_enabled_with_boolean():
    row = WeeklyObservation('2026-W37','never-archived','prospective_registered',True,True,0.10)
    try:
        result = block_bootstrap_mean([row],block_length=1,n_boot=10,seed=1)
    except ObservationError:
        return
    pytest.fail(f'No prediction, store or receipt, prospective evaluation returned {result}')


def test_control_packet_rechecks_bytes_and_extractor_errors(tmp_path):
    s = RawStore(tmp_path)
    raw = b'{"revenue":100}'
    r = s.put(source_id='test',dataset='revenue',payload=raw,url='fixture')
    d = doc('d',r.ingested_at_dt,capture=r,payload=json.loads(raw))
    args = dict(packet_id='p',cutoff_at=r.ingested_at_dt,documents=[d],mode='prospective',
                evidence_class='prospective_registered',calendar=CAL,captures={r.capture_id:r})
    assert build_packet(**args,read_bytes=s.read,extractors={'json':json.loads}).admitted
    assert not build_packet(**args,read_bytes=lambda r:b'{"revenue":999}',extractors={'json':json.loads}).admitted
    assert not build_packet(**args,read_bytes=s.read,extractors={}).admitted
    def broken(raw):
        raise ValueError('broken extractor')
    assert not build_packet(**args,read_bytes=s.read,extractors={'json':broken}).admitted


def test_control_all_accepted_master_views_remain_nonoverlapping():
    import random
    rng = random.Random(20260909)
    for _ in range(30):
        m = SecurityMaster()
        for _ in range(30):
            a = rng.randrange(2020,2025)
            b = rng.randrange(a+1,2027)
            v = sv(security_id='A',symbol='1111',valid_from=date(a,1,1),valid_to=date(b,1,1),
                   recorded_at=R(rng.randrange(2020,2027),1,1))
            try:
                m.add(v)
            except ValueError:
                continue
            for known in [R(y,6,1) for y in range(2020,2028)] + [None]:
                rows = m._effective(known)
                assert all(not a.overlaps(b) for i,a in enumerate(rows) for b in rows[i+1:])
