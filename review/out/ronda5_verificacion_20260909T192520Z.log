def live_packet(cutoff=None):
    return packet(documents=[], mode='prospective', evidence_class='prospective_registered',
                  captures={}, read_bytes=lambda r: b'', extractors={},
                  cutoff_at=cutoff or datetime.now(TAIPEI) - timedelta(hours=1))


def forecast(p, **kw):
    o = base(cutoff_at=p.cutoff_at.isoformat(), deadline_at=p.deadline_at.isoformat(),
             issued_at=(p.cutoff_at + timedelta(seconds=1)).isoformat(),
             evidence_class='prospective_registered', **kw)
    o['ranking'][0]['document_ids'] = []
    return o


def signed(tmp_path, p, payload=b'{"ranking":["SEC-1"]}', stamp=None):
    # Fixture only: deliberately not a cryptographic verifier.
    s = RawStore(tmp_path, verifiers={'opentimestamps': lambda r, rc: rc.digest == r.sha256})
    r = s.put(source_id='forecast', dataset='L1', payload=payload, url='fixture',
              extra={'packet_hash': p.packet_hash()})
    s.attach_receipt(r.capture_id, receipt_id='ots:test', authority='opentimestamps',
                     digest=r.sha256, attested_at=(stamp or r.ingested_at))
    o = forecast(p, independent_timestamp_receipt_id='ots:test', raw_response_hash=r.sha256)
    return s, r, o


