      "prueba_propuesta": "from dataclasses import replace\nfrom tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal\nfrom twlab.packet import Rejection, PredictorView\nfrom twlab.schemas import validate_prediction\n\ndef test_contenido_visible_del_paquete_queda_sellado(tmp_path):\n    p = prospective_packet()\n    obj = prospective_forecast(p)\n    s, _ = archive_and_seal(tmp_path, obj, p)\n    changed = replace(p, rejected=(Rejection('future', 'available_after_cutoff', '2030-W02 future winner A +50%'),))\n    assert PredictorView(changed).packet().rejected != p.rejected\n    assert validate_prediction(obj, changed, store=s)\n",
