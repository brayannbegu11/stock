+def test_control_canonical_forecast_all_fields_except_receipt_are_bound():
+    p = prospective_packet()
+    o = prospective_forecast(p, raw_response_hash='0'*64, independent_timestamp_receipt_id='a')
+    digest = sealed_forecast_digest(o, p)
+    for key in o:
+        changed = deepcopy(o)
+        changed[key] = {'changed': True}
+        if key == 'independent_timestamp_receipt_id':
+            assert sealed_forecast_digest(changed, p) == digest
+        else:
+            assert sealed_forecast_digest(changed, p) != digest, key
+    assert json.loads(sealed_forecast_bytes(o, p))['packet_hash'] == p.packet_hash()
+
