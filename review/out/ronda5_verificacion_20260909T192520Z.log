      "prueba_propuesta": "from decimal import Decimal as D\nfrom tests.test_ledger import ledger, FREE, MON, FRI\nfrom twlab.ledger import CorporateAction\n\ndef test_dividendo_no_depende_de_fragmentar_compra():\n    def paid(quantities):\n        lg = ledger('300000', FREE)\n        for i, n in enumerate(quantities):\n            lg.buy(security_id='A', price=D(100), shares=n, at=MON, event_id=f'b{i}', owner='same')\n        lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', MON, per_share_cash=D('1.2345'), pay_at=FRI))\n        lg.advance_to(FRI)\n        return lg.cash\n    assert paid([1000, 1000]) == paid([2000])\n",
