+    monday = date(2030, 1, 7)
+    cal = TradingCalendar(start=date(2030,1,1), end=date(2030,1,31),
+        closures=[monday+timedelta(days=i) for i in range(1,5)],
+        session_overrides={monday: (opening,time(13,30))}, source_id='one', recorded_at=CUTOFF_2030)
+    plan = plan_week(CUTOFF_2030, cal)
+    assert plan.is_valid == (opening > time(8,30))
+    if plan.is_valid:
+        assert plan.deadline_at < plan.entry_at < plan.exit_at
+    else:
