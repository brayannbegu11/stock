      "comando_reproduccion": "python -B -m pytest -q -p no:cacheprovider review/out/astra_scratch/test_ronda5.py::test_invalid_unsealed_run_is_counted_in_prospective_coverage --basetemp=review/out/astra_scratch/r5_p10",
      "prueba_propuesta": "from tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal\nfrom twlab.evaluation import WeeklyObservation, block_bootstrap_mean\n\ndef test_cobertura_conserva_fallo_sin_prediccion(tmp_path):\n    p = prospective_packet()\n    obj = prospective_forecast(p)\n    s, r = archive_and_seal(tmp_path, obj, p)\n    rows = [WeeklyObservation(p.week_id, obj['forecast_id'], 'prospective_registered', r.capture_id, True, 0.1), WeeklyObservation('2030-W03', 'failed-run', 'prospective_registered', None, False, None)]\n    result = block_bootstrap_mean(rows, block_length=1, n_boot=20, seed=1, store=s)\n    assert result.n_used == 1\n    assert result.n_invalid_excluded == 1\n",
