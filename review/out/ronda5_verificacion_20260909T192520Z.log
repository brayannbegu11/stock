      "prueba_propuesta": "import pytest\nfrom datetime import timedelta\nfrom tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal\nfrom twlab.schemas import validate_prediction\nfrom twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError\n\ndef test_evaluacion_rechaza_sello_tardio(tmp_path):\n    p = prospective_packet()\n    obj = prospective_forecast(p)\n    s, r = archive_and_seal(tmp_path, obj, p, attested_at=(p.deadline_at + timedelta(days=7)).isoformat())\n    assert validate_prediction(obj, p, store=s)\n    row = WeeklyObservation(p.week_id, obj['forecast_id'], 'prospective_registered', r.capture_id, True, 0.1)\n    with pytest.raises(ObservationError):\n        block_bootstrap_mean([row], block_length=1, n_boot=20, seed=1, store=s)\n",
