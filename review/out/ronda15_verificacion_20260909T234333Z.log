      "prueba_propuesta": "from review.out.astra_scratch.test_r15_attacks import ledger\nfrom review.out.astra_scratch.r10_support import D, date, taipei\nfrom twlab.ledger import CorporateAction, Fill\n\ndef test_sale_cannot_exceed_exact_holding():\n    lg = ledger()\n    lg.apply_corporate_action(CorporateAction('rs', 'A', 'split', taipei(date(2024,1,9)),\n        split_ratio=D('0.99999999999999999999999999999')))\n    assert lg.positions['A'].lots[0].rational() < 1000\n    result = lg.sell(security_id='A', price=D(100), shares=1000,\n        at=taipei(date(2024,1,10)), event_id='sell')\n    assert not isinstance(result, Fill)\n",
