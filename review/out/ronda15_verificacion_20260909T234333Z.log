+from pathlib import Path
+
+root = Path(__file__).resolve().parent
+s = (root / 'test_r14_verifications.py').read_text(encoding='utf-8')
+s = s.replace("assert {'open','close','adjusted'} <= KNOWN_DOCUMENT_KINDS", "assert not ({'open','close','adjusted'} & KNOWN_DOCUMENT_KINDS)")
+s = s.replace("        assert Document('d',kind,'test',(),taipei(date(2024,1,2)),AvailabilityQuality.VERIFIED_ORIGINAL).kind==kind", "        with pytest.raises(ValueError):\n            Document('d',kind,'test',(),taipei(date(2024,1,2)),AvailabilityQuality.VERIFIED_ORIGINAL)")
+(root / 'test_r15_verifications.py').write_text(s, encoding='utf-8')
+s = (root / 'test_r14_attacks.py').read_text(encoding='utf-8')
+s = s.replace("assert s.events[0].stock_ratio==D(0)", "assert s.events[0].stock_ratio==D('0.1')")
+s = s.replace("stock_ratio=ratio)", "stock_ratio=None)")
+# The direct cache API requires the caller to version its inputs. Test the new
+# protection at the MarketData/TabularForecaster boundary in test_r15_attacks.
+s = s.replace('def test_cached_clean_row_must_not_survive_ambiguity', 'def direct_cache_example_not_collected')
+(root / 'test_r15_previous_attacks.py').write_text(s, encoding='utf-8')
