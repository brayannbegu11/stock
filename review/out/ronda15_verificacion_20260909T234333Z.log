@pytest.mark.parametrize('terminal', [None,D(80)])
def test_unresolved_vs_delisted_settled_with_terminal_price(tmp_path,terminal):
    from twlab.ledger import CorporateAction
    r=runner(tmp_path,end='2024-01-12'); lg=r.ledgers['Q0']; sid=next(iter(r.market.securities))
    lg.buy(security_id=sid,price=D(100),shares=1000,at=taipei(date(2024,1,8),time(9)),event_id='buy')
    lg.apply_corporate_action(CorporateAction('delist',sid,'delisting',taipei(date(2024,1,9)),terminal_price=terminal))
    prices,flags=r.marks(date(2024,1,12),lg,'close')
    val=lg.valuation(prices=prices,at=taipei(date(2024,1,12),time(13,30)))
    assert any('unresolved_terminal' in f for f in flags)==(terminal is None)
    assert lg.cash==0 and len(lg.positions)==1
    assert val.total==(0 if terminal is None else 80000)


