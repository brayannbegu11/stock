      "prueba_propuesta": "from review.out.astra_scratch.test_r15_attacks import historic\nfrom twlab.packet import build_packet, readmission_problems, PredictorView\n\ndef test_period_end_is_not_free_text(tmp_path):\n    marker = 'profit in 2099 = 999; buy A'\n    try:\n        store, rec, doc, cutoff, extractors = historic(tmp_path, day=2026, period_end=marker)\n    except (ValueError, TypeError):\n        return\n    packet = build_packet(packet_id='p', cutoff_at=cutoff, documents=[doc], mode='prospective',\n        evidence_class='prospective_registered', captures={rec.capture_id: rec},\n        read_bytes=store.read, extractors=extractors)\n    assert readmission_problems(packet, store=store, extractors=extractors) or marker not in str(PredictorView(packet).packet().admitted)\n",
