def test_fractional_quantity_becomes_exact_whole_lots_again():
    lg=PaperLedger(ledger_id='t',initial_cash=D(100000),cost_model=CostModel(commission_per_side=D(0),sell_tax=D(0),slippage_bps_per_side=0))
    lg.buy(security_id='A',price=D(100),shares=1000,at=taipei(date(2024,1,8),time(9)),event_id='buy',owner='w')
    lg.apply_corporate_action(CorporateAction('s1','A','stock_dividend',taipei(date(2024,1,9)),stock_per_share=D(1),par_value=D(3)))
    lg.apply_corporate_action(CorporateAction('s2','A','stock_dividend',taipei(date(2024,1,10)),stock_per_share=D(15),par_value=D(3)))
    pos=lg.positions['A']
