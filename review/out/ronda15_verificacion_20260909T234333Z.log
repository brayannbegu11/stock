      "prueba_propuesta": "from review.out.astra_scratch.test_r15_attacks import historic\nfrom twlab.packet import build_packet\n\ndef test_historical_source_can_be_captured_today(tmp_path):\n    store, rec, doc, cutoff, extractors = historic(tmp_path)\n    packet = build_packet(packet_id='p', cutoff_at=cutoff, documents=[doc], mode='historical',\n        evidence_class='historical_numeric_temporally_controlled', captures={rec.capture_id: rec},\n        read_bytes=store.read, extractors=extractors)\n    assert packet.admitted, packet.rejected\n    assert packet.admitted[0].first_seen_at == rec.ingested_at_dt\n",
