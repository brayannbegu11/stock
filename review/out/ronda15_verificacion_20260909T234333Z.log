@dataclass(frozen=True)
class DividendLike:
    """Un derecho con fecha ex para la etiqueta de retorno total.

    ``event_id`` identifica el evento como en el libro (un mismo derecho repetido no se aplica dos veces, R11-02);
    ``known_at`` es el instante en que el derecho era p├║blico (anuncio); ``None`` = desconocido, y entonces la
    etiqueta de esa semana no puede madurar (R11-01). ``kind`` ordena efectivo antes que acciones el mismo d├¡a,
    como el libro.
    """
    event_id: str
    ex_date: date
    kind: str                                   # cash | stock
    cash_per_share: Decimal = Decimal(0)
    stock_ratio: Decimal = Decimal(0)
    known_at: Optional[datetime] = None
    pay_date: Optional[date] = None             # efectivo: fecha de pago (la usa el libro; nunca anterior a la fecha ex)
    known_quality: str = "unknown"              # verified_original | conservative_inference | unknown
    stock_per_share: Decimal = Decimal(0)       # acciones: TWD de valor nominal por acci├│n (forma exacta, R13-07)
    par_value: Decimal = Decimal(0)
    ambiguous: bool = False                     # derecho con filas contradictorias o inv├ílidas: invalida etiquetas e intervalos (R13-05)

    def __post_init__(self) -> None:
        """La forma exacta manda: ``stock_ratio`` se deriva de ella y no puede contradecirla (R14-08)."""
        if self.kind not in ("cash", "stock"):
            raise ValueError(f"unknown right kind {self.kind!r}")
        if self.kind == "stock" and not self.ambiguous and self.par_value > 0:
            derived = self.stock_per_share / self.par_value
            if self.stock_ratio == 0:
                object.__setattr__(self, "stock_ratio", derived)
