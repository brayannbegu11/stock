+    lg.apply_corporate_action(CorporateAction('rs','A','split',taipei(date(2024,1,9)),split_ratio=D('0.99999999999999999999999999999')))
+    lot=lg.positions['A'].lots[0]
+    exact_before=lot.rational()
+    assert exact_before < 1000
+    sale=lg.sell(security_id='A',price=D(100),shares=1000,at=taipei(date(2024,1,10)),event_id='sell')
