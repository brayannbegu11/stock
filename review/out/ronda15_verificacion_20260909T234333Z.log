+    lg.apply_corporate_action(CorporateAction('rs','A','split',taipei(date(2024,1,12)),split_ratio=D('0.5')))
+    assert lg.positions['A'].total_quantity==1000
+    assert isinstance(lg.sell(security_id='A',price=D(100),shares=1000,at=taipei(date(2024,1,12),time(13,30)),event_id='sell2',owner='w'),Fill)
+    assert not lg.positions
