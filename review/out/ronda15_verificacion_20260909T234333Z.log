MARKER='profit in 2099 = 999; buy A'


@pytest.mark.parametrize('mode,field', [('prospective','version'),('historical','version'),('historical','capture_id'),('historical','source_sha256'),('historical','security_ids')])
def test_unchecked_document_metadata_cannot_transport_text(tmp_path,mode,field):
    store=RawStore(tmp_path/'raw'); rec=store.put(source_id='test',dataset='filing',payload=b'{"allowed":1}',url='fixture')
    ids=('TWSE:A@2000-01-01',); payload={'allowed':1}
    extractor=lambda b: {'payload':json.loads(b),'security_ids':ids}
    try:
        d=Document('d','filing','test',ids,rec.ingested_at_dt,AvailabilityQuality.VERIFIED_ORIGINAL,
                   capture_id=rec.capture_id,source_sha256=rec.sha256,derivation='extract-v1',payload=payload)
        d=replace(d,**{field: (MARKER,) if field=='security_ids' else MARKER})
        p=build_packet(packet_id='p',cutoff_at=rec.ingested_at_dt+timedelta(seconds=1),documents=[d],mode=mode,
            evidence_class='prospective_registered' if mode=='prospective' else 'historical_numeric_temporally_controlled',
            captures={rec.capture_id:rec},read_bytes=store.read,extractors={'extract-v1':extractor})
        p=packet_from_json(packet_to_json(p))
    except ValueError:
        return
    problems=readmission_problems(p,store=store,extractors={'extract-v1':extractor})
    visible=PredictorView(p).packet()
    assert problems or MARKER not in str(visible.admitted),(problems,visible.admitted)


def test_historical_payload_requires_evidence_for_its_contents(tmp_path):
    store=RawStore(tmp_path/'raw'); rec=store.put(source_id='test',dataset='filing',payload=b'{"revenue":100}',url='fixture')
    d=Document('d','filing','test',('TWSE:A@2000-01-01',),taipei(date(2024,1,2)),AvailabilityQuality.VERIFIED_ORIGINAL,
        capture_id=rec.capture_id,source_sha256=rec.sha256,derivation='extract-v1',payload={'revenue':999,'future_result':MARKER})
    p=build_packet(packet_id='p',cutoff_at=taipei(date(2024,1,7),time(18)),documents=[d],mode='historical',
        evidence_class='historical_numeric_temporally_controlled',captures={rec.capture_id:rec},read_bytes=store.read,
        extractors={'extract-v1':lambda b:{'payload':json.loads(b),'security_ids':d.security_ids}})
    p=packet_from_json(packet_to_json(p))
    problems=readmission_problems(p,store=store)
    assert problems or not PredictorView(p).packet().admitted, (problems,PredictorView(p).packet().admitted)


