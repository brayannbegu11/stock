      "prueba_propuesta": "from fractions import Fraction\nfrom review.out.astra_scratch.test_r15_attacks import ledger, action\nfrom review.out.astra_scratch.r10_support import D, date, taipei\nfrom twlab.ledger import CorporateAction\n\ndef test_exact_cash_entitlement():\n    lg = ledger()\n    action(lg, 's', 9, 1, 3)\n    assert lg.positions['A'].lots[0].rational() == Fraction(4000, 3)\n    lg.apply_corporate_action(CorporateAction('c', 'A', 'cash_dividend',\n        taipei(date(2024,1,10)), per_share_cash=D(3)))\n    assert lg.receivables[0].amount == D(4000)\n",
