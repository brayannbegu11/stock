@pytest.mark.parametrize('ratio', [D(0)])
def test_informational_ratio_cannot_override_exact_form(ratio):
    lg=PaperLedger(ledger_id='t',initial_cash=D(400000),cost_model=CostModel(commission_per_side=D(0)))
    lg.buy(security_id='A',price=D(100),shares=3000,at=taipei(date(2024,1,8),time(9)),event_id='buy')
