def test_cached_clean_row_must_not_survive_ambiguity(tmp_path):
    _,m=fixture(tmp_path,end='2024-01-12',dividends=[cash(10)])
    sid=next(iter(m.securities)); events=m.securities[sid].events; cache={}
    kwargs=dict(now_cutoff=taipei(date(2024,1,14),time(18)),calendar=m.calendar,dividends_by_security={sid:events},cache=cache,data_version=m.data_version)
    args=({sid:m.securities[sid].bars},[taipei(date(2024,1,7),time(18))])
    clean=q1.build_training_rows(*args,**kwargs)
    assert len(clean)==1
    events[0]=replace(events[0],ambiguous=True)
    assert q1.weekly_label(m.by_session[sid],date(2024,1,8),date(2024,1,12),events) is None
    stale=q1.build_training_rows(*args,**kwargs)
    print('CACHE',len(stale),stale[0].label if stale else None)
    assert not stale,stale


