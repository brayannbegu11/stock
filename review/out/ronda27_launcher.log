[31;1m[0m
[31;1mfunction Get-TreeHashes {[0m
[31;1m  $paths = @("docs", "src", "tests", "scripts", "AGENTS.md", "pyproject.toml", "README.md", "review\prompts", "review\schemas", "data\reference", "data\audit")[0m
