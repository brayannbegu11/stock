[31;1m    Sort-Object FullName |[0m
[31;1m    ForEach-Object { "{0}  {1}" -f (Get-FileHash -Algorithm SHA256 $_.FullName).Hash, $_.FullName.Substring($root.Length + 1) }[0m
[31;1m}[0m
[31;1m[0m
[31;1m$before = Get-TreeHashes[0m
