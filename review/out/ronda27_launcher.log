[31;1mGet-Content $prompt -Raw | codex exec `[0m
[31;1m  --skip-git-repo-check `[0m
[31;1m  -C $root `[0m
[31;1m  -s workspace-write `[0m
[31;1m  -c "model_reasoning_effort=`"$Effort`"" `[0m
