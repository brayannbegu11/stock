[31;1m      "prueba_propuesta": "from review.out.astra_scratch.test_r23 import setup\nfrom review.out.astra_scratch.test_r25 import rewrite_manifest\nfrom twlab.packet import packet_from_json\n\ndef test_clasificacion_usa_una_generacion(tmp_path, monkeypatch):\n    raw, market, data, ex, w = setup(tmp_path, monkeypatch)\n    src = packet_from_json(raw.read(raw.get(w['packet_capture']))).admitted[0].capture_id\n    fid = w['forecasters']['Q0']['forecast_capture_id']\n    rewrite_manifest(raw, lambda rows: [r.update(clock_source='injected') for r in rows if r['capture_id'] == src])\n    assert not ex.classify_week('lab', w)['prospective']\n    original = ex.forecast_archive\n    def switch(*args, **kwargs):\n        result = original(*args, **kwargs)\n        def mutate(rows):\n            for r in rows:\n                if r['capture_id'] == src: r['clock_source'] = 'system'\n                if r['capture_id'] == fid: r['clock_source'] = 'injected'\n        rewrite_manifest(raw, mutate)\n        return result\n    monkeypatch.setattr(ex, 'forecast_archive', switch)\n    mixed = ex.classify_week('lab', w)\n    monkeypatch.setattr(ex, 'forecast_archive', original)\n    assert not ex.classify_week('lab', w)['prospective']\n    assert not mixed['prospective']\n",[0m
