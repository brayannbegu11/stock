[31;1m    html = pat.sub(lambda m: m.group(1) + "\n" + safe + "\n" + m.group(3), html, count=1)[0m
[31;1m    INDEX.write_text(html, encoding="utf-8", newline="\n")[0m
[31;1m    return True[0m
