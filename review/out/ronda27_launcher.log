[31;1m)[0m
[31;1m$ErrorActionPreference = "Stop"[0m
[31;1m$root = Split-Path -Parent $PSScriptRoot[0m
[31;1m$prompt = Join-Path $root "review\prompts\$Ronda.md"[0m
[31;1mif (-not (Test-Path $prompt)) { throw "No existe el prompt $prompt" }[0m
[31;1m$stamp = (Get-Date).ToUniversalTime().ToString("yyyyMMddTHHmmssZ")[0m
[31;1m$outDir = Join-Path $root "review\out"[0m
