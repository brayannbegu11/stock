[31;1m    raw = sealed_forecast_bytes(obj, pkt)                                          # predicción completa + hash del paquete[0m
[31;1m    rec = store.put(source_id="forecast", dataset=obj["experiment_id"], payload=raw, url="model://fable")[0m
[31;1m    store.attach_receipt(rec.capture_id, receipt_id=f"{authority}:f1", authority=authority, digest=rec.sha256,[0m
[31;1m                         attested_at=attested_at or rec.ingested_at)[0m
[31;1m    obj["independent_timestamp_receipt_id"] = f"{authority}:f1"                    # asignado después del sello[0m
[31;1m    return store, rec[0m
