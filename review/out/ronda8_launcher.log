[31;1m+def test_segmented_bootstrap_preserves_week_weights(monkeypatch):[0m
[31;1m+    import random[0m
[31;1m+    from twlab import evaluation[0m
[31;1m+    chosen = [][0m
[31;1m+    original = random.Random[0m
[31;1m+    class TrackedRandom:[0m
[31;1m+        def __init__(self, seed):[0m
[31;1m+            self.rng = original(seed)[0m
[31;1m+        def randrange(self, n):[0m
[31;1m+            x = self.rng.randrange(n)[0m
[31;1m+            chosen.append(x)[0m
[31;1m+            return x[0m
[31;1m+    monkeypatch.setattr(evaluation.random,'Random',TrackedRandom)[0m
[31;1m+    # Two constant segments, lengths 4 and 8; one absent week in between.[0m
[31;1m+    dates = [date(2024,1,1)+timedelta(weeks=i) for i in list(range(4))+list(range(5,13))][0m
[31;1m+    vals = [1.] * 4 + [0.] * 8[0m
[31;1m+    obs = [WeeklyObservation(f'{d.isocalendar().year}-W{d.isocalendar().week:02}',str(i),'historical_numeric_temporally_controlled',None,True,v)[0m
[31;1m+           for i,(d,v) in enumerate(zip(dates,vals))][0m
[31;1m+    result = block_bootstrap_mean(obs,block_length=4,n_boot=10000,seed=1)[0m
[31;1m+    starts = evaluation._block_starts(dates,4)[0m
[31;1m+    # Every draw has length 4, exactly 3 draws per replicate. Observe actual resampling weights.[0m
[31;1m+    boot_mean = sum(sum(vals[s:s+n]) for s,n in (starts[i] for i in chosen)) / (10000*12)[0m
[31;1m+    assert abs(boot_mean-result.mean) < .02, (result.mean,boot_mean,starts)[0m
[31;1m+[0m
