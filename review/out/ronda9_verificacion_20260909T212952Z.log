_SESSION_MARKERS = ("ΘûïσºïΣ║ñµÿô", "µ£Çσ╛îΣ║ñµÿô", "µ¡úσ╕╕Σ║ñµÿô")
_CLOSURE_MARKERS = ("µö╛σüç", "Φú£σüç", "σ╕éσá┤τäíΣ║ñµÿô", "Σ╝æσ╕é")
_NEGATION_PREFIXES = ("Σ╕ì", "µ£¬", "σÅûµ╢ê", "Θ¥₧", "τäí")   # cualquier marcador precedido de negaci├│n ΓåÆ revisi├│n (R03-12)


