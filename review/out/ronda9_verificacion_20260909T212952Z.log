+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / 'src'))
+import json
+from dataclasses import replace
+from datetime import date, time, timedelta
+from decimal import Decimal as D
+import pytest
+from twlab.calendar import TradingCalendar, CalendarStore, CalendarRangeError, load_twse_reference_calendar, classify_holiday_row_en
+from twlab.packet import Document, Rejection, readmission_problems, build_packet, packet_to_json, packet_from_json
+from twlab.store import RawStore
+from twlab.master import SecurityMaster, SecurityVersion, security_id_for
+from twlab.sources.twse import DelistingRow, resolve_delistings
+from twlab.timeutil import taipei, AvailabilityQuality as Q
+from twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError
+from tests.test_schema import prospective_packet, prospective_forecast, archive_and_seal, CAL_2030
+from review.out.astra_scratch.test_ronda9_verificaciones import run_demo, stock_div
+
+
+@pytest.mark.parametrize('text', ['Not a Holiday', 'Market Open is not confirmed', 'Typhoon warning: trading continues', 'Holiday schedule; Market Open'])
+def test_calendar_new_negations(text):
+    assert classify_holiday_row_en(text) == 'unknown'
+
+
+def packet_with_capture(tmp_path, injected=False):
+    p = prospective_packet()
+    store = RawStore(tmp_path, clock=(lambda: taipei(date(2024,1,1))) if injected else None)
+    rec = store.put(source_id='news', dataset='original', payload=b'{"profit":1}', url='fixture')
+    d = Document('d', 'news', 'news', ('SEC-1',), p.cutoff_at-timedelta(days=1), Q.VERIFIED_ORIGINAL,
+                 first_seen_at=rec.ingested_at_dt, capture_id=rec.capture_id, source_sha256=rec.sha256,
+                 derivation='extract-v1', payload={'profit':1})
+    return replace(p, admitted=(d,)), store, rec
+
+
+@pytest.mark.parametrize('variant', ['missing_capture', 'injected', 'first_seen'])
+def test_readmission_without_store_must_not_certify_provenance(tmp_path, variant):
+    p, store, rec = packet_with_capture(tmp_path, injected=variant=='injected')
+    d = p.admitted[0]
+    if variant == 'missing_capture':
+        d = replace(d, capture_id='does-not-exist')
+    if variant == 'first_seen':
+        d = replace(d, first_seen_at=taipei(date(2020,1,1)))
+    p = replace(p, admitted=(d,))
+    assert readmission_problems(p, store=store)  # control: archive detects each forgery
+    assert readmission_problems(p), (variant, 'accepted without archive')
+
+
+@pytest.mark.parametrize('variant', ['bytes', 'payload', 'derivation'])
+def test_evaluator_rejects_inadmissible_source(tmp_path, variant):
+    p, store, rec = packet_with_capture(tmp_path)
+    d = p.admitted[0]
+    if variant == 'bytes':
+        (store.root / rec.path).write_bytes(b'{"profit":999}')
+    elif variant == 'payload':
+        d = replace(d, payload={'profit':999})
+    else:
+        d = replace(d, derivation='not-registered')
+    p = packet_from_json(packet_to_json(replace(p, admitted=(d,))))
+    built = build_packet(packet_id=p.packet_id, cutoff_at=p.cutoff_at, documents=[d], mode=p.mode,
+                         evidence_class=p.evidence_class, calendar=CAL_2030, captures={rec.capture_id:rec},
+                         read_bytes=store.read, extractors={'extract-v1':lambda raw: {'payload':json.loads(raw), 'security_ids':['SEC-1']}})
+    assert not built.admitted  # same document fails construction
+    f = prospective_forecast(p)
+    f['ranking'][0]['document_ids'] = ['d']
+    store, sealed = archive_and_seal(tmp_path, f, p)
+    row = WeeklyObservation(p.week_id, f['forecast_id'], p.evidence_class, sealed.capture_id, True, .1)
+    with pytest.raises(ObservationError):
+        block_bootstrap_mean([row], block_length=1, n_boot=10, seed=1, store=store,
+                             packets={p.packet_hash():p}, calendar=CAL_2030, allow_test_authorities=True)
+
+
+def test_rejected_metadata_is_checked(tmp_path):
+    p = prospective_packet()
+    p = replace(p, rejected=(Rejection('ghost', 'invented_reason', 'profit in 2099 = 999'),)*2)
+    p = packet_from_json(packet_to_json(p))
+    assert readmission_problems(p, store=RawStore(tmp_path)), 'invented reasons and duplicate rejected ids accepted'
+
+
+@pytest.mark.parametrize('length', [1,2,3])
+def test_short_segments_keep_weight(length):
+    indexes = list(range(length)) + list(range(length+1, length+9))
+    days = [date(2024,1,1)+timedelta(weeks=i) for i in indexes]
+    vals = [1.]*length+[0.]*8
+    rows = [WeeklyObservation(f'{d.isocalendar().year}-W{d.isocalendar().week:02}',str(i),
+                              'historical_numeric_temporally_controlled',None,True,v)
+            for i,(d,v) in enumerate(zip(days,vals))]
+    r = block_bootstrap_mean(rows, block_length=4, n_boot=20000, seed=1)
+    assert abs(r.resample_mean-r.mean) < .02, r
+
+
+def segment(start, end=None, sec=None):
+    sid = sec or security_id_for('TWSE','A',start)
+    return SecurityVersion(sid,sid,'A','A','TWSE','main','ordinary_equity',start,end,taipei(date(2026,1,1)),'fixture')
+
+
+def resolve(master, day):
+    return resolve_delistings([DelistingRow('A','A',day)], master, market='TWSE',
+                             recorded_at=taipei(date(2026,1,2)), source_id='fixture')
+
+
+def test_delisting_valid_to_control():
+    m = SecurityMaster()
+    old = segment(date(2000,1,1),date(2008,9,1))
+    new = segment(date(2023,5,31))
+    m.extend([old,new])
+    r = resolve(m,date(2008,9,1))
+    assert len(r.events)==1 and r.events[0].security_id == old.security_id
+
+
+@pytest.mark.parametrize('kind', ['same_day','after_closed'])
+def test_delisting_not_invented_prior_issuer(kind):
+    m = SecurityMaster()
+    m.add(segment(date(2024,1,8),date(2024,1,12) if kind=='after_closed' else None))
+    r = resolve(m,date(2024,1,17) if kind=='after_closed' else date(2024,1,8))
+    assert not r.prior_issuer, r  # no evidence of a different, prior issuer
+    assert r.events or r.ambiguous or r.orphan
+
+
+def test_friday_closure_cannot_erase_monday_entry(tmp_path, monkeypatch):
+    result, ledgers, store = run_demo(tmp_path,monkeypatch,
+        prices=lambda d:D(0) if d==date(2024,1,12) else D(100),end='2024-01-19')
+    assert result['weeks'][0]['status']=='valid:not_operated'  # identifies the branch actually taken
+    assert store.captures(source_id='packet',dataset='Q0/2024-W02'), 'Sunday packet disappeared using Friday data'
+    assert '2024-W02:1' in ledgers[0].owners_seen
+
+
+@pytest.mark.parametrize('day,closures', [('2024-01-13',()),('2024-01-15',(date(2024,1,15),))])
+def test_weekend_and_holiday_cursor_control(tmp_path, monkeypatch, day, closures):
+    result, ledgers, _ = run_demo(tmp_path,monkeypatch, dividends=[stock_div('2024-01-10',5),
+        {'stock_id':'A','year':'2024','CashExDividendTradingDate':day,'CashEarningsDistribution':2}],
+        closures=closures,end='2024-01-19')
+    assert sum(r.amount for r in ledgers[0].receivables)==D(1000)
+    assert all(r.pay_at is None for r in ledgers[0].receivables)
+    assert ledgers[0].cash==D(100000)
+    assert not any(w.get('action_errors') for w in result['weeks'])
+
+
+@pytest.mark.parametrize('kind', ['no_sessions','extraordinary'])
+def test_final_equity_includes_nonoperated_week(tmp_path, monkeypatch, kind):
+    holidays = [date(2024,1,d) for d in range(15,20)] if kind=='no_sessions' else []
+    prices = (lambda d:D(0) if d==date(2024,1,19) else D(100)) if kind=='extraordinary' else None
+    result, ledgers, _ = run_demo(tmp_path,monkeypatch,dividends=[stock_div('2024-01-10',5)],
+                                 delisted='2024-01-17',closures=holidays,prices=prices,end='2024-01-21')
+    lg = ledgers[0]
+    assert lg.positions['TWSE:A@2000-01-01'].status=='delisted_unresolved'
+    actual = lg.valuation(prices={},at=taipei(date(2024,1,21),time(23,59))).total
+    assert D(str(result['summary']['Q0']['final_equity']))==actual, (result['summary']['Q0'],actual)
+
+
+def test_event_at_period_tail(tmp_path, monkeypatch):
+    result, ledgers, _ = run_demo(tmp_path,monkeypatch,dividends=[stock_div('2024-01-10',5),
+        {'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-20','CashEarningsDistribution':2}],end='2024-01-21')
+    assert sum(r.amount for r in ledgers[0].receivables)==D(1000)
+
+
+def test_calendar_known_at_claim():
+    c = load_twse_reference_calendar()
+    s = CalendarStore()
+    s.add(c)
+    with pytest.raises(CalendarRangeError):
+        s.as_known_at(taipei(date(2024,1,7),time(18)))
+    assert c.recorded_at <= taipei(date(2024,1,7),time(18)), c.recorded_at
+
+
+def test_stale_open_is_not_measured_interval(tmp_path, monkeypatch):
+    from review.out.astra_scratch.r9_two_helper import run_two_demo
+    result, ledgers, _ = run_two_demo(tmp_path,monkeypatch,dividends=[stock_div('2024-01-10',5)],
+        prices=lambda d:D(0) if d==date(2024,1,15) else D(200) if d>date(2024,1,15) else D(100),end='2024-01-19')
+    w = result['weeks'][1]
+    assert any('stale_price:TWSE:A' in f for f in w['Q0']['flags']), w
+    assert not w['paired'], w  # missing Monday opening of carried A: no measured open-close return
+
+
+def test_delisted_exposure_matches_valuation(tmp_path, monkeypatch):
+    from review.out.astra_scratch.r9_two_helper import run_two_demo
+    result, _, _ = run_two_demo(tmp_path,monkeypatch,dividends=[stock_div('2024-01-10',5)],
+                               delisted='2024-01-14',end='2024-01-19')
+    w = result['weeks'][1]
+    assert w['Q0']['equity_open']==200000
+    assert w['Q0']['exposure_at_open']==D('.5'), w  # only B worth 100000, A carried at zero under ledger policy

