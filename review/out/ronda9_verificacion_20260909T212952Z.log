+@pytest.mark.parametrize('text', ['Not a Holiday', 'Market Open is not confirmed', 'Typhoon warning: trading continues', 'Holiday schedule; Market Open'])
+def test_calendar_new_negations(text):
+    assert classify_holiday_row_en(text) == 'unknown'
+
+
+def packet_with_capture(tmp_path, injected=False):
+    p = prospective_packet()
+    store = RawStore(tmp_path, clock=(lambda: taipei(date(2024,1,1))) if injected else None)
+    rec = store.put(source_id='news', dataset='original', payload=b'{"profit":1}', url='fixture')
+    d = Document('d', 'news', 'news', ('SEC-1',), p.cutoff_at-timedelta(days=1), Q.VERIFIED_ORIGINAL,
+                 first_seen_at=rec.ingested_at_dt, capture_id=rec.capture_id, source_sha256=rec.sha256,
+                 derivation='extract-v1', payload={'profit':1})
+    return replace(p, admitted=(d,)), store, rec
+
+
+@pytest.mark.parametrize('variant', ['missing_capture', 'injected', 'first_seen'])
+def test_readmission_without_store_must_not_certify_provenance(tmp_path, variant):
+    p, store, rec = packet_with_capture(tmp_path, injected=variant=='injected')
+    d = p.admitted[0]
+    if variant == 'missing_capture':
+        d = replace(d, capture_id='does-not-exist')
+    if variant == 'first_seen':
+        d = replace(d, first_seen_at=taipei(date(2020,1,1)))
+    p = replace(p, admitted=(d,))
+    assert readmission_problems(p, store=store)  # control: archive detects each forgery
+    assert readmission_problems(p), (variant, 'accepted without archive')
+
+
+@pytest.mark.parametrize('variant', ['bytes', 'payload', 'derivation'])
+def test_evaluator_rejects_inadmissible_source(tmp_path, variant):
+    p, store, rec = packet_with_capture(tmp_path)
+    d = p.admitted[0]
+    if variant == 'bytes':
+        (store.root / rec.path).write_bytes(b'{"profit":999}')
+    elif variant == 'payload':
+        d = replace(d, payload={'profit':999})
+    else:
+        d = replace(d, derivation='not-registered')
+    p = packet_from_json(packet_to_json(replace(p, admitted=(d,))))
+    built = build_packet(packet_id=p.packet_id, cutoff_at=p.cutoff_at, documents=[d], mode=p.mode,
+                         evidence_class=p.evidence_class, calendar=CAL_2030, captures={rec.capture_id:rec},
+                         read_bytes=store.read, extractors={'extract-v1':lambda raw: {'payload':json.loads(raw), 'security_ids':['SEC-1']}})
+    assert not built.admitted  # same document fails construction
+    f = prospective_forecast(p)
+    f['ranking'][0]['document_ids'] = ['d']
+    store, sealed = archive_and_seal(tmp_path, f, p)
+    row = WeeklyObservation(p.week_id, f['forecast_id'], p.evidence_class, sealed.capture_id, True, .1)
+    with pytest.raises(ObservationError):
+        block_bootstrap_mean([row], block_length=1, n_boot=10, seed=1, store=store,
+                             packets={p.packet_hash():p}, calendar=CAL_2030, allow_test_authorities=True)
+
+
+def test_rejected_metadata_is_checked(tmp_path):
+    p = prospective_packet()
+    p = replace(p, rejected=(Rejection('ghost', 'invented_reason', 'profit in 2099 = 999'),)*2)
+    p = packet_from_json(packet_to_json(p))
+    assert readmission_problems(p, store=RawStore(tmp_path)), 'invented reasons and duplicate rejected ids accepted'
+
+
+@pytest.mark.parametrize('length', [1,2,3])
+def test_short_segments_keep_weight(length):
+    indexes = list(range(length)) + list(range(length+1, length+9))
+    days = [date(2024,1,1)+timedelta(weeks=i) for i in indexes]
+    vals = [1.]*length+[0.]*8
+    rows = [WeeklyObservation(f'{d.isocalendar().year}-W{d.isocalendar().week:02}',str(i),
+                              'historical_numeric_temporally_controlled',None,True,v)
+            for i,(d,v) in enumerate(zip(days,vals))]
+    r = block_bootstrap_mean(rows, block_length=4, n_boot=20000, seed=1)
+    assert abs(r.resample_mean-r.mean) < .02, r
+
+
+def segment(start, end=None, sec=None):
+    sid = sec or security_id_for('TWSE','A',start)
+    return SecurityVersion(sid,sid,'A','A','TWSE','main','ordinary_equity',start,end,taipei(date(2026,1,1)),'fixture')
+
+
+def resolve(master, day):
+    return resolve_delistings([DelistingRow('A','A',day)], master, market='TWSE',
