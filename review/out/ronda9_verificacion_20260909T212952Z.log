            'Trading_Volume':1000,'Trading_money':100000,'Trading_turnover':10}


def test_bar_adapter_does_not_erase_security_identity():
    # Identical prices are possible for distinct securities; identity must survive decoding.
    assert finmind.bars_from_rows([price_row('A')]) != finmind.bars_from_rows([price_row('B')])


def test_bar_adapter_does_not_count_duplicate_dates_as_sessions():
    try:
        bars = finmind.bars_from_rows([price_row()] * 120)
    except ValueError:
        return  # rejecting ambiguous input is also valid
    assert len(bars) == 1, len(bars)


def test_segmented_bootstrap_preserves_week_weights(monkeypatch):
    import random
    from twlab import evaluation
    chosen = []
    original = random.Random
    class TrackedRandom:
        def __init__(self, seed):
            self.rng = original(seed)
        def randrange(self, n):
            x = self.rng.randrange(n)
            chosen.append(x)
            return x
    monkeypatch.setattr(evaluation.random,'Random',TrackedRandom)
    # Two constant segments, lengths 4 and 8; one absent week in between.
    dates = [date(2024,1,1)+timedelta(weeks=i) for i in list(range(4))+list(range(5,13))]
    vals = [1.] * 4 + [0.] * 8
    obs = [WeeklyObservation(f'{d.isocalendar().year}-W{d.isocalendar().week:02}',str(i),'historical_numeric_temporally_controlled',None,True,v)
           for i,(d,v) in enumerate(zip(dates,vals))]
    result = block_bootstrap_mean(obs,block_length=4,n_boot=10000,seed=1)
    starts = evaluation._block_starts(dates,4)
    # Every draw has length 4, exactly 3 draws per replicate. Observe actual resampling weights.
    boot_mean = sum(sum(vals[s:s+n]) for s,n in (starts[i] for i in chosen)) / (10000*12)
    assert abs(boot_mean-result.mean) < .02, (result.mean,boot_mean,starts)


def test_real_zero_price_rows_are_not_all_zero_trading():
    # Archived real row TWSE:1203, 2022-11-17: no OHLC, but 48 shares / 1,606 TWD / 18 trades.
    r = {'date':'2022-11-17','stock_id':'1203','Trading_Volume':48,'Trading_money':1606,
         'open':0.,'max':0.,'min':0.,'close':0.,'Trading_turnover':18}
    b = finmind.bars_from_rows([r])[0]
    discarded_as_no_trading = not (b.close > 0 and b.open > 0)
    assert not discarded_as_no_trading or (b.volume_shares == 0 and b.value_twd == 0 and b.transactions == 0)


def test_census_report_innovation_exclusion_matches_default_universe():
    from twlab.master import SecurityMaster, SecurityVersion
    master = SecurityMaster()
    path = ROOT / 'data/store/master_2026-09-09.jsonl'
    for line in path.read_text(encoding='utf-8').splitlines():
        row = json.loads(line)
        if row.pop('kind') != 'segment':
            continue
        for field in ('valid_from','valid_to'):
            if row[field]:
                row[field] = date.fromisoformat(row[field])
        row['recorded_at'] = datetime.fromisoformat(row['recorded_at'])
        master.add(SecurityVersion(**row))
    universe = master.universe(as_of=date(2026,9,9))
    assert len(universe) == 1973
    assert not [v for v in universe if v.board == 'innovation']


def load_demo():
    spec = importlib.util.spec_from_file_location('r8_demo', ROOT / 'scripts/run_q0_demo.py')
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def run_demo(tmp_path, monkeypatch, *, dividends=(), prices=None, closures=(), end='2024-01-26', delisted=None, notional=100000, raw_symbol='A'):
    m = load_demo()
    folder = tmp_path / 'data/store'
    folder.mkdir(parents=True)
    store = RawStore(tmp_path / 'raw')
    price_rows = []
    day = date(2021,1,1)
    while day <= date.fromisoformat(end):
        if day.weekday() < 5 and day not in closures:
            price = prices(day) if prices else D(100)
            price_rows.append({'stock_id':raw_symbol,'date':day.isoformat(),'open':str(price), 'max':str(price),'min':str(price),
                               'close':str(price),'Trading_Volume':10000000,'Trading_money':1000000000,'Trading_turnover':1000})
        day += timedelta(days=1)
    def capture(dataset, data):
        return store.put(source_id='finmind',dataset=dataset,payload=json.dumps({'status':200,'msg':'success','data':data}).encode(),url='fixture')
    bp = capture(f'TaiwanStockPrice/{raw_symbol}',price_rows)
    bd = capture('TaiwanStockDividend/A',list(dividends))
    manifest = {'listed':[{'symbol':'A','name':'A','listing_date':'2000-01-01'}],
                'delisted':[] if not delisted else [{'symbol':'A','name':'A','delisting_date':delisted}],
                'captures':{'A':{'price':bp.capture_id,'price_rows':len(price_rows),'dividend':bd.capture_id,'dividend_rows':len(dividends)}}}
    (folder/'sample_universe.json').write_text(json.dumps(manifest),encoding='utf-8')
    cal = TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=closures,source_id='synthetic',recorded_at=taipei(date(2021,1,1)))
    monkeypatch.setattr(m,'ROOT',tmp_path)
    monkeypatch.setattr(m,'RawStore',lambda path:store)
    monkeypatch.setattr(m,'load_twse_reference_calendar',lambda:cal)
    monkeypatch.setattr(m,'CostModel',lambda **kw:FREE)
    ledgers = []
    def ledger(**kw):
        obj = PaperLedger(**kw)
        ledgers.append(obj)
        return obj
    monkeypatch.setattr(m,'PaperLedger',ledger)
    monkeypatch.setattr(sys,'argv',['demo','--start','2024-01-01','--end',end,'--slots','1','--notional',str(notional),'--block-length','1'])
    assert m.main() == 0
    result = json.loads((folder/f'q0_demo_2024-01-01_{end}.json').read_text(encoding='utf-8'))
    return result, ledgers, store


def stock_div(ex, amount):
    return {'stock_id':'A','year':'2024','StockExDividendTradingDate':ex,'StockEarningsDistribution':amount}


def test_demo_rejects_capture_for_another_security(tmp_path, monkeypatch):
    with pytest.raises(ValueError):
        run_demo(tmp_path,monkeypatch,raw_symbol='B',end='2024-01-12')


def test_demo_control_extraordinary_closure_is_inferred_ex_post(tmp_path, monkeypatch):
    result, _, store = run_demo(tmp_path,monkeypatch,prices=lambda d: D(0) if d == date(2024,1,12) else D(100),end='2024-01-19')
    assert '2024-01-12' in result['summary']['inferred_extraordinary_closures']
    rec = store.captures(source_id='packet',dataset='Q0/2024-W02')[0]
    packet = packet_from_json(store.read(rec))
    assert packet.cutoff_at.date() == date(2024,1,7)
    assert packet.exit_at.date() == date(2024,1,11)


def test_demo_retries_residue_after_it_becomes_sellable(tmp_path, monkeypatch):
    result, ledgers, _ = run_demo(tmp_path,monkeypatch, dividends=[stock_div('2024-01-10',5),stock_div('2024-01-17',10)],
                                 prices=lambda d: D(100) if d < date(2024,1,10) else D(60) if d < date(2024,1,17) else D(30),end='2024-01-19')
    assert not ledgers[0].positions, result['summary']['open_positions_at_end']


@pytest.mark.parametrize('kind', ['cash', 'delisting'])
def test_demo_processes_events_in_no_session_week(tmp_path, monkeypatch, kind):
    holidays = [date(2024,1,d) for d in range(15,20)]
    dvs = [stock_div('2024-01-10',5)]
    if kind == 'cash':
        dvs.append({'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-17','CashEarningsDistribution':2})
    result, ledgers, _ = run_demo(tmp_path,monkeypatch, dividends=dvs,closures=holidays,
                                 delisted='2024-01-17' if kind == 'delisting' else None)
    lg = ledgers[0]
    if kind == 'cash':
        assert sum((r.amount for r in lg.receivables),D(0)) == D(1000)
    else:
        assert lg.positions['TWSE:A'].status == 'delisted_unresolved'


def test_demo_excludes_pre_entry_return_from_open_close_interval(tmp_path, monkeypatch):
    result, ledgers, _ = run_demo(tmp_path,monkeypatch,dividends=[stock_div('2024-01-10',2.5)],notional=200000,
                                 prices=lambda d: D(100) if d < date(2024,1,15) else D(200),end='2024-01-19')
    w = result['weeks'][1]['Q0']
    # 500 carried shares rise 100 -> 200 over weekend. Monday open and Friday close are both 200.
    # Free costs, no weekly action: true Monday-open -> Friday-close total-equity return is zero.
    assert w['filled'] == 1 and result['weeks'][1]['paired']
    assert w['portfolio_net_return'] == 0, w


def test_demo_exposure_includes_carried_positions(tmp_path, monkeypatch):
    result, ledgers, _ = run_demo(tmp_path,monkeypatch,dividends=[stock_div('2024-01-10',5)],end='2024-01-19')
    w = result['weeks'][1]['Q0']
    # New 1,000 shares + carried 500 at 100, equity 150,000: fully invested.
    assert w['exposure'] == 1, w


def test_demo_entry_day_dividend_is_not_given_to_new_buyer(tmp_path, monkeypatch):
    result, ledgers, _ = run_demo(tmp_path,monkeypatch,dividends=[{'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-08','CashEarningsDistribution':10}],end='2024-01-12')
    assert ledgers[0].cash == D(100000) and not ledgers[0].receivables


def test_demo_marks_stale_prices_explicitly(tmp_path, monkeypatch):
    # Test the actual nested marking function without rewriting its logic.
    m = load_demo()
    tree = ast.parse((ROOT/'scripts/run_q0_demo.py').read_text(encoding='utf-8'))
    main = next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='main')
    fn = next(n for n in main.body if isinstance(n,ast.FunctionDef) and n.name=='mark_prices')
    row = finmind.Bar(date(2024,1,11),D(100),D(100),D(100),D(100),1000,D(100000),1,taipei(date(2024,1,12)))
    scope = dict(vars(m), by_session={'A':{row.session:row}},bars={'A':[row]})
    exec(compile(ast.Module(body=[fn],type_ignores=[]),'scripts/run_q0_demo.py','exec'),scope)
    lg = PaperLedger(ledger_id='t',initial_cash=D(100000),cost_model=FREE)
    lg.buy(security_id='TWSE:A',price=D(100),shares=1000,at=taipei(date(2024,1,8),time(9)),event_id='b')
    prices,flags = scope['mark_prices'](date(2024,1,12),lg)
    assert prices == {'TWSE:A':D(100)} and flags == ['stale_price:TWSE:A:2024-01-11']

