[31;1mdef load_market_daily(store: RawStore, calendar: TradingCalendar, master: SecurityMaster, *, as_of: date, start: date, end: date,[0m
[31;1m                      par_value: D = D(10)) -> MarketData:[0m
[31;1m    """Mercado construido desde las cotizaciones diarias oficiales por fecha (TWSE ``MI_INDEX``, TPEx ``dailyQuotes``).[0m
[31;1m[0m
[31;1m    Universo y fechas de alta del maestro; una barra por símbolo y sesión desde las capturas por fecha; barras[0m
[31;1m    anteriores al alta descartadas; **sin derechos** (la fuente no los trae: se declara en ``warnings`` y en el[0m
[31;1m    resumen). Cada documento de barras referencia la captura de su última sesión.[0m
[31;1m    """[0m
[31;1m    from .sources import twse_daily as td[0m
[31;1m    universe = master.universe(as_of=as_of)[0m
[31;1m    wanted = {(v.market, v.symbol): v for v in universe}[0m
[31;1m    have = {"TWSE": td.captured_sessions(store, "twse", td.TWSE_DATASET), "TPEX": td.captured_sessions(store, "tpex", td.TPEX_DATASET)}[0m
[31;1m    readers = {"TWSE": (td.twse_rows, td.bars_twse), "TPEX": (td.tpex_rows, td.bars_tpex)}[0m
[31;1m    bars: dict[tuple[str, str], list] = {k: [] for k in wanted}[0m
[31;1m    last_capture: dict[tuple[str, str], object] = {}[0m
[31;1m    missing: list[str] = [][0m
[31;1m    closed_sessions: list[str] = [][0m
[31;1m    for s in calendar.sessions_between(start, end):[0m
[31;1m        for market in ("TWSE", "TPEX"):[0m
[31;1m            rec = have[market].get(s)[0m
[31;1m            if rec is None:[0m
[31;1m                missing.append(f"{market}:{s.isoformat()}")[0m
[31;1m                continue[0m
[31;1m            reader, parser = readers[market][0m
[31;1m            rows = reader(store, rec)[0m
[31;1m            if rows is None:[0m
[31;1m                closed_sessions.append(f"{market}:{s.isoformat()}")[0m
[31;1m                continue[0m
[31;1m            for sid, bar in parser(s, rows).items():[0m
[31;1m                key = (market, sid)[0m
[31;1m                if key in wanted:[0m
[31;1m                    bars[key].append(bar)[0m
[31;1m                    last_capture[key] = rec[0m
[31;1m    dropped = 0[0m
[31;1m    dropped_before_listing = 0[0m
[31;1m    securities: dict[str, Security] = {}[0m
[31;1m    by_symbol: dict[str, str] = {}[0m
[31;1m    by_session: dict[str, dict[date, finmind.Bar]] = {}[0m
[31;1m    for key, v in wanted.items():[0m
[31;1m        allb = sorted(bars[key], key=lambda b: b.session)[0m
[31;1m        usable = [b for b in allb if b.has_regular_price][0m
[31;1m        dropped += len(allb) - len(usable)[0m
[31;1m        kept = [b for b in usable if b.session >= v.valid_from][0m
[31;1m        dropped_before_listing += len(usable) - len(kept)[0m
[31;1m        if not kept:[0m
[31;1m            continue[0m
[31;1m        securities[v.security_id] = Security(v.symbol, v.security_id, v.market, v.name_zh, v.valid_from, v.valid_to, kept, [], last_capture[key], None, [])[0m
[31;1m        by_symbol[v.symbol] = v.security_id[0m
[31;1m        by_session[v.security_id] = {b.session: b for b in kept}[0m
[31;1m    traded: set[date] = set().union(*[set(m) for m in by_session.values()]) if by_session else set()[0m
[31;1m    warnings = ["sin derechos: la fuente oficial por fecha no trae dividendos; libro y etiquetas operan sin ellos"][0m
[31;1m    if missing:[0m
[31;1m        warnings.append(f"sesiones oficiales sin captura: {len(missing)} (p. ej. {', '.join(missing[:3])})")[0m
[31;1m    if closed_sessions:[0m
[31;1m        warnings.append(f"sesiones oficiales sin datos (cierres sobrevenidos u otros): {len(closed_sessions)} (p. ej. {', '.join(closed_sessions[:3])})")[0m
[31;1m    return MarketData(securities, by_symbol, master, calendar, by_session, traded, dropped,[0m
[31;1m                      f"official_daily_quotes:{start.isoformat()}..{end.isoformat()}", dropped_before_listing, warnings, par_value)[0m
