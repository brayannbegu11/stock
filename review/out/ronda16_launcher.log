[31;1m[0m
[31;1mdef weekly_label(bars_by_session: Mapping[date, BarLike], entry_s: date, exit_s: date,[0m
[31;1m                 dividends: Iterable[DividendLike] = ()) -> Optional[tuple[float, datetime]]:[0m
[31;1m    """Retorno total apertura(entrada)→cierre(salida) por acción inicial, con derechos en (entrada, salida].[0m
[31;1m[0m
[31;1m    Los derechos se aplican en orden (fecha ex; efectivo antes que acciones el mismo día) sobre la cantidad[0m
[31;1m    vigente, como en el libro (R10-09); un ``event_id`` repetido cuenta una sola vez (R11-02). El instante de[0m
[31;1m    conocimiento es el más tardío de apertura, cierre y derechos (R10-01, R11-01); un derecho sin instante conocido[0m
[31;1m    hace que la etiqueta no exista.[0m
[31;1m    """[0m
[31;1m    a, b = bars_by_session.get(entry_s), bars_by_session.get(exit_s)[0m
[31;1m    if a is None or b is None or a.open <= 0 or b.close <= 0:[0m
[31;1m        return None[0m
[31;1m    seen: set[str] = set()[0m
[31;1m    events = [][0m
[31;1m    for d in dividends:[0m
[31;1m        if entry_s < d.ex_date <= exit_s and d.event_id not in seen:[0m
[31;1m            seen.add(d.event_id)[0m
[31;1m            events.append(d)[0m
[31;1m    known_at = max(a.available_at, b.available_at, key=to_utc)[0m
[31;1m    shares, cash = 1.0, 0.0[0m
[31;1m    for d in sorted(events, key=lambda e: (e.ex_date, 0 if e.kind == "cash" else 1)):[0m
[31;1m        if d.ambiguous or d.known_at is None:            # un derecho ambiguo o sin instante conocido: no hay etiqueta (R13-05)[0m
[31;1m            return None[0m
[31;1m        known_at = max(known_at, d.known_at, key=to_utc)[0m
[31;1m        if d.kind == "cash":[0m
[31;1m            cash += float(d.cash_per_share) * shares[0m
[31;1m        elif d.par_value > 0:[0m
[31;1m            shares *= float(d.par_value + d.stock_per_share) / float(d.par_value)[0m
[31;1m        else:[0m
[31;1m            shares *= 1.0 + float(d.stock_ratio)[0m
[31;1m    total = (float(b.close) * shares + cash) / float(a.open) - 1.0[0m
[31;1m    return total, known_at[0m
