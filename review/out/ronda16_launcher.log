[31;1m                                             known_quality=m["quality"]))[0m
[31;1m        else:[0m
[31;1m            events.append(q1mod.DividendLike(eid, exd, "stock", stock_ratio=m["amount"] / par_value, known_at=m["known_at"], pay_date=None,[0m
[31;1m                                             known_quality=m["quality"], stock_per_share=m["amount"], par_value=par_value))[0m
