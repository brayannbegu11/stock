[31;1m            groups.setdefault(("cash", dv.cash_ex_date), []).append([0m
[31;1m                {"amount": dv.cash_per_share, "pay": dv.cash_pay_date, "period": str(dv.period or "").strip(), "known_at": known_at, "quality": quality})[0m
[31;1m        if dv.stock_ex_date is not None:[0m
[31;1m            groups.setdefault(("stock", dv.stock_ex_date), []).append([0m
[31;1m                {"amount": dv.stock_per_share, "pay": None, "period": str(dv.period or "").strip(), "known_at": known_at, "quality": quality})[0m
[31;1m    events: list[q1mod.DividendLike] = [][0m
