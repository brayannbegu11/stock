[31;1m    return TradingCalendar.from_twse_legacy_rows([0m
[31;1m        rows_by_year,[0m
[31;1m        source_id="S06:www.twse.com.tw/rwd/en/holidaySchedule/holidaySchedule",[0m
[31;1m        recorded_at=datetime(2026, 9, 10, 4, 5, tzinfo=TAIPEI),[0m
[31;1m        version=f"captured_2026-09-09_{start_year}-{end_year}",[0m
[31;1m    )[0m
