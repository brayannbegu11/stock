[31;1mclass RidgeRank:[0m
[31;1m    """Regresión ridge cerrada sobre características estandarizadas (sin dependencias)."""[0m
[31;1m[0m
[31;1m    def __init__(self, alpha: float = 1.0) -> None:[0m
[31;1m        self.alpha = alpha[0m
[31;1m        self.mu: list[float] = [][0m
[31;1m        self.sd: list[float] = [][0m
[31;1m        self.w: list[float] = [][0m
[31;1m        self.b = 0.0[0m
[31;1m[0m
[31;1m    def fit(self, X: Sequence[Sequence[float]], y: Sequence[float]) -> "RidgeRank":[0m
[31;1m        n, p = len(X), len(X[0])[0m
[31;1m        self.mu = [statistics.fmean(col) for col in zip(*X)][0m
[31;1m        self.sd = [max(statistics.pstdev(col), 1e-9) for col in zip(*X)][0m
[31;1m        Z = [[(row[j] - self.mu[j]) / self.sd[j] for j in range(p)] for row in X][0m
[31;1m        ym = statistics.fmean(y)[0m
[31;1m        yc = [v - ym for v in y][0m
[31;1m        A = [[sum(Z[i][j] * Z[i][k] for i in range(n)) + (self.alpha if j == k else 0.0) for k in range(p)] for j in range(p)][0m
[31;1m        rhs = [sum(Z[i][j] * yc[i] for i in range(n)) for j in range(p)][0m
[31;1m        for j in range(p):[0m
[31;1m            piv = max(range(j, p), key=lambda r: abs(A[r][j]))[0m
[31;1m            A[j], A[piv] = A[piv], A[j][0m
[31;1m            rhs[j], rhs[piv] = rhs[piv], rhs[j][0m
[31;1m            for r in range(j + 1, p):[0m
[31;1m                f = A[r][j] / A[j][j][0m
[31;1m                for k in range(j, p):[0m
[31;1m                    A[r][k] -= f * A[j][k][0m
[31;1m                rhs[r] -= f * rhs[j][0m
[31;1m        w = [0.0] * p[0m
[31;1m        for j in range(p - 1, -1, -1):[0m
[31;1m            w[j] = (rhs[j] - sum(A[j][k] * w[k] for k in range(j + 1, p))) / A[j][j][0m
[31;1m        self.w, self.b = w, ym[0m
[31;1m        return self[0m
