[31;1m            master.add(SecurityVersion(**row))[0m
[31;1m    return master[0m
[31;1m[0m
[31;1m[0m
[31;1mdef already_covered(store: RawStore, dataset: str, sid: str, end: str) -> tuple[str, int] | None:[0m
