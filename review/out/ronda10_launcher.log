[31;1m    print(f"universo: {len(universe)} valores ({args.markets}); periodo {args.start}..{args.end}", flush=True)[0m
[31;1m    t0 = time.time()[0m
[31;1m    done = 0[0m
[31;1m    for i, v in enumerate(universe, 1):[0m
[31;1m        entry = manifest["captures"].get(v.symbol, {})[0m
