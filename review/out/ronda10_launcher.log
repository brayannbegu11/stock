      "prueba_propuesta": "from dataclasses import replace\nfrom review.out.astra_scratch.r10_support import fixture, date, time, taipei, D\nfrom twlab.models import q1\n\ndef test_both_label_endpoints_must_be_available(tmp_path):\n    _, market = fixture(tmp_path, end='2024-01-19')\n    bars = next(iter(market.securities.values())).bars\n    bars = [replace(b, open=D(50), available_at=taipei(date(2024,1,20))) if b.session == date(2024,1,8) else b for b in bars]\n    rows = q1.build_training_rows({'A': bars}, [taipei(date(2024,1,7),time(18))], now_cutoff=taipei(date(2024,1,14),time(18)), calendar=market.calendar)\n    assert not rows\n\n# label_known_at debe cubrir todas las observaciones utilizadas.",
