[31;1mdef test_features_use_only_bars_available_at_the_cutoff():[0m
[31;1m    bars = synthetic_bars(date(2024, 1, 2), 200, seed=1)[0m
[31;1m    cutoff = taipei(date(2024, 9, 8), time(18, 0))                     # domingo[0m
[31;1m    f = q1.features_from_bars(bars, cutoff)[0m
[31;1m    assert f is not None and set(f) == set(q1.FEATURE_NAMES)[0m
[31;1m    # la barra del viernes 6-09 está disponible el sábado 7-09 13:30 (política 24 h): entra. La del lunes 9-09 no.[0m
[31;1m    known = [b for b in bars if b.available_at <= cutoff][0m
[31;1m    assert known[-1].session == date(2024, 9, 6)[0m
[31;1m    # una barra futura plantada con precio absurdo no cambia nada porque no está disponible[0m
[31;1m    spiked = bars + [q1.BarLike(date(2024, 9, 9), D(1), D(99999), D(1), taipei(date(2024, 9, 10), time(13, 30)))][0m
[31;1m    assert q1.features_from_bars(spiked, cutoff) == f[0m
[31;1m    # con menos de 121 barras no hay características[0m
[31;1m    assert q1.features_from_bars(bars[:100], cutoff) is None[0m
