[31;1mdef test_r09_12_segment_weights_are_preserved_when_segments_are_shorter_than_the_block():[0m
[31;1m    # tramos de 1 y 8 (valores 1 y 0): media 1/9; con bloque 4 una extracción del tramo corto aporta 1 observación y[0m
[31;1m    # una del largo 4, así que el tramo corto debe elegirse con probabilidad ∝ 1/1 frente a 8/4.[0m
[31;1m    rows = [obs("2026-W20", 1.0)] + [obs(f"2026-W{w}", 0.0) for w in range(22, 30)][0m
[31;1m    r = block_bootstrap_mean(rows, block_length=4, n_boot=6000, seed=1)[0m
[31;1m    assert abs(r.mean - 1 / 9) < 1e-9 and abs(r.resample_mean - 1 / 9) < 0.015[0m
[31;1m    rows2 = [obs("2026-W20", 1.0), obs("2026-W21", 1.0)] + [obs(f"2026-W{w}", 0.0) for w in range(23, 31)][0m
[31;1m    r2 = block_bootstrap_mean(rows2, block_length=4, n_boot=6000, seed=1)[0m
[31;1m    assert abs(r2.mean - 0.2) < 1e-9 and abs(r2.resample_mean - 0.2) < 0.02[0m
