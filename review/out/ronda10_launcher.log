[31;1m    out_path.write_text(json.dumps(manifest, ensure_ascii=False, indent=1), encoding="utf-8")[0m
[31;1m    print(f"escrito {out_path}; peticiones nuevas: {done}")[0m
[31;1m    return 0[0m
