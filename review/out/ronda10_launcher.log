[31;1mdef synthetic_bars(start: date, n: int, *, seed: int, drift: float = 0.0, lag_hours: int = 24) -> list[q1.BarLike]:[0m
[31;1m    import random[0m
[31;1m    rng = random.Random(seed)[0m
[31;1m    out, price, d = [], 100.0, start[0m
[31;1m    while len(out) < n:[0m
[31;1m        if CAL.is_session(d):[0m
[31;1m            price *= 1 + drift + rng.gauss(0, 0.02)[0m
[31;1m            close_at = taipei(d, time(13, 30))[0m
[31;1m            out.append(q1.BarLike(d, D(f"{price * 0.999:.2f}"), D(f"{price:.2f}"), D(1_000_000 + rng.randrange(500_000)),[0m
[31;1m                                  close_at + timedelta(hours=lag_hours)))[0m
[31;1m        d += timedelta(days=1)[0m
[31;1m    return out[0m
[31;1m[0m
