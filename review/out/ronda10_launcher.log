[31;1mdef test_training_rows_only_carry_labels_known_at_the_current_cutoff():[0m
[31;1m    bars = {"SEC-A": synthetic_bars(date(2023, 1, 2), 600, seed=2), "SEC-B": synthetic_bars(date(2023, 1, 2), 600, seed=3)}[0m
[31;1m    cutoffs = [][0m
[31;1m    d = date(2023, 1, 1)[0m
[31;1m    while d < date(2025, 6, 1):[0m
[31;1m        cutoffs.append(taipei(d, time(18, 0)))[0m
[31;1m        d += timedelta(days=7)[0m
[31;1m    now = taipei(date(2024, 6, 2), time(18, 0))[0m
[31;1m    rows = q1.build_training_rows(bars, cutoffs, now_cutoff=now, calendar=CAL)[0m
[31;1m    assert rows[0m
[31;1m    assert all(r.cutoff_at < now for r in rows)[0m
[31;1m    assert all(r.label_known_at <= now for r in rows)[0m
[31;1m    # la semana cuyo corte es el domingo anterior (26-05) termina el viernes 31-05: su barra está disponible el sábado 1-06 → entra[0m
[31;1m    assert any(r.cutoff_at.date() == date(2024, 5, 26) for r in rows)[0m
[31;1m    # la semana del corte 2-06 (la actual) no tiene etiqueta conocida: no entra[0m
[31;1m    assert not any(r.cutoff_at.date() == date(2024, 6, 2) for r in rows)[0m
[31;1m    # coherencia de la etiqueta: apertura del lunes → cierre del viernes de ESA semana[0m
