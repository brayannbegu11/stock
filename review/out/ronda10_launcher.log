      "prueba_propuesta": "from review.out.astra_scratch.r10_support import fixture, date, time, taipei\nfrom twlab.backtest import TabularForecaster\n\ndef test_model_cannot_serve_an_earlier_cutoff(tmp_path):\n    _, market = fixture(tmp_path, end='2024-01-19')\n    f = TabularForecaster(market, min_weeks=1)\n    f.maybe_train(taipei(date(2024,1,14),time(18)))\n    earlier = taipei(date(2024,1,7),time(18))\n    try:\n        f.maybe_train(earlier)\n    except ValueError:\n        return\n    assert f.model.trained_at <= earlier\n\n# Rechazar el retroceso o recuperar/reentrenar un modelo temporalmente admisible.",
