[31;1m+def test_ridge_collinear_constant_control():[0m
[31;1m+    import numpy as np[0m
[31;1m+    X=np.array([[v,2*v,7.] for v in range(10)],dtype=float)[0m
[31;1m+    y=np.arange(10,dtype=float)[0m
[31;1m+    m=q1.RidgeRank(alpha=1.).fit(X.tolist(),y.tolist())[0m
[31;1m+    Z=(X-X.mean(axis=0))/np.maximum(X.std(axis=0),1e-9)[0m
[31;1m+    expected=np.linalg.solve(Z.T@Z+np.eye(3),Z.T@(y-y.mean()))[0m
[31;1m+    assert np.allclose(m.w,expected)[0m
