[31;1mdef test_q1_fits_and_ranks_and_refuses_with_too_little_history():[0m
[31;1m    bars = {f"SEC-{i}": synthetic_bars(date(2023, 1, 2), 500, seed=10 + i, drift=0.0005 * (i % 3)) for i in range(6)}[0m
[31;1m    cutoffs = [taipei(date(2023, 1, 1) + timedelta(days=7 * k), time(18, 0)) for k in range(120)][0m
[31;1m    now = taipei(date(2025, 3, 2), time(18, 0))[0m
