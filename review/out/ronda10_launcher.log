      "prueba_propuesta": "from dataclasses import replace\nfrom tests.test_schema import prospective_packet\nfrom twlab.packet import Rejection, readmission_problems, packet_to_json, packet_from_json, PredictorView\nfrom twlab.store import RawStore\n\ndef test_rejected_detail_requires_provenance(tmp_path):\n    p = replace(prospective_packet(), rejected=(Rejection('ghost', 'available_after_cutoff', 'profit in 2099 = 999'),))\n    p = packet_from_json(packet_to_json(p))\n    problems = readmission_problems(p, store=RawStore(tmp_path))\n    assert problems or '2099' not in str(PredictorView(p).packet().rejected)\n\n# Reconstruir los detalles permitidos o excluirlos de la vista del predictor.",
