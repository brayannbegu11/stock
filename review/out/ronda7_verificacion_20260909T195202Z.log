def evaluate(s, r, week):
    row = WeeklyObservation(week, 'f-1', 'prospective_registered', r.capture_id, True, .10)
    return block_bootstrap_mean([row], block_length=1, n_boot=20, seed=1,
                                store=s, allow_test_authorities=True)


def archive_body(path, body):
    s = RawStore(path, verifiers={'fixture': lambda rec, rc: rc.digest == rec.sha256})
    r = s.put(source_id='forecast', dataset='L1', payload=json.dumps(body).encode(), url='fixture')
    s.attach_receipt(r.capture_id, receipt_id='fixture:f', authority='fixture',
                     digest=r.sha256, attested_at=r.ingested_at)
    return s, r


@pytest.mark.parametrize('variant', ['before_cutoff', 'after_deadline', 'null_deadline_selected'])
def test_evaluator_rechecks_temporal_semantics(tmp_path, variant):
    p = prospective_packet()
    o = prospective_forecast(p)
    if variant == 'before_cutoff':
        o['issued_at'] = (p.cutoff_at - timedelta(days=1)).isoformat()
    elif variant == 'after_deadline':
        o['issued_at'] = (p.deadline_at + timedelta(days=4)).isoformat()
    else:
        o['deadline_at'] = p.cutoff_at.isoformat()
    s, r = archive_and_seal(tmp_path, o, p)
    assert validate_prediction(o, p, store=s, allow_test_authorities=True)
    with pytest.raises(ObservationError):
        evaluate(s, r, p.week_id)


@pytest.mark.parametrize('variant', ['unknown_experiment', 'duplicate_security', 'duplicate_rank',
                                     'rank_gap', 'invented_calibrator'])
def test_evaluator_rechecks_nonpacket_semantics(tmp_path, variant):
    p = prospective_packet()
    o = prospective_forecast(p)
    if variant == 'unknown_experiment':
        o['experiment_id'] = 'UNREGISTERED-99'
    elif variant == 'invented_calibrator':
        o['ranking'][0].update(calibrated_probability=.99, calibration_model_id='trained-in-2099')
    elif variant == 'rank_gap':
        o['ranking'][0]['rank'] = 20
    else:
        second = deepcopy(o['ranking'][0])
        if variant == 'duplicate_security':
            second['rank'] = 2
        else:
            second['security_id'] = 'SEC-2'
        o['ranking'].append(second)
    s, r = archive_and_seal(tmp_path, o, p)
    assert validate_prediction(o, p, store=s, allow_test_authorities=True)
    with pytest.raises(ObservationError):
        evaluate(s, r, p.week_id)


@pytest.mark.parametrize('hash_value', ['', 'not-a-sha256', '0'*64])
def test_evaluator_requires_actual_packet(tmp_path, hash_value):
    p = prospective_packet()
    o = prospective_forecast(p, packet_id='nonexistent-packet')
    o['ranking'][0]['document_ids'] = ['future-result-2099']
    s, r = archive_body(tmp_path, {'forecast': o, 'packet_hash': hash_value})
    with pytest.raises(ObservationError):
        evaluate(s, r, p.week_id)


def test_no_calendar_cannot_extend_deadline_inside_target_week(tmp_path):
    p = prospective_packet()
    forged = replace(p, deadline_at=p.deadline_at+timedelta(days=4),
                     registration_deadline_at=p.deadline_at+timedelta(days=4),
                     entry_at=p.entry_at+timedelta(days=4))
    o = prospective_forecast(forged, issued_at=(forged.deadline_at-timedelta(minutes=1)).isoformat())
    s, r = archive_and_seal(tmp_path, o, forged, attested_at=forged.deadline_at.isoformat())
    assert validate_prediction(o, forged, calendar=CAL_2030, store=s, allow_test_authorities=True)
    assert validate_prediction(o, forged, store=s, allow_test_authorities=True), 'Friday seal accepted for Monday entry week'


def test_no_sessions_packet_cannot_contain_regular_deadline():
    p = prospective_packet(cutoff=CUTOFF_2030_EMPTY)
    forged = replace(p, deadline_at=p.cutoff_at+timedelta(days=100))
    o = prospective_forecast(p, evidence_class='historical_current_llm_exploratory',
                             status='invalid', ranking=[], status_reason='no_sessions')
    assert validate_prediction(o, forged, calendar=CAL_2030)
    assert validate_prediction(o, forged), 'No-session plan accepts arbitrary nonnull deadline'


def enter(lg, week, at, price=100):
    return enter_basket(lg, picks=['A'], slots=1, notional_per_slot=D(100000),
                        open_prices={'A': D(price)}, at=at, week_id=week)


def residue(lg):
    w = enter(lg, '2026-W37', MON)
    lg.apply_corporate_action(CorporateAction('stock', 'A', 'stock_dividend', MON, stock_ratio=D('.5')))
    exit_basket(lg, w, close_prices={'A': D(60)}, at=FRI, week_id='2026-W37')
    assert w[0].exit_residual_quantity == D(500)
    assert w[0].gross_pick_return == D('-.1')
    return w


