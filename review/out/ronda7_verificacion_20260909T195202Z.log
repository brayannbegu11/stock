        lg.mark_suspended('A', at=week2)
    prices = {'A': D(30)} if blocked == 'suspended' else {}
    exit_basket(lg, w, close_prices=prices, at=FRI+timedelta(days=7), week_id='2026-W37')
    assert lg.positions['A'].owner_quantity(w[0].owner) == D(1000)
    assert lg.positions['A'].owner_quantity(other[0].owner) == D(2000)
    assert lg.declared_dividends('A', w[0].owner) == D(2000)
    report = basket_report('2026-W37', w, equity_start=D(100000), equity_end=D(92000))
    assert report.exit_blocked_slots == 1, (report, w[0])
    assert w[0].gross_pick_return is None


def test_odd_lot_retry_cannot_use_future_state_at_past_timestamp():
    lg = ledger('1000000', FREE)
    w = residue(lg)
    future = MON+timedelta(days=21)
    lg.apply_corporate_action(CorporateAction('future-div', 'A', 'cash_dividend', future, per_share_cash=D(20)))
    with pytest.raises(OutOfOrderEvent):
        exit_basket(lg, w, close_prices={'A': D(60)}, at=FRI, week_id='2026-W37')


@pytest.mark.parametrize('price', [D(-60), D(0), D('NaN')])
def test_odd_lot_retry_validates_mark_price(price):
    lg = ledger('1000000', FREE)
    w = residue(lg)
    with pytest.raises((LedgerError, ValueError)):
        exit_basket(lg, w, close_prices={'A': price}, at=FRI+timedelta(days=7), week_id='2026-W37')


def test_fifo_sale_cannot_execute_fractional_entitlements():
    lg = ledger('1000000', FREE)
    a = enter(lg, '2026-W37', MON)
    b = enter(lg, '2026-W38', MON+timedelta(days=7))
    at = MON+timedelta(days=14)
    lg.apply_corporate_action(CorporateAction('reverse', 'A', 'split', at, split_ratio=D('.5005')))
    assert lg.positions['A'].unresolved_fraction == D(1)
    res = lg.sell(security_id='A', shares=1000, price=D(200), at=at, event_id='fifo')
    assert isinstance(res, Rejection), (res, lg.positions['A'].lots)


def test_control_four_weeks_owners_actions_retries_and_undated_dividends():
    lg = ledger('1000000', FREE)
    a = residue(lg)
    t2 = MON+timedelta(days=7)
    b = enter(lg, '2026-W38', t2)
    lg.apply_corporate_action(CorporateAction('reverse', 'A', 'split', t2, split_ratio=D('.5')))
    lg.apply_corporate_action(CorporateAction('undated', 'A', 'cash_dividend', t2, per_share_cash=D('1.2345')))
    lg.mark_suspended('A', at=t2)
    exit_basket(lg, b, close_prices={'A': D(120)}, at=FRI+timedelta(days=7), week_id='2026-W38')
    assert b[0].status == 'exit_blocked'
    assert lg.cash == D(860000)
    t3 = MON+timedelta(days=14)
    lg.mark_resumed('A', at=t3)
    lg.apply_corporate_action(CorporateAction('restore', 'A', 'split', t3, split_ratio=D(4)))
    exit_basket(lg, b, close_prices={'A': D(30)}, at=FRI+timedelta(days=14), week_id='2026-W38')
    assert lg.positions['A'].owner_quantity(a[0].owner) == D(1000)
    t4 = MON+timedelta(days=21)
    lg.set_payment_date('undated', pay_at=t3, at=t4)
    assert lg.cash == D(920925)
    exit_basket(lg, a, close_prices={'A': D(30)}, at=FRI+timedelta(days=21), week_id='2026-W37')
    assert a[0].liquidated and b[0].liquidated
    assert lg.cash == D(950925)
    assert a[0].gross_pick_return == D('-.09691375')
    assert b[0].gross_pick_return == D('-.3938275')
    assert lg.valuation(prices={}, at=FRI+timedelta(days=21)).total == lg.cash
