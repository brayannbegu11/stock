150: .picks .nm{font-family:"Noto Sans TC",var(--font-sans);font-weight:500;font-size:1rem;line-height:1.25;overflow-wrap:anywhere}
151: .picks .mk{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;color:var(--fog);border:1px solid var(--line-2);border-radius:4px;padding:2px 6px}
152: .col footer{padding:12px 18px 14px;border-top:1px solid var(--line);background:var(--surface-2);font-size:.82rem;color:var(--fog);display:flex;flex-direction:column;gap:5px}
153: .col footer .row{display:flex;justify-content:space-between;gap:10px;align-items:center}
154: .col footer .row>span{flex:1;min-width:0}
155: .col footer .row b{color:var(--ink);font-weight:500;white-space:nowrap;display:inline-flex;gap:8px;align-items:center}
156: 
157: /* ---------- chips ---------- */
158: .chip{display:inline-flex;align-items:center;gap:5px;font-family:var(--font-mono);font-size:.66rem;letter-spacing:.04em;padding:2px 8px;border-radius:999px;border:1px solid var(--line-2);color:var(--fog);white-space:nowrap;background:transparent}
159: .chip.ok{color:var(--down);border-color:color-mix(in srgb,var(--down) 40%,transparent);background:var(--down-dim)}
160: .chip.bad{color:var(--up);border-color:color-mix(in srgb,var(--up) 40%,transparent);background:var(--up-dim)}
161: .chip.warn{color:var(--warn);border-color:var(--accent-line);background:var(--warn-dim)}
162: .chip.Q0{color:var(--q0);border-color:color-mix(in srgb,var(--q0) 45%,transparent)}
163: .chip.Q1{color:var(--q1);border-color:color-mix(in srgb,var(--q1) 45%,transparent)}
164: .chip.A1{color:var(--ink-2);border-color:var(--line-3)}
165: 
166: /* ---------- results ---------- */
167: .tabs{display:inline-flex;flex-wrap:wrap;gap:8px;margin-bottom:24px;padding:3px;border:1px solid var(--line-2);border-radius:var(--r-card);background:var(--surface)}
168: .tab{border:1px solid transparent;background:transparent;color:var(--fog);border-radius:9px;padding:9px 14px;font:inherit;font-size:.88rem;font-weight:500;cursor:pointer;display:inline-flex;flex-direction:column;gap:2px;align-items:flex-start;text-align:left;transition:color .15s,background .15s}
169: .tab .sub{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.04em;font-weight:400;color:var(--ash)}
170: .tab:hover{color:var(--ink)}
171: .tab[aria-selected="true"]{background:var(--surface-3);color:var(--ink);border-color:var(--line-2)}
172: .tab[aria-selected="true"] .sub{color:var(--fog)}
173: .resgrid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:16px;align-items:stretch}
174: table{border-collapse:collapse;width:100%;font-size:.9rem}
175: th,td{padding:9px 10px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
176: th{font-family:var(--font-mono);font-weight:400;color:var(--fog);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}
177: td.num,th.num{text-align:right;white-space:nowrap}
178: tbody tr:last-child td{border-bottom:0}
179: .kpi{table-layout:fixed}
180: .kpi td:first-child{color:var(--fog);font-size:.86rem}
181: .kpi col.lbl{width:38%}
182: .kpi td.num,.kpi th.num{white-space:normal;overflow-wrap:anywhere;font-size:.9rem}
183: .kpi td.wrap{line-height:1.35;font-size:.8rem}
184: .kpi .chip{white-space:normal}
185: .legend{display:flex;flex-wrap:wrap;gap:16px;font-size:.8rem;color:var(--fog);margin-top:10px}
186: .legend i{display:inline-block;width:14px;height:2px;border-radius:2px;vertical-align:middle;margin-right:7px}
187: svg text{font-family:var(--font-mono);font-size:10.5px;fill:var(--fog);font-feature-settings:"zero"}
188: .weeks{margin-top:16px}
189: .weeks tbody tr.wk{cursor:pointer;transition:background .12s}
190: .weeks tbody tr.wk:hover td{background:var(--surface-2)}
191: .weeks tr.detail td{background:var(--surface-2);padding:14px 16px;border-bottom:1px solid var(--line)}
192: .weeks tr.detail[hidden]{display:none}
193: .weeks td.mono{font-size:.84rem}
194: .dgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
195: .dgrid .f{background:var(--surface);border:1px solid var(--line-2);border-radius:8px;padding:12px 14px}
196: .dgrid .f h4{display:flex;align-items:center;gap:8px;margin-bottom:8px}
197: .dgrid ul{list-style:none;margin:0;padding:0;font-size:.86rem}
198: .dgrid li{display:grid;grid-template-columns:44px 1fr auto;gap:8px;padding:4px 0;align-items:baseline;border-top:1px solid var(--line)}
199: .dgrid li:first-child{border-top:0}
200: .dgrid li .nm{font-family:"Noto Sans TC",var(--font-sans);overflow-wrap:anywhere}
201: .caret{display:inline-block;transition:transform .15s;color:var(--ash);margin-right:2px;font-size:.8rem}
202: tr.wk.open .caret{transform:rotate(90deg)}
203: 
204: /* ---------- how it works ---------- */
205: .rail{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0;margin:8px 0 40px;position:relative}
206: .rail::before{content:"";position:absolute;left:0;right:0;top:9px;height:1px;background:var(--line-2)}
207: .step{position:relative;padding:0 20px 0 0}
208: .step .pt{width:19px;height:19px;border-radius:50%;background:var(--canvas);border:1px solid var(--accent-line);display:grid;place-items:center;position:relative;z-index:1}
209: .step .pt::after{content:"";width:5px;height:5px;border-radius:50%;background:var(--accent)}
210: .step .when{font-family:var(--font-mono);font-size:.68rem;color:var(--accent);margin-top:14px;letter-spacing:.08em;text-transform:uppercase}
211: .step h4{margin:6px 0 6px;font-size:1rem}
212: .step p{font-size:.88rem;color:var(--fog);line-height:1.5}
213: .cards3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
214: .cards3 .card h3{display:flex;align-items:center;gap:9px}
215: .cards3 .card p{font-size:.92rem;color:var(--fog);line-height:1.55}
216: .ctl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 40px;margin-top:16px;max-width:1000px}
217: .ctl div{padding:16px 0;border-top:1px solid var(--line)}
218: .ctl b{display:block;font-weight:500;font-size:.98rem;margin-bottom:4px;letter-spacing:-.005em}
219: .ctl p{font-size:.9rem;color:var(--fog);line-height:1.5}
220: .roles{margin-top:48px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--line-2);border-radius:var(--r-card);overflow:hidden;max-width:1000px}
221: .roles div{padding:16px 18px;border-left:1px solid var(--line);font-size:.88rem;color:var(--fog);line-height:1.5}
222: .roles div:first-child{border-left:0}
223: .roles b{display:block;color:var(--ink);font-weight:500;margin-bottom:3px}
224: .subhead{display:flex;align-items:baseline;gap:14px;margin-top:56px}
225: .subhead h3{font-size:1.15rem}
226: 
227: /* ---------- review ---------- */
228: .rounds{margin-top:8px;border-top:1px solid var(--line)}
229: .round{display:grid;grid-template-columns:64px 1fr;gap:18px;padding:18px 0;border-bottom:1px solid var(--line)}
230: .round .n{font-family:var(--font-display);font-size:1.7rem;color:var(--ink);line-height:1;padding-top:2px}
231: .round .n small{font-family:var(--font-mono);font-size:.62rem;color:var(--ash);display:block;letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px}
232: .round .meta{display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:.8rem;color:var(--fog);margin-bottom:6px}
233: .round .sum{font-size:.9rem;color:var(--ink-2);max-width:92ch;line-height:1.55}
234: .round .links{font-size:.8rem;margin-top:8px;display:flex;gap:14px;flex-wrap:wrap}
235: .round .links a{color:var(--fog)}
236: .sevbar{display:inline-flex;gap:2px;align-items:center}
237: .sevbar i{display:inline-block;height:8px;border-radius:2px}
238: .sev-bloqueante{background:var(--sev-block)} .sev-alta{background:var(--sev-high)} .sev-media{background:var(--sev-mid)} .sev-baja{background:var(--sev-low)}
239: .sevlegend{display:flex;gap:16px;flex-wrap:wrap;font-size:.78rem;color:var(--fog);margin-top:8px}
240: .sevlegend i{display:inline-block;width:10px;height:8px;border-radius:2px;margin-right:6px;vertical-align:baseline}
241: .revgrid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:stretch}
242: .revgrid .side{display:flex;flex-direction:column;gap:0}
243: .revgrid .side div{padding:14px 0;border-top:1px solid var(--line)}
244: .revgrid .side div:first-child{border-top:0;padding-top:0}
245: .revgrid .side .k{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--fog)}
246: .revgrid .side .v{font-family:var(--font-display);font-size:2.1rem;line-height:1;margin-top:6px}
247: .revgrid .side .s{font-size:.8rem;color:var(--fog);margin-top:4px}
248: 
249: /* ---------- lists ---------- */
250: .facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 40px;max-width:1000px}
251: .facts div{padding:16px 0;border-top:1px solid var(--line)}
252: .facts b{display:block;font-weight:500;font-size:.98rem;margin-bottom:4px}
253: .facts p{font-size:.9rem;color:var(--fog);line-height:1.5}
254: ol.limits{list-style:none;margin:0;padding:0;max-width:860px;counter-reset:lim}
255: ol.limits li{display:grid;grid-template-columns:44px 1fr;gap:12px;padding:14px 0;border-top:1px solid var(--line);color:var(--fog);font-size:.95rem;line-height:1.55}
256: ol.limits li::before{counter-increment:lim;content:counter(lim,decimal-leading-zero);font-family:var(--font-mono);font-size:.7rem;color:var(--ash);padding-top:5px;letter-spacing:.08em}
257: ol.limits li b{color:var(--ink);font-weight:500}
258: .two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:40px}
259: .two ol{margin:12px 0 0;padding-left:0;list-style:none;font-size:.92rem;color:var(--ink-2);counter-reset:it}
260: .two ol li{padding:10px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:28px 1fr;gap:10px;line-height:1.5}
261: .two ol li::before{counter-increment:it;content:counter(it);font-family:var(--font-mono);font-size:.7rem;color:var(--ash);padding-top:4px}
262: .two .mono{font-size:.76rem;color:var(--fog)}
263: .cmd{background:var(--surface);border:1px solid var(--line-2);border-radius:8px;padding:12px 14px;font-family:var(--font-mono);font-size:.78rem;overflow-x:auto;white-space:pre;margin-top:10px;color:var(--ink-2);line-height:1.6}
264: footer.foot{padding:40px 0 64px;color:var(--fog);font-size:.82rem;border-top:1px solid var(--line)}
265: footer.foot .wrap{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}
266: footer.foot a{color:var(--fog)}
267: 
268: @media (max-width:960px){
269:   :root{--gap-section:64px}
270:   .readout{grid-template-columns:repeat(3,minmax(0,1fr))}
271:   .readout>div:nth-child(3n+1){border-left:0}
272:   .readout>div:nth-child(n+4){border-top:1px solid var(--line)}
273:   .board,.resgrid,.cards3,.dgrid,.ctl,.facts,.two,.revgrid{grid-template-columns:1fr}
274:   .roles{grid-template-columns:1fr}
275:   .roles div{border-left:0;border-top:1px solid var(--line)}
276:   .roles div:first-child{border-top:0}
277:   .rail{grid-template-columns:1fr;gap:18px}
278:   .rail::before{display:none}
279:   .top .wrap{flex-wrap:wrap;height:auto;padding-top:10px;padding-bottom:10px;gap:12px}
280:   .nav{order:3;width:100%;margin-left:0}
281: }
282: @media (max-width:560px){
283:   .readout{grid-template-columns:repeat(2,minmax(0,1fr))}
284:   .readout>div:nth-child(3n+1){border-left:1px solid var(--line)}
285:   .readout>div:nth-child(2n+1){border-left:0}
286:   .readout>div:nth-child(n+3){border-top:1px solid var(--line)}
287:   .verdict{grid-template-columns:1fr}
288:   .round{grid-template-columns:1fr;gap:8px}
289: }
290: </style>
291: </head>
292: <body>
293: <script type="application/json" id="site-data">
295: </script>
296: <div id="app"></div>
