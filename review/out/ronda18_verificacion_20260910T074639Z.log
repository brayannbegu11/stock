+            for flag in w['forecasters'][f]['flags']:assert flag in chart
+        assert chart.count('r="3.2" fill="var(--surface)"')==3
+        assert chart.count('stroke-dasharray="3 3"')==6
+        row=re.search(r'<tr class="wk[^>]+data-week="2026-W29".*?</tr>',rendered[lang][sc['id']]['table'],re.S)[0]
+        assert row.count(rendered[lang]['strings']['st']['nosel'])==6
+        w29=next(w for w in sc['weeks'] if w['week_id']=='2026-W29')
+        for f in ('Q0','Q1','A1'):
+            value=f"{abs(w29['forecasters'][f]['net'])*100:.2f}"
+            if lang=='es':value=value.replace('.',',')
+            assert value in row
+
+def test_r17_10_pending_entries_and_exports(site):
+    for sc in site['scenarios']:
+        d=read_source(sc['label']);w=d['weeks'][-1]
+        assert w['pending_outcome'] and w['week_id']=='2026-W37'
+        for f,fr in w['forecasters'].items():
+            assert all(p['entry_status'] in ('filled','entry_failed') for p in fr['picks'])
+            assert fr['filled']==sum(p['entry_status']=='filled' for p in fr['picks'])
+            assert fr['failed']==sum(p['entry_status']=='entry_failed' for p in fr['picks'])
+            for original,published in zip(fr['picks'],sc['weeks'][-1]['forecasters'][f]['picks']):
+                for k in ('security_id','entry_status','entry_reason'):assert published[k]==original[k]
+        copy=sc.copy();copy.pop('current_week')
+        assert copy==export.export_scenario(sc['id'],sc['label'],sc['informe'])
+        assert sc['current_week']['archived_at']==export.forecast_archive_times(sc['label'],'2026-W37')
+    html=(ROOT/'docs/index.html').read_text(encoding='utf8')
