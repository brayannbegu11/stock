660: /* ---------- state ---------- */
661: const state = {lang:"es", scenario:"standard", open:new Set()};
662: function detectLang(){
663:   try{ const q=new URLSearchParams(location.search).get("lang"); if(q&&S[q]) return q; }catch(e){}
664:   try{ const v=localStorage.getItem("twlab.lang"); if(v&&S[v]) return v; }catch(e){}
665:   const n=(navigator.language||"es").toLowerCase();
666:   if(n.startsWith("zh")) return "zh"; if(n.startsWith("en")) return "en"; return "es";
667: }
668: function t(k){ const v=S[state.lang][k]; return v===undefined?S.es[k]:v; }
669: function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
670: 
671: /* ---------- formatting ---------- */
672: function nf(x,d){ let o={minimumFractionDigits:d,maximumFractionDigits:d}; try{ o.useGrouping="always"; return new Intl.NumberFormat(LOC[state.lang],o).format(x); }catch(e){ delete o.useGrouping; return new Intl.NumberFormat(LOC[state.lang],o).format(x); } }
673: function pct(x,d,sign){ if(x==null||isNaN(x)) return "ΓÇö"; d=d==null?2:d; const s=x<0?"ΓêÆ":(sign===false?"":(x>0?"+":"")); return s+nf(Math.abs(x*100),d)+(state.lang==="es"?" %":"%"); }
674: function pp(x,d){ if(x==null||isNaN(x)) return "ΓÇö"; const s=x<0?"ΓêÆ":(x>0?"+":""); return s+nf(Math.abs(x*100),d==null?2:d); }
675: function twd(x){ if(x==null) return "ΓÇö"; return state.lang==="es"? nf(x,0)+" TWD" : "NT$"+nf(x,0); }
676: function twdShort(x){ const a=Math.abs(x); if(a>=1e6) return nf(x/1e6,1)+"M"; if(a>=1e3) return nf(x/1e3,0)+"k"; return nf(x,0); }
677: function cls(x){ return x==null?"flat":x>0?"up":x<0?"down":"flat"; }
678: function arrow(x){ return x==null?"":x>0?"Γû▓ ":x<0?"Γû╝ ":""; }
679: function fmtDate(iso,opts){ if(!iso) return "ΓÇö"; const d=new Date(iso); return new Intl.DateTimeFormat(LOC[state.lang],Object.assign({timeZone:"Asia/Taipei"},opts||{day:"numeric",month:"short",year:"numeric"})).format(d); }
680: function fmtDateTime(iso){ return fmtDate(iso,{weekday:"short",day:"numeric",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit",hour12:false}); }
681: function fmtDay(iso){ return fmtDate(iso,{day:"numeric",month:"short"}); }
682: function fmtPlainDate(ymd){ if(!ymd) return "ΓÇö"; return fmtDate(ymd+"T12:00:00+08:00",{day:"numeric",month:"short",year:"numeric"}); }
683: 
684: /* ---------- data helpers ---------- */
685: function scenario(id){ return (DATA.scenarios||[]).find(s=>s.id===id)||null; }
686: function anyScenario(){ return scenario("standard")||scenario("user")||(DATA.scenarios||[])[0]||null; }
687: function currentWeek(sc){ if(!sc) return null; const w=sc.weeks.filter(w=>w.pending_outcome); return w.length?w[w.length-1]:null; }
688: function gh(path){ return (DATA.repo||"#")+"/blob/main/"+path; }
689: 
690: /* ---------- render ---------- */
691: function render(){
692:   document.documentElement.lang = state.lang==="zh"?"zh-Hant-TW":state.lang;
693:   const sc = scenario(state.scenario)||anyScenario();
694:   const base = scenario("standard")||anyScenario();
695:   const rounds = DATA.rounds||[];
696:   const cw = currentWeek(base);
697:   const html = [
698:     topbar(),
699:     hero(base,rounds),
700:     weekSection(base,cw),
701:     resultsSection(sc),
702:     howSection(),
703:     reviewSection(rounds),
704:     dataSection(base),
705:     limitsSection(),
706:     nextSection(),
707:     docsSection(),
708:     footer()
709:   ].join("");
710:   document.getElementById("app").innerHTML = html;
711:   wire();
712: }
713: function secHead(labelKey,titleHtml,sub){
714:   return `<div class="sechead"><div class="label">${esc(t(labelKey))}</div><h2>${titleHtml}</h2>${sub?`<p>${sub}</p>`:""}</div>`;
715: }
716: function topbar(){
717:   const nav = t("nav");
718:   const ids = {week:"semana",results:"resultados",how:"como-funciona",review:"revision",data:"datos",limits:"limites",next:"siguientes",docs:"documentos"};
719:   return `<header class="top"><div class="wrap">
720:     <a class="brand" href="#top"><span class="mark">TW</span><b>Taiwan IA Lab</b><span>${esc(t("brand_sub"))}</span></a>
