357:     {when:"Viernes ┬╖ cierre",h:"Salida simulada",p:"Venta al ├║ltimo cierre de la semana, con impuesto de venta. Si no hay sesi├│n, la salida espera a la siguiente."},
358:     {when:"Despu├⌐s",h:"Medici├│n",p:"Cada cartera se empareja con el control aleatorio de la misma semana y se estima el exceso con bootstrap por bloques."}
359:   ],
