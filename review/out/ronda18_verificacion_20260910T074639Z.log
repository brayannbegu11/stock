728: function hero(base,rounds){
729:   const weeks = base?base.weeks_operated:0;
730:   const cw = currentWeek(base);
731:   const tiles = [
732:     {k:t("st_week"), v:cw?cw.week_id:"ΓÇö", s:cw?fmtDay(cw.cutoff_at):""},
733:     {k:t("st_weeks"), v:nf(weeks,0), s:t("st_weeks_s")},
734:     {k:t("st_universe"), v:base?nf(base.universe_size,0):"ΓÇö", s:t("st_universe_s")},
735:     {k:t("st_tests"), v:DATA.tests!=null?nf(DATA.tests,0):"ΓÇö", s:t("st_tests_s")},
736:     {k:t("st_rounds"), v:nf(rounds.length,0), s:t("st_rounds_s")(rounds.length)},
737:     {k:t("st_updated"), v:fmtDate(DATA.generated_at,{day:"numeric",month:"short"}), s:fmtDate(DATA.generated_at,{hour:"2-digit",minute:"2-digit",hour12:false})+" Taipei"}
738:   ];
739:   const std = scenario("standard"), usr = scenario("user");
740:   const net = (sc,f)=> sc&&sc.forecasters[f]? sc.forecasters[f].mean_weekly_net : null;
741:   const v = {w:weeks, user:!!usr,
742:     q0s:pct(net(std,"Q0")), q1s:pct(net(std,"Q1")), a1s:pct(net(std,"A1")),
743:     q1u:pct(net(usr,"Q1")), a1u:pct(net(usr,"A1")),
744:     stdBelow: !!std && net(std,"Q0")<net(std,"A1") && net(std,"Q1")<net(std,"A1"),
745:     q1AboveUser: !!usr && net(usr,"Q1")>net(usr,"A1")};
746:   return `<a id="top"></a><section class="hero"><div class="wrap">
747:     <div class="eyebrow"><i></i><span>${esc(t("eyebrow"))}</span></div>
748:     <h1>${t("title_html")}</h1>
749:     <p class="deck">${esc(t("deck"))}</p>
750:     <div class="readout">${tiles.map(x=>`<div><div class="k">${esc(x.k)}</div><div class="v">${esc(x.v)}</div><div class="s">${esc(x.s)}</div></div>`).join("")}</div>
751:     <div class="verdict"><span class="tag">${esc(t("verdict_tag"))}</span><p>${esc(t("verdict")(v))}</p></div>
752:   </div></section>`;
