diff --git a/review/out/astra_scratch/r18_render.cjs b/review/out/astra_scratch/r18_render.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..da96f53d715bab967ada4539fddd7f1957586579
--- /dev/null
+++ b/review/out/astra_scratch/r18_render.cjs
@@ -0,0 +1,21 @@
+const fs=require('fs'), vm=require('vm');
+const html=fs.readFileSync('docs/index.html','utf8');
+const payload=html.match(/<script type="application\/json" id="site-data">([\s\S]*?)<\/script>/)[1];
+let code=[...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].pop()[1];
+code=code.replace('state.lang = detectLang();\nrender();', 'globalThis.api={S,DATA,state,howSection,reviewSection,limitsSection,kpiAndChart,weekSection,weeksTable,resultsSection,hero,equityChart,dataSection};');
+const ctx={document:{getElementById:()=>({textContent:payload})},Intl,URLSearchParams};
+vm.createContext(ctx);vm.runInContext(code,ctx);const a=ctx.api;
+if(process.argv[2]==='mutated-review'){
+  a.DATA.rounds=[{round:18,findings_new:1,severity:{bloqueante:1},verdict:'aprobado_con_cambios',summary:'',new_findings:[],verifications:[]}];
+  a.DATA.review_stats={new_total:1,verified_total:0,blocking_new:1,blocking_verified:0,unverified_ids:[]};
+}
+const out={};
+for(const lang of ['es','en','zh']){
+  a.state.lang=lang;
+  out[lang]={strings:a.S[lang],protocol:a.howSection(),review:a.reviewSection(a.DATA.rounds),limits:a.limitsSection()};
+  for(const sc of a.DATA.scenarios){
+    a.state.scenario=sc.id;
+    out[lang][sc.id]={kpi:a.kpiAndChart(sc),week:a.weekSection(sc,null),table:a.weeksTable(sc),results:a.resultsSection(sc),chart:a.equityChart(sc)};
+  }
+}
+process.stdout.write(JSON.stringify(out));
