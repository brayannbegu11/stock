+from review.out.astra_scratch.test_r18_verification import (
+    ROOT,D,date,time,taipei,daily,fixture,Runner,BacktestConfig,MomentumForecaster,
+    RandomForecaster,plan_week,export,read_source,render,site,rendered)
+from twlab.backtest import markdown_report
+from twlab.ledger import PaperLedger,CostModel,Fill
+from dataclasses import replace
+import json,re,pytest
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_empty_daily_capture_map_is_not_a_single_capture_series(tmp_path,market):
+    raw,m=daily(tmp_path,market)
+    m.securities['A'].bar_captures.clear()
+    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12),min_history_sessions=1,liquidity_multiple=0),[MomentumForecaster(),RandomForecaster(1)])
+    p,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    series=[d for d in p.admitted if d.kind=='price_bar_series']
+    assert not series and cs[0].reasons==('provenance_incomplete:2_sessions_without_capture',), [(d.derivation,d.payload) for d in series]
