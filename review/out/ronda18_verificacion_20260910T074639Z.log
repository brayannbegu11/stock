891:     <div class="revgrid">
892:       <div class="card"><h3>${esc(t("rev_chart"))}</h3>${findingsChart(rounds)}<div class="sevlegend">${SEV.map(s=>`<span><i class="sev-${s}"></i>${esc(t("sev")[s])}</span>`).join("")}</div><p class="cap">${esc(t("rev_cap")(first.findings_new,first.severity.bloqueante||0,last.findings_new))}</p></div>
893:       <div class="card side">
