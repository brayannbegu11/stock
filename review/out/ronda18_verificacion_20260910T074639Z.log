344:   tw_legend:"Convenci├│n de Taiw├ín: Γû▓ rojo = sube, Γû╝ verde = baja. El signo acompa├▒a siempre al color.",
345:   weeks_title:"Semana a semana",
346:   weeks_hint:"Pulsa una fila para ver las cinco selecciones de cada pronosticador.",
347:   th:{week:"Semana",cutoff:"Corte",elig:"Elegibles",ew:"Universo bruto",net:f=>`${f} neto`,gross:"Bruto",status:"Estado"},
348:   st:{valid:"",pending:"pendiente",closure:"sesi├│n sin datos (10-07)",nosel:"sin selecci├│n nueva"},
349:   pick_status:{exited:"salida ejecutada",filled:"comprada, salida pendiente",open:"posici├│n abierta",entry_failed:"entrada fallida",exit_blocked:"salida bloqueada",pending:"pendiente"},
350:   reason:{notional_below_one_lot:"nocional < 1 lote",interval_mismatch:"exposici├│n distinta de A1",extraordinary_closure_unhandled:"cierre sobrevenido",missing_interval:"sin intervalo"},
