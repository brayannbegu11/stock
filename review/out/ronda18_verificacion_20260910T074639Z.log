index 0000000000000000000000000000000000000000..a23b1b86d30ad7b946c4dfef29bef8e5d5d08d1b
--- /dev/null
+++ b/review/out/astra_scratch/test_r18_attacks.py
@@ -0,0 +1,126 @@
+from review.out.astra_scratch.test_r18_verification import (
+    ROOT,D,date,time,taipei,daily,fixture,Runner,BacktestConfig,MomentumForecaster,
+    RandomForecaster,plan_week,export,read_source,render,site,rendered)
+from twlab.backtest import markdown_report
+from twlab.ledger import PaperLedger,CostModel,Fill
+from dataclasses import replace
+import json,re,pytest
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_empty_daily_capture_map_is_not_a_single_capture_series(tmp_path,market):
+    raw,m=daily(tmp_path,market)
+    m.securities['A'].bar_captures.clear()
+    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12),min_history_sessions=1,liquidity_multiple=0),[MomentumForecaster(),RandomForecaster(1)])
+    p,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    series=[d for d in p.admitted if d.kind=='price_bar_series']
+    assert not series and cs[0].reasons==('provenance_incomplete:2_sessions_without_capture',), [(d.derivation,d.payload) for d in series]
+
+def test_conflicting_session_captures_cannot_overwrite_each_other(tmp_path):
+    raw,m=daily(tmp_path)
+    a=m.securities['A'];original=a.bar_captures[date(2024,1,4)]
+    # Two captured revisions of the same TWSE session; the two securities may reference different revisions.
+    orig=raw.get(original)
+    body=json.loads(raw.read(orig));body['revision']=2
+    revised=raw.put(source_id='twse',dataset=orig.dataset,payload=json.dumps(body).encode(),url='fixture',http_status=200)
+    b=replace(a,security_id='B',symbol='9999',bar_captures=dict(a.bar_captures))
+    b.bar_captures[date(2024,1,4)]=revised.capture_id
+    m.securities['B']=b
+    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12)),[MomentumForecaster(),RandomForecaster(1)])
+    try:p,_,_=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    except ValueError:return
+    doc=next(d for d in p.admitted if d.kind=='price_bar_series' and d.security_ids==('A',))
+    manifest=next(d for d in p.admitted if d.doc_id==doc.payload['captures_doc'])
+    actual=manifest.payload['session_captures']['2024-01-04']
+    assert actual==original,(actual,original)
+
+def export_fake(tmp_path,monkeypatch,rows):
+    dest=tmp_path/'review/out';dest.mkdir(parents=True)
+    (tmp_path/'docs/informes').mkdir(parents=True)
+    for n,hs in rows:
+        (dest/f'ronda{n}_verificacion_20260910T000000Z.json').write_text(json.dumps({'hallazgos':hs}),encoding='utf8')
+    monkeypatch.setattr(export,'ROOT',tmp_path)
+    return export.review_stats(export.export_rounds())
+
+@pytest.mark.parametrize('identifier',['R01-01/verificacion_extra','R01-01/otra/verificacion'])
+def test_review_verification_identifier_requires_full_match(tmp_path,monkeypatch,identifier):
+    stats=export_fake(tmp_path,monkeypatch,[(1,[{'id':'R01-01','severidad':'bloqueante'}]),(2,[{'id':identifier,'estado_verificacion':'reproducido'}])])
+    assert stats['verified_total']==0 and stats['blocking_verified']==0,stats
+
+@pytest.mark.parametrize('verification_round',[1,2])
+def test_review_verification_must_be_later_than_finding(tmp_path,monkeypatch,verification_round):
+    hs=[{'id':'R02-01','severidad':'bloqueante'}]
+    verification={'id':'R02-01/verificacion','estado_verificacion':'reproducido'}
+    rows=[(1,[verification]),(2,hs)] if verification_round==1 else [(2,hs+[verification])]
+    stats=export_fake(tmp_path,monkeypatch,rows)
+    assert stats['verified_total']==0,stats
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_review_public_text_responds_to_data_instead_of_literal_counts(lang):
+    rendered=render('mutated-review')[lang]['review']
+    # New blocking finding in round 18, verified and approved in round 19.
+    forbidden={'es':['todas con veredicto ┬½rechazado┬╗','ninguno bloqueante desde la ronda 6'],
+               'en':['all with a ΓÇ£rejectedΓÇ¥ verdict','none blocking since round 6'],
+               'zh':['σà¿Θâ¿Φúüσ«Üτé║πÇîΘºüσ¢₧πÇì','Φç¬τ¼¼ 6 σ¢₧σÉêΦ╡╖µ▓Æµ£ëΘÿ╗µû╖τ┤Üτ╝║ΘÖ╖']}[lang]
+    assert not any(t in rendered for t in forbidden),re.sub('<[^>]+>',' ',rendered)
+
+@pytest.mark.parametrize('sid,label,report',export.SCENARIOS)
+def test_generated_reports_keep_abstained_week_returns(sid,label,report):
+    d=read_source(label)
+    txt=(ROOT/'docs/informes'/report).read_text(encoding='utf8')
+    row=next(l for l in txt.splitlines() if l.startswith('| 2026-W29 |'))
+    w=next(w for w in d['weeks'] if w['week_id']=='2026-W29')
+    for f in ('Q0','Q1','A1'):
+        net=w['forecasters'][f]['portfolio_net_return_open_close']
+        assert f'{net*100:+.2f} %' in row,(f,net,row)
+
+@pytest.mark.parametrize('sid,label,report',export.SCENARIOS)
+def test_generated_positive_week_denominator_is_measurable(sid,label,report):
+    d=read_source(label);txt=(ROOT/'docs/informes'/report).read_text(encoding='utf8')
+    for f in ('Q0','Q1','A1'):
+        row=next(l for l in txt.splitlines() if l.startswith('| '+f+' (`'))
+        xs=[w['forecasters'][f].get('portfolio_net_return_open_close') for w in d['weeks'] if not w.get('pending_outcome')]
+        measurable=[x for x in xs if x is not None]
+        expected=f'{sum(x>0 for x in measurable)}/{len(measurable)}'
+        assert expected in row,(expected,row)
+
+def test_followup_sales_are_in_weekly_costs(tmp_path):
+    raw,m=fixture(tmp_path,end='2024-01-19')
+    s=next(iter(m.securities.values()));missing=date(2024,1,12)
+    s.bars=[b for b in s.bars if b.session!=missing]
+    del m.by_session[s.security_id][missing];m.traded_days.discard(missing)
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,19),slots=1,notional=10000,lot_size=1,min_commission_twd=D(20),slippage_bps=0)
+    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
+    r.run_week(date(2024,1,7));assert r.weeks[-1]['forecasters']['Q0']['exit_blocked']==1
+    oldslot=r.open_slots['Q0'][0][1][0]
+    r.run_week(date(2024,1,14));w=r.weeks[-1]['forecasters']['Q0']
+    assert w['forecast_status']=='abstained' and isinstance(oldslot.exit,Fill)
+    f=oldslot.exit;actual=f.commission+f.tax+f.slippage_cost
+    assert w['costs_twd']==float(actual),(w['costs_twd'],actual,f.shares,f.price,w['portfolio_net_return_open_close'])
+
+def test_final_valuation_flags_survive_site_export():
+    original=read_source('sample_2024_2025')['summary']['forecasters']['Q0']['final_valuation']
+    assert original['flags'] and original['equity']==2021351
+    sc=export.export_scenario('standard','sample_2024_2025','14_backtest_muestra_2024-2025.md')
+    published=sc['forecasters']['Q0']
+    assert published.get('final_valuation',{}).get('flags')==original['flags'],published
+
+def test_readme_and_response_counts_match_site(site):
+    readme=(ROOT/'README.md').read_text(encoding='utf8')
+    response=(ROOT/'docs/informes/23_respuesta_ronda17_astra.md').read_text(encoding='utf8')
+    n=int(re.search(r'the (\d+) review rounds',readme)[1])
+    cumulative=int(re.search(r'ahora publica (\d+) hallazgos nuevos acumulados',response)[1])
+    assert (n,cumulative)==(len(site['rounds']),site['review_stats']['new_total']),(n,cumulative,len(site['rounds']),site['review_stats']['new_total'])
+
+def test_p7_documented_at_referenced_location():
+    txt=(ROOT/'docs/informes/22_respuesta_ronda16_astra.md').read_text(encoding='utf8')
+    section=txt.split('## 2.',1)[1].split('## 3.',1)[0]
+    assert 'P7' in section
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_exit_retry_is_weekly_not_next_session(rendered,lang):
+    txt=rendered[lang]['strings']['steps'][3]['p']
+    # W28's missing Friday 10 July was retried Friday 17 July, not Monday 13 July.
+    words={'es':['semana siguiente','semanal'],
+           'en':['following week','next week','weekly'],
+           'zh':['Σ╕ïΘÇ▒','µ»ÅΘÇ▒','µ¼íΘÇ▒']}[lang]
+    assert any(x in txt for x in words),txt
