+from review.out.astra_scratch.test_r18_verification import (
+    ROOT,D,date,time,taipei,daily,fixture,Runner,BacktestConfig,MomentumForecaster,
+    RandomForecaster,plan_week,export,read_source,render,site,rendered)
+from twlab.backtest import markdown_report
+from twlab.ledger import PaperLedger,CostModel,Fill
+from dataclasses import replace
+import json,re,pytest
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_empty_daily_capture_map_is_not_a_single_capture_series(tmp_path,market):
+    raw,m=daily(tmp_path,market)
+    m.securities['A'].bar_captures.clear()
+    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12),min_history_sessions=1,liquidity_multiple=0),[MomentumForecaster(),RandomForecaster(1)])
+    p,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    series=[d for d in p.admitted if d.kind=='price_bar_series']
+    assert not series and cs[0].reasons==('provenance_incomplete:2_sessions_without_capture',), [(d.derivation,d.payload) for d in series]
+
+def test_conflicting_session_captures_cannot_overwrite_each_other(tmp_path):
+    raw,m=daily(tmp_path)
+    a=m.securities['A'];original=a.bar_captures[date(2024,1,4)]
+    # Two captured revisions of the same TWSE session; the two securities may reference different revisions.
+    orig=raw.get(original)
+    body=json.loads(raw.read(orig));body['revision']=2
+    revised=raw.put(source_id='twse',dataset=orig.dataset,payload=json.dumps(body).encode(),url='fixture',http_status=200)
+    b=replace(a,security_id='B',symbol='9999',bar_captures=dict(a.bar_captures))
+    b.bar_captures[date(2024,1,4)]=revised.capture_id
+    m.securities['B']=b
+    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12)),[MomentumForecaster(),RandomForecaster(1)])
+    try:p,_,_=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    except ValueError:return
+    doc=next(d for d in p.admitted if d.kind=='price_bar_series' and d.security_ids==('A',))
+    manifest=next(d for d in p.admitted if d.doc_id==doc.payload['captures_doc'])
+    actual=manifest.payload['session_captures']['2024-01-04']
+    assert actual==original,(actual,original)
+
+def export_fake(tmp_path,monkeypatch,rows):
+    dest=tmp_path/'review/out';dest.mkdir(parents=True)
+    (tmp_path/'docs/informes').mkdir(parents=True)
+    for n,hs in rows:
+        (dest/f'ronda{n}_verificacion_20260910T000000Z.json').write_text(json.dumps({'hallazgos':hs}),encoding='utf8')
+    monkeypatch.setattr(export,'ROOT',tmp_path)
+    return export.review_stats(export.export_rounds())
+
+@pytest.mark.parametrize('identifier',['R01-01/verificacion_extra','R01-01/otra/verificacion'])
+def test_review_verification_identifier_requires_full_match(tmp_path,monkeypatch,identifier):
+    stats=export_fake(tmp_path,monkeypatch,[(1,[{'id':'R01-01','severidad':'bloqueante'}]),(2,[{'id':identifier,'estado_verificacion':'reproducido'}])])
+    assert stats['verified_total']==0 and stats['blocking_verified']==0,stats
+
+@pytest.mark.parametrize('verification_round',[1,2])
+def test_review_verification_must_be_later_than_finding(tmp_path,monkeypatch,verification_round):
+    hs=[{'id':'R02-01','severidad':'bloqueante'}]
+    verification={'id':'R02-01/verificacion','estado_verificacion':'reproducido'}
+    rows=[(1,[verification]),(2,hs)] if verification_round==1 else [(2,hs+[verification])]
+    stats=export_fake(tmp_path,monkeypatch,rows)
+    assert stats['verified_total']==0,stats
