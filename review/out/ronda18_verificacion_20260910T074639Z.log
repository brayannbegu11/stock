from review.out.astra_scratch.r10_support import *
from review.out.astra_scratch.test_r16_attacks import daily
from twlab.ledger import PaperLedger, CostModel, CorporateAction, Fill
from twlab.simulation import enter_basket, exit_basket
from twlab.backtest import TabularForecaster
from twlab.weekly import plan_week
from fractions import Fraction
import pytest

def cost():
    return CostModel(D('.001425'), sell_tax=D('.003'), slippage_bps_per_side=20, min_commission_twd=D(20))

def basket(cash, notional, slots=1, price='10'):
    lg = PaperLedger(ledger_id='test', initial_cash=D(cash), cost_model=cost(), lot_size=1)
    picks = [str(i) for i in range(slots)]
    ss = enter_basket(lg, picks=picks, slots=slots, notional_per_slot=D(notional), open_prices={s:D(price) for s in picks}, at=taipei(date(2024,1,8),time(9)), week_id='2024-W02')
    return lg, ss

def test_minimum_commission_does_not_reject_affordable_smaller_order():
    lg, slots = basket(1000,1000)
    # 97 shares cost 970 + floor(970*.002) + 20 = 991 <= 1000.
    assert slots[0].status == 'filled', (slots[0].status, slots[0].reason, lg.cash)
    assert slots[0].entry.shares == 97

def test_minimum_commission_respects_each_slot_budget():
    lg, slots = basket(5000,1000,5)
    assert all(s.entry and -s.entry.cash_delta <= 1000 for s in slots), [(s.status, -s.entry.cash_delta if s.entry else s.reason) for s in slots]

def test_odd_lot_minimum_applies_buy_sell_and_fraction_survives():
    lg = PaperLedger(ledger_id='t', initial_cash=D(1000), cost_model=cost(), lot_size=1)
    slots=enter_basket(lg,picks=['A'],slots=1,notional_per_slot=D(400),open_prices={'A':D(100)},at=taipei(date(2024,1,8),time(9)),week_id='w')
    assert slots[0].entry.commission == 20
    lg.apply_corporate_action(CorporateAction('split','A','split',taipei(date(2024,1,9)),split_ratio=D('.5')))
    exit_basket(lg,slots,close_prices={'A':D(200)},at=taipei(date(2024,1,12),time(13,30)),week_id='w')
    assert slots[0].exit.shares == 1 and slots[0].exit.commission == 20
    assert lg.positions['A'].lots[0].rational() == Fraction(1,2)
    assert lg.positions['A'].unresolved_fraction == D('.5')
    before=lg.cash
    exit_basket(lg,slots,close_prices={'A':D(200)},at=taipei(date(2024,1,19),time(13,30)),week_id='w')
    assert lg.cash == before and slots[0].status == 'exit_blocked'

def test_daily_missing_capture_in_series_must_not_be_admitted(tmp_path):
    store, market = daily(tmp_path)
    del market.securities['A'].bar_captures[date(2024,1,4)]
    r=Runner(store,market,BacktestConfig(date(2024,1,1),date(2024,1,12)),[MomentumForecaster(),RandomForecaster(1)])
    try:
        p,_,_=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),market.calendar))
    except (ValueError, KeyError):
        return
    for doc in p.admitted:
        if doc.kind=='price_bar_series':
            m=next(d for d in p.admitted if d.doc_id==doc.payload['captures_doc'])
            assert all(row[0] in m.payload['session_captures'] for row in doc.payload['sessions']), (doc.payload,m.payload)

def test_data_version_covers_session_capture_change(tmp_path):
    _,market=daily(tmp_path)
    f=TabularForecaster(market,min_weeks=1)
    before=market.data_version
    market.securities['A'].bar_captures[date(2024,1,4)]=market.securities['A'].bar_captures[date(2024,1,5)]
    with pytest.raises(ValueError):
        f.maybe_train(taipei(date(2024,1,7),time(18)))
    assert market.data_version != before

def test_liquidity_scales_with_configured_notional_and_odd_lot_exposure(tmp_path):
    store, market=fixture(tmp_path,end='2024-01-12')
    from dataclasses import replace
    sec=next(iter(market.securities.values()))
    sec.bars=[replace(b,value_twd=D(300000)) for b in sec.bars]
    market.by_session[sec.security_id]={b.session:b for b in sec.bars}
    elig=[]
    for notional,lot in [(15000,1),(1000000,1000)]:
        cfg=BacktestConfig(date(2024,1,1),date(2024,1,12),notional=notional,lot_size=lot,min_commission_twd=D(20),slippage_bps=20)
        r=Runner(store,market,cfg,[MomentumForecaster(),RandomForecaster(1)])
        _,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),market.calendar))
        elig.append(cs[0].eligible)
        if lot==1:
            w=r.run()['weeks'][0]['forecasters']['Q0']
            assert w['filled']==1 and w['failed']==0 and 0 < w['exposure_at_open'] <= D('.2')
    assert elig == [True,False]
from review.out.astra_scratch.r10_support import *
import re, subprocess, importlib.util
import pytest

spec=importlib.util.spec_from_file_location('site_export',ROOT/'scripts/export_site_data.py')
export=importlib.util.module_from_spec(spec); spec.loader.exec_module(export)

def source(label):
    return json.loads((ROOT/'data/store'/f'backtest_{label}.json').read_text(encoding='utf8'))

@pytest.fixture(scope='module')
def site():
    return json.loads((ROOT/'docs/site/data.json').read_text(encoding='utf8'))

@pytest.fixture(scope='module')
def rendered():
    proc=subprocess.run(['node','review/out/astra_scratch/r17_render.cjs'],cwd=ROOT,capture_output=True,text=True,encoding='utf8',check=True)
    return json.loads(proc.stdout)

def test_exported_scenarios_match_sources_and_inline(site):
    html=(ROOT/'docs/index.html').read_text(encoding='utf8')
    embedded=json.loads(re.search(r'<script type="application/json" id="site-data">(.*?)</script>',html,re.S)[1])
    assert embedded == site
    for sid,label,report in export.SCENARIOS:
        actual=next(s for s in site['scenarios'] if s['id']==sid).copy()
        actual.pop('current_week',None)
        assert actual == export.export_scenario(sid,label,report)

def test_review_round_exports_match_original_artifacts(site):
    assert site['rounds'] == export.export_rounds()

def test_master_segments_excludes_terminal_events(site):
    rows=[json.loads(x) for x in (ROOT/'data/store'/site['master']['file']).read_text(encoding='utf8').splitlines()]
    assert site['master']['segments'] == sum(r['kind']=='segment' for r in rows), (site['master']['segments'], {k:sum(r['kind']==k for r in rows) for k in {'segment','delisting'}})

def test_export_preserves_bootstrap_uncertainty(site):
    sc=next(s for s in site['scenarios'] if s['id']=='user')
    original=source(sc['label'])['summary']['forecasters']['Q0']['paired_excess_vs_baseline']
    assert original['n_fixed_observations']==4 and original['variability_limited']
    for key in ('n_fixed_observations','variability_limited'):
        assert sc['forecasters']['Q0']['paired'].get(key)==original[key], (key,sc['forecasters']['Q0']['paired'])

@pytest.mark.parametrize('lang',['es','en','zh'])
def test_p7_approximation_is_disclosed_in_every_language(rendered,lang):
    text=rendered[lang]['user']['kpi'] + rendered[lang]['protocol'] + rendered[lang]['limits']
    # The declared scenario must say that these are REGULAR-session prices approximating odd-lot executions.
    assert any(token in text.lower() for token in {'es':['precios de sesi├│n regular','precios de la sesi├│n regular'], 'en':['regular-session prices','regular session prices'], 'zh':['Σ╕ÇΦê¼Σ║ñµÿôσâ╣µá╝','Σ╕ÇΦê¼Σ║ñµÿôµÖéµ«╡','µò┤Φéíσâ╣µá╝','µò┤ΦéíΣ║ñµÿô','µÖ«ΘÇÜΣ║ñµÿôσâ╣µá╝']}[lang])

@pytest.mark.parametrize('lang',['es','en','zh'])
def test_historical_readmission_claim_is_conditional(rendered,lang):
    controls=rendered[lang]['strings']['controls']
    claim=controls[2]['p']
    # This code path explicitly has no multi-capture extractor yet.
    assert any(x in claim.lower() for x in {'es':['pendiente','registro de extractores'], 'en':['pending','extractor registry','if '], 'zh':['σ░Üµ£¬','σ╛à','ΦïÑ','σâàσ£¿']}[lang]), claim

def test_reviews_do_not_present_new_findings_as_closed(rendered,site):
    n=sum(r['findings_new'] for r in site['rounds'])
    original=json.loads((ROOT/'review/out/ronda16_verificacion_20260910T014302Z.json').read_text(encoding='utf8'))
    assert original['veredicto']=='rechazado'
    assert not ('Hallazgos corregidos' in rendered['es']['review'] and f'>{n}<' in rendered['es']['review']), n

def test_no_global_denial_of_user_confidence_intervals(rendered,site):
    user=next(s for s in site['scenarios'] if s['id']=='user')
    assert user['forecasters']['Q1']['paired']['ci95'] is not None
    assert 'no hay intervalo de confianza que publicar' not in rendered['es']['limits']

def test_published_sample_equity_keeps_flags():
    d=source('sample_2024_2025')
    assert d['summary']['forecasters']['Q0']['final_valuation']['flags']
    report=(ROOT/'docs/informes/14_backtest_muestra_2024-2025.md').read_text(encoding='utf8')
    row=next(s for s in report.splitlines() if s.startswith('| Q0 (`'))
    assert any(x in row.lower() for x in ('provisional','inciert','fractional')), row

def test_abstention_does_not_hide_return_of_held_positions(rendered,site):
    sc=next(s for s in site['scenarios'] if s['id']=='standard')
    w=next(w for w in sc['weeks'] if w['week_id']=='2026-W29')
    assert w['forecasters']['Q0']['net'] == pytest.approx(-.0629250122596161)
    assert w['forecasters']['Q0']['status']=='abstained'
    row=re.search(r'<tr class="wk[^>]+data-week="2026-W29".*?</tr>',rendered['es']['standard']['table'],re.S)[0]
    assert '6,29' in row, row

def test_equity_chart_marks_obsolete_prices(rendered,site):
    sc=next(s for s in site['scenarios'] if s['id']=='standard')
    w=next(w for w in sc['weeks'] if w['week_id']=='2026-W28')
    assert any('stale_price' in f for f in w['forecasters']['Q0']['flags'])
    assert w['forecasters']['Q0']['equity_end'] is not None
    chart=rendered['es']['standard']['kpi'].split('Patrimonio simulado, semana a semana',1)[1]
    assert any(token in chart.lower() for token in ('obsoleto','provisional','sin precio','stale')), chart[-400:]

