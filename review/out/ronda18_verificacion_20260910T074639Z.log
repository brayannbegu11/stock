790: function kpiAndChart(sc){
791:   const K = t("kpi"); const F = sc.forecasters;
792:   const row = (label,fn)=>`<tr><td>${esc(label)}</td>${FC.map(f=>{const x=F[f]; if(!x) return "<td class=num>ΓÇö</td>"; return `<td class="num">${esc(fn(x))}</td>`;}).join("")}</tr>`;
793:   const signed = v=>`<td class="num ${cls(v)}">${arrow(v)}${esc(pct(v))}</td>`;
794:   const rows = [
795:     `<tr><td>${esc(K.net)}</td>${FC.map(f=>F[f]?signed(F[f].mean_weekly_net):"<td class=num>ΓÇö</td>").join("")}</tr>`,
796:     `<tr><td>${esc(K.gross)}</td>${FC.map(f=>F[f]?signed(F[f].mean_weekly_gross_picks):"<td class=num>ΓÇö</td>").join("")}</tr>`,
797:     row(K.costs,x=>pct(x.mean_costs_over_invested,2,false)),
798:     row(K.pos,x=>`${x.weeks_positive}/${x.weeks_selected}`),
799:     row(K.fail,x=>`${x.entry_failures}/${(x.weeks_selected||0)*(sc.assumptions.slots||5)}`),
800:     row(K.eq,x=>twd(x.final_equity)),
801:     `<tr><td>${esc(K.tot)}</td>${FC.map(f=>F[f]?signed(F[f].total_net_return):"<td class=num>ΓÇö</td>").join("")}</tr>`,
802:     `<tr><td>${esc(K.paired)}</td>${FC.map(f=>{const x=F[f]; if(!x) return "<td class=num>ΓÇö</td>"; const p=x.paired; if(!p||f===sc.assumptions.baseline) return `<td class="num flat">ΓÇö</td>`; const ci=(p.ci95?`<br><span class="chip">${esc(t("paired_ci")(pp(p.ci95[0]),pp(p.ci95[1])))}</span>`:"")+(p.variability_limited?` <span class="chip warn">${esc(t("paired_lim")(p.n_fixed_observations))}</span>`:""); return `<td class="num wrap ${p.degenerate?"flat":cls(p.mean)}">${esc(t("paired_v")(pp(p.mean),p.n_used,p.degenerate))}${ci}</td>`;}).join("")}</tr>`
803:   ].join("");
804:   return `<div class="resgrid">
805:     <div class="card"><h3>${esc(t("kpi_title")(sc.weeks_operated))}</h3><div class="scroll"><table class="kpi"><colgroup><col class="lbl"><col><col><col></colgroup><thead><tr><th></th>${FC.map(f=>`<th class="num"><span class="chip ${f}">${f}</span></th>`).join("")}</tr></thead><tbody>${rows}</tbody></table></div>
806:       <p class="cap">${esc(t("ew")(pct(sc.universe_ew_mean_weekly_gross)))}</p><p class="cap">${esc(t("tw_legend"))}</p></div>
807:     <div class="card"><h3>${esc(t("chart_title"))}</h3>${equityChart(sc)}<div class="legend">${FC.map(f=>`<span><i style="background:var(--${f.toLowerCase()})"></i>${esc(t("fc")[f])}</span>`).join("")}</div><p class="cap">${esc(t("chart_cap"))}</p></div>
808:   </div>`;
809: }
810: function equityChart(sc){
811:   const weeks = sc.weeks.filter(w=>!w.pending_outcome);
812:   const series = FC.map(f=>({f,pts:weeks.map((w,i)=>({i,v:w.forecasters[f]&&w.forecasters[f].equity_end,prov:!!(w.forecasters[f]&&(w.forecasters[f].flags||[]).length)})).filter(p=>typeof p.v==="number")}));
813:   const init = sc.assumptions.initial_cash_twd||0;
814:   let vals = series.flatMap(s=>s.pts.map(p=>p.v)); vals.push(init);
815:   if(!vals.length) return "";
816:   let lo=Math.min(...vals), hi=Math.max(...vals); const pad=(hi-lo)*0.1||1; lo-=pad; hi+=pad;
817:   const W=640,H=300,L=52,R=64,T=16,B=34; const iw=W-L-R, ih=H-T-B, n=Math.max(weeks.length-1,1);
818:   const X=i=>L+iw*i/n, Y=v=>T+ih*(1-(v-lo)/(hi-lo));
819:   const ticks=[]; for(let k=0;k<=4;k++) ticks.push(lo+(hi-lo)*k/4);
820:   const grid = ticks.map(v=>`<line x1="${L}" x2="${W-R}" y1="${Y(v).toFixed(1)}" y2="${Y(v).toFixed(1)}" stroke="var(--line)" stroke-width="1"/><text x="${L-8}" y="${(Y(v)+3.5).toFixed(1)}" text-anchor="end">${esc(twdShort(v))}</text>`).join("");
821:   const xl = weeks.map((w,i)=> (i%3===0||i===weeks.length-1)?`<text x="${X(i).toFixed(1)}" y="${H-12}" text-anchor="middle">${esc(w.week_id.slice(5))}</text>`:"").join("");
822:   const initLine = `<line x1="${L}" x2="${W-R}" y1="${Y(init).toFixed(1)}" y2="${Y(init).toFixed(1)}" stroke="var(--fog)" stroke-dasharray="2 4" stroke-width="1"/>`;
823:   const ends = series.filter(s=>s.pts.length).map(s=>({f:s.f,y:Y(s.pts[s.pts.length-1].v),v:s.pts[s.pts.length-1].v,x:X(s.pts[s.pts.length-1].i)})).sort((a,b)=>a.y-b.y);
824:   for(let k=1;k<ends.length;k++){ if(ends[k].y-ends[k-1].y<13) ends[k].y=ends[k-1].y+13; }
825:   const paths = series.map(s=>{ if(!s.pts.length) return ""; const col=`var(--${s.f.toLowerCase()})`; let out="";
826:     for(let k=1;k<s.pts.length;k++){ const a=s.pts[k-1], b=s.pts[k]; const dash=(a.prov||b.prov)?` stroke-dasharray="3 3"`:"";
827:       out+=`<line x1="${X(a.i).toFixed(1)}" y1="${Y(a.v).toFixed(1)}" x2="${X(b.i).toFixed(1)}" y2="${Y(b.v).toFixed(1)}" stroke="${col}" stroke-width="1.7" stroke-linecap="round"${dash}/>`; }
828:     for(const p of s.pts){ if(p.prov) out+=`<circle cx="${X(p.i).toFixed(1)}" cy="${Y(p.v).toFixed(1)}" r="3.2" fill="var(--surface)" stroke="${col}" stroke-width="1.5"><title>${esc(weeks[p.i].week_id)}: ${esc((weeks[p.i].forecasters[s.f].flags||[]).join(", "))}</title></circle>`; }
829:     const last=s.pts[s.pts.length-1]; if(!last.prov) out+=`<circle cx="${X(last.i).toFixed(1)}" cy="${Y(last.v).toFixed(1)}" r="3" fill="${col}"/>`;
830:     return out; }).join("");
831:   const labels = ends.map(e=>`<text x="${(W-R+8).toFixed(1)}" y="${(e.y+3.5).toFixed(1)}" style="fill:var(--${e.f.toLowerCase()})">${esc(e.f)} ${esc(twdShort(e.v))}</text>`).join("");
832:   return `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="${esc(t("chart_title"))}"><rect x="0" y="0" width="${W}" height="${H}" fill="transparent"/>${grid}${initLine}${paths}${labels}${xl}</svg>`;
833: }
834: function weeksTable(sc){
835:   const TH = t("th"); const ST = t("st");
836:   const head = `<tr><th></th><th>${esc(TH.week)}</th><th>${esc(TH.cutoff)}</th><th class="num">${esc(TH.elig)}</th><th class="num">${esc(TH.ew)}</th>${FC.map(f=>`<th class="num">${esc(TH.net(f))}</th>`).join("")}<th>${esc(TH.status)}</th></tr>`;
837:   const rows = sc.weeks.map(w=>{
838:     const open = state.open.has(w.week_id);
839:     const closure = (sc.weeks_extraordinary_closure_unhandled||[]).includes(w.week_id);
840:     const status = w.pending_outcome?`<span class="chip warn">${esc(ST.pending)}</span>`:closure?`<span class="chip warn">${esc(ST.closure)}</span>`:w.status!=="valid"?`<span class="chip">${esc(w.status)}</span>`:"";
841:     const cell = f=>{ const x=w.forecasters[f]; if(!x) return `<td class="num flat">ΓÇö</td>`; if(w.pending_outcome) return `<td class="num flat">ΓÇª</td>`; const v=x.net; const abst=x.status!=="selected"?` <span class="chip" title="${esc(ST.nosel)}">${esc(ST.nosel)}</span>`:""; if(typeof v!=="number") return `<td class="num flat">ΓÇö${abst}</td>`; return `<td class="num ${cls(v)}">${arrow(v)}${esc(pct(v))}${x.failed?` <span class="chip bad" title="${esc(t("no_lot"))}">ΓêÆ${x.failed}</span>`:""}${abst}</td>`; };
842:     const main = `<tr class="wk${open?" open":""}" data-week="${esc(w.week_id)}" tabindex="0" aria-expanded="${open}"><td><span class="caret">Γû╕</span></td><td class="mono">${esc(w.week_id)}</td><td>${esc(fmtDay(w.cutoff_at))}</td><td class="num">${nf(w.eligible||0,0)}</td><td class="num ${w.pending_outcome?"flat":cls(w.ew_gross)}">${w.pending_outcome?"ΓÇª":arrow(w.ew_gross)+esc(pct(w.ew_gross))}</td>${FC.map(cell).join("")}<td>${status}</td></tr>`;
843:     const detail = `<tr class="detail" data-detail="${esc(w.week_id)}"${open?"":" hidden"}><td colspan="${6+FC.length}"><div class="dgrid">${FC.map(f=>pickList(w,f)).join("")}</div></td></tr>`;
844:     return main+detail;
845:   }).join("");
846:   return `<div class="card weeks"><h3 style="margin-bottom:4px">${esc(t("weeks_title"))}</h3><p class="cap" style="margin:0 0 12px">${esc(t("weeks_hint"))}</p><div class="scroll"><table><thead>${head}</thead><tbody>${rows}</tbody></table></div></div>`;
847: }
848: function pickList(w,f){
849:   const x = w.forecasters[f]; const PS=t("pick_status"), RS=t("reason");
850:   if(!x) return "";
851:   const items = (x.picks||[]).map(p=>{
852:     const st = p.entry_status||(w.pending_outcome?"pending":"");
853:     const chip = st? `<span class="chip ${st==="entry_failed"?"bad":st==="exited"||st==="filled"?"":"warn"}">${esc(PS[st]||st)}${p.entry_reason?" ┬╖ "+esc(RS[p.entry_reason]||p.entry_reason):""}</span>`:"";
854:     const g = typeof p.gross_return==="number"?`<span class="num ${cls(p.gross_return)}">${arrow(p.gross_return)}${esc(pct(p.gross_return))}</span>`:chip;
855:     return `<li><span class="mono">${esc(p.symbol)}</span><span class="nm" lang="zh-Hant">${esc(p.name)}${typeof p.gross_return==="number"&&st==="entry_failed"?" "+chip:""}</span>${g}</li>`;
856:   }).join("");
857:   const sub = x.status==="selected"? (w.pending_outcome?"":`${esc(t("th").gross)} ${esc(pct(x.gross_picks))} ┬╖ ${esc(t("th").net(f))} ${esc(pct(x.net))}${x.paired===false&&x.unpaired_reason?` ┬╖ <span class="chip">${esc(RS[x.unpaired_reason]||x.unpaired_reason)}</span>`:""}`) : esc(x.status_reason||x.status||"");
858:   return `<div class="f"><h4><i class="dot ${f}"></i>${esc(t("fc")[f])}</h4><ul>${items||`<li>${esc(t("st").nosel)}</li>`}</ul><p class="cap" style="margin-top:8px">${sub}</p></div>`;
859: }
