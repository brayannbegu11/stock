+from review.out.astra_scratch.r10_support import *
+from review.out.astra_scratch.test_r16_attacks import daily
+from twlab.backtest import TabularForecaster
+from twlab.simulation import affordable_shares, entry_cost, enter_basket, exit_basket
+from twlab.ledger import PaperLedger, CostModel, Fill
+from twlab.weekly import plan_week
+from decimal import ROUND_HALF_UP, ROUND_DOWN
+import importlib.util, subprocess, re, random, pytest
+
+spec=importlib.util.spec_from_file_location('r18_export', ROOT/'scripts/export_site_data.py')
+export=importlib.util.module_from_spec(spec);spec.loader.exec_module(export)
+
+def read_source(label):
+    return json.loads((ROOT/'data/store'/f'backtest_{label}.json').read_text(encoding='utf8'))
+
+@pytest.fixture(scope='module')
+def site():
+    return json.loads((ROOT/'docs/site/data.json').read_text(encoding='utf8'))
+
+@pytest.fixture(scope='module')
+def rendered():
+    return render()
+
+def render(mode=None):
+    p=subprocess.run(['node','review/out/astra_scratch/r18_render.cjs']+([mode] if mode else []),cwd=ROOT,capture_output=True,text=True,encoding='utf8',check=True)
+    return json.loads(p.stdout)
+
+def oracle_cost(q,p,c):
+    gross=(q*p).quantize(D(1),rounding=ROUND_HALF_UP)
+    rnd=ROUND_DOWN if c.rounding=='floor' else ROUND_HALF_UP
+    slip=(gross*D(c.slippage_bps_per_side)/10000).quantize(D(1),rounding=rnd)
+    ex=gross+slip
+    comm=max((ex*c.commission_per_side).quantize(D(1),rounding=rnd),c.min_commission_twd) if ex>0 else D(0)
+    return ex+comm
+
+@pytest.mark.parametrize('lot',[1,1000])
+@pytest.mark.parametrize('minimum',[0,20])
+@pytest.mark.parametrize('rounding',['floor','half_up'])
+def test_r17_01_boundary_sizing_and_ledger(lot,minimum,rounding):
+    rng=random.Random(1801)
+    for i in range(180):
+        p=D(rng.randrange(1,1500000))/100
+        c=CostModel(D('0.001425') if i%3 else D(0),slippage_bps_per_side=[0,10,20,25][i%4],min_commission_twd=D(minimum),rounding=rounding)
+        target=rng.randrange(1,30)*lot
+        budget=oracle_cost(target,p,c)+D(['-1','-0.01','0','0.01','1'][i%5])
+        lg=PaperLedger(ledger_id='r18',initial_cash=max(budget,D(0)),cost_model=c,lot_size=lot)
+        q=affordable_shares(lg,price=p,budget=budget)
+        assert q%lot==0 and q>=0
+        assert not q or oracle_cost(q,p,c)<=budget
+        assert oracle_cost(q+lot,p,c)>budget
+        if q:
+            f=lg.buy(security_id='A',price=p,shares=q,at=taipei(date(2024,1,8),time(9)),event_id='e')
+            assert isinstance(f,Fill)
+            assert -f.cash_delta==oracle_cost(q,p,c)==entry_cost(lg,price=p,shares=q)
+
+@pytest.mark.parametrize('lot',[1,1000])
+def test_r17_01_trapped_cash_sim05(lot):
+    lg=PaperLedger(ledger_id='r18',initial_cash=D(1000*lot),cost_model=CostModel(D(0),sell_tax=D(0)),lot_size=lot)
+    first=enter_basket(lg,picks=['A'],slots=1,notional_per_slot=D(1000*lot),open_prices={'A':D(10)},at=taipei(date(2024,1,8),time(9)),week_id='W02')
+    exit_basket(lg,first,close_prices={},at=taipei(date(2024,1,12),time(13,30)),week_id='W02')
+    assert first[0].status=='exit_blocked' and lg.cash==0
+    second=enter_basket(lg,picks=['B'],slots=1,notional_per_slot=D(1000*lot),open_prices={'B':D(10)},at=taipei(date(2024,1,15),time(9)),week_id='W03')
+    assert second[0].status=='entry_failed' and second[0].reason=='insufficient_cash'
+    assert 'A' in lg.positions and 'B' not in lg.positions and lg.cash==0
+
+@pytest.mark.parametrize('change',['replace','add','remove','clear'])
+def test_r17_02_all_session_capture_mutations(tmp_path,change):
+    _,m=daily(tmp_path)
+    before=m.data_version;f=TabularForecaster(m,min_weeks=1)
+    caps=m.securities['A'].bar_captures
+    if change=='replace':caps[date(2024,1,4)]=caps[date(2024,1,5)]
+    if change=='add':caps[date(2024,1,3)]=caps[date(2024,1,5)]
+    if change=='remove':del caps[date(2024,1,4)]
+    if change=='clear':caps.clear()
+    assert before!=m.data_version
+    with pytest.raises(ValueError,match='data_version'):
+        f.maybe_train(taipei(date(2024,1,7),time(18)))
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_r17_03_missing_one_and_intact(tmp_path,market):
+    raw,m=daily(tmp_path,market,days=('2024-01-04','2024-01-05','2024-01-08'))
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,12),min_history_sessions=1,liquidity_multiple=0)
+    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
+    plan=plan_week(taipei(date(2024,1,7),time(18)),m.calendar)
+    p,_,cs=r.build_week_packet(plan)
+    assert any(d.kind=='price_bar_series' for d in p.admitted) and cs[0].eligible
+    del m.securities['A'].bar_captures[date(2024,1,4)]
+    p,_,cs=r.build_week_packet(plan)
+    assert not any(d.kind=='price_bar_series' for d in p.admitted)
+    assert not cs[0].eligible and cs[0].reasons==('provenance_incomplete:1_sessions_without_capture',)
+    r.run_week(date(2024,1,7))
+    assert r.weeks[-1]['coverage_reasons']['provenance_incomplete']==1
