317:   verdict_tag:"Lectura honesta",
318:   verdict:(v)=>`En las ${v.w} semanas simuladas (mayoΓÇôseptiembre de 2026) ninguna cartera gana dinero neta de costes en ning├║n escenario. En el protocolo est├índar, Q0 y Q1 ${v.stdBelow?"quedan por debajo del":"no superan con claridad al"} control aleatorio (${v.q0s} y ${v.q1s} frente a ${v.a1s} semanal)${v.user?`; con tu capital, Q1 ${v.q1AboveUser?"queda ligeramente por encima del azar":"tampoco supera al azar"} (${v.q1u} frente a ${v.a1u}), pero el intervalo de confianza del exceso incluye el cero`:""}. Con tan pocas semanas y sin dividendos no se puede afirmar ni negar que tengan se├▒al. Las listas de esta p├ígina son la salida de un experimento, no recomendaciones.`,
319:   wk_label:"Esta semana", wk_title:"La lista de la semana",
320:   wk_sub:(wk,cut)=>`Semana ${wk}. Corte: ${cut} (hora de Taip├⌐i). Entrada simulada en la primera apertura tras el plazo del lunes 08:30; salida en el ├║ltimo cierre de la semana.`,
321:   wk_banner:(when)=>`Esta lista se archiv├│ el ${when} (hora de Taip├⌐i), despu├⌐s de la apertura del lunes: es una reconstrucci├│n con datos ya conocidos, no una predicci├│n prospectiva. La primera lista prospectiva ser├í la del corte del domingo 13 de septiembre, publicada antes de la apertura del lunes 14.`,
322:   wk_banner_tag:"No prospectiva",
323:   wk_pending:"Resultado pendiente: la semana a├║n no ha cerrado.",
324:   wk_scen_note:"Las listas cambian con el escenario: la regla de liquidez exige que la mediana del importe negociado en 20 sesiones sea al menos 20 veces el nocional del puesto, as├¡ que con 15.000 TWD por puesto entran valores peque├▒os que con 1.000.000 TWD quedan fuera. El control aleatorio tambi├⌐n se sortea sobre ese universo.",
325:   wk_universe:(n)=>`${n} valores elegibles`,
326:   fc:{Q0:"Q0 ┬╖ Momentum",Q1:"Q1 ┬╖ Modelo tabular",A1:"A1 ┬╖ Control aleatorio"},
327:   fc_how:{Q0:"las 5 que m├ís subieron en 20 sesiones",Q1:"ridge + LightGBM sobre rangos semanales",A1:"5 valores al azar del universo elegible"},
328:   entries:"Entradas", entries_v:(f,n)=>`${f} de ${n}`, no_lot:"sin lote posible", scen_short:{standard:"est├índar",user:"tu capital"},
329:   no_scenario:"en c├ílculo",
