+        xs=[w['forecasters'][f].get('portfolio_net_return_open_close') for w in d['weeks'] if not w.get('pending_outcome')]
+        measurable=[x for x in xs if x is not None]
+        expected=f'{sum(x>0 for x in measurable)}/{len(measurable)}'
+        assert expected in row,(expected,row)
+
+def test_followup_sales_are_in_weekly_costs(tmp_path):
+    raw,m=fixture(tmp_path,end='2024-01-19')
+    s=next(iter(m.securities.values()));missing=date(2024,1,12)
+    s.bars=[b for b in s.bars if b.session!=missing]
+    del m.by_session[s.security_id][missing];m.traded_days.discard(missing)
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,19),slots=1,notional=10000,lot_size=1,min_commission_twd=D(20),slippage_bps=0)
+    r=Runner(raw,m,cfg,[MomentumForecaster(),RandomForecaster(1)])
+    r.run_week(date(2024,1,7));assert r.weeks[-1]['forecasters']['Q0']['exit_blocked']==1
+    oldslot=r.open_slots['Q0'][0][1][0]
+    r.run_week(date(2024,1,14));w=r.weeks[-1]['forecasters']['Q0']
+    assert w['forecast_status']=='abstained' and isinstance(oldslot.exit,Fill)
+    f=oldslot.exit;actual=f.commission+f.tax+f.slippage_cost
+    assert w['costs_twd']==float(actual),(w['costs_twd'],actual,f.shares,f.price,w['portfolio_net_return_open_close'])
+
+def test_final_valuation_flags_survive_site_export():
+    original=read_source('sample_2024_2025')['summary']['forecasters']['Q0']['final_valuation']
+    assert original['flags'] and original['equity']==2021351
+    sc=export.export_scenario('standard','sample_2024_2025','14_backtest_muestra_2024-2025.md')
+    published=sc['forecasters']['Q0']
+    assert published.get('final_valuation',{}).get('flags')==original['flags'],published
+
+def test_readme_and_response_counts_match_site(site):
+    readme=(ROOT/'README.md').read_text(encoding='utf8')
+    response=(ROOT/'docs/informes/23_respuesta_ronda17_astra.md').read_text(encoding='utf8')
