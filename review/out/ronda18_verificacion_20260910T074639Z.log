+                assert sc['forecasters'][f]['paired'][k]==p[k]
+    rows=[json.loads(l) for l in (ROOT/'data/store'/site['master']['file']).read_text(encoding='utf8').splitlines()]
+    assert site['master']['segments']==sum(x['kind']=='segment' for x in rows)==2348
+
+@pytest.mark.parametrize('lang',['es','en','zh'])
+def test_r17_08_and_09_rendered_flags_returns(site,rendered,lang):
+    for sc in site['scenarios']:
+        w=next(w for w in sc['weeks'] if w['week_id']=='2026-W28')
