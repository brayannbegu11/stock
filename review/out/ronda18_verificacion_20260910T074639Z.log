331:   res_sub:(u)=>`Recorrido semana a semana sobre las ${u} acciones ordinarias del tablero principal, con las cotizaciones oficiales por fecha y sin dividendos. Dos escenarios: el est├índar del protocolo y uno con un capital como el tuyo.`,
332:   scen:{standard:"Protocolo est├índar",user:"Tu capital"},
333:   scen_sub:{standard:"5.000.000 TWD ┬╖ lotes de 1.000",user:"75.000 TWD ┬╖ lotes sueltos Θ¢╢Φéí ┬╖ m├¡n. 20 TWD"},
334:   scen_missing:"Este escenario todav├¡a se est├í calculando; cuando termine, el exportador lo a├▒adir├í aqu├¡.",
335:   scen_note:{standard:"",user:"Aproximaci├│n declarada: las ejecuciones de lotes sueltos usan los precios de la sesi├│n regular, no los del mercado de lotes sueltos; el deslizamiento de 20 pb y la comisi├│n m├¡nima de 20 TWD son hip├│tesis, no mediciones."},
336:   kpi_title:(n)=>`${n} semanas operadas`,
