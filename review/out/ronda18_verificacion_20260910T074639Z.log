+def render(mode=None):
+    p=subprocess.run(['node','review/out/astra_scratch/r18_render.cjs']+([mode] if mode else []),cwd=ROOT,capture_output=True,text=True,encoding='utf8',check=True)
+    return json.loads(p.stdout)
