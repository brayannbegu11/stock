882:     const sevtxt = SEV.filter(s=>r.severity[s]).map(s=>`${r.severity[s]} ${esc(t("sev")[s])}`).join(" ┬╖ ");
883:     return `<div class="round"><div class="n"><small>${esc(t("round_word"))}</small>${r.round}</div><div>
884:       <div class="meta"><span class="chip ${r.verdict==="rechazado"?"warn":"ok"}">${esc(t("verdicts")[r.verdict]||r.verdict)}</span><span>${esc(t("new_findings")(r.findings_new))}</span><span class="sevbar">${bar}</span><span>${sevtxt}</span></div>
885:       <p class="sum">${esc(r.summary||"")}</p>
886:       <p class="links"><a href="${esc(gh(r.file))}">${esc(t("astra_out"))} Γåù</a>${r.response?`<a href="${esc(gh(r.response))}">${esc(t("response"))} Γåù</a>`:""}</p>
