diff --git a/review/out/astra_scratch/r18_render.cjs b/review/out/astra_scratch/r18_render.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..da96f53d715bab967ada4539fddd7f1957586579
--- /dev/null
+++ b/review/out/astra_scratch/r18_render.cjs
@@ -0,0 +1,21 @@
+const fs=require('fs'), vm=require('vm');
+const html=fs.readFileSync('docs/index.html','utf8');
+const payload=html.match(/<script type="application\/json" id="site-data">([\s\S]*?)<\/script>/)[1];
+let code=[...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].pop()[1];
+code=code.replace('state.lang = detectLang();\nrender();', 'globalThis.api={S,DATA,state,howSection,reviewSection,limitsSection,kpiAndChart,weekSection,weeksTable,resultsSection,hero,equityChart,dataSection};');
+const ctx={document:{getElementById:()=>({textContent:payload})},Intl,URLSearchParams};
+vm.createContext(ctx);vm.runInContext(code,ctx);const a=ctx.api;
+if(process.argv[2]==='mutated-review'){
+  a.DATA.rounds=[{round:18,findings_new:1,severity:{bloqueante:1},verdict:'aprobado_con_cambios',summary:'',new_findings:[],verifications:[]}];
+  a.DATA.review_stats={new_total:1,verified_total:0,blocking_new:1,blocking_verified:0,unverified_ids:[]};
+}
+const out={};
+for(const lang of ['es','en','zh']){
+  a.state.lang=lang;
+  out[lang]={strings:a.S[lang],protocol:a.howSection(),review:a.reviewSection(a.DATA.rounds),limits:a.limitsSection()};
+  for(const sc of a.DATA.scenarios){
+    a.state.scenario=sc.id;
+    out[lang][sc.id]={kpi:a.kpiAndChart(sc),week:a.weekSection(sc,null),table:a.weeksTable(sc),results:a.resultsSection(sc),chart:a.equityChart(sc)};
+  }
+}
+process.stdout.write(JSON.stringify(out));
diff --git a/review/out/astra_scratch/test_r18_attacks.py b/review/out/astra_scratch/test_r18_attacks.py
new file mode 100644
index 0000000000000000000000000000000000000000..1317f4bcf33daa405545ebbabb6afce0c4c0857c
--- /dev/null
+++ b/review/out/astra_scratch/test_r18_attacks.py
@@ -0,0 +1,116 @@
+from review.out.astra_scratch.test_r18_verification import (
+    ROOT,D,date,time,taipei,daily,fixture,Runner,BacktestConfig,MomentumForecaster,
+    RandomForecaster,plan_week,export,read_source,render,site,rendered)
+from twlab.backtest import markdown_report
+from twlab.ledger import PaperLedger,CostModel,Fill
+from dataclasses import replace
+import json,re,pytest
+
+@pytest.mark.parametrize('market',['TWSE','TPEX'])
+def test_empty_daily_capture_map_is_not_a_single_capture_series(tmp_path,market):
+    raw,m=daily(tmp_path,market)
+    m.securities['A'].bar_captures.clear()
+    r=Runner(raw,m,BacktestConfig(date(2024,1,1),date(2024,1,12),min_history_sessions=1,liquidity_multiple=0),[MomentumForecaster(),RandomForecaster(1)])
+    p,_,cs=r.build_week_packet(plan_week(taipei(date(2024,1,7),time(18)),m.calendar))
+    series=[d for d in p.admitted if d.kind=='price_bar_series']
+    assert not series and cs[0].reasons==('provenance_incomplete:2_sessions_without_capture',), [(d.derivation,d.payload) for d in series]
+
+def test_conflicting_session_captures_cannot_overwrite_each_other(tmp_path):
+    raw,m=daily(tmp_path)
+    a=m.securities['A'];original=a.bar_captures[date(2024,1,4)]
+    # Two captured revisions of the same TWSE session; the two securities may reference different revisions.
+    orig=raw.get(original)
+    revised=raw.put(source_id='twse',dataset=orig.dataset,payload=b'{"revision":2}',url='fixture',http_status=200)
