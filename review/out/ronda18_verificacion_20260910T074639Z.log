895:         <div><div class="k">${esc(K.verified)}</div><div class="v">${RS.verified_total!=null?nf(RS.verified_total,0):"ΓÇö"}</div><div class="s">${RS.unverified_ids?esc(RS.unverified_ids.slice(0,6).join(" ┬╖ "))+(RS.unverified_ids.length>6?" ΓÇª":""):""}</div></div>
896:         <div><div class="k">${esc(K.block)}</div><div class="v">${RS.blocking_new!=null?`${nf(RS.blocking_new,0)} ┬╖ ${nf(RS.blocking_verified,0)}`:"ΓÇö"}</div><div class="s">${esc(t("sev").bloqueante)}</div></div>
897:         <div><div class="k">${esc(K.last)}</div><div class="v">${last.findings_new}</div><div class="s">${(last.severity||{}).alta||0} ${esc(t("sev").alta)} ┬╖ ${(last.severity||{}).media||0} ${esc(t("sev").media)}</div></div>
898:       </div>
899:     </div>
900:     <p class="cap" style="margin-top:20px">${esc(t("rev_lang"))}</p>
901:     <div class="rounds">${list}</div>
902:   </div></section>`;
903: }
904: function findingsChart(rounds){
905:   if(!rounds.length) return "";
906:   const SEV = ["baja","media","alta","bloqueante"];
907:   const W=640,H=220,L=30,R=8,T=14,B=26; const iw=W-L-R, ih=H-T-B;
908:   const max = Math.max(5,...rounds.map(r=>r.findings_new));
909:   const bw = iw/rounds.length, gap = Math.min(12,bw*0.34);
910:   const Y = v=>T+ih*(1-v/max);
911:   const ticks=[0,Math.round(max/2),max];
912:   const grid = ticks.map(v=>`<line x1="${L}" x2="${W-R}" y1="${Y(v).toFixed(1)}" y2="${Y(v).toFixed(1)}" stroke="var(--line)"/><text x="${L-6}" y="${(Y(v)+3.5).toFixed(1)}" text-anchor="end">${v}</text>`).join("");
913:   const bars = rounds.map((r,i)=>{ let acc=0; const x=L+i*bw+gap/2, w=bw-gap; const segs=SEV.map(s=>{const n=r.severity[s]||0; if(!n) return ""; const y1=Y(acc+n), y0=Y(acc); acc+=n; return `<rect x="${x.toFixed(1)}" y="${y1.toFixed(1)}" width="${w.toFixed(1)}" height="${Math.max(0,(y0-y1)-1).toFixed(1)}" rx="1" style="fill:var(--sev-${({bloqueante:"block",alta:"high",media:"mid",baja:"low"})[s]})"/>`;}).join("");
914:     return segs+`<text x="${(x+w/2).toFixed(1)}" y="${(Y(r.findings_new)-5).toFixed(1)}" text-anchor="middle" style="fill:var(--ink-2)">${r.findings_new}</text><text x="${(x+w/2).toFixed(1)}" y="${H-8}" text-anchor="middle">${r.round}</text>`; }).join("");
915:   return `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="${esc(t("rev_chart"))}">${grid}${bars}</svg>`;
916: }
