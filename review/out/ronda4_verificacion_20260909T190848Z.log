      "comando_reproduccion": "python -B -m pytest -q -p no:cacheprovider review/out/astra_scratch/test_ronda4.py::test_unsigned_packet_binding_can_be_reassigned --basetemp=review/out/astra_scratch/r4_repro",
      "prueba_propuesta": "from datetime import timedelta\nfrom review.out.astra_scratch.test_ronda4 import live_packet, signed, validate_prediction\n\ndef test_paquete_dentro_del_digest(tmp_path):\n    p = live_packet()\n    store, rec, obj = signed(tmp_path, p)\n    seals = store.seals()\n    other = live_packet(p.cutoff_at - timedelta(minutes=5))\n    obj['cutoff_at'] = other.cutoff_at.isoformat()\n    assert validate_prediction(obj, other, seals=seals)\n    seals['ots:test'].capture_extra['packet_hash'] = other.packet_hash()\n    assert validate_prediction(obj, other, seals=seals)\n",
