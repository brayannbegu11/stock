      "prueba_propuesta": "from datetime import timedelta\nfrom review.out.astra_scratch.test_ronda4 import live_packet, signed, validate_prediction\n\ndef test_acreditacion_antes_del_plazo(tmp_path):\n    p = live_packet()\n    store, rec, obj = signed(tmp_path, p, stamp=(p.deadline_at + timedelta(days=7)).isoformat())\n    assert store.seals(not_after=p.deadline_at) == {}\n    assert validate_prediction(obj, p, seals=store.seals())\n",
