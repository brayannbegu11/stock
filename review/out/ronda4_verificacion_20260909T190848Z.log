+    p2 = live_packet(p.cutoff_at - timedelta(minutes=5))
+    o['cutoff_at'] = p2.cutoff_at.isoformat()
+    assert validate_prediction(o, p2, seals=seals)
+    seals['ots:test'].capture_extra['packet_hash'] = p2.packet_hash()
+    assert validate_prediction(o, p2, seals=seals), 'Unsigned mutable metadata rebinds unchanged receipt'
+
+
+def test_attestation_after_deadline_is_rejected_by_validator(tmp_path):
+    p = live_packet()
+    s, r, o = signed(tmp_path, p, stamp=(p.deadline_at + timedelta(days=7)).isoformat())
+    assert s.seals(not_after=p.deadline_at) == {}
+    assert validate_prediction(o, p, seals=s.seals()), 'Attestation one week late accepted through seals()'
+
+
+def test_midweek_cutoff_cannot_reissue_weekly_selection():
+    cutoff = datetime.fromisoformat('2026-09-10T02:00:00+08:00')
+    try:
+        p = packet(cutoff_at=cutoff)
+    except ValueError:
+        return
+    o = base(cutoff_at=cutoff.isoformat(), issued_at='2026-09-10T07:00:00+08:00',
+             deadline_at=p.deadline_at.isoformat())
+    assert validate_prediction(o, p), (p.week_id, p.entry_at, p.exit_at)
+
+
+def test_week_plan_never_enters_before_forecast_deadline():
+    cal = TradingCalendar(start=date(2026,1,1), end=date(2026,12,31), closures=[],
+                          source_id='synthetic', recorded_at=R(2026,1,1),
+                          session_overrides={date(2026,9,7): (time(8), time(13,30))})
+    p = plan_week(CUTOFF, cal)
+    assert p.entry_at > p.deadline_at, (p.entry_at, p.deadline_at)
+
+
+def test_packet_payload_identity_includes_json_types(tmp_path):
+    s = RawStore(tmp_path)
+    r = s.put(source_id='test', dataset='x', payload=b'{"revenue":true}', url='fixture')
+    d = doc('d', r.ingested_at_dt, capture=r, payload={'revenue': 1}, derivation='json')
+    p = build_packet(packet_id='p', cutoff_at=r.ingested_at_dt, documents=[d],
+                     mode='prospective', evidence_class='prospective_registered', calendar=CAL,
+                     captures={r.capture_id:r}, read_bytes=s.read, extractors={'json':json.loads})
+    assert not p.admitted, 'Boolean true became numerical revenue=1'
+
+
+def test_late_known_payment_does_not_backdate_cash_event():
+    lg = ledger(costs=FREE)
+    lg.buy(security_id='A', price=D(100), shares=1000, at=MON, event_id='buy')
+    lg.apply_corporate_action(CorporateAction('div', 'A', 'cash_dividend', MON, per_share_cash=D(1)))
+    lg.advance_to(FRI)
+    lg.set_payment_date('div', pay_at=MON+timedelta(days=1), at=FRI)
+    ats = [e.at for e in lg.events]
+    assert ats == sorted(ats), [(e.kind,e.at,e.cash_delta) for e in lg.events]
+
+
+def test_previous_blocked_basket_does_not_own_later_purchase():
+    lg = ledger('300000',FREE)
+    args = dict(picks=['A'], slots=1, notional_per_slot=D(100000), open_prices={'A':D(100)})
+    w1 = enter_basket(lg, **args, at=MON, week_id='w1')
+    exit_basket(lg,w1,close_prices={},at=FRI,week_id='w1')
+    w2 = enter_basket(lg, **args, at=MON+timedelta(days=7),week_id='w2')
+    exit_basket(lg,w1,close_prices={'A':D(100)},at=FRI+timedelta(days=7),week_id='w1')
+    assert w1[0].gross_pick_return == D(0), w1[0]
+    assert lg.positions['A'].total_quantity >= D(w2[0].entry.shares)
+
+
+def test_exit_residual_uses_same_proportion_as_attributed_quantity():
+    lg = ledger('400000',FREE)
+    lg.buy(security_id='A',price=D(100),shares=1000,at=MON,event_id='old')
+    w = enter_basket(lg,picks=['A'],slots=1,notional_per_slot=D(100000),open_prices={'A':D(100)},at=MON,week_id='w')
+    lg.apply_corporate_action(CorporateAction('sp','A','split',MON,split_ratio=D('1.1')))
+    exit_basket(lg,w,close_prices={'A':D(100)/D('1.1')},at=FRI,week_id='w')
+    assert lg.positions['A'].total_quantity == D(200)
+    assert w[0].exit_residual_quantity == D(100), w[0]
+
+
+def test_cash_dividend_is_in_gross_total_pick_return():
+    lg = ledger('100000',FREE)
+    w = enter_basket(lg,picks=['A'],slots=1,notional_per_slot=D(100000),open_prices={'A':D(100)},at=MON,week_id='w')
+    lg.apply_corporate_action(CorporateAction('div','A','cash_dividend',MON+timedelta(days=1),per_share_cash=D(1),pay_at=FRI))
+    exit_basket(lg,w,close_prices={'A':D(99)},at=FRI,week_id='w')
+    assert lg.cash == D(100000)
+    assert w[0].gross_pick_return == D(0), w[0].gross_pick_return
+
+
+def test_same_master_key_cannot_rewrite_known_history():
+    m = SecurityMaster()
+    a = sv(security_id='A',symbol='1111',valid_from=date(2020,1,1),recorded_at=R(2020,1,1))
+    m.add(a)
+    before = m.universe(as_of=date(2020,6,1),known_at=R(2020,6,1))
+    try:
+        m.add(sv(security_id='A',symbol='2222',valid_from=a.valid_from,recorded_at=a.recorded_at))
+    except ValueError:
+        return
+    assert m.universe(as_of=date(2020,6,1),known_at=R(2020,6,1)) == before
+
+
