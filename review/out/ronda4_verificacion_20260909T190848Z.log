      "prueba_propuesta": "import json\nfrom dataclasses import replace\nfrom review.out.astra_scratch.test_ronda4 import RawStore, doc, build_packet, CAL\n\ndef test_identidad_documental_derivada(tmp_path):\n    store = RawStore(tmp_path)\n    raw = b'{\"security_id\":\"SEC-1\",\"revenue\":100}'\n    rec = store.put(source_id='test',dataset='revenue',payload=raw,url='fixture')\n    d = replace(doc('d',rec.ingested_at_dt,capture=rec,payload=json.loads(raw)),security_ids=('SEC-2',))\n    p = build_packet(packet_id='p',cutoff_at=rec.ingested_at_dt,documents=[d],mode='prospective',evidence_class='prospective_registered',calendar=CAL,captures={rec.capture_id:rec},read_bytes=store.read,extractors={'json':json.loads})\n    assert not p.admitted\n",
