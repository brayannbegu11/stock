      "contraejemplo": "W1 compra 1.000 acciones A a 100 y no sale por ausencia de precio. W2 compra otras 1.000 a 100. Reintentar W1 a 100 vende 2.000, atribuye todas a W1 y publica gross_pick_return=1,000000000000, es decir +100%, con precio constante. W2 queda sin posición.",
      "comando_reproduccion": "python -B -m pytest -q -p no:cacheprovider review/out/astra_scratch/test_ronda4.py::test_previous_blocked_basket_does_not_own_later_purchase",
      "prueba_propuesta": "from datetime import timedelta\nfrom decimal import Decimal as D\nfrom review.out.astra_scratch.test_ronda4 import ledger, FREE, MON, FRI, enter_basket, exit_basket\n\ndef test_compras_posteriores_no_son_beneficio():\n    lg = ledger('300000', FREE)\n    args = dict(picks=['A'],slots=1,notional_per_slot=D(100000),open_prices={'A':D(100)})\n    w1 = enter_basket(lg, **args, at=MON, week_id='w1')\n    exit_basket(lg,w1,close_prices={},at=FRI,week_id='w1')\n    w2 = enter_basket(lg, **args, at=MON+timedelta(days=7), week_id='w2')\n    exit_basket(lg,w1,close_prices={'A':D(100)},at=FRI+timedelta(days=7),week_id='w1')\n    assert w1[0].gross_pick_return == D(0)\n    assert lg.positions['A'].total_quantity >= D(w2[0].entry.shares)\n",
