      "prueba_propuesta": "from datetime import date, time\nfrom review.out.astra_scratch.test_ronda4 import TradingCalendar, R, CUTOFF, plan_week\n\ndef test_apertura_posterior_al_plazo():\n    cal = TradingCalendar(start=date(2026,1,1), end=date(2026,12,31), closures=[], source_id='synthetic', recorded_at=R(2026,1,1), session_overrides={date(2026,9,7):(time(8),time(13,30))})\n    p = plan_week(CUTOFF, cal)\n    assert p.entry_at > p.deadline_at\n",
