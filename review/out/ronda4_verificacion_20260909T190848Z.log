      "prueba_propuesta": "from datetime import datetime\nfrom review.out.astra_scratch.test_ronda4 import packet, base, validate_prediction\n\ndef test_corte_semanal_fijo():\n    cutoff = datetime.fromisoformat('2026-09-10T02:00:00+08:00')\n    try:\n        p = packet(cutoff_at=cutoff)\n    except ValueError:\n        return\n    obj = base(cutoff_at=cutoff.isoformat(), issued_at='2026-09-10T07:00:00+08:00', deadline_at=p.deadline_at.isoformat())\n    assert validate_prediction(obj, p)\n",
