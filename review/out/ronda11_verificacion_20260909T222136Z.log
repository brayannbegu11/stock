      "prueba_propuesta": "from datetime import date\nfrom twlab.models import q1\nfrom twlab.timeutil import taipei\n\ndef test_constant_model_assigns_equal_scores():\n    ridge = q1.RidgeRank().fit([[1.]*len(q1.FEATURE_NAMES)]*3, [.5]*3)\n    model = q1.Q1Model(taipei(date(2024,1,1)),3,1,'w','w',ridge)\n    scores = model.predict([{k:1. for k in q1.FEATURE_NAMES}]*3)\n    assert len(set(scores)) == 1\n\n# Usar rangos medios para empates y separar cualquier desempate de selecci├│n del score estad├¡stico.",
