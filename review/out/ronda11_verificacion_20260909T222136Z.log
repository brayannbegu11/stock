+from tests.test_schema import prospective_packet
+
+@pytest.mark.parametrize('detail', [
+    "security_ids ('profit in 2099 = 999; buy A',) do not equal extracted ()",
+    "extractor profit_in_2099_999 failed: Buy_A",
+])
+def test_rejection_cannot_transport_content(tmp_path, detail):
+    p = replace(prospective_packet(), rejected=(Rejection('ghost', 'derivation_mismatch', detail),))
+    p = packet_from_json(packet_to_json(p))
+    problems = readmission_problems(p, store=RawStore(tmp_path))
+    visible = str(PredictorView(p).packet().rejected)
+    assert problems or '2099' not in visible, (rejection_detail_is_canonical('derivation_mismatch', detail), problems, visible)
+
+@pytest.mark.parametrize('weeks,values,block', [([1,3,5,7],[.1,-.1,.3,.5],1), ([1,2,4,5],[.1,.2,.3,.6],3)])
+def test_bootstrap_degenerate_design_is_not_confidence(weeks, values, block):
+    obs = [WeeklyObservation(f'2024-W{w:02}', str(w), 'historical_numeric_temporally_controlled', None, True, v) for w,v in zip(weeks,values)]
+    try:
+        r = block_bootstrap_mean(obs, block_length=block, n_boot=1000, seed=1)
+    except ObservationError:
+        return
+    assert r.ci_low < r.ci_high, r
+
+def test_invalid_week_respects_bound(tmp_path):
+    holidays = [date(2024,1,15)+timedelta(days=i) for i in range(5)]
+    r = runner(tmp_path, end='2024-01-26', config_end='2024-01-16', closures=holidays,
+               dividends=[stock_div('2024-01-10',5), {'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-18','CashEarningsDistribution':2}])
+    result = r.run()
+    assert r.cursor['Q0'] <= date(2024,1,16), result
+    assert all(e.at.date() <= date(2024,1,16) for e in r.ledgers['Q0'].events)
+
+def test_pending_exit_does_not_read_future_close(tmp_path):
+    r = runner(tmp_path, end='2024-01-26', config_end='2024-01-09')
+    class Guard(dict):
+        def __contains__(self, key):
+            assert key <= date(2024,1,9), f'consulted future session {key}'
+            return super().__contains__(key)
+    r.market.by_session = {k:Guard(v) for k,v in r.market.by_session.items()}
+    r.run()
+
+def test_partial_tuesday_prior_basket_and_future_dividend_control(tmp_path):
+    ds = [stock_div('2024-01-10',5), {'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-18','CashEarningsDistribution':200}]
+    r = runner(tmp_path, end='2024-01-16', config_end='2024-01-19', dividends=ds)
+    result = r.run()
+    s = result['summary']['forecasters']['Q0']
+    assert result['summary']['simulation_bound']=='2024-01-16'
+    assert s['baskets_in_follow_up_at_end']==['2024-W02','2024-W03']
+    assert s['final_equity']==150000 and s['final_valuation']['receivables']==0
+    assert result['weeks'][-1]['forecasters']['Q0']['filled']==1
+
