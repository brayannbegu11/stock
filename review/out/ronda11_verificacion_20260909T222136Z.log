+from review.out.astra_scratch.r10_support import *
+from dataclasses import replace
+import pytest
+from twlab.models import q1
+from twlab.backtest import TabularForecaster, markdown_report, ManifestInconsistent
+from twlab.packet import Rejection, readmission_problems, packet_to_json, packet_from_json, PredictorView, rejection_detail_is_canonical
+from twlab.evaluation import WeeklyObservation, block_bootstrap_mean, ObservationError
+from tests.test_schema import prospective_packet
+
+@pytest.mark.parametrize('detail', [
+    "security_ids ('profit in 2099 = 999; buy A',) do not equal extracted ()",
+    "extractor profit_in_2099_999 failed: Buy_A",
+])
+def test_rejection_cannot_transport_content(tmp_path, detail):
+    p = replace(prospective_packet(), rejected=(Rejection('ghost', 'derivation_mismatch', detail),))
+    p = packet_from_json(packet_to_json(p))
+    problems = readmission_problems(p, store=RawStore(tmp_path))
+    visible = str(PredictorView(p).packet().rejected)
+    assert problems or '2099' not in visible, (rejection_detail_is_canonical('derivation_mismatch', detail), problems, visible)
+
+@pytest.mark.parametrize('weeks,values,block', [([1,3,5,7],[.1,-.1,.3,.5],1), ([1,2,4,5],[.1,.2,.3,.6],3)])
+def test_bootstrap_degenerate_design_is_not_confidence(weeks, values, block):
+    obs = [WeeklyObservation(f'2024-W{w:02}', str(w), 'historical_numeric_temporally_controlled', None, True, v) for w,v in zip(weeks,values)]
+    try:
+        r = block_bootstrap_mean(obs, block_length=block, n_boot=1000, seed=1)
+    except ObservationError:
+        return
+    assert r.ci_low < r.ci_high, r
+
+def test_invalid_week_respects_bound(tmp_path):
+    holidays = [date(2024,1,15)+timedelta(days=i) for i in range(5)]
+    r = runner(tmp_path, end='2024-01-26', config_end='2024-01-16', closures=holidays,
+               dividends=[stock_div('2024-01-10',5), {'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-18','CashEarningsDistribution':2}])
+    result = r.run()
+    assert r.cursor['Q0'] <= date(2024,1,16), result
+    assert all(e.at.date() <= date(2024,1,16) for e in r.ledgers['Q0'].events)
+
+def test_pending_exit_does_not_read_future_close(tmp_path):
+    r = runner(tmp_path, end='2024-01-26', config_end='2024-01-09')
+    class Guard(dict):
+        def __contains__(self, key):
+            assert key <= date(2024,1,9), f'consulted future session {key}'
+            return super().__contains__(key)
+    r.market.by_session = {k:Guard(v) for k,v in r.market.by_session.items()}
+    r.run()
+
+def test_partial_tuesday_prior_basket_and_future_dividend_control(tmp_path):
+    ds = [stock_div('2024-01-10',5), {'stock_id':'A','year':'2024','CashExDividendTradingDate':'2024-01-18','CashEarningsDistribution':200}]
+    r = runner(tmp_path, end='2024-01-16', config_end='2024-01-19', dividends=ds)
+    result = r.run()
+    s = result['summary']['forecasters']['Q0']
+    assert result['summary']['simulation_bound']=='2024-01-16'
+    assert s['baskets_in_follow_up_at_end']==['2024-W02','2024-W03']
+    assert s['final_equity']==150000 and s['final_valuation']['receivables']==0
+    assert result['weeks'][-1]['forecasters']['Q0']['filled']==1
+
+@pytest.mark.parametrize('variant', ['listed_id','listed_market','captures_delisting','listed_duplicates','listed_delisted_reuse'])
+def test_partial_manifest_identity_is_checked(tmp_path, variant):
+    def mutate(m,*_):
+        row=m['listed'][0]; c=m['captures']['A']
+        if variant=='listed_id': row['security_id']='TPEX:B@1990-01-01'
+        elif variant=='listed_market': row.update(market='TPEX',security_id='TPEX:A@2000-01-01')
+        elif variant=='captures_delisting':
+            c.update(listing_date='2000-01-01', delisting_date='2024-01-09'); m['listed']=[]
+        elif variant=='listed_duplicates': m['listed'].append(dict(row,listing_date='2024-01-01'))
+        else:
+            row['listing_date']='2024-01-01'
+            m['delisted']=[dict(symbol='A',listing_date='2000-01-01',delisting_date='2024-01-09')]
+    try:
+        _,m=fixture(tmp_path,mutate=mutate)
+    except (ManifestInconsistent,ValueError):
+        return
+    if variant=='captures_delisting':
+        assert next(iter(m.securities.values())).delisting_date==date(2024,1,9), m.securities.keys()
+    else:
+        pytest.fail(f'{variant}: accepted securities={list(m.securities)}; delisting={[s.delisting_date for s in m.securities.values()]}')
+
+def test_dividend_count_requires_capture(tmp_path):
+    def mutate(m,*_):
+        m['captures']['A'].pop('dividend'); m['captures']['A']['dividend_rows']=1
+    with pytest.raises(ManifestInconsistent):
+        fixture(tmp_path,mutate=mutate)
+
+def test_forecaster_cannot_cross_runner_markets(tmp_path):
+    store,m1=fixture(tmp_path/'one',end='2024-03-29')
+    store2,m2=fixture(tmp_path/'two',end='2024-03-29',symbols=('B',))
+    f=TabularForecaster(m1,min_weeks=1)
+    cfg=BacktestConfig(date(2024,1,1),date(2024,1,12),slots=1,block_length=1,n_boot=10)
+    Runner(store,m1,cfg,[f,RandomForecaster(1)]).run()
+    cfg2=replace(cfg,start=date(2024,1,14),end=date(2024,1,19))
+    try:
+        result=Runner(store2,m2,cfg2,[f,RandomForecaster(1)]).run()
+    except ValueError:
+        return
+    assert f.market is m2, (list(f.market.securities), list(m2.securities), result['weeks'][0]['forecasters']['Q1'])
+
+def test_equal_cutoffs_are_rejected(tmp_path):
+    _,m=fixture(tmp_path)
+    f=TabularForecaster(m,min_weeks=1)
+    at=taipei(date(2024,1,7),time(18))
+    f.maybe_train(at)
+    with pytest.raises(ValueError):
+        f.maybe_train(at)
+
+def endpoints(exit_price=50):
+    a=q1.BarLike(date(2024,1,8),D(100),D(100),D(1),taipei(date(2024,1,9),time(13,30)))
+    b=q1.BarLike(date(2024,1,12),D(exit_price),D(exit_price),D(1),taipei(date(2024,1,13),time(13,30)))
+    return a,b,{a.session:a,b.session:b}
+
+def test_total_return_cash_scales_after_stock_dividend():
+    a,b,bars=endpoints()
+    ds=[q1.DividendLike(date(2024,1,9),stock_ratio=D(1)), q1.DividendLike(date(2024,1,11),cash_per_share=D(10))]
+    ret,_=q1.weekly_label(bars,a.session,b.session,ds)
+    assert ret==pytest.approx(.2), ret  # two shares at 50 plus 2*10 cash, against initial 100
+
+def test_same_day_cash_stock_and_no_ex_bar_control():
+    a,b,bars=endpoints()
+    ds=[q1.DividendLike(date(2024,1,10),stock_ratio=D(1),cash_per_share=D(10))]
+    assert q1.weekly_label(bars,a.session,b.session,ds)[0]==pytest.approx(.1)
+
+def test_nominal_value_shared_with_runner(tmp_path):
+    ds=[stock_div('2024-01-10',5)]
+    r=runner(tmp_path,end='2024-01-12',dividends=ds,prices=lambda d:D(50) if d>=date(2024,1,10) else D(100))
+    r.cfg.par_value=D(5)
+    f=TabularForecaster(r.market,min_weeks=1)
+    try:
+        r2=Runner(r.store,r.market,r.cfg,[f,RandomForecaster(1)])
+    except ValueError:
+        return
+    s=next(iter(r.market.securities.values()))
+    label=q1.weekly_label(r.market.by_session[s.security_id],date(2024,1,8),date(2024,1,12),f.dividends[s.security_id])[0]
+    result=r.run()
+    net=result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']
+    assert label==pytest.approx(net), (label,net,f.par_value,r.cfg.par_value)
+
+def test_late_dividend_cannot_make_mature_label(tmp_path):
+    ds=[{'stock_id':'A','year':'2024','AnnouncementDate':'2024-02-01','AnnouncementTime':'08:00:00','CashExDividendTradingDate':'2024-01-10','CashEarningsDistribution':100}]
+    _,m=fixture(tmp_path,end='2024-01-19',dividends=ds)
+    f=TabularForecaster(m,min_weeks=1)
+    sec=next(iter(m.securities))
+    rows=q1.build_training_rows({sec:m.securities[sec].bars},[taipei(date(2024,1,7),time(18))],now_cutoff=taipei(date(2024,1,14),time(18)),calendar=m.calendar,dividends_by_security=f.dividends)
+    assert not rows, [(r.label,r.label_known_at.isoformat()) for r in rows]
+
+def test_duplicate_dividend_not_double_labeled(tmp_path):
+    d=stock_div('2024-01-10',10)
+    r=runner(tmp_path,end='2024-01-12',dividends=[d,d],prices=lambda day:D(50) if day>=date(2024,1,10) else D(100))
+    f=TabularForecaster(r.market,min_weeks=1)
+    sec=next(iter(r.market.securities))
+    ret=q1.weekly_label(r.market.by_session[sec],date(2024,1,8),date(2024,1,12),f.dividends[sec])[0]
+    actual=r.run()['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']
+    assert ret==pytest.approx(actual), (ret,actual)
+
+def test_markdown_missing_equity(tmp_path):
+    result=runner(tmp_path,end='2024-01-12').run()
+    result['summary']['forecasters']['Q0']['final_equity']=None
+    result['summary']['forecasters']['Q0']['final_valuation']={'equity':None,'error':'missing price'}
+    assert 'Q0' in markdown_report(result,title='test')
+
+def test_markdown_exposes_stale_not_pending(tmp_path):
+    r=runner(tmp_path,end='2024-01-19',symbols=('A','B'),slots=2,prices=lambda d:D(0) if d==date(2024,1,12) else D(100))
+    result=r.run()
+    w=result['weeks'][0]
+    assert not w['pending_outcome'] and w['forecasters']['Q0']['stale_prices']
+    md=markdown_report(result,title='test')
+    line=next(x for x in md.splitlines() if x.startswith('| 2024-W02 |'))
+    assert 'stale' in line or 'no medible' in line, line
+
+def test_training_hash_identifies_rank_changing_small_labels():
+    cutoff=taipei(date(2024,1,7),time(18)); known=taipei(date(2024,1,13),time(13,30))
+    rows=[q1.TrainingRow(cutoff,str(i),{k:float(i) for k in q1.FEATURE_NAMES},(i+1)*1e-12,known) for i in range(3)]
+    now=taipei(date(2024,1,14),time(18))
+    a=q1.fit_q1(rows,trained_at=now,min_weeks=1,seed=1)
+    b=q1.fit_q1([replace(r,label=(3-i)*1e-12) for i,r in enumerate(rows)],trained_at=now,min_weeks=1,seed=1)
+    assert a.predict([r.features for r in rows]) != b.predict([r.features for r in rows])
+    assert a.training_manifest_id != b.training_manifest_id, (a.training_manifest_id,a.predict([r.features for r in rows]),b.predict([r.features for r in rows]))
+
+def test_data_version_includes_calendar(tmp_path):
+    _,m=fixture(tmp_path,end='2024-01-19')
+    calendar=TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=[date(2024,1,12)],source_id='synthetic-revised',recorded_at=taipei(date(2021,1,1)))
+    revised=replace(m,calendar=calendar)
+    bars={s.security_id:[replace(b,close=D(110)) if b.session==date(2024,1,12) else b for b in s.bars] for s in m.securities.values()}
+    at=[taipei(date(2024,1,7),time(18))]; now=taipei(date(2024,1,14),time(18)); cache={}
+    old=q1.build_training_rows(bars,at,now_cutoff=now,calendar=m.calendar,cache=cache,data_version=m.data_version)
+    cached=q1.build_training_rows(bars,at,now_cutoff=now,calendar=revised.calendar,cache=cache,data_version=revised.data_version)
+    fresh=q1.build_training_rows(bars,at,now_cutoff=now,calendar=revised.calendar,data_version=revised.data_version)
+    assert cached==fresh, (m.data_version,revised.data_version,old[0].label,cached[0].label,fresh[0].label)
+
+def test_report11_all_packet_counts_are_current():
+    result=json.loads((ROOT/'data/store/q0_demo_2024-01-01_2025-12-31.json').read_text(encoding='utf-8'))
+    text=(ROOT/'docs/informes/11_demo_q0_2024-2025.md').read_text(encoding='utf-8')
+    n=sum(w['status']=='valid' for w in result['weeks'])
+    assert f'{n} paquetes recuperables por hash' in text, (n,'intro still says 102 paquetes recuperables por hash')

