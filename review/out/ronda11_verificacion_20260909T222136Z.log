      "prueba_propuesta": "import pytest\nfrom review.out.astra_scratch.r10_support import runner, stock_div, date, D\nfrom twlab.backtest import TabularForecaster\nfrom twlab.models import q1\n\ndef test_duplicate_event_does_not_duplicate_target(tmp_path):\n    d = stock_div('2024-01-10', 10)\n    r = runner(tmp_path, end='2024-01-12', dividends=[d,d], prices=lambda day: D(50) if day >= date(2024,1,10) else D(100))\n    f = TabularForecaster(r.market, min_weeks=1)\n    sec = next(iter(r.market.securities))\n    label = q1.weekly_label(r.market.by_session[sec], date(2024,1,8), date(2024,1,12), f.dividends[sec])[0]\n    actual = r.run()['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']\n    assert label == pytest.approx(actual)\n\n# Resolver duplicados y revisiones antes de alimentar tanto al libro como al etiquetador.",
