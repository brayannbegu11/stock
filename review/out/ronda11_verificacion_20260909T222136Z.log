      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner, date, D\nfrom twlab.backtest import markdown_report\n\ndef test_markdown_handles_unknown_equity(tmp_path):\n    result = runner(tmp_path, end='2024-01-12').run()\n    result['summary']['forecasters']['Q0']['final_equity'] = None\n    result['summary']['forecasters']['Q0']['final_valuation'] = {'equity':None, 'error':'missing price'}\n    assert 'Q0' in markdown_report(result, title='test')\n\ndef test_markdown_distinguishes_stale_from_pending(tmp_path):\n    result = runner(tmp_path, end='2024-01-19', symbols=('A','B'), slots=2, prices=lambda d: D(0) if d == date(2024,1,12) else D(100)).run()\n    assert not result['weeks'][0]['pending_outcome']\n    line = next(x for x in markdown_report(result,title='test').splitlines() if x.startswith('| 2024-W02 |'))\n    assert 'stale' in line or 'no medible' in line",
