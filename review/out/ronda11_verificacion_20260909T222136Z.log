+    a=q1.BarLike(date(2024,1,8),D(100),D(100),D(1),taipei(date(2024,1,9),time(13,30)))
+    b=q1.BarLike(date(2024,1,12),D(exit_price),D(exit_price),D(1),taipei(date(2024,1,13),time(13,30)))
+    return a,b,{a.session:a,b.session:b}
+
+def test_total_return_cash_scales_after_stock_dividend():
+    a,b,bars=endpoints()
+    ds=[q1.DividendLike(date(2024,1,9),stock_ratio=D(1)), q1.DividendLike(date(2024,1,11),cash_per_share=D(10))]
+    ret,_=q1.weekly_label(bars,a.session,b.session,ds)
+    assert ret==pytest.approx(.2), ret  # two shares at 50 plus 2*10 cash, against initial 100
+
+def test_same_day_cash_stock_and_no_ex_bar_control():
+    a,b,bars=endpoints()
+    ds=[q1.DividendLike(date(2024,1,10),stock_ratio=D(1),cash_per_share=D(10))]
+    assert q1.weekly_label(bars,a.session,b.session,ds)[0]==pytest.approx(.1)
+
+def test_nominal_value_shared_with_runner(tmp_path):
+    ds=[stock_div('2024-01-10',5)]
+    r=runner(tmp_path,end='2024-01-12',dividends=ds,prices=lambda d:D(50) if d>=date(2024,1,10) else D(100))
+    r.cfg.par_value=D(5)
+    f=TabularForecaster(r.market,min_weeks=1)
+    try:
+        r2=Runner(r.store,r.market,r.cfg,[f,RandomForecaster(1)])
+    except ValueError:
+        return
+    s=next(iter(r.market.securities.values()))
+    label=q1.weekly_label(r.market.by_session[s.security_id],date(2024,1,8),date(2024,1,12),f.dividends[s.security_id])[0]
+    result=r.run()
+    net=result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']
+    assert label==pytest.approx(net), (label,net,f.par_value,r.cfg.par_value)
+
+def test_late_dividend_cannot_make_mature_label(tmp_path):
+    ds=[{'stock_id':'A','year':'2024','AnnouncementDate':'2024-02-01','AnnouncementTime':'08:00:00','CashExDividendTradingDate':'2024-01-10','CashEarningsDistribution':100}]
+    _,m=fixture(tmp_path,end='2024-01-19',dividends=ds)
+    f=TabularForecaster(m,min_weeks=1)
+    sec=next(iter(m.securities))
+    rows=q1.build_training_rows({sec:m.securities[sec].bars},[taipei(date(2024,1,7),time(18))],now_cutoff=taipei(date(2024,1,14),time(18)),calendar=m.calendar,dividends_by_security=f.dividends)
+    assert not rows, [(r.label,r.label_known_at.isoformat()) for r in rows]
+
+def test_duplicate_dividend_not_double_labeled(tmp_path):
+    d=stock_div('2024-01-10',10)
+    r=runner(tmp_path,end='2024-01-12',dividends=[d,d],prices=lambda day:D(50) if day>=date(2024,1,10) else D(100))
+    f=TabularForecaster(r.market,min_weeks=1)
+    sec=next(iter(r.market.securities))
+    ret=q1.weekly_label(r.market.by_session[sec],date(2024,1,8),date(2024,1,12),f.dividends[sec])[0]
+    actual=r.run()['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']
+    assert ret==pytest.approx(actual), (ret,actual)
+
+def test_markdown_missing_equity(tmp_path):
+    result=runner(tmp_path,end='2024-01-12').run()
+    result['summary']['forecasters']['Q0']['final_equity']=None
+    result['summary']['forecasters']['Q0']['final_valuation']={'equity':None,'error':'missing price'}
+    assert 'Q0' in markdown_report(result,title='test')
+
+def test_markdown_exposes_stale_not_pending(tmp_path):
+    r=runner(tmp_path,end='2024-01-19',symbols=('A','B'),slots=2,prices=lambda d:D(0) if d==date(2024,1,12) else D(100))
+    result=r.run()
+    w=result['weeks'][0]
+    assert not w['pending_outcome'] and w['forecasters']['Q0']['stale_prices']
+    md=markdown_report(result,title='test')
+    line=next(x for x in md.splitlines() if x.startswith('| 2024-W02 |'))
+    assert 'stale' in line or 'no medible' in line, line
+
+def test_training_hash_identifies_rank_changing_small_labels():
+    cutoff=taipei(date(2024,1,7),time(18)); known=taipei(date(2024,1,13),time(13,30))
+    rows=[q1.TrainingRow(cutoff,str(i),{k:float(i) for k in q1.FEATURE_NAMES},(i+1)*1e-12,known) for i in range(3)]
+    now=taipei(date(2024,1,14),time(18))
+    a=q1.fit_q1(rows,trained_at=now,min_weeks=1,seed=1)
+    b=q1.fit_q1([replace(r,label=(3-i)*1e-12) for i,r in enumerate(rows)],trained_at=now,min_weeks=1,seed=1)
+    assert a.predict([r.features for r in rows]) != b.predict([r.features for r in rows])
+    assert a.training_manifest_id != b.training_manifest_id, (a.training_manifest_id,a.predict([r.features for r in rows]),b.predict([r.features for r in rows]))
+
+def test_data_version_includes_calendar(tmp_path):
+    _,m=fixture(tmp_path,end='2024-01-19')
+    calendar=TradingCalendar(start=date(2021,1,1),end=date(2026,12,31),closures=[date(2024,1,12)],source_id='synthetic-revised',recorded_at=taipei(date(2021,1,1)))
+    revised=replace(m,calendar=calendar)
+    bars={s.security_id:[replace(b,close=D(110)) if b.session==date(2024,1,12) else b for b in s.bars] for s in m.securities.values()}
+    at=[taipei(date(2024,1,7),time(18))]; now=taipei(date(2024,1,14),time(18)); cache={}
+    old=q1.build_training_rows(bars,at,now_cutoff=now,calendar=m.calendar,cache=cache,data_version=m.data_version)
+    cached=q1.build_training_rows(bars,at,now_cutoff=now,calendar=revised.calendar,cache=cache,data_version=revised.data_version)
+    fresh=q1.build_training_rows(bars,at,now_cutoff=now,calendar=revised.calendar,data_version=revised.data_version)
+    assert cached==fresh, (m.data_version,revised.data_version,old[0].label,cached[0].label,fresh[0].label)
+
