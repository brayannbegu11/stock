+    cfg2=replace(cfg,start=date(2024,1,14),end=date(2024,1,19))
+    try:
+        result=Runner(store2,m2,cfg2,[f,RandomForecaster(1)]).run()
+    except ValueError:
+        return
+    assert f.market is m2, (list(f.market.securities), list(m2.securities), result['weeks'][0]['forecasters']['Q1'])
+
+def test_equal_cutoffs_are_rejected(tmp_path):
+    _,m=fixture(tmp_path)
+    f=TabularForecaster(m,min_weeks=1)
+    at=taipei(date(2024,1,7),time(18))
+    f.maybe_train(at)
+    with pytest.raises(ValueError):
+        f.maybe_train(at)
+
+def endpoints(exit_price=50):
+    a=q1.BarLike(date(2024,1,8),D(100),D(100),D(1),taipei(date(2024,1,9),time(13,30)))
+    b=q1.BarLike(date(2024,1,12),D(exit_price),D(exit_price),D(1),taipei(date(2024,1,13),time(13,30)))
+    return a,b,{a.session:a,b.session:b}
+
+def test_total_return_cash_scales_after_stock_dividend():
+    a,b,bars=endpoints()
+    ds=[q1.DividendLike(date(2024,1,9),stock_ratio=D(1)), q1.DividendLike(date(2024,1,11),cash_per_share=D(10))]
+    ret,_=q1.weekly_label(bars,a.session,b.session,ds)
+    assert ret==pytest.approx(.2), ret  # two shares at 50 plus 2*10 cash, against initial 100
+
+def test_same_day_cash_stock_and_no_ex_bar_control():
+    a,b,bars=endpoints()
+    ds=[q1.DividendLike(date(2024,1,10),stock_ratio=D(1),cash_per_share=D(10))]
+    assert q1.weekly_label(bars,a.session,b.session,ds)[0]==pytest.approx(.1)
+
+def test_nominal_value_shared_with_runner(tmp_path):
+    ds=[stock_div('2024-01-10',5)]
+    r=runner(tmp_path,end='2024-01-12',dividends=ds,prices=lambda d:D(50) if d>=date(2024,1,10) else D(100))
+    r.cfg.par_value=D(5)
