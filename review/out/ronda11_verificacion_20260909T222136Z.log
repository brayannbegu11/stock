EVIDENCE = "historical_numeric_temporally_controlled"
PRE_OPEN = time(8, 59)


@dataclass
class BacktestConfig:
    start: date
    end: date
    slots: int = 5
    notional: int = 1_000_000
    sizing: str = "proportional"              # proportional | fixed
