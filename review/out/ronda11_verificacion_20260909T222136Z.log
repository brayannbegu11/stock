      "prueba_propuesta": "from review.out.astra_scratch.r10_support import fixture, date, time, taipei\nfrom twlab.models import q1\n\ndef test_missing_labels_are_retried(tmp_path):\n    _, market = fixture(tmp_path, end='2024-01-19')\n    bars = next(iter(market.securities.values())).bars\n    cutoffs = [taipei(date(2024,1,7),time(18))]\n    cache = {}\n    q1.build_training_rows({'A':[b for b in bars if b.session <= date(2024,1,10)]}, cutoffs, now_cutoff=taipei(date(2024,1,11)), calendar=market.calendar, cache=cache)\n    kw = dict(now_cutoff=taipei(date(2024,1,14),time(18)), calendar=market.calendar)\n    assert q1.build_training_rows({'A':bars},cutoffs,cache=cache,**kw) == q1.build_training_rows({'A':bars},cutoffs,**kw)\n\n# No congelar ausencias transitorias; vincular la cach├⌐ al archivo/versiones que la originaron.",
