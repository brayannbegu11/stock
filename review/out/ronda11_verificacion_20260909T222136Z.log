      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner, stock_div, date, D\nfrom twlab.backtest import Runner, TabularForecaster, RandomForecaster\n\ndef test_runner_rejects_inconsistent_par_value(tmp_path):\n    r = runner(tmp_path, end='2024-01-12', dividends=[stock_div('2024-01-10',5)], prices=lambda d: D(50) if d >= date(2024,1,10) else D(100))\n    r.cfg.par_value = D(5)\n    f = TabularForecaster(r.market, min_weeks=1)\n    try:\n        Runner(r.store, r.market, r.cfg, [f, RandomForecaster(1)])\n    except ValueError:\n        return\n    assert f.par_value == r.cfg.par_value\n\n# Compartir una conversi├│n validada por valor/evento o rechazar configuraciones incompatibles.",
