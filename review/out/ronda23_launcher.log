[31;1mdef classify_week(archive_label: str, w: dict) -> dict:[0m
[31;1m    """Clasificación temporal completa de una semana del JSON de resultados (exportador y ensamblador comparten esta función).[0m
[31;1m[0m
[31;1m    predicción ⇔ identidad, contrato, plazo, reloj y vínculo de cada predicción (`forecast_archive`) **y** procedencia[0m
[31;1m    íntegra del paquete con entradas antes del corte (`inputs_before_cutoff`) **y** nombres mostrados iguales a los del[0m
[31;1m    paquete archivado (R22-05). Devuelve `fa`, `inp`, `prospective` y `reasons`."""[0m
[31;1m    expected = {f: {"sha": x.get("forecast_sha256"), "picks": [p.get("security_id") for p in x.get("picks") or []],[0m
[31;1m                    "symbols": [p.get("symbol") for p in x.get("picks") or []], "status": x.get("forecast_status", x.get("status")),[0m
[31;1m                    "packet_hash": w.get("packet_hash"), "cutoff_at": w.get("cutoff_at")} for f, x in (w.get("forecasters") or {}).items()}[0m
[31;1m    fa = forecast_archive(archive_label, w["week_id"], expected)[0m
[31;1m    reasons = list(fa["reasons"])[0m
[31;1m    if not fa["before_deadline"]:[0m
[31;1m        return {"fa": fa, "inp": {"ok": None, "reason": "not_checked"}, "prospective": False, "reasons": reasons}[0m
[31;1m    inp = inputs_before_cutoff(w.get("packet_capture"), w["cutoff_at"], w.get("packet_hash"))[0m
[31;1m    if inp.get("reason"):[0m
[31;1m        reasons.append(inp["reason"])[0m
[31;1m    names_ok = inp.get("ok") is True[0m
[31;1m    if names_ok:[0m
[31;1m        archived = inp.get("names") or {}[0m
[31;1m        for f, x in (w.get("forecasters") or {}).items():[0m
[31;1m            for p in x.get("picks") or []:[0m
[31;1m                if archived.get(p.get("security_id")) is None or archived.get(p.get("security_id")) != p.get("name"):[0m
[31;1m                    names_ok = False; reasons.append(f"name_mismatch:{f}"); break[0m
[31;1m    return {"fa": fa, "inp": inp, "prospective": bool(fa["before_deadline"]) and inp.get("ok") is True and names_ok, "reasons": reasons}[0m
