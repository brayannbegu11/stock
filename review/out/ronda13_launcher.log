[31;1m                         "open": round(price * 0.998, 2), "max": round(price * 1.01, 2), "min": round(price * 0.99, 2),[0m
[31;1m                         "close": round(price, 2), "spread": 0.0, "Trading_turnover": 1500})[0m
[31;1m        d += timedelta(days=1)[0m
[31;1m    return rows[0m
