[31;1mdef validated_dividend_events(sec_id: str, rows: Sequence[finmind.DividendRow], par_value: D,[0m
[31;1m                              calendar: TradingCalendar) -> tuple[list[q1mod.DividendLike], list[str]]:[0m
[31;1m    """La **única** lista de derechos que consumen el libro y las etiquetas de Q1 (R12-01).[0m
[31;1m[0m
[31;1m    Un ``event_id`` (``{valor}:{cash|stock}:{fecha ex}:{periodo}``) con filas de valores distintos, o con una[0m
[31;1m    fila que el libro rechazaría (pago anterior a la fecha ex), se descarta por completo y se informa: ni el[0m
[31;1m    libro ni las etiquetas lo aplican. Las filas idénticas repetidas cuentan una vez.[0m
[31;1m    """[0m
[31;1m    candidates: dict[str, list] = {}[0m
[31;1m    problems: list[str] = [][0m
[31;1m    for dv in rows:[0m
[31;1m        known_at, quality = dividend_known_at(dv, calendar)[0m
[31;1m        if dv.cash_ex_date and dv.cash_per_share > 0:[0m
[31;1m            eid = f"{sec_id}:cash:{dv.cash_ex_date}:{dv.period}"[0m
[31;1m            if dv.cash_pay_date and dv.cash_pay_date < dv.cash_ex_date:[0m
[31;1m                candidates.setdefault(eid, []).append("invalid:pay_before_ex")[0m
[31;1m            else:[0m
[31;1m                candidates.setdefault(eid, []).append(q1mod.DividendLike(eid, dv.cash_ex_date, "cash", cash_per_share=dv.cash_per_share,[0m
[31;1m                                                                         known_at=known_at, pay_date=dv.cash_pay_date, known_quality=quality))[0m
[31;1m        if dv.stock_ex_date and dv.stock_per_share > 0:[0m
[31;1m            eid = f"{sec_id}:stock:{dv.stock_ex_date}:{dv.period}"[0m
[31;1m            candidates.setdefault(eid, []).append(q1mod.DividendLike(eid, dv.stock_ex_date, "stock", stock_ratio=dv.stock_per_share / par_value,[0m
[31;1m                                                                     known_at=known_at, pay_date=None, known_quality=quality))[0m
[31;1m    events: list[q1mod.DividendLike] = [][0m
[31;1m    for eid, cands in candidates.items():[0m
[31;1m        invalid = [c for c in cands if isinstance(c, str)][0m
[31;1m        distinct = {c for c in cands if not isinstance(c, str)}[0m
[31;1m        if invalid or len(distinct) > 1:[0m
[31;1m            problems.append(f"{eid}: {len(cands)} rows " + ("with an invalid member (" + ", ".join(invalid) + ")" if invalid else "with different values")[0m
[31;1m                            + "; event discarded for ledger and labels (R12-01)")[0m
[31;1m            continue[0m
[31;1m        events.append(next(iter(distinct)))[0m
