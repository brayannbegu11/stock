[31;1m                elif kind == "stock":[0m
[31;1m                    ledger.apply_corporate_action(CorporateAction(e.event_id, sec, "stock_dividend", at, stock_ratio=e.stock_ratio))[0m
[31;1m                elif kind == "delisting":[0m
