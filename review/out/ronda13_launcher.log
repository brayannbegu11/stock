[31;1m      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner, date, D\nfrom review.out.astra_scratch.test_r12_new import cash\nfrom twlab.backtest import dividend_events, ManifestInconsistent\nfrom twlab.models import q1\nimport pytest\n\ndef test_labels_and_ledger_reject_the_same_invalid_right(tmp_path):\n    bad = cash(amount=10, CashDividendPaymentDate='2024-01-09')\n    good = cash(amount=2)\n    try:\n        r = runner(tmp_path, dividends=[bad, good], end='2024-01-12')\n        sec = next(iter(r.market.securities))\n        events = dividend_events(sec, r.market.securities[sec].dividends, D(10))\n        label = q1.weekly_label(r.market.by_session[sec], date(2024,1,8), date(2024,1,12), events)[0]\n        result = r.run()\n    except ManifestInconsistent:\n        return\n    actual = result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']\n    assert label == pytest.approx(actual)\n\n# Rechazar colisiones incompatibles antes de entrenar o simular; validar y versionar los eventos una sola vez.",[0m
