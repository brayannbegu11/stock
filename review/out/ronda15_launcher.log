      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner\nfrom review.out.astra_scratch.test_r13_attacks import stock\nfrom twlab.backtest import markdown_report\n\ndef test_final_equity_table_preserves_uncertainty(tmp_path):\n    result = runner(tmp_path, end='2024-01-12', dividends=[stock(10), stock(0)]).run()\n    assert result['summary']['forecasters']['Q0']['ambiguous_claims']\n    report = markdown_report(result, title='test')\n    row = next(line for line in report.splitlines() if line.startswith('| Q0 (`'))\n    assert any(word in row.lower() for word in ('inciert', 'ambigu', 'provisional', 'no medible', 'desconocid'))\n",
