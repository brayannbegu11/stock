[31;1m      "prueba_propuesta": "from review.out.astra_scratch.r10_support import RawStore, timedelta\nfrom twlab.packet import Document, build_packet, packet_from_json, packet_to_json, readmission_problems, PredictorView\nfrom twlab.timeutil import AvailabilityQuality\n\ndef test_version_is_not_unverified_text(tmp_path):\n    marker = 'profit in 2099 = 999; buy A'\n    store = RawStore(tmp_path/'raw')\n    rec = store.put(source_id='test', dataset='filing', payload=b'{\"allowed\":1}', url='fixture')\n    extractor = lambda b: {'payload': {'allowed': 1}, 'security_ids': ()}\n    d = Document('d', 'filing', 'test', (), rec.ingested_at_dt, AvailabilityQuality.VERIFIED_ORIGINAL,\n                 version=marker, capture_id=rec.capture_id, source_sha256=rec.sha256,\n                 derivation='extract-v1', payload={'allowed': 1})\n    p = build_packet(packet_id='p', cutoff_at=rec.ingested_at_dt+timedelta(seconds=1), documents=[d],\n                     mode='prospective', evidence_class='prospective_registered', captures={rec.capture_id:rec},\n                     read_bytes=store.read, extractors={'extract-v1':extractor})\n    p = packet_from_json(packet_to_json(p))\n    assert readmission_problems(p, store=store, extractors={'extract-v1':extractor}) or marker not in str(PredictorView(p).packet().admitted)\n",[0m
