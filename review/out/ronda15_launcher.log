[31;1m        if dv.cash_ex_date is not None:[0m
[31;1m            groups.setdefault(("cash", dv.cash_ex_date), []).append([0m
[31;1m                {"amount": dv.cash_per_share, "pay": dv.cash_pay_date, "period": str(dv.period or "").strip(), "known_at": known_at, "quality": quality})[0m
[31;1m        if dv.stock_ex_date is not None:[0m
[31;1m            groups.setdefault(("stock", dv.stock_ex_date), []).append([0m
[31;1m                {"amount": dv.stock_per_share, "pay": None, "period": str(dv.period or "").strip(), "known_at": known_at, "quality": quality})[0m
[31;1m    events: list[q1mod.DividendLike] = [][0m
[31;1m    problems: list[str] = [][0m
[31;1m    for (kind, exd), members in groups.items():[0m
[31;1m        invalid: list[str] = [][0m
[31;1m        for m in members:[0m
[31;1m            if not _finite_nonneg(m["amount"]):[0m
[31;1m                invalid.append("non_finite_or_negative_amount")[0m
[31;1m            if not m["period"] and (isinstance(m["amount"], D) and m["amount"] != 0):[0m
[31;1m                invalid.append("missing_period")[0m
[31;1m            if kind == "cash" and m["pay"] and m["pay"] < exd:[0m
[31;1m                invalid.append("pay_before_ex")[0m
[31;1m        positive = [m for m in members if _finite_nonneg(m["amount"]) and m["amount"] > 0][0m
[31;1m        zero = [m for m in members if _finite_nonneg(m["amount"]) and m["amount"] == 0][0m
[31;1m        distinct = {(m["amount"], m["pay"], m["period"], m["known_at"]) for m in positive}[0m
[31;1m        period = positive[0]["period"] if positive else ""[0m
[31;1m        eid = f"{sec_id}:{kind}:{exd.isoformat()}:{period}"[0m
[31;1m        if invalid or len(distinct) > 1 or (positive and zero):[0m
[31;1m            why = "invalid member (" + ", ".join(sorted(set(invalid))) + ")" if invalid else ("zero and positive rows" if (positive and zero) else "different values")[0m
[31;1m            problems.append(f"{eid}: {len(members)} rows with {why}; right marked AMBIGUOUS: labels and intervals of holders are invalid (R13-02..05)")[0m
[31;1m            events.append(q1mod.DividendLike(eid, exd, kind, known_at=None, ambiguous=True))[0m
[31;1m            continue[0m
[31;1m        if not positive:[0m
