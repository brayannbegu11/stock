[31;1m+    d=Document('d','filing','test',(),when,AvailabilityQuality.VERIFIED_ORIGINAL,capture_id=rec.capture_id,source_sha256=rec.sha256,derivation=derivation,payload={'revenue':100})[0m
[31;1m+    d=replace(d,**fields)[0m
[31;1m+    ex={'extract-v1':lambda b:{'payload':json.loads(b),'security_ids':()}}[0m
[31;1m+    return store,rec,d,cutoff,ex[0m
