      "prueba_propuesta": "from review.out.astra_scratch.r10_support import runner\nfrom review.out.astra_scratch.test_r13_attacks import stock\n\ndef test_new_purchase_has_its_own_gross_return(tmp_path):\n    result = runner(tmp_path, end='2024-01-19', dividends=[stock(10), stock(0)]).run()\n    old, new = [w['forecasters']['Q0'] for w in result['weeks']]\n    assert old['picks'][0]['gross_return'] is None\n    assert new['filled'] == 1\n    assert new['portfolio_net_return_open_close'] is None\n    assert new['picks'][0]['gross_return'] == 0\n    assert new['mean_gross_pick_return'] == 0\n",
