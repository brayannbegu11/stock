[31;1mdef features_from_bars(bars: Sequence[BarLike], cutoff_at: datetime, *, sessions_expected_20: int = 20) -> Optional[dict[str, float]]:[0m
[31;1m    """Características de un valor en el corte; ``None`` si no hay historial suficiente (121 barras)."""[0m
[31;1m    known = [b for b in bars if to_utc(b.available_at) <= to_utc(cutoff_at) and b.close > 0 and b.open > 0][0m
[31;1m    if len(known) < 121:[0m
