+++ b/review/out/astra_scratch/test_r12_new.py
@@ -0,0 +1,125 @@
+from review.out.astra_scratch.r10_support import *
+from dataclasses import replace
+import pytest
+import math
+from twlab.backtest import dividend_events, dividend_known_at, TabularForecaster, markdown_report, ManifestInconsistent
+from twlab.models import q1
+from twlab.packet import Document, build_packet, packet_to_json, packet_from_json, readmission_problems, PredictorView
+from twlab.timeutil import AvailabilityQuality, derive_available_at
+from twlab.sources.finmind import dividends_from_rows
+
+
+def cash(ex='2024-01-10', amount=10, **kw):
+    return dict(stock_id='A', year='2024', CashExDividendTradingDate=ex,
+                CashEarningsDistribution=amount, AnnouncementDate='2024-01-02', AnnouncementTime='08:00:00', **kw)
+
+
+def test_rejected_doc_id_cannot_transport_future_content(tmp_path):
+    marker='profit in 2099 = 999; buy A'
+    d=Document(marker,'filing','test',(),taipei(date(2099,1,1)),AvailabilityQuality.VERIFIED_ORIGINAL)
+    p=build_packet(packet_id='p',cutoff_at=taipei(date(2024,1,7),time(18)),documents=[d],mode='historical',evidence_class='historical_numeric_temporally_controlled')
+    p=packet_from_json(packet_to_json(p))
+    problems=readmission_problems(p,store=RawStore(tmp_path/'raw'))
+    assert problems or marker not in str(PredictorView(p).packet().rejected), (problems,p.rejected)
+
+
+def test_saturday_announcement_waits_next_session(tmp_path):
+    ds=[dict(cash(),AnnouncementDate='2024-01-13',AnnouncementTime='')]
+    _,m=fixture(tmp_path,dividends=ds)
+    sec=next(iter(m.securities))
+    f=TabularForecaster(m,min_weeks=1)
+    expected=derive_available_at(date(2024,1,13),calendar=m.calendar).available_at
+    rows=q1.build_training_rows({sec:m.securities[sec].bars},[taipei(date(2024,1,7),time(18))],
+                               now_cutoff=taipei(date(2024,1,14),time(18)),calendar=m.calendar,dividends_by_security=f.dividends)
+    assert not rows, (expected,[(r.label,r.label_known_at) for r in rows])
+
+
+def test_captures_delisting_is_not_silently_erased(tmp_path):
+    def mutate(m,*_):
+        m['listed']=[]
+        m['captures']['A'].update(listing_date='2000-01-01',delisting_date='2024-01-09')
+    try:
+        r=runner(tmp_path,mutate=mutate,end='2024-01-12')
+    except ManifestInconsistent:
+        return
+    result=r.run()
+    sales=[(e.at.isoformat(),e.kind) for e in r.ledgers['Q0'].events if e.kind=='sell']
+    assert not sales, (sales,result['summary']['forecasters']['Q0']['final_valuation'])
+
+
+def test_conflicting_same_event_does_not_depend_on_row_order(tmp_path):
+    def label(ds,where):
+        _,m=fixture(where,dividends=ds,end='2024-01-12')
+        sec=next(iter(m.securities))
+        return q1.weekly_label(m.by_session[sec],date(2024,1,8),date(2024,1,12),dividend_events(sec,m.securities[sec].dividends,D(10)))
+    a,b=cash(amount=2),cash(amount=10)
+    try:
+        first=label([a,b],tmp_path/'a'); second=label([b,a],tmp_path/'b')
+    except (ManifestInconsistent,ValueError):
+        return
+    assert first==second,(first,second)
+
+
+def test_invalid_first_duplicate_does_not_diverge_label_and_book(tmp_path):
+    bad=cash(amount=10,CashDividendPaymentDate='2024-01-09')
+    good=cash(amount=2)
+    try:
+        r=runner(tmp_path,dividends=[bad,good],end='2024-01-12')
+        sec=next(iter(r.market.securities))
+        label=q1.weekly_label(r.market.by_session[sec],date(2024,1,8),date(2024,1,12),dividend_events(sec,r.market.securities[sec].dividends,D(10)))[0]
+        result=r.run()
+    except (ManifestInconsistent,ValueError):
+        return
+    net=result['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close']
+    assert label==pytest.approx(net),(label,net,result['weeks'][0].get('action_errors'))
+
+
+def test_bootstrap_result_can_be_serialized_as_strict_json(tmp_path):
+    result=runner(tmp_path,end='2024-01-12').run()
+    pe=result['summary']['forecasters']['Q0']['paired_excess_vs_baseline']
+    assert pe['degenerate'] and pe['n_fixed_observations']==1
+    json.dumps(result,allow_nan=False,default=str)
+
+
+def test_no_sessions_partial_bound_with_prior_residual_control(tmp_path):
+    closures=[date(2024,1,15)+timedelta(days=i) for i in range(5)]
+    r=runner(tmp_path,end='2024-01-26',config_end='2024-01-16',closures=closures,
+             dividends=[stock_div('2024-01-10',5),cash('2024-01-18',200)])
+    res=r.run(); s=res['summary']['forecasters']['Q0']
+    assert r.cursor['Q0']==date(2024,1,16)
+    assert all(e.at.date()<=date(2024,1,16) for e in r.ledgers['Q0'].events)
+    assert s['baskets_in_follow_up_at_end']==['2024-W02']
+    assert s['final_equity']==150000 and s['final_valuation']['receivables']==0
+
+
+@pytest.mark.parametrize('ex,kind,amount,period2',[
+    ('2024-01-10','cash',0,'2024'),('2024-01-10','stock',0,'2024'),
+    ('2024-01-10','cash',10,'2024'),('2024-01-10','cash',10,'2024Q2'),
+    ('2024-01-10','stock',10,'2024'),('2024-01-11','cash',10,'2024')])
+def test_event_parity_controls(tmp_path,ex,kind,amount,period2):
+    a=cash(ex,amount) if kind=='cash' else dict(stock_div(ex,amount),AnnouncementDate='2024-01-02',AnnouncementTime='08:00:00')
+    b=dict(a,year=period2)
+    r=runner(tmp_path,end='2024-01-12',dividends=[a,b],closures=[date(2024,1,11)])
+    sec=next(iter(r.market.securities))
+    events=dividend_events(sec,r.market.securities[sec].dividends,D(10))
+    label=q1.weekly_label(r.market.by_session[sec],date(2024,1,8),date(2024,1,12),events)[0]
+    res=r.run()
+    assert label==pytest.approx(res['weeks'][0]['forecasters']['Q0']['portfolio_net_return_open_close'])
+
+
+def test_no_session_stock_action_marks_obsolete_price(tmp_path):
+    closures=[date(2024,1,15)+timedelta(days=i) for i in range(5)]
+    r=runner(tmp_path,end='2024-01-26',config_end='2024-01-16',closures=closures,
+             dividends=[stock_div('2024-01-10',5),stock_div('2024-01-15',10)])
+    res=r.run(); val=res['summary']['forecasters']['Q0']['final_valuation']
+    assert val['equity'] is None or val['flags'],val
+
+
+def test_report16_nonincreasing_claim_is_not_current():
+    text=(ROOT/'docs/informes/16_respuesta_ronda10_astra.md').read_text(encoding='utf-8')
+    assert '**Cortes no crecientes y cach├⌐.** Se rechazan' not in text
+
+
+def test_report17_single_dividend_event_source_claim():
+    import inspect
+    assert 'dividend_events(' in inspect.getsource(Runner.apply_actions)

