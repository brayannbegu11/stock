[31;1mclass CostModel:[0m
[31;1m    commission_per_side: Decimal          # p. ej. D("0.001425") (ilustrativa, no contratada)[0m
[31;1m    sell_tax: Decimal = D("0.003")        # impuesto de transacción sobre venta de acciones ordinarias[0m
[31;1m    slippage_bps_per_side: int = 0[0m
[31;1m    rounding: str = "floor"               # floor | half_up; política declarada, a confirmar con el bróker[0m
[31;1m    label: str = "illustrative_not_contracted"[0m
[31;1m    min_commission_twd: Decimal = D(0)    # comisión mínima por orden (habitual: 20 TWD); pesa en órdenes pequeñas (lotes sueltos)[0m
[31;1m[0m
[31;1m    def commission(self, executed: Decimal) -> Decimal:[0m
[31;1m        if executed <= 0:[0m
[31;1m            return D(0)[0m
[31;1m        return max(self.round(executed * self.commission_per_side), D(self.min_commission_twd))[0m
[31;1m[0m
[31;1m    def __post_init__(self) -> None:[0m
[31;1m        for name in ("commission_per_side", "sell_tax"):[0m
[31;1m            v = getattr(self, name)[0m
[31;1m            if not isinstance(v, Decimal) or not v.is_finite() or v < 0 or v >= 1:[0m
[31;1m                raise LedgerError(f"{name} must be a finite Decimal in [0, 1)")[0m
[31;1m        if not isinstance(self.slippage_bps_per_side, int) or self.slippage_bps_per_side < 0 or self.slippage_bps_per_side >= 10_000:[0m
[31;1m            raise LedgerError("slippage_bps_per_side out of range")[0m
[31;1m        if self.rounding not in ("floor", "half_up"):[0m
[31;1m            raise LedgerError("rounding must be floor or half_up")[0m
[31;1m        if not isinstance(self.min_commission_twd, Decimal) or not self.min_commission_twd.is_finite() or self.min_commission_twd < 0:[0m
[31;1m            raise LedgerError("min_commission_twd must be a finite non-negative Decimal")[0m
[31;1m[0m
[31;1m    @property[0m
[31;1m    def slippage(self) -> Decimal:[0m
[31;1m        return D(self.slippage_bps_per_side) / D(10_000)[0m
[31;1m[0m
[31;1m    def round(self, x: Decimal) -> Decimal:[0m
[31;1m        return floor_twd(x) if self.rounding == "floor" else q_twd(x)[0m
