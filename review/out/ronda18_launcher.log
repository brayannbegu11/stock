[31;1m+def test_r17_01_boundary_sizing_and_ledger(lot,minimum,rounding):[0m
[31;1m+    rng=random.Random(1801)[0m
[31;1m+    for i in range(180):[0m
[31;1m+        p=D(rng.randrange(1,1500000))/100[0m
[31;1m+        c=CostModel(D('0.001425') if i%3 else D(0),slippage_bps_per_side=[0,10,20,25][i%4],min_commission_twd=D(minimum),rounding=rounding)[0m
[31;1m+        target=rng.randrange(1,30)*lot[0m
[31;1m+        budget=oracle_cost(target,p,c)+D(['-1','-0.01','0','0.01','1'][i%5])[0m
[31;1m+        lg=PaperLedger(ledger_id='r18',initial_cash=max(budget,D(0)),cost_model=c,lot_size=lot)[0m
[31;1m+        q=affordable_shares(lg,price=p,budget=budget)[0m
[31;1m+        assert q%lot==0 and q>=0[0m
[31;1m+        assert not q or oracle_cost(q,p,c)<=budget[0m
[31;1m+        assert oracle_cost(q+lot,p,c)>budget[0m
[31;1m+        if q:[0m
[31;1m+            f=lg.buy(security_id='A',price=p,shares=q,at=taipei(date(2024,1,8),time(9)),event_id='e')[0m
[31;1m+            assert isinstance(f,Fill)[0m
[31;1m+            assert -f.cash_delta==oracle_cost(q,p,c)==entry_cost(lg,price=p,shares=q)[0m
