[31;1m    assert lg.positions['A'].unresolved_fraction == D('.5')[0m
[31;1m    before=lg.cash[0m
[31;1m    exit_basket(lg,slots,close_prices={'A':D(200)},at=taipei(date(2024,1,19),time(13,30)),week_id='w')[0m
