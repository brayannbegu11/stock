[31;1m    exit_basket(lg,slots,close_prices={'A':D(200)},at=taipei(date(2024,1,12),time(13,30)),week_id='w')[0m
[31;1m    assert slots[0].exit.shares == 1 and slots[0].exit.commission == 20[0m
