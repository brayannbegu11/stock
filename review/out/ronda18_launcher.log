[31;1mdef q_twd(x: Decimal) -> Decimal:[0m
[31;1m    """Redondeo comercial a TWD entero (HALF_UP)."""[0m
[31;1m    return x.quantize(TWD, rounding=ROUND_HALF_UP)[0m
