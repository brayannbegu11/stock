[31;1m913:   const bars = rounds.map((r,i)=>{ let acc=0; const x=L+i*bw+gap/2, w=bw-gap; const segs=SEV.map(s=>{const n=r.severity[s]||0; if(!n) return ""; const y1=Y(acc+n), y0=Y(acc); acc+=n; return `<rect x="${x.toFixed(1)}" y="${y1.toFixed(1)}" width="${w.toFixed(1)}" height="${Math.max(0,(y0-y1)-1).toFixed(1)}" rx="1" style="fill:var(--sev-${({bloqueante:"block",alta:"high",media:"mid",baja:"low"})[s]})"/>`;}).join("");[0m
[31;1m914:     return segs+`<text x="${(x+w/2).toFixed(1)}" y="${(Y(r.findings_new)-5).toFixed(1)}" text-anchor="middle" style="fill:var(--ink-2)">${r.findings_new}</text><text x="${(x+w/2).toFixed(1)}" y="${H-8}" text-anchor="middle">${r.round}</text>`; }).join("");[0m
[31;1m915:   return `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="${esc(t("rev_chart"))}">${grid}${bars}</svg>`;[0m
[31;1m916: }[0m
