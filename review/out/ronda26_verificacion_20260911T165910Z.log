        asm._assemble(path,'# Backtest',header)
        assert 'entrada pendiente' in path.read_text(encoding='utf8')
        assert 'predicci├│n del protocolo seg├║n el reloj' in path.read_text(encoding='utf8')
    # Render actual exported fixture in all languages.
    path=tmp_path/'site.json';path.write_text(json.dumps(out),encoding='utf8')
    result=subprocess.run(['node',str(ROOT/'review/out/astra_scratch/r21_render.cjs'),'file',str(path)],cwd=ROOT,capture_output=True,text=True,encoding='utf8',check=True)
    rendered=json.loads(result.stdout)
