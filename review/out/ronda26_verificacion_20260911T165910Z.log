def test_changed_displayed_picks(tmp_path,monkeypatch):
    raw,m,cfg,r,d,now=sunday_fixture(tmp_path,monkeypatch)
    q=d['weeks'][-1]['forecasters']['Q0'];rec=raw.get(q['forecast_capture_id'])
