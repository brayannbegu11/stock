    raw,m=fixture(tmp_path,end='2024-01-26',symbols=('A','B'))
    now[0]=datetime(2024,1,7,12,tzinfo=timezone.utc)
    cfg=BacktestConfig(date(2024,1,1),date(2024,1,7),slots=1,notional=10000,lot_size=1,label='lab',archive_label='lab',n_boot=20)
    q1=MomentumForecaster();q1.name='Q1'
    r=Runner(raw,m,cfg,[MomentumForecaster(),q1,RandomForecaster(1)])
    d=r.run()
    return raw,m,cfg,r,d,now

