+@pytest.mark.parametrize('corrupt', ['first', 'second', 'both'])
+def test_master_multiple_copies(tmp_path, monkeypatch, corrupt):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    first = raw.get(data['weeks'][-1]['master_capture'])
+    payload = raw.read(first)
+    now[0] += timedelta(minutes=1)
+    second = raw.put(source_id='master', dataset='lab/master', payload=payload, url='fixture')
+    for rec, name in [(first, 'first'), (second, 'second')]:
+        if corrupt in (name, 'both'):
+            (raw.root / rec.path).write_bytes(b'corrupt')
+    now[0] = datetime(2024, 1, 14, 12, tzinfo=timezone.utc)
+    runner.run_week(date(2024, 1, 14))
+    w = runner.weeks[-1]
+    rec = raw.get(w['master_capture'])
+    assert raw.read(rec) == payload
+    if corrupt == 'first': assert rec.capture_id == second.capture_id
+    if corrupt == 'second': assert rec.capture_id == first.capture_id
+    for f in w['forecasters'].values():
+        forecast = raw.get(f['forecast_capture_id'])
+        assert rec.ingested_at_dt <= forecast.ingested_at_dt
+        assert json.loads(raw.read(forecast))['master_sha256'] == rec.sha256
+
