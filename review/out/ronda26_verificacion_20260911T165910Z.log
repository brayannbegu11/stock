+def test_runner_malformed_no_exception(tmp_path, monkeypatch, target, bad):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    w = data['weeks'][-1]
+    if target == 'manifest':
+        p = raw.root / 'manifest.jsonl'
