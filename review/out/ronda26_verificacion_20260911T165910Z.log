+def test_changed_master_same_runner(tmp_path, monkeypatch):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    sid = market.by_symbol['A']
+    v = market.master.current_segment(sid)
+    market.master.add(replace(v, name_en='Changed before W03', recorded_at=datetime(2024, 1, 10, 8, tzinfo=timezone.utc)))
+    now[0] = datetime(2024, 1, 14, 12, tzinfo=timezone.utc)
+    runner.run_week(date(2024, 1, 14))
+    w = runner.weeks[-1]
+    expected = hashlib.sha256(master_snapshot_bytes(market.master)).hexdigest()
+    actual = raw.get(w['master_capture']).sha256
+    assert actual == expected, (actual, expected, w['master_capture'])
