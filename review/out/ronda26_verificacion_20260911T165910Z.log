def test_all_scenario_summary_metrics_and_report_tables():
    from statistics import fmean
    for sid,_,report in ex.SCENARIOS:
        d=source(sid)
        for f,s in d['summary']['forecasters'].items():
            ws=[w['forecasters'][f] for w in d['weeks'] if w['status']=='valid' and not w.get('pending_outcome')]
            rs=[w['portfolio_net_return_open_close'] for w in ws if w.get('portfolio_net_return_open_close') is not None]
