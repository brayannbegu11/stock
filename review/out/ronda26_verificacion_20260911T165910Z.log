import copy
import importlib.util
import json
import subprocess
from dataclasses import replace
from datetime import date, datetime, timezone

import pytest
from review.out.astra_scratch import test_r21 as prev
from review.out.astra_scratch.test_r23 import setup, classify, rearchive_packet
from review.out.astra_scratch.test_r24 import rows_of, save_master
from twlab.packet import packet_from_json
from twlab.store import IntegrityError


def relink(raw, w, sha):
    for f, x in w['forecasters'].items():
        old = raw.get(x['forecast_capture_id'])
        body = json.loads(raw.read(old))
        body['master_sha256'] = sha
        rec = raw.put(source_id='forecast', dataset=old.dataset, payload=json.dumps(body).encode(), url='fixture')
        x.update(forecast_sha256=rec.sha256, forecast_capture_id=rec.capture_id)


def change_master(raw, w, rows):
    rec = save_master(raw, w, rows)
    w['master_sha256'] = rec.sha256
    relink(raw, w, rec.sha256)
    return rec


def rewrite_manifest(raw, mutate):
    path = raw.root / 'manifest.jsonl'
    rows = [json.loads(x) for x in path.read_text(encoding='utf8').splitlines()]
    mutate(rows)
    path.write_text('\n'.join(map(json.dumps, rows)), encoding='utf8')


@pytest.mark.parametrize('kind', ['past_revision', 'future_revision', 'future_valid_from', 'closed_on_cutoff',
    'backdated_replacement', 'overlap', 'orphan_closed_segment'])
def test_history_and_cutoff(tmp_path, monkeypatch, kind):
    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
    rows = rows_of(raw, w)
    row = next(x for x in rows if x['symbol'] == 'A')
    if kind in ('past_revision', 'future_revision'):
        revised = dict(row, recorded_at='2024-01-07T09:00:00+00:00' if kind == 'past_revision' else '2024-01-07T11:00:00+00:00')
        row['symbol'] = 'OLD'
        rows.append(revised)
    elif kind == 'future_valid_from': row['valid_from'] = '2024-01-08'
    elif kind == 'closed_on_cutoff': row['valid_to'] = '2024-01-07'
    elif kind == 'backdated_replacement':
        rows.append(dict(row, symbol='OLD', recorded_at='2024-01-05T08:00:00+00:00'))
    elif kind == 'overlap':
        rows.append(dict(row, valid_from='2024-01-01', recorded_at='2024-01-07T09:00:00+00:00'))
    else:
        # A standalone historical closed interval is valid under SecurityMaster.add;
        # it is not evidence of an unrecorded close_version operation.
        rows.append(dict(row, security_id='TWSE:C@2000-01-01', symbol='C', valid_to='2024-01-01'))
    change_master(raw, w, rows)
    result = classify(ex, w)
    assert result['prospective'] is (kind in ('past_revision', 'orphan_closed_segment')), result
    if kind in ('backdated_replacement', 'overlap'):
        assert any(x.startswith('master_contract:') for x in result['reasons']), result


def test_other_timely_master_is_not_the_linked_master(tmp_path, monkeypatch):
    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
    original_id = w['master_capture']
    rows = rows_of(raw, w)
    rows[0]['name_en'] = 'Different snapshot'
    other = save_master(raw, w, rows)
    w['master_capture'] = original_id
    relink(raw, w, other.sha256)
    result = classify(ex, w)
    assert result['prospective'] is False
    assert set(result['reasons']) == {'master_link_mismatch:Q0', 'master_link_mismatch:Q1', 'master_link_mismatch:A1'}


def test_corruption_between_weeks_same_runner(tmp_path, monkeypatch):
    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
    old = raw.get(data['weeks'][-1]['master_capture'])
    (raw.root / old.path).write_bytes(b'corrupt')
    now[0] = datetime(2024, 1, 14, 12, tzinfo=timezone.utc)
    runner.run_week(date(2024, 1, 14))
    w = runner.weeks[-1]
    assert w['week_id'] == '2024-W03'
    ex = prev.export_setup(monkeypatch, raw, data, tmp_path)
    result = classify(ex, w)
    assert result['prospective'] is False and 'master_corrupt' in result['reasons']
    # Either stop before issuing forecasts, or repair and cite an intact snapshot.
    raw.read(raw.get(w['master_capture']))


def test_master_after_forecast_before_deadline(tmp_path, monkeypatch):
    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
    w = data['weeks'][-1]
    old = raw.get(w['master_capture'])
    payload = raw.read(old)
    (raw.root / old.path).write_bytes(b'corrupt')
    now[0] = datetime(2024, 1, 7, 13, tzinfo=timezone.utc)
    rec = raw.put(source_id='master', dataset='lab/master', payload=payload, url='fixture')
    w['master_capture'] = rec.capture_id
    assert rec.sha256 == old.sha256
    ex = prev.export_setup(monkeypatch, raw, data, tmp_path)
    result = classify(ex, w)
    assert all(datetime.fromisoformat(t) < rec.ingested_at_dt for t in result['fa']['archived_at'].values())
    assert result['prospective'] is False, result


@pytest.mark.parametrize('doc_id', ['opaque-id', 'B:bars:2024-W02', 'A:prices:2024-W02'])
def test_nonmatching_series_id_is_rejected(tmp_path, monkeypatch, doc_id):
    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
    docs = tuple(replace(d, doc_id=doc_id) if d.kind == 'price_bar_series' and d.security_ids[0] == market.by_symbol['A'] else d for d in packet.admitted)
    rearchive_packet(raw, data, replace(packet, admitted=docs))
    result = classify(ex, w)
    assert result['prospective'] is False
    assert 'packet_symbol_mismatch:' + market.by_symbol['A'] in result['reasons']


def test_all_series_security_ids_are_checked(tmp_path, monkeypatch):
    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
    ghost = 'TWSE:GHOST@2000-01-01'
    docs = tuple(replace(d, security_ids=d.security_ids + (ghost,)) if d.kind == 'price_bar_series' else d for d in packet.admitted)
    rearchive_packet(raw, data, replace(packet, admitted=docs))
    result = classify(ex, w)
    assert result['prospective'] is False, result


@pytest.mark.parametrize('reason_case', ['master_link', 'master_late', 'master_contract', 'master_record', 'classification_error', 'reconstruction', 'late_and_master_link'])
def test_new_reasons_full_site_and_headers(tmp_path, monkeypatch, reason_case):
    raw, market, cfg, runner, _, now = prev.sunday_fixture(tmp_path, monkeypatch)
    cfg = replace(cfg, start=date(2023, 12, 10))
    data = prev.Runner(raw, market, cfg, list(runner.forecasters.values())).run()
    w = data['weeks'][-1]
    if reason_case in ('master_link', 'late_and_master_link'):
        relink(raw, w, '0' * 64)
        if reason_case == 'late_and_master_link':
            def late_source(rows):
                for row in rows:
                    if row['source_id'] not in ('forecast', 'packet', 'master'): row['ingested_at'] = '2024-01-07T12:00:00+00:00'
            rewrite_manifest(raw, late_source)
    elif reason_case == 'master_late':
        old = raw.get(w['master_capture']); payload = raw.read(old)
        (raw.root / old.path).write_bytes(b'corrupt')
        now[0] = datetime(2024, 1, 9, 12, tzinfo=timezone.utc)
