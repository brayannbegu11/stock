+import hashlib
+import json
+from dataclasses import replace
+from datetime import date, datetime, timezone, timedelta
+
+import pytest
+from review.out.astra_scratch import test_r21 as prev
+from review.out.astra_scratch.test_r23 import setup, classify, rearchive_packet
+from review.out.astra_scratch.test_r25 import rewrite_manifest, change_master
+from review.out.astra_scratch.test_r24 import rows_of
+from twlab.backtest import master_snapshot_bytes
+from twlab.packet import packet_from_json
+
+
+@pytest.mark.parametrize('target', ['source', 'packet', 'forecast', 'master'])
+@pytest.mark.parametrize('mutation', ['clock', 'late', 'sha', 'path'])
+def test_manifest_rewrite_rechecked(tmp_path, monkeypatch, target, mutation):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    cid = {'source': packet.admitted[0].capture_id, 'packet': w['packet_capture'],
+           'forecast': w['forecasters']['Q0']['forecast_capture_id'], 'master': w['master_capture']}[target]
+    key, value = {'clock': ('clock_source', 'injected'), 'late': ('ingested_at', '2024-01-09T12:00:00+00:00'),
+                  'sha': ('sha256', '0' * 64), 'path': ('path', 'missing.bin')}[mutation]
+    rewrite_manifest(raw, lambda rows: [r.update({key: value}) for r in rows if r['capture_id'] == cid])
+    cached = ex.classify_week('lab', w)
+    ex._MANIFEST = None
+    fresh = ex.classify_week('lab', w)
+    # Packet ingestion itself is allowed after the cutoff, but not source or forecast/master.
+    if (target, mutation) == ('packet', 'late'):
+        assert fresh['prospective'] is True
+    else:
+        assert fresh['prospective'] is False, fresh
+        assert cached['prospective'] is False, (target, mutation, cached['reasons'], fresh['reasons'])
+
+
+@pytest.mark.parametrize('target', ['master', 'packet', 'source', 'forecast'])
+def test_same_declared_sha_different_bytes(tmp_path, monkeypatch, target):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    cid = {'source': packet.admitted[0].capture_id, 'packet': w['packet_capture'],
+           'forecast': w['forecasters']['Q0']['forecast_capture_id'], 'master': w['master_capture']}[target]
+    rec = raw.get(cid)
+    (raw.root / rec.path).write_bytes(b'{}')
+    assert ex.classify_week('lab', w)['prospective'] is False
+
+
+@pytest.mark.parametrize('delta_us,clock', [(0, 'system'), (1, 'system'), (-1, 'system'), (0, 'injected')])
+def test_master_forecast_boundary(tmp_path, monkeypatch, delta_us, clock):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    at = datetime(2024, 1, 7, 12, tzinfo=timezone.utc) + timedelta(microseconds=delta_us)
+    rewrite_manifest(raw, lambda rows: [r.update(ingested_at=at.isoformat(), clock_source=clock)
+        for r in rows if r['capture_id'] == w['master_capture']])
+    result = classify(ex, w)
+    assert result['prospective'] is (delta_us <= 0 and clock == 'system'), result
+    if delta_us > 0:
+        assert all('master_after_forecast:' + f in result['reasons'] for f in w['forecasters'])
+
+
+@pytest.mark.parametrize('ids', [(), ('TWSE:A@2000-01-01',) * 2, ('TPEX:A@2000-01-01',)])
+def test_series_id_edge_cases(tmp_path, monkeypatch, ids):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    p = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    docs = tuple(replace(d, security_ids=ids) if d.kind == 'price_bar_series' and d.security_ids[0] == market.by_symbol['A'] else d for d in p.admitted)
+    rearchive_packet(raw, data, replace(p, admitted=docs))
+    assert classify(ex, w)['prospective'] is False
+
+
+@pytest.mark.parametrize('corrupt', ['first', 'second', 'both'])
+def test_master_multiple_copies(tmp_path, monkeypatch, corrupt):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    first = raw.get(data['weeks'][-1]['master_capture'])
+    payload = raw.read(first)
+    now[0] += timedelta(minutes=1)
+    second = raw.put(source_id='master', dataset='lab/master', payload=payload, url='fixture')
+    for rec, name in [(first, 'first'), (second, 'second')]:
+        if corrupt in (name, 'both'):
+            (raw.root / rec.path).write_bytes(b'corrupt')
+    now[0] = datetime(2024, 1, 14, 12, tzinfo=timezone.utc)
+    runner.run_week(date(2024, 1, 14))
+    w = runner.weeks[-1]
+    rec = raw.get(w['master_capture'])
+    assert raw.read(rec) == payload
+    if corrupt == 'first': assert rec.capture_id == second.capture_id
+    if corrupt == 'second': assert rec.capture_id == first.capture_id
+    for f in w['forecasters'].values():
+        forecast = raw.get(f['forecast_capture_id'])
+        assert rec.ingested_at_dt <= forecast.ingested_at_dt
+        assert json.loads(raw.read(forecast))['master_sha256'] == rec.sha256
+
+
+def test_changed_master_same_runner(tmp_path, monkeypatch):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    sid = market.by_symbol['A']
+    v = market.master.current_segment(sid)
+    market.master.add(replace(v, name_en='Changed before W03', recorded_at=datetime(2024, 1, 10, 8, tzinfo=timezone.utc)))
+    now[0] = datetime(2024, 1, 14, 12, tzinfo=timezone.utc)
+    runner.run_week(date(2024, 1, 14))
+    w = runner.weeks[-1]
+    expected = hashlib.sha256(master_snapshot_bytes(market.master)).hexdigest()
+    actual = raw.get(w['master_capture']).sha256
+    assert actual == expected, (actual, expected, w['master_capture'])
+
+
+def test_closed_master_same_runner_false_positive(tmp_path, monkeypatch):
+    raw, market, cfg, runner, data, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    sid = market.by_symbol['A']
+    market.master.close_version(sid, valid_to=date(2024, 1, 13),
+        recorded_at=datetime(2024, 1, 10, 8, tzinfo=timezone.utc), source_id='fixture')
+    now[0] = datetime(2024, 1, 14, 12, tzinfo=timezone.utc)
+    runner.run_week(date(2024, 1, 14))
+    w = runner.weeks[-1]
+    assert sid in [p['security_id'] for p in w['forecasters']['Q0']['picks']]
+    ex = prev.export_setup(monkeypatch, raw, data, tmp_path)
+    result = ex.classify_week('lab', w)
+    assert result['prospective'] is False, (w['week_id'], w['master_capture'], result['reasons'])
+
+
+@pytest.mark.parametrize('target', ['master', 'forecast'])
+def test_corrupt_injected_copy_does_not_shadow_intact_system_copy(tmp_path, monkeypatch, target):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    cid = w['master_capture'] if target == 'master' else w['forecasters']['Q0']['forecast_capture_id']
+    old = raw.get(cid)
+    path = raw.root / 'corrupt_earlier.bin'
+    path.write_bytes(b'corrupt')
+    def mutate(rows):
+        r = dict(next(r for r in rows if r['capture_id'] == cid))
+        r.update(capture_id='earlier-corrupt', ingested_at='2024-01-07T11:00:00+00:00',
+                 clock_source='injected', path=path.name)
+        rows.append(r)
+    rewrite_manifest(raw, mutate)
+    result = classify(ex, w)
+    assert result['prospective'] is True, result['reasons']
+
+
+@pytest.mark.parametrize('reason_case', ['master_after_forecast', 'packet_series_identity'])
+def test_new_reasons_site_headers(tmp_path, monkeypatch, reason_case):
+    import importlib.util
+    import subprocess
+    raw, market, cfg, runner, _, now = prev.sunday_fixture(tmp_path, monkeypatch)
+    cfg = replace(cfg, start=date(2023, 12, 10))
+    data = prev.Runner(raw, market, cfg, list(runner.forecasters.values())).run()
+    w = data['weeks'][-1]
+    if reason_case == 'master_after_forecast':
+        rewrite_manifest(raw, lambda rows: [r.update(ingested_at='2024-01-07T13:00:00+00:00')
+            for r in rows if r['capture_id'] == w['master_capture']])
+    else:
+        p = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+        docs = tuple(replace(d, security_ids=d.security_ids * 2) if d.kind == 'price_bar_series' else d for d in p.admitted)
+        rearchive_packet(raw, data, replace(p, admitted=docs))
+    ex = prev.export_setup(monkeypatch, raw, data, tmp_path)
+    output = ex.build()
+    current = output['scenarios'][0]['current_week']
+    assert not current['prospective'] and any(r.startswith(reason_case + ':') for r in current['reasons'])
+    asm = prev.load('assemble_backtest_reports')
+    original_spec = importlib.util.spec_from_file_location
+    def redirected(name, *args, **kwargs):
+        spec = original_spec(name, *args, **kwargs)
+        if name == 'export_site_data':
+            original_exec = spec.loader.exec_module
+            def execute(module):
+                original_exec(module)
+                module.RAW = raw.root
+            spec.loader.exec_module = execute
+        return spec
+    monkeypatch.setattr(importlib.util, 'spec_from_file_location', redirected)
+    for sid, header in [('standard', lambda: asm.header_15(data)), ('user', lambda: asm.header_15b(data, data)), ('longhist', lambda: asm.header_15c(data, data))]:
+        path = tmp_path / (sid + '.md')
+        path.write_text(prev.markdown_report(data, title='Backtest fixture'), encoding='utf8')
+        asm._assemble(path, '# Backtest', header)
+        assert all(reason in path.read_text(encoding='utf8') for reason in current['reasons'])
+    path = tmp_path / 'site.json'
+    path.write_text(json.dumps(output), encoding='utf8')
+    rendered = json.loads(subprocess.run(['node', 'review/out/astra_scratch/r22_render.cjs', 'file', str(path)],
+        capture_output=True, text=True, encoding='utf8', check=True).stdout)
+    assert set(rendered) == {'es', 'en', 'zh'}
+    for lang, x in rendered.items():
+        assert f'<b>{x["tag_unv"]} ┬╖' in x['week'], lang
+        assert all(reason in x['week'] for reason in current['reasons']), lang
+
+
