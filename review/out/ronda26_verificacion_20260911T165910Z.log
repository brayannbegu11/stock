import copy, hashlib, importlib.util, json, subprocess
from pathlib import Path
from datetime import datetime, date, time, timezone
from dataclasses import replace
import pytest
from review.out.astra_scratch.r10_support import fixture, Runner, BacktestConfig, MomentumForecaster, RandomForecaster, ROOT, taipei
from twlab.store import RawStore
