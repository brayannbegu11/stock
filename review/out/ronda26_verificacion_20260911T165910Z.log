+@pytest.mark.parametrize('target', ['source', 'packet', 'forecast', 'master'])
+@pytest.mark.parametrize('mutation', ['clock', 'late', 'sha', 'path'])
+def test_manifest_rewrite_rechecked(tmp_path, monkeypatch, target, mutation):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    cid = {'source': packet.admitted[0].capture_id, 'packet': w['packet_capture'],
+           'forecast': w['forecasters']['Q0']['forecast_capture_id'], 'master': w['master_capture']}[target]
+    key, value = {'clock': ('clock_source', 'injected'), 'late': ('ingested_at', '2024-01-09T12:00:00+00:00'),
+                  'sha': ('sha256', '0' * 64), 'path': ('path', 'missing.bin')}[mutation]
+    rewrite_manifest(raw, lambda rows: [r.update({key: value}) for r in rows if r['capture_id'] == cid])
+    cached = ex.classify_week('lab', w)
+    ex._MANIFEST = None
+    fresh = ex.classify_week('lab', w)
+    # Packet ingestion itself is allowed after the cutoff, but not source or forecast/master.
+    if (target, mutation) == ('packet', 'late'):
+        assert fresh['prospective'] is True
+    else:
+        assert fresh['prospective'] is False, fresh
+        assert cached['prospective'] is False, (target, mutation, cached['reasons'], fresh['reasons'])
+
+
+@pytest.mark.parametrize('target', ['master', 'packet', 'source', 'forecast'])
+def test_same_declared_sha_different_bytes(tmp_path, monkeypatch, target):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    cid = {'source': packet.admitted[0].capture_id, 'packet': w['packet_capture'],
+           'forecast': w['forecasters']['Q0']['forecast_capture_id'], 'master': w['master_capture']}[target]
+    rec = raw.get(cid)
+    (raw.root / rec.path).write_bytes(b'{}')
+    assert ex.classify_week('lab', w)['prospective'] is False
+
+
+@pytest.mark.parametrize('delta_us,clock', [(0, 'system'), (1, 'system'), (-1, 'system'), (0, 'injected')])
+def test_master_forecast_boundary(tmp_path, monkeypatch, delta_us, clock):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    at = datetime(2024, 1, 7, 12, tzinfo=timezone.utc) + timedelta(microseconds=delta_us)
+    rewrite_manifest(raw, lambda rows: [r.update(ingested_at=at.isoformat(), clock_source=clock)
+        for r in rows if r['capture_id'] == w['master_capture']])
+    result = classify(ex, w)
+    assert result['prospective'] is (delta_us <= 0 and clock == 'system'), result
+    if delta_us > 0:
+        assert all('master_after_forecast:' + f in result['reasons'] for f in w['forecasters'])
+
+
+@pytest.mark.parametrize('ids', [(), ('TWSE:A@2000-01-01',) * 2, ('TPEX:A@2000-01-01',)])
+def test_series_id_edge_cases(tmp_path, monkeypatch, ids):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    p = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    docs = tuple(replace(d, security_ids=ids) if d.kind == 'price_bar_series' and d.security_ids[0] == market.by_symbol['A'] else d for d in p.admitted)
+    rearchive_packet(raw, data, replace(p, admitted=docs))
+    assert classify(ex, w)['prospective'] is False
+
