+@pytest.mark.parametrize('target', ['source', 'packet', 'forecast', 'master'])
+@pytest.mark.parametrize('mutation', ['clock', 'late', 'sha', 'path'])
+def test_manifest_rewrite_rechecked(tmp_path, monkeypatch, target, mutation):
+    raw, market, data, ex, w = setup(tmp_path, monkeypatch)
+    packet = packet_from_json(raw.read(raw.get(w['packet_capture'])))
+    cid = {'source': packet.admitted[0].capture_id, 'packet': w['packet_capture'],
+           'forecast': w['forecasters']['Q0']['forecast_capture_id'], 'master': w['master_capture']}[target]
+    key, value = {'clock': ('clock_source', 'injected'), 'late': ('ingested_at', '2024-01-09T12:00:00+00:00'),
+                  'sha': ('sha256', '0' * 64), 'path': ('path', 'missing.bin')}[mutation]
+    rewrite_manifest(raw, lambda rows: [r.update({key: value}) for r in rows if r['capture_id'] == cid])
+    cached = ex.classify_week('lab', w)
+    ex._MANIFEST = None
+    fresh = ex.classify_week('lab', w)
+    # Packet ingestion itself is allowed after the cutoff, but not source or forecast/master.
+    if (target, mutation) == ('packet', 'late'):
+        assert fresh['prospective'] is True
+    else:
+        assert fresh['prospective'] is False, fresh
+        assert cached['prospective'] is False, (target, mutation, cached['reasons'], fresh['reasons'])
+
