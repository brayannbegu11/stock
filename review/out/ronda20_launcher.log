[31;1m            t = rec.get("ingested_at", "")[0m
[31;1m            if f not in out["archived_at"] or t < out["archived_at"][f]:[0m
[31;1m                out["archived_at"][f] = t[0m
[31;1m                first_rec[f] = rec[0m
[31;1m            out["archived_at_latest"][f] = max(out["archived_at_latest"].get(f, ""), t)[0m
[31;1m    for f, rec in first_rec.items():[0m
[31;1m        try:[0m
[31;1m            body = json.loads((RAW / rec["path"]).read_text(encoding="utf-8"))[0m
[31;1m            dl = (body.get("forecast") or {}).get("deadline_at")[0m
