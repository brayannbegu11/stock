[31;1m            if v["id"] in new_by_id and v["state"] == "reproducido" and r["round"] > emitted_round[v["id"]]:[0m
[31;1m                verified.add(v["id"])[0m
[31;1m    blocking = {i for i, s in new_by_id.items() if s == "bloqueante"}[0m
[31;1m    return {"new_total": len(new_by_id), "verified_total": len(verified), "blocking_new": len(blocking),[0m
[31;1m            "blocking_verified": len(blocking & verified), "unverified_ids": sorted(set(new_by_id) - verified)}[0m
[31;1m[0m
