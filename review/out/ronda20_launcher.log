[31;1m    R_PROVENANCE_MISMATCH: (r"document source or source_sha256 do not match the capture",),[0m
[31;1m    R_DERIVATION_MISMATCH: (r"derivation is not a registered extractor", r"extractor failed",[0m
[31;1m                            r"payload does not equal the extractor output on the archived bytes",[0m
[31;1m                            r"security_ids do not equal the extracted identities"),[0m
