[31;1mdef forecast_archive(archive_label: str, week_id: str) -> dict:[0m
[31;1m    """Primera hora real de archivo (ingested_at) de la lista de cada pronosticador para esa semana, el plazo del[0m
[31;1m    protocolo que declara la predicción archivada y si la primera ingestión fue anterior a ese plazo.[0m
[31;1m[0m
[31;1m    La primera ingestión es la única que vale como fecha de emisión; una corrida posterior que vuelva a archivar los[0m
[31;1m    mismos bytes no la adelanta ni la retrasa (RawStore.find). «Anterior al plazo» se decide con el reloj del sistema[0m
[31;1m    de la máquina que archivó: no hay sello externo, y así se declara en el sitio."""[0m
[31;1m    out: dict = {"archived_at": {}, "archived_at_latest": {}, "deadline_at": None, "before_deadline": None}[0m
[31;1m    mf = RAW / "manifest.jsonl"[0m
[31;1m    if not mf.exists():[0m
[31;1m        return out[0m
[31;1m    prefix = f"{archive_label}/"[0m
[31;1m    first_rec: dict[str, dict] = {}[0m
[31;1m    with mf.open(encoding="utf-8") as fh:[0m
[31;1m        for line in fh:[0m
[31;1m            try:[0m
[31;1m                rec = json.loads(line)[0m
[31;1m            except json.JSONDecodeError:[0m
[31;1m                continue[0m
[31;1m            if rec.get("source_id") != "forecast":[0m
