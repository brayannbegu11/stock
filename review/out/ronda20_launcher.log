[31;1m    if packet.mode == MODE_PROSPECTIVE and store is None:[0m
[31;1m        problems.append("archive_required_for_prospective_readmission (R09-02)")[0m
[31;1m    seen: set[str] = set()[0m
[31;1m    for d in packet.admitted:[0m
[31;1m        if d.doc_id in seen:[0m
[31;1m            problems.append(f"{d.doc_id}: duplicate doc_id")[0m
[31;1m        seen.add(d.doc_id)[0m
[31;1m        if d.availability_quality == AvailabilityQuality.UNKNOWN:[0m
[31;1m            problems.append(f"{d.doc_id}: {R_UNKNOWN_AVAILABILITY}")[0m
[31;1m        if d.published_at is not None and is_after(d.published_at, d.available_at):[0m
[31;1m            problems.append(f"{d.doc_id}: {R_INCONSISTENT_METADATA}")[0m
[31;1m        if is_after(d.available_at, packet.cutoff_at):[0m
[31;1m            problems.append(f"{d.doc_id}: {R_AVAILABLE_AFTER_CUTOFF}")[0m
[31;1m        # histórico: se verifica cuando hay archivo y registro y el documento declara derivación (R14-02)[0m
[31;1m        verify = packet.mode == MODE_PROSPECTIVE or (d.derivation is not None and store is not None and extractors is not None)[0m
[31;1m        if not verify:[0m
[31;1m            continue[0m
[31;1m        if d.capture_id is None or d.source_sha256 is None or d.derivation is None:[0m
[31;1m            problems.append(f"{d.doc_id}: {R_NO_CAPTURE_EVIDENCE}")[0m
[31;1m            continue[0m
[31;1m        prospective = packet.mode == MODE_PROSPECTIVE[0m
[31;1m        if prospective and (d.first_seen_at is None or is_after(d.first_seen_at, packet.cutoff_at)):[0m
[31;1m            problems.append(f"{d.doc_id}: {R_NOT_RECEIVED_BEFORE_CUTOFF}")[0m
[31;1m        if store is None:[0m
[31;1m            continue[0m
[31;1m        try:[0m
[31;1m            rec = store.get(d.capture_id)[0m
[31;1m        except KeyError:[0m
[31;1m            problems.append(f"{d.doc_id}: {R_NO_CAPTURE_EVIDENCE} (capture {d.capture_id} not in archive)")[0m
[31;1m            continue[0m
[31;1m        if rec.source_id != d.source_id or rec.sha256 != d.source_sha256:[0m
[31;1m            problems.append(f"{d.doc_id}: {R_PROVENANCE_MISMATCH}")[0m
[31;1m        if rec.clock_source != "system":[0m
[31;1m            problems.append(f"{d.doc_id}: {R_SYNTHETIC_CAPTURE}")[0m
[31;1m        if prospective and (is_after(rec.ingested_at_dt, packet.cutoff_at)[0m
[31;1m                            or (d.first_seen_at is not None and to_utc(d.first_seen_at) != to_utc(rec.ingested_at_dt))):[0m
[31;1m            problems.append(f"{d.doc_id}: {R_NOT_RECEIVED_BEFORE_CUTOFF}")     # reloj de ingestión: sólo prospectivo (R15-02)[0m
[31;1m        try:                                                    # integridad real de los bytes archivados (R09-01)[0m
[31;1m            raw = (read_bytes or store.read)(rec)[0m
[31;1m            if hashlib.sha256(raw).hexdigest() != rec.sha256:[0m
[31;1m                raise ValueError("archived bytes do not match capture sha256")[0m
[31;1m        except Exception as exc:[0m
[31;1m            problems.append(f"{d.doc_id}: archived bytes fail integrity: {exc}")[0m
[31;1m            continue[0m
[31;1m        extractor = (extractors or {}).get(d.derivation)[0m
[31;1m        if extractor is None:[0m
[31;1m            problems.append(f"{d.doc_id}: {R_DERIVATION_MISMATCH} (extractor {d.derivation!r} not registered; payload cannot be re-derived)")[0m
[31;1m            continue[0m
[31;1m        try:[0m
[31;1m            extraction = extractor(raw)[0m
[31;1m            if not isinstance(extraction, Mapping) or "payload" not in extraction or "security_ids" not in extraction:[0m
[31;1m                raise ValueError("extractor must return a mapping with 'payload' and 'security_ids'")[0m
[31;1m            if canonical_bytes(_thaw(extraction["payload"])) != canonical_bytes(_thaw(d.payload)):[0m
[31;1m                raise ValueError("payload does not equal extractor output on the archived bytes")[0m
[31;1m            if tuple(str(s) for s in extraction["security_ids"]) != d.security_ids:[0m
[31;1m                raise ValueError("security_ids do not equal extracted identities")[0m
[31;1m        except Exception as exc:[0m
[31;1m            problems.append(f"{d.doc_id}: {R_DERIVATION_MISMATCH} ({exc})")[0m
[31;1m    rejected_ids: set[str] = set()[0m
[31;1m    for r in packet.rejected:[0m
[31;1m        if not is_valid_doc_id(r.doc_id):[0m
[31;1m            problems.append("rejection doc_id is not an identifier (R09-03)")[0m
[31;1m            continue[0m
[31;1m        if r.doc_id in seen:[0m
[31;1m            problems.append(f"{r.doc_id}: document is both admitted and rejected")[0m
[31;1m        if r.doc_id in rejected_ids:[0m
[31;1m            problems.append(f"{r.doc_id}: duplicate rejection")[0m
[31;1m        rejected_ids.add(r.doc_id)[0m
[31;1m        if r.reason not in KNOWN_REJECTION_REASONS:[0m
[31;1m            problems.append(f"{r.doc_id}: rejection reason {r.reason!r} is not in the admission catalog (R09-03)")[0m
[31;1m        elif not rejection_detail_is_canonical(r.reason, r.detail):[0m
[31;1m            problems.append(f"{r.doc_id}: rejection detail is not one of the templates build_packet emits for {r.reason!r} (R09-03)")[0m
[31;1m    return problems[0m
