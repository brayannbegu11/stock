[31;1mdef readmission_problems([0m
[31;1m    packet: Packet,[0m
[31;1m    *,[0m
[31;1m    store: Optional[RawStore] = None,[0m
[31;1m    extractors: Optional[Mapping[str, Extractor]] = None,[0m
[31;1m    read_bytes: Optional[Callable[[CaptureRecord], bytes]] = None,[0m
